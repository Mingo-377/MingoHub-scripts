local function notifySystem(text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "MingoHub",
            Text = tostring(text),
            Duration = duration or 4,
        })
    end)
end

local player = Players.LocalPlayer
if not player then
    notifySystem("Waiting for game to load...", 3)
    local waited = 0
    repeat
        task.wait(0.1)
        waited += 0.1
        player = Players.LocalPlayer
    until player or waited >= 60
end

