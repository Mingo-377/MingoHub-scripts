        local hexBox = Instance.new("TextBox")
        hexBox.Size = UDim2.fromOffset(104, 32)
        hexBox.Position = UDim2.fromOffset(76, 40)
        hexBox.BackgroundColor3 = Color3.fromRGB(40, 47, 76)
        hexBox.Text = colorToHex(current)
        hexBox.TextColor3 = Color3.new(1, 1, 1)
        hexBox.PlaceholderText = "#RRGGBB"
        hexBox.Font = FONT
        hexBox.TextSize = 12
        hexBox.ClearTextOnFocus = false
        hexBox.ZIndex = 503
        hexBox.Parent = card
        corner(hexBox, 10)
        stroke(hexBox, 1, 0.4)
        label(card, "HEX CODE", 188, 47, 96, 18, 9)
        local sv = Instance.new("TextButton")
        sv.Size = UDim2.fromOffset(268, 148)
        sv.Position = UDim2.fromOffset(16, 82)
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        sv.BorderSizePixel = 0
        sv.Text = ""
        sv.AutoButtonColor = false
        sv.ClipsDescendants = true
        sv.ZIndex = 502
        sv.Parent = card
        corner(sv, 8)
        local svWhite = Instance.new("Frame")
        svWhite.Size = UDim2.fromScale(1, 1)
        svWhite.BackgroundColor3 = Color3.new(1, 1, 1)
        svWhite.BorderSizePixel = 0
        svWhite.ZIndex = 503
        svWhite.Parent = sv
        local svWhiteGrad = Instance.new("UIGradient")
        svWhiteGrad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
        svWhiteGrad.Parent = svWhite
        local svBlack = Instance.new("Frame")
        svBlack.Size = UDim2.fromScale(1, 1)
        svBlack.BackgroundColor3 = Color3.new(0, 0, 0)
        svBlack.BorderSizePixel = 0
        svBlack.ZIndex = 504
        svBlack.Parent = sv
        local svBlackGrad = Instance.new("UIGradient")
        svBlackGrad.Rotation = 90
        svBlackGrad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
        svBlackGrad.Parent = svBlack
        local svCursor = Instance.new("Frame")
        svCursor.Size = UDim2.fromOffset(14, 14)
        svCursor.AnchorPoint = Vector2.new(0.5, 0.5)
        svCursor.BackgroundTransparency = 1
        svCursor.ZIndex = 505
        svCursor.Parent = sv
        local svCursorDot = Instance.new("UICorner")
        svCursorDot.CornerRadius = UDim.new(1, 0)
        svCursorDot.Parent = svCursor
        local svRing = Instance.new("UIStroke")
        svRing.Color = Color3.new(1, 1, 1)
        svRing.Thickness = 2
        svRing.Transparency = 0.05
        svRing.Parent = svCursor
        local hueBar = Instance.new("TextButton")
        hueBar.Size = UDim2.fromOffset(268, 18)
        hueBar.Position = UDim2.fromOffset(16, 238)
        hueBar.BackgroundColor3 = Color3.new(1, 1, 1)
        hueBar.BorderSizePixel = 0
        hueBar.Text = ""
        hueBar.AutoButtonColor = false
        hueBar.ClipsDescendants = true
        hueBar.ZIndex = 502
        hueBar.Parent = card
        corner(hueBar, 9)
        local hueGrad = Instance.new("UIGradient")
        hueGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255, 0, 0)),
        })
        hueGrad.Parent = hueBar
        local hueCursor = Instance.new("Frame")
        hueCursor.Size = UDim2.fromOffset(6, 22)
        hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
        hueCursor.BackgroundColor3 = Color3.new(1, 1, 1)
        hueCursor.BorderSizePixel = 0
        hueCursor.ZIndex = 505
        hueCursor.Parent = hueBar
        corner(hueCursor, 3)
        stroke(hueCursor, 1, 0.2)
        local function refreshPicker()
            current = Color3.fromHSV(h, s, v)
            sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            preview.BackgroundColor3 = current
            hexBox.Text = colorToHex(current)
            local lum = current.R * 0.299 + current.G * 0.587 + current.B * 0.114
            hexBox.TextColor3 = lum > 0.62 and Color3.fromRGB(15, 18, 30) or Color3.new(1, 1, 1)
            svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
            hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
        end
        refreshPicker()
        local conns = {}
        local function track(conn) conns[#conns + 1] = conn end
        overlay.Destroying:Connect(function()
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        end)
        local svDragging, hueDragging = false, false
        local function updateSV(input)
            local ax, ay = sv.AbsolutePosition.X, sv.AbsolutePosition.Y
            local aw = math.max(sv.AbsoluteSize.X, 1)
            local ah = math.max(sv.AbsoluteSize.Y, 1)
            s = math.clamp((input.Position.X - ax) / aw, 0, 1)
            v = 1 - math.clamp((input.Position.Y - ay) / ah, 0, 1)
            refreshPicker()
        end
        local function updateHue(input)
            local ax = hueBar.AbsolutePosition.X
            local aw = math.max(hueBar.AbsoluteSize.X, 1)
            h = math.clamp((input.Position.X - ax) / aw, 0, 1)
            refreshPicker()
        end
        sv.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                svDragging = true
                updateSV(input)
            end
        end)
        hueBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                hueDragging = true
                updateHue(input)
            end
        end)
        track(UIS.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                if svDragging then updateSV(input) end
                if hueDragging then updateHue(input) end
            end
        end))
        track(UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                svDragging = false
                hueDragging = false
            end
        end))
        hexBox.FocusLost:Connect(function()
            local parsed = hexToColor(hexBox.Text)
            if parsed then h, s, v = Color3.toHSV(parsed) end
            refreshPicker()
        end)
        label(card, "PRESETS", 16, 266, 80, 14, 9, true)
        local presets = {
            { 132, 145, 255 }, { 174, 193, 255 }, { 75, 91, 190 }, { 255, 95, 86 },
            { 255, 189, 46 }, { 39, 201, 63 }, { 0, 200, 220 }, { 255, 105, 180 },
        }
        for i, rgb in ipairs(presets) do
            local p = Instance.new("TextButton")
            p.Size = UDim2.fromOffset(28, 22)
            p.Position = UDim2.fromOffset(16 + (i - 1) * 33, 284)
            p.BackgroundColor3 = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
            p.Text = ""
            p.AutoButtonColor = false
            p.ZIndex = 503
            p.Parent = card
            corner(p, 6)
            stroke(p, 1, 0.35)
            p.MouseButton1Click:Connect(function()
                h, s, v = Color3.toHSV(p.BackgroundColor3)
                refreshPicker()
            end)
        end
        local cancelBtn = Instance.new("TextButton")
        cancelBtn.Size = UDim2.fromOffset(120, 30)
        cancelBtn.Position = UDim2.fromOffset(16, 322)
        cancelBtn.BackgroundColor3 = Color3.fromRGB(44, 49, 72)
        cancelBtn.Text = "CANCEL"
        cancelBtn.TextColor3 = Color3.fromRGB(225, 230, 250)
        cancelBtn.Font = FONT_BOLD
        cancelBtn.TextSize = 11
        cancelBtn.AutoButtonColor = false
        cancelBtn.ZIndex = 503
        cancelBtn.Parent = card
        corner(cancelBtn, 10)
        cancelBtn.MouseButton1Click:Connect(function() overlay:Destroy() end)
        local applyBtn = Instance.new("TextButton")
        applyBtn.Size = UDim2.fromOffset(120, 30)
        applyBtn.Position = UDim2.fromOffset(164, 322)
        applyBtn.BackgroundColor3 = current
        applyBtn.Text = "APPLY"
        applyBtn.TextColor3 = Color3.new(1, 1, 1)
        applyBtn.Font = FONT_BOLD
        applyBtn.TextSize = 11
        applyBtn.AutoButtonColor = false
        applyBtn.ZIndex = 503
        applyBtn.Parent = card
        corner(applyBtn, 10)
        applyBtn.MouseButton1Click:Connect(function()
            if onApply then onApply(current) end
            overlay:Destroy()
        end)
        overlay.MouseButton1Click:Connect(function() overlay:Destroy() end)
        local function syncApplyTint() applyBtn.BackgroundColor3 = current end
        track(RunService.Heartbeat:Connect(syncApplyTint))
    end

    local function addColorRow(page, titleText, desc, getColor, onApply)
        local row = baseRow(page, 42)
        rowLabels(row, titleText, desc)
        local swatch = Instance.new("TextButton")
        swatch.Name = "ColorSwatch"
        swatch.Size = UDim2.fromOffset(58, 24)
        swatch.Position = UDim2.new(1, -68, 0.5, -12)
        swatch.Text = ""
        swatch.Font = FONT_BOLD
        swatch.TextSize = 8
        swatch.AutoButtonColor = false
        swatch.ZIndex = 7
        swatch.Parent = row
        corner(swatch, 10)
        stroke(swatch, 1, 0.25)
        local function renderSwatch()
            local c = getColor()
            swatch.BackgroundColor3 = c
            swatch.Text = colorToHex(c)
            local lum = c.R * 0.299 + c.G * 0.587 + c.B * 0.114
            swatch.TextColor3 = lum > 0.62 and Color3.fromRGB(20, 22, 34) or Color3.new(1, 1, 1)
        end
        renderSwatch()
        swatch.MouseButton1Click:Connect(function()
            openColorPicker(titleText, getColor(), function(c)
                onApply(c)
                renderSwatch()
            end)
        end)
        registerControl(renderSwatch)
        return swatch
    end

    local function resolveImage(img)
        if img:sub(1, 5) == "file:" then
            local path = img:sub(6)
            if getcustomasset and isfile and isfile(path) then
                local ok, id = pcall(getcustomasset, path)
                if ok then return id end
            end
            return nil
        elseif img:sub(1, 4) == "url:" then
            local url = img:sub(5)
            local h = 0
            for i = 1, #url do h = (h * 31 + url:byte(i)) % 1000000007 end
            local path = "velaware_bg_" .. h .. ".png"
            if writefile and getcustomasset and isfile then
                if not isfile(path) then
                    local ok, data = pcall(game.HttpGet, game, url)
                    if not ok then return nil end
                    writefile(path, data)
                end
                local ok, id = pcall(getcustomasset, path)
                if ok then return id end
            end
            return nil
        end
        return img
    end

    local function applyBackground(name)
        local b
        if Settings.Visuals.CustomBackground.Enabled and Settings.Visuals.CustomBackground.ImageId ~= "" then
            local img = Settings.Visuals.CustomBackground.ImageId
            if not img:match("^rbxassetid://") then img = "rbxassetid://" .. img end
            b = { image = img }
        else
            for _, x in ipairs(BACKGROUNDS) do
                if x.name == name then b = x end
            end
        end
        if not b or b.image == "" then return end
        local img = resolveImage(b.image)
        if not img then
            warn("[MingoHub] couldn't load background '" .. name .. "'")
            return
        end
        Appearance.Background = name
        currentBgDef = b
        frameIndex = 0
        frameClock = 0
        local sprite = b.cols ~= nil
        local newW = b.w or 341
        local newH = b.h or 213
        local rectSize = sprite and Vector2.new(newW, newH) or Vector2.new(0, 0)
        local scaleType = sprite and Enum.ScaleType.Stretch or Enum.ScaleType.Crop
        activeLayer.Image = img
        activeLayer.ImageTransparency = 0.06
        activeLayer.ImageRectOffset = Vector2.new(0, 0)
        activeLayer.ImageRectSize = rectSize
        activeLayer.ScaleType = scaleType
        activeLayer.Visible = true
        activeLayer.ZIndex = 1
        incomingLayer.Image = img
        incomingLayer.ImageTransparency = 1
        incomingLayer.ImageRectOffset = Vector2.new(0, 0)
        incomingLayer.ImageRectSize = rectSize
        incomingLayer.ScaleType = scaleType
        incomingLayer.Visible = false
        incomingLayer.ZIndex = 2
    end

    local antiLag = {
        active = false, textures = {}, effects = {}, skies = {}, atmos = {}, materials = {},
        partSet = setmetatable({}, { __mode = "k" }), lighting = nil, cc = nil, conns = {},
    }

    local function isCharacterPart(part)
        local model = part:FindFirstAncestorOfClass("Model")
        if not model then return false end
        if model:FindFirstChildOfClass("Humanoid") then return true end
        local ok, plr = pcall(function() return Players:GetPlayerFromCharacter(model) end)
        return ok and plr ~= nil
    end

    local function stripPart(part)
        if antiLag.partSet[part] then return end
        if isCharacterPart(part) then return end
        antiLag.partSet[part] = true
        local rec = { inst = part, material = part.Material, castShadow = part.CastShadow, reflectance = part.Reflectance }
        antiLag.materials[#antiLag.materials + 1] = rec
        pcall(function()
            part.Material = Enum.Material.SmoothPlastic
            part.CastShadow = false
            part.Reflectance = 0
            if part:IsA("MeshPart") then part.TextureID = "" end
        end)
    end

    local function stripInstance(inst)
        if not antiLag.active then return end
        local cls = inst.ClassName
        if cls == "Decal" or cls == "Texture" then
            local ok, tex = pcall(function() return inst.Texture end)
            if ok and tex ~= "" then
                antiLag.textures[#antiLag.textures + 1] = { inst = inst, prop = "Texture", old = tex }
                pcall(function() inst.Texture = "" end)
            end
        elseif cls == "MeshPart" then
            local ok, tex = pcall(function() return inst.TextureID end)
            if ok and tex ~= "" then
                antiLag.textures[#antiLag.textures + 1] = { inst = inst, prop = "TextureID", old = tex }
                pcall(function() inst.TextureID = "" end)
            end
        elseif cls == "SpecialMesh" then
            if inst.TextureId ~= "" then
                antiLag.textures[#antiLag.textures + 1] = { inst = inst, prop = "TextureId", old = inst.TextureId }
                pcall(function() inst.TextureId = "" end)
            end
        elseif cls == "SurfaceAppearance" then
            local ok, map = pcall(function() return inst.ColorMap end)
            if ok and map ~= "" then
                antiLag.textures[#antiLag.textures + 1] = { inst = inst, prop = "ColorMap", old = map }
                pcall(function() inst.ColorMap = "" end)
            end
        elseif cls == "ParticleEmitter" or cls == "Smoke" or cls == "Fire" or cls == "Sparkles"
            or cls == "Beam" or cls == "Trail" or cls == "Highlight"
            or cls == "PointLight" or cls == "SpotLight" or cls == "SurfaceLight" then
            local ok, enabled = pcall(function() return inst.Enabled end)
            if ok and enabled then
                antiLag.effects[#antiLag.effects + 1] = inst
                pcall(function() inst.Enabled = false end)
            end
        elseif cls == "Sky" then
            local rec = { inst = inst, faces = {}, stars = inst.StarCount, bodies = inst.CelestialBodiesShown }
            for _, prop in ipairs({ "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }) do
                rec.faces[prop] = inst[prop]
                pcall(function() inst[prop] = "" end)
            end
            pcall(function() inst.StarCount = 0; inst.CelestialBodiesShown = false end)
            antiLag.skies[#antiLag.skies + 1] = rec
        end
        if inst:IsA("BasePart") then stripPart(inst) end
    end

    local function applyGrayLighting()
        local L = Lighting
        antiLag.lighting = {
            Ambient = L.Ambient, OutdoorAmbient = L.OutdoorAmbient, Brightness = L.Brightness,
            ClockTime = L.ClockTime, FogColor = L.FogColor, FogStart = L.FogStart, FogEnd = L.FogEnd,
            GlobalShadows = L.GlobalShadows,
        }
        L.Ambient = Color3.fromRGB(72, 74, 84)
        L.OutdoorAmbient = Color3.fromRGB(84, 88, 100)
        L.Brightness = 1.1
        L.ClockTime = 14
        L.FogColor = Color3.fromRGB(104, 106, 118)
        L.FogStart = 0
        L.FogEnd = 100000
        L.GlobalShadows = false
        for _, eff in ipairs(L:GetChildren()) do
            if eff:IsA("PostEffect") and eff.Name ~= "VelaBlur" and eff.Name ~= "MingoAntiLagGray" then
                if eff.Enabled then
                    antiLag.effects[#antiLag.effects + 1] = eff
                    pcall(function() eff.Enabled = false end)
                end
            elseif eff:IsA("Atmosphere") then
                antiLag.atmos[#antiLag.atmos + 1] = { inst = eff, density = eff.Density }
                pcall(function() eff.Density = 0 end)
            end
        end
        local cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "MingoAntiLagGray"
        cc.Brightness = 0; cc.Contrast = 0; cc.Saturation = 0
        cc.TintColor = Color3.fromRGB(225, 228, 238)
        cc.Parent = L
        antiLag.cc = cc
        tween(cc, 0.55, { Brightness = 0.03, Contrast = 0.05, Saturation = -0.5 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    end

    local function restoreAntiLag()
        for _, rec in ipairs(antiLag.textures) do pcall(function() rec.inst[rec.prop] = rec.old end) end
        for _, eff in ipairs(antiLag.effects) do pcall(function() eff.Enabled = true end) end
        for _, sky in ipairs(antiLag.skies) do
            for prop, value in pairs(sky.faces) do pcall(function() sky.inst[prop] = value end) end
            pcall(function() sky.inst.StarCount = sky.stars; sky.inst.CelestialBodiesShown = sky.bodies end)
        end
        for _, rec in ipairs(antiLag.atmos) do pcall(function() rec.inst.Density = rec.density end) end
        for _, rec in ipairs(antiLag.materials) do
            pcall(function()
                rec.inst.Material = rec.material
                rec.inst.CastShadow = rec.castShadow
                rec.inst.Reflectance = rec.reflectance
            end)
        end
        antiLag.materials = {}
        antiLag.partSet = setmetatable({}, { __mode = "k" })
        if antiLag.cc then pcall(function() antiLag.cc:Destroy() end); antiLag.cc = nil end
        local saved = antiLag.lighting
        if saved then
            for prop, value in pairs(saved) do pcall(function() Lighting[prop] = value end) end
            antiLag.lighting = nil
        end
        antiLag.textures, antiLag.effects, antiLag.skies, antiLag.atmos = {}, {}, {}, {}
    end

    local function setAntiLag(on, silent)
        on = on and true or false
        Settings.Visuals.AntiLag = on
        if on == antiLag.active then return end
        antiLag.active = on
        if on then
            antiLag.textures, antiLag.effects, antiLag.skies, antiLag.atmos = {}, {}, {}, {}
            antiLag.materials, antiLag.partSet = {}, setmetatable({}, { __mode = "k" })
            applyGrayLighting()
            for _, inst in ipairs(workspace:GetDescendants()) do stripInstance(inst) end
            for _, inst in ipairs(Lighting:GetDescendants()) do stripInstance(inst) end
            antiLag.conns[#antiLag.conns + 1] = workspace.DescendantAdded:Connect(function(inst) stripInstance(inst) end)
            antiLag.conns[#antiLag.conns + 1] = Lighting.DescendantAdded:Connect(function(inst) stripInstance(inst) end)
        else
            for _, conn in ipairs(antiLag.conns) do pcall(function() conn:Disconnect() end) end
            antiLag.conns = {}
            restoreAntiLag()
        end
        if not silent then notify(on and "Anti-Lag enabled" or "Anti-Lag disabled") end
    end

    local CONFIG_DIR = "MingoHub_Configs"
    local memoryFiles = {}
    local function fsReady()
        return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
    end
    local function ensureConfigDir()
        if type(makefolder) == "function" and type(isfolder) == "function" then
            pcall(function() if not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end end)
        end
    end
    local function configPath(name) return CONFIG_DIR .. "/" .. name .. ".json" end
    local function readTextFile(path)
        if fsReady() then
            local ok, exists = pcall(isfile, path)
            if ok and exists then
                local ok2, data = pcall(readfile, path)
                if ok2 and type(data) == "string" then return data end
            end
        end
        return memoryFiles[path]
    end
    local function writeTextFile(path, data)
        memoryFiles[path] = data
        if fsReady() then
            ensureConfigDir()
            pcall(writefile, path, data)
        end
    end
    local function sanitizeName(name)
        name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
        name = name:gsub('[\\/:*?"<>|]', "_")
        if name == "" then return nil end
        return name
    end
    local function copyToClipboard(text)
        if type(setclipboard) == "function" then
            if pcall(setclipboard, text) then return true end
        end
        if type(toclipboard) == "function" then
            if pcall(toclipboard, text) then return true end
        end
        return false
    end
    local function readClipboard()
        if type(getclipboard) == "function" then
            local ok, value = pcall(getclipboard)
            if ok and type(value) == "string" then return value end
        end
        return nil
    end

    local function deepCopy(tbl)
        local out = {}
        for k, v in pairs(tbl) do
            out[k] = type(v) == "table" and deepCopy(v) or v
        end
        return out
    end
    local function deepApply(dst, src)
        for k, v in pairs(src) do
            local cur = dst[k]
            if type(cur) == "table" and type(v) == "table" then
                deepApply(cur, v)
            elseif cur ~= nil and type(v) == type(cur) then
                dst[k] = v
            end
        end
    end

    local function listConfigNames()
        local names, seen = {}, {}
        if fsReady() and type(listfiles) == "function" then
            local ok, files = pcall(listfiles, CONFIG_DIR)
            if ok and type(files) == "table" then
                for _, path in ipairs(files) do
                    local fname = tostring(path):match("([^/\\]+)$")
                    if fname and fname:sub(-5) == ".json" and fname:sub(1, 1) ~= "_" then
                        local n = fname:sub(1, #fname - 5)
                        if not seen[n] then seen[n] = true; names[#names + 1] = n end
                    end
                end
            end
        end
        for path in pairs(memoryFiles) do
            if path:sub(1, #CONFIG_DIR) == CONFIG_DIR then
                local fname = path:match("([^/\\]+)$")
                if fname and fname:sub(-5) == ".json" and fname:sub(1, 1) ~= "_" then
                    local n = fname:sub(1, #fname - 5)
                    if not seen[n] then seen[n] = true; names[#names + 1] = n end
                end
            end
        end
        table.sort(names)
        return names
    end

    local function readJsonFile(path)
        local raw = readTextFile(path)
        if not raw then return nil end
        local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok and type(data) == "table" then return data end
        return nil
    end

    local configListRefreshers = {}
    local function refreshConfigLists(selectName)
        for _, entry in ipairs(configListRefreshers) do
            if selectName then entry.set(selectName) else entry.refresh() end
        end
    end

    local AutoLoadState = { Enabled = false, Config = "" }
    local function autoLoadPath() return CONFIG_DIR .. "/_autoload.json" end
    local function persistAutoLoad() writeTextFile(autoLoadPath(), HttpService:JSONEncode(AutoLoadState)) end
    local function setAutoLoad(on, name)
        AutoLoadState.Enabled = on and true or false
        if name then AutoLoadState.Config = tostring(name) end
        persistAutoLoad()
    end
    do
        local saved = readJsonFile(autoLoadPath())
        if saved then
            AutoLoadState.Enabled = saved.Enabled == true
            AutoLoadState.Config = tostring(saved.Config or "")
        end
    end

    local function applyAppearance()
        applyColors(
            Color3.fromRGB(Appearance.Accent[1], Appearance.Accent[2], Appearance.Accent[3]),
            Color3.fromRGB(Appearance.Button[1], Appearance.Button[2], Appearance.Button[3]),
            Color3.fromRGB(Appearance.Border[1], Appearance.Border[2], Appearance.Border[3])
        )
        setUiScale(Appearance.Scale, true)
        setEdgeGlow(Appearance.EdgeGlow)
        setBlur(Appearance.Blur)
        if Appearance.Background then applyBackground(Appearance.Background) end
    end

    local function refreshGameplay()
        applyAntiDeathCounter()
        if currentCharacter then
            applyHeadless(currentCharacter)
            applyKorblox(currentCharacter)
        end
        if currentHumanoid then
            currentHumanoid.WalkSpeed = Settings.Player.WalkSpeedEnabled and (tonumber(Settings.Player.WalkSpeed) or 16) or 16
        end
        setAntiLag(Settings.Visuals.AntiLag, true)
        extra.setMotionBlur(Settings.Visuals.MotionBlur)
        extra.setCustomSky(Settings.Visuals.CustomSky.Enabled)
        extra.setCustomAtmosphere(Settings.Visuals.CustomAtmosphere.Enabled)
        extra.setAntiFling(Settings.Player.AntiFling)
        extra.setPingSpoof(Settings.Player.PingSpoof.Enabled)
        extra.setDeviceSpoof(Settings.Player.DeviceSpoof.Enabled)
        extra.setESP(Settings.ESP.Enabled)
        extra.setBackdash(Settings.Macros.Backdash.Enabled)
    end

    local function collectConfig()
        local s = deepCopy(Settings)
        if s.Macros and s.Macros.Backdash and s.Macros.Backdash.Keys then
            for i, k in ipairs(s.Macros.Backdash.Keys) do
                s.Macros.Backdash.Keys[i] = k and k.Name or nil
            end
        end
        return { version = VERSION, settings = s, appearance = deepCopy(Appearance) }
    end

    local function applyRGB(dst, src)
        if type(src) == "table" and #src == 3 then
            for i = 1, 3 do
                local v = tonumber(src[i])
                if v then dst[i] = math.clamp(math.floor(v), 0, 255) end
            end
        end
    end

    local function applyConfigTable(data)
        if type(data) ~= "table" then return false end
        if type(data.settings) == "table" then
            for group, values in pairs(Settings) do
                if type(values) == "table" and type(data.settings[group]) == "table" then
                    deepApply(values, data.settings[group])
                end
            end
            if data.settings.Macros and data.settings.Macros.Backdash and type(data.settings.Macros.Backdash.Keys) == "table" then
                for i, k in ipairs(data.settings.Macros.Backdash.Keys) do
                    if type(k) == "string" then
                        Settings.Macros.Backdash.Keys[i] = Enum.KeyCode[k]
                    end
                end
            end
        end
        if type(data.appearance) == "table" then
            local ap = data.appearance
            if type(ap.Background) == "string" then Appearance.Background = ap.Background end
            if type(ap.Blur) == "boolean" then Appearance.Blur = ap.Blur end
            if type(ap.EdgeGlow) == "boolean" then Appearance.EdgeGlow = ap.EdgeGlow end
            if tonumber(ap.Scale) then Appearance.Scale = math.clamp(tonumber(ap.Scale), 0.75, 2) end
            applyRGB(Appearance.Accent, ap.Accent)
            applyRGB(Appearance.Button, ap.Button)
            applyRGB(Appearance.Border, ap.Border)
        end
        applyAppearance()
        syncControls()
        refreshGameplay()
        return true
    end

    local function saveConfig(name)
        name = sanitizeName(name)
        if not name then notify("Enter a config name first") return end
        writeTextFile(configPath(name), HttpService:JSONEncode(collectConfig()))
        refreshConfigLists(name)
        notify("Saved config: " .. name)
    end

    local function loadConfig(name)
        name = sanitizeName(name)
        if not name then notify("No config selected") return end
        local data = readJsonFile(configPath(name))
        if not data then notify("Config not found: " .. name) return end
        if applyConfigTable(data) then
            notify("Loaded config: " .. name)
        else
            notify("Failed to load config: " .. name)
        end
    end

    local function deleteConfig(name)
        name = sanitizeName(name)
        if not name then notify("No config selected") return end
        local path = configPath(name)
        memoryFiles[path] = nil
        if fsReady() and type(delfile) == "function" then
            pcall(function() if isfile(path) then delfile(path) end end)
        end
        refreshConfigLists()
        notify("Deleted config: " .. name)
    end

    local function exportConfig(name)
        name = sanitizeName(name)
        local data = name and readJsonFile(configPath(name)) or nil
        if not data then data = collectConfig() end
        local json = HttpService:JSONEncode(data)
        local copied = copyToClipboard(json)
        print("[MingoHub] Config export (" .. (name or "current settings") .. "):\n" .. json)
        notify(copied and "Config JSON copied to clipboard" or "Clipboard unavailable, check console")
    end

    local function importConfig(name, text)
        name = sanitizeName(name) or "imported"
        text = tostring(text or "")
        text = text:gsub("^%s+", ""):gsub("%s+$", "")
        if text == "" then
            text = readClipboard() or ""
            text = text:gsub("^%s+", ""):gsub("%s+$", "")
        end
        if text == "" then notify("Paste JSON first (or copy it)") return end
        local ok, data = pcall(HttpService.JSONDecode, HttpService, text)
        if not ok or type(data) ~= "table" then notify("Import failed: invalid JSON") return end
        writeTextFile(configPath(name), HttpService:JSONEncode(data))
        refreshConfigLists(name)
        notify("Imported config: " .. name)
    end

    local activeMenu
    local function closeSelectMenu()
        if activeMenu then pcall(function() activeMenu:Destroy() end); activeMenu = nil end
    end

    local function openSelectMenu(anchorButton, options, onPick)
        closeSelectMenu()
        local menu = Instance.new("ScrollingFrame")
        menu.Name = "ConfigSelectMenu"
        menu.Size = UDim2.fromOffset(180, math.min(math.max(#options, 1) * 24 + 8, 190))
        menu.BackgroundColor3 = Color3.fromRGB(13, 18, 40)
        menu.BackgroundTransparency = 0.06
        menu.BorderSizePixel = 0
        menu.ScrollBarThickness = 3
        menu.ScrollBarImageColor3 = Palette.Accent
        menu.CanvasSize = UDim2.new()
        menu.AutomaticCanvasSize = Enum.AutomaticSize.Y
        menu.ZIndex = 80
        menu.Parent = gui
        corner(menu, 12)
        local menuStroke = stroke(menu, 1, 0.35)
        menuStroke.ZIndex = 80
        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 2)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = menu
        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 4); pad.PaddingBottom = UDim.new(0, 4)
        pad.PaddingLeft = UDim.new(0, 4); pad.PaddingRight = UDim.new(0, 4)
        pad.Parent = menu
        if #options == 0 then
            local empty = Instance.new("TextLabel")
            empty.Size = UDim2.new(1, 0, 0, 22)
            empty.BackgroundTransparency = 1
            empty.Text = "No configs yet"
            empty.TextColor3 = Color3.fromRGB(190, 199, 230)
            empty.Font = FONT
            empty.TextSize = 11
            empty.ZIndex = 81
            empty.Parent = menu
        end
        for i, option in ipairs(options) do
            local optionButton = Instance.new("TextButton")
            optionButton.Size = UDim2.new(1, 0, 0, 22)
            optionButton.LayoutOrder = i
            optionButton.BackgroundColor3 = Palette.Button
            optionButton.BackgroundTransparency = 0.5
            optionButton.Text = "  " .. tostring(option)
            optionButton.TextColor3 = Color3.new(1, 1, 1)
            optionButton.TextXAlignment = Enum.TextXAlignment.Left
            optionButton.TextTruncate = Enum.TextTruncate.AtEnd
            optionButton.Font = FONT
            optionButton.TextSize = 11
            optionButton.AutoButtonColor = false
            optionButton.ZIndex = 81
            optionButton.Parent = menu
            corner(optionButton, 8)
            optionButton.MouseButton1Click:Connect(function()
                closeSelectMenu()
                onPick(option)
            end)
        end
        local anchorPos, anchorSize = anchorButton.AbsolutePosition, anchorButton.AbsoluteSize
        local viewport = gui.AbsoluteSize
        local x = math.clamp(anchorPos.X + anchorSize.X - menu.Size.X.Offset, 6, math.max(6, viewport.X - menu.Size.X.Offset - 6))
        local y = anchorPos.Y + anchorSize.Y + 4
        if y + menu.Size.Y.Offset > viewport.Y - 6 then y = anchorPos.Y - menu.Size.Y.Offset - 4 end
        menu.Position = UDim2.fromOffset(x, math.max(6, y))
        local inputConn
        inputConn = UIS.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local p = input.Position
                local ap, as = menu.AbsolutePosition, menu.AbsoluteSize
                if p.X < ap.X or p.X > ap.X + as.X or p.Y < ap.Y or p.Y > ap.Y + as.Y then closeSelectMenu() end
            end
        end)
        menu.Destroying:Connect(function()
            if inputConn then inputConn:Disconnect() end
        end)
        activeMenu = menu
    end

    local function makeConfigSelector(page, titleText, desc)
        local row = baseRow(page, 42)
        rowLabels(row, titleText, desc)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.fromOffset(100, 22)
        btn.Position = UDim2.new(1, -110, 0.5, -11)
        btn.BackgroundColor3 = Palette.Button
        btn.BackgroundTransparency = 0.36
        btn.Text = "None"
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = FONT
        btn.TextSize = 11
        btn.AutoButtonColor = false
        btn.ZIndex = 7
        btn:SetAttribute("ThemeRole", "field")
        btn.Parent = row
        corner(btn, 10)
        stroke(btn, 1, 0.6)
        local selected
        local function refresh(preferred)
            local list = listConfigNames()
            if preferred and table.find(list, preferred) then selected = preferred end
            if not selected or not table.find(list, selected) then selected = list[1] end
            btn.Text = selected or "None"
            return list
        end
        btn.MouseButton1Click:Connect(function()
            openSelectMenu(btn, listConfigNames(), function(choice)
                selected = choice
                btn.Text = choice
                if AutoLoadState.Enabled then setAutoLoad(true, choice) end
            end)
        end)
        refresh(AutoLoadState.Config ~= "" and AutoLoadState.Config or nil)
        local entry = {
            refresh = refresh,
            get = function() return selected end,
            set = function(value) selected = value; refresh(value) end,
        }
        configListRefreshers[#configListRefreshers + 1] = entry
        return entry
    end

    local function autoLoadOnStart()
        if not AutoLoadState.Enabled then return end
        local name = sanitizeName(AutoLoadState.Config)
        if not name then return end
        local data = readJsonFile(configPath(name))
        if data and applyConfigTable(data) then notify("Auto-loaded config: " .. name) end
    end

    local loopPopup
    local function toggleLoopPopup()
        if loopPopup and loopPopup.Parent then loopPopup:Destroy(); loopPopup = nil; return end
        loopPopup = Instance.new("Frame")
        loopPopup.Size = UDim2.fromOffset(WIN_W, WIN_H)
        loopPopup.Position = UDim2.new(0.5, WIN_W/2 + 20, 0.5, -WIN_H/2)
        loopPopup.BackgroundTransparency = 1
        loopPopup.Parent = gui
        loopPopup.ZIndex = 100
        loopPopup.ClipsDescendants = true
        local pWindow = Instance.new("CanvasGroup")
        pWindow.Size = UDim2.fromOffset(WIN_W, WIN_H)
        pWindow.BackgroundColor3 = Color3.fromRGB(10, 15, 39)
        pWindow.BackgroundTransparency = 0.34
        pWindow.BorderSizePixel = 0
        pWindow.Parent = loopPopup
        corner(pWindow, 24)
        stroke(pWindow, 1.5, 0.35)
        local pScale = Instance.new("UIScale")
        pScale.Scale = 0.92
        pScale.Parent = pWindow
        tween(pScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
        local pTitle = Instance.new("Frame")
        pTitle.Size = UDim2.new(1, 0, 0, BAR_H)
        pTitle.BackgroundTransparency = 1
        pTitle.ZIndex = 6
        pTitle.Parent = pWindow
        local pLabel = Instance.new("TextLabel")
        pLabel.Size = UDim2.new(1, -140, 1, 0)
        pLabel.Position = UDim2.new(0, 76, 0, 0)
        pLabel.BackgroundTransparency = 1
        pLabel.Text = "MingoHub  |  Loop V2"
        pLabel.TextColor3 = Color3.fromRGB(235, 235, 242)
        pLabel.Font = FONT
        pLabel.TextSize = 12
        pLabel.TextXAlignment = Enum.TextXAlignment.Left
        pLabel.ZIndex = 6
        pLabel.Parent = pTitle
        local pClose = Instance.new("TextButton")
        pClose.Size = UDim2.fromOffset(12, 12)
        pClose.Position = UDim2.new(0, 14, 0.5, -6)
        pClose.BackgroundColor3 = Color3.fromRGB(255, 95, 86)
        pClose.Text = "x"
        pClose.TextColor3 = Color3.fromRGB(60, 20, 20)
        pClose.TextSize = 10
        pClose.Font = FONT_BOLD
        pClose.AutoButtonColor = false
        pClose.ZIndex = 7
        pClose.Parent = pTitle
        corner(pClose, 6)
        stroke(pClose, 1, 0.6)
        pClose.MouseButton1Click:Connect(function() loopPopup:Destroy(); loopPopup = nil end)
        local pScroll = Instance.new("ScrollingFrame")
        pScroll.Size = UDim2.new(1, -20, 1, -BAR_H - 10)
        pScroll.Position = UDim2.fromOffset(10, BAR_H + 5)
        pScroll.BackgroundTransparency = 1
        pScroll.BorderSizePixel = 0
        pScroll.ScrollBarThickness = 2
        pScroll.ScrollBarImageColor3 = Palette.Accent
        pScroll.CanvasSize = UDim2.new()
        pScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        pScroll.ZIndex = 5
        pScroll:SetAttribute("ThemeRole", "scroll")
        pScroll.Parent = pWindow
        local pLay = Instance.new("UIListLayout")
        pLay.Padding = UDim.new(0, 6)
        pLay.SortOrder = Enum.SortOrder.LayoutOrder
        pLay.Parent = pScroll
        local pPad = Instance.new("UIPadding")
        pPad.PaddingTop = UDim.new(0, 2); pPad.PaddingBottom = UDim.new(0, 4)
        pPad.PaddingLeft = UDim.new(0, 2); pPad.PaddingRight = UDim.new(0, 4)
        pPad.Parent = pScroll
        addTextbox(pScroll, "Precision (0-1)", "", Settings.AutoTech.Loopv2.Precision, function(v) Settings.AutoTech.Loopv2.Precision = v end, true)
        addTextbox(pScroll, "First flick angle", "", Settings.AutoTech.Loopv2.FirstFlickAngle, function(v) Settings.AutoTech.Loopv2.FirstFlickAngle = v end, true)
        addTextbox(pScroll, "Second flick delay", "", Settings.AutoTech.Loopv2.SecondFlick, function(v) Settings.AutoTech.Loopv2.SecondFlick = v end, true)
        addToggle(pScroll, "Jump", "", Settings.AutoTech.Loopv2.Jump, function(v) Settings.AutoTech.Loopv2.Jump = v end)
        addToggle(pScroll, "Rotate Camera", "", Settings.AutoTech.Loopv2.RotateCam, function(v) Settings.AutoTech.Loopv2.RotateCam = v end)
        local pPos = { x = 0, y = -WIN_H/2 }
        local pTarget = { x = 0, y = -WIN_H/2 }
        local pDrag = false
        local pStart, pStartT
        pTitle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                pDrag = true
                pStart = input.Position
                pStartT = { x = pTarget.x, y = pTarget.y }
                tween(pScale, 0.25, { Scale = 1.015 })
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if pDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - pStart
                local vp = gui.AbsoluteSize
                pTarget.x = math.clamp(pStartT.x + delta.X, -vp.X/2, vp.X/2 - WIN_W)
                pTarget.y = math.clamp(pStartT.y + delta.Y, -vp.Y/2, vp.Y/2 - BAR_H)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if pDrag and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                pDrag = false
                tween(pScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
            end
        end)
        RunService.RenderStepped:Connect(function(dt)
            if not loopPopup or not loopPopup.Parent then return end
            local a = 1 - math.exp(-dt * 22)
            local dx, dy = pTarget.x - pPos.x, pTarget.y - pPos.y
            if math.abs(dx) > 0.05 or math.abs(dy) > 0.05 then
                pPos.x += dx * a
                pPos.y += dy * a
                loopPopup.Position = UDim2.new(0.5, pPos.x, 0.5, pPos.y)
            end
        end)
    end

