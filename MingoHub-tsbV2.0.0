    local dockLocked = true
    local dockDragging = false
    local dockDragStart = nil
    local dockStartPosition = nil
    local dockDragMoved = false
    local suppressDockButton = false

    local function beginDockDrag(input)
        if not dockDragging then suppressDockButton = false end
        if dockLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dockDragging = true
            dockDragMoved = false
            dockDragStart = input.Position
            dockStartPosition = dock.Position
        end
    end
    visibilityButton.InputBegan:Connect(beginDockDrag)
    lockButton.InputBegan:Connect(beginDockDrag)
    UIS.InputChanged:Connect(function(input)
        if dockDragging and not dockLocked and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dockDragStart
            if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
                dockDragMoved = true
                suppressDockButton = true
            end
            dock.Position = UDim2.new(
                dockStartPosition.X.Scale, dockStartPosition.X.Offset + delta.X,
                dockStartPosition.Y.Scale, dockStartPosition.Y.Offset + delta.Y
            )
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dockDragging = false
        end
    end)
    lockButton.Activated:Connect(function()
        if suppressDockButton then
            suppressDockButton = false
            return
        end
        dockLocked = not dockLocked
        lockButton.Text = dockLocked and "LOCKED" or "UNLOCKED"
        lockButton.BackgroundColor3 = dockLocked and Color3.fromRGB(35, 39, 52) or Palette.Button
        tween(lockButton, 0.18, { BackgroundTransparency = dockLocked and 0.02 or 0 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    end)
    visibilityButton.Activated:Connect(function()
        if suppressDockButton then
            suppressDockButton = false
            return
        end
        setOpen(not isOpen)
        visibilityButton.Text = isOpen and "HIDE UI" or "SHOW UI"
    end)

    task.spawn(function()
        while task.wait(1) do
            local backpack = player:FindFirstChild("Backpack")
            if backpack then
                counterTool = backpack:FindFirstChild("Prey's Peril") or backpack:FindFirstChild("Split Second Counter")
            end
        end
    end)

    local animConn
    local function onCharacterAdded(char)
        currentCharacter = char
        currentHumanoid = char:WaitForChild("Humanoid")
        currentRootPart = char:WaitForChild("HumanoidRootPart")
        currentCommunicate = char:WaitForChild("Communicate", 10)
        currentAnimator = currentHumanoid:WaitForChild("Animator", 10)
        blockActive = false
        isDashOnCooldown = false
        if solitudePullConn then
            solitudePullConn:Disconnect()
            solitudePullConn = nil
        end
        solitudeDashVelocity = nil
        for inst in pairs(dashStates) do dashStates[inst] = nil end
        if rootChildConn then rootChildConn:Disconnect() end
        rootChildConn = currentRootPart.ChildAdded:Connect(function(child)
            trackDashRange(child)
            trackSolitudeDash(child)
        end)
        applyPlayerVis(char)
        if Settings.Player.WalkSpeedEnabled then currentHumanoid.WalkSpeed = Settings.Player.WalkSpeed end
        if not currentAnimator then return end
        if animConn then animConn:Disconnect() end
        animConn = currentAnimator.AnimationPlayed:Connect(function(track)
            local id = track.Animation.AnimationId
            if solitudeActive() and (id:find(SOLITUDE_ANIM_A) or id:find(SOLITUDE_ANIM_B)) then
                task.spawn(function()
                    task.wait(0.05)
                    doSolitudeTPAndStick()
                end)
            end
            if id == "rbxassetid://" .. animId4 or id == "rbxassetid://" .. animId5 then
                local lastHit = currentCharacter:GetAttribute("LastM1Hitted")
                local targetChar = nil
                if lastHit then
                    local targetName = lastHit:match("^(.-);;")
                    if targetName then targetChar = liveFolder:FindFirstChild(targetName) end
                end
                if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then
                    local bestDist, bestChar = 50, nil
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= player and plr.Character then
                            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                            local hum = plr.Character:FindFirstChild("Humanoid")
                            if hrp and hum and hum.Health > 0 and currentRootPart then
                                local dist = (hrp.Position - currentRootPart.Position).Magnitude
                                if dist < bestDist then
                                    bestDist, bestChar = dist, plr.Character
                                end
                            end
                        end
                    end
                    if bestChar then targetChar = bestChar end
                end
                if not targetChar then return end
                local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
                local targetHum = targetChar:FindFirstChild("Humanoid")
                if not targetHrp or not targetHum then return end
                task.wait(math.max(0, 0.38 - pingScaledDelay(1000)))
                if Settings.AutoTech.Enabled and not isDashOnCooldown then
                    local handler = TECH_HANDLERS[Settings.AutoTech.Tech]
                    if handler then task.spawn(handler, targetChar, targetHrp, targetHum) end
                end
            end
        end)
    end

    local hookedModels = setmetatable({}, { __mode = "k" })
    local function hookModel(model)
        if not model or model == player.Character or hookedModels[model] then return end
        hookedModels[model] = model.DescendantAdded:Connect(function(desc)
            if Settings.Autoblock.Enabled then task.spawn(watchEnemyModel, desc) end
        end)

        local plr = Players:GetPlayerFromCharacter(model)
        if plr and plr ~= player then
            model:GetAttributeChangedSignal("Ulted"):Connect(function()
                if model:GetAttribute("Ulted") and Settings.Misc.Notifications.Enabled and Settings.Misc.Notifications.Ult then
                    local charAttr = model:GetAttribute("Character")
                    local ultName = ({ Bald="Saitama",Hunter="Garou",Monster="Red Garou",Cyborg="Genos",Ninja="Sonic",Batter="Metal Bat",Blade="Samurai",Esper="Tatsumaki",Purple="Siryu",Tech="Emperor" })[charAttr] or "Other"
                    local url = getThumbnail(plr)
                    mingoNotifyShim({Title = "MingoHub", Category = "Ult", Description = string.format("%s used %s Ult!", plr.DisplayName, ultName), Image = url})
                end
            end)
            model.ChildAdded:Connect(function(child)
                if child.Name == "Counter" and Settings.Misc.Notifications.Enabled and Settings.Misc.Notifications.Counter then
                    local url = getThumbnail(plr)
                    mingoNotifyShim({Title = "MingoHub", Category = "Counter", Description = string.format("%s used Death Counter!", plr.DisplayName), Image = url})
                end
            end)
        end

        model.AncestryChanged:Connect(function(_, parent)
            if not parent and hookedModels[model] then
                hookedModels[model]:Disconnect()
                hookedModels[model] = nil
            end
        end)
    end

    local function onPlayerAdded(plr)
        if plr == player then return end
        if plr.Character then hookModel(plr.Character) end
        hookModel(liveFolder:FindFirstChild(plr.Name))
        plr.CharacterAdded:Connect(function(char)
            hookModel(char)
            hookModel(liveFolder:FindFirstChild(plr.Name))
        end)
    end
    liveFolder.ChildAdded:Connect(function(child)
        if child.Name ~= player.Name and Players:FindFirstChild(child.Name) then hookModel(child) end
    end)
    Players.PlayerAdded:Connect(onPlayerAdded)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then onPlayerAdded(plr) end
    end

    if player.Character then task.spawn(onCharacterAdded, player.Character) end
    player.CharacterAdded:Connect(onCharacterAdded)

    local function playIntro()
        introActive = true
        local introGui, refs
        local ok, err = pcall(function()
            local introParent = getGuiParent()
            local existing = introParent:FindFirstChild("MingoHubIntro")
            if existing then existing:Destroy() end
            introGui = Instance.new("ScreenGui")
            introGui.Name = "MingoHubIntro"
            introGui.ResetOnSpawn = false
            introGui.IgnoreGuiInset = true
            introGui.DisplayOrder = 2147483647
            introGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            introGui.Parent = introParent
            ensureBlur().Size = 0
            local backdrop = Instance.new("CanvasGroup")
            backdrop.Size = UDim2.fromScale(1, 1)
            backdrop.BackgroundColor3 = Color3.fromRGB(4, 6, 16)
            backdrop.BackgroundTransparency = 0.3
            backdrop.BorderSizePixel = 0
            backdrop.GroupTransparency = 1
            backdrop.Parent = introGui
            local holder = Instance.new("Frame")
            holder.Size = UDim2.new(1, -40, 0, 220)
            holder.Position = UDim2.fromScale(0.5, 0.5)
            holder.AnchorPoint = Vector2.new(0.5, 0.5)
            holder.BackgroundTransparency = 1
            holder.Parent = backdrop
            local holderLimit = Instance.new("UISizeConstraint")
            holderLimit.MaxSize = Vector2.new(820, 220)
            holderLimit.MinSize = Vector2.new(240, 140)
            holderLimit.Parent = holder
            local holderScale = Instance.new("UIScale")
            holderScale.Scale = 0.72
            holderScale.Parent = holder
            local title = Instance.new("TextLabel")
            title.Size = UDim2.fromScale(1, 0.62)
            title.BackgroundTransparency = 1
            title.Text = "MingoHub"
            title.TextScaled = true
            title.Font = Enum.Font.GothamBlack
            title.TextColor3 = Color3.new(1, 1, 1)
            title.TextTransparency = 1
            title.Parent = holder
            local titleGradient = Instance.new("UIGradient")
            titleGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Palette.Accent),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(1, Palette.AccentLight),
            })
            titleGradient.Offset = Vector2.new(-1, 0)
            titleGradient.Parent = title
            local titleGlow = Instance.new("UIStroke")
            titleGlow.Color = Palette.Accent
            titleGlow.Thickness = 2
            titleGlow.Transparency = 1
            titleGlow.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
            titleGlow.Parent = title
            local subtitle = Instance.new("TextLabel")
            subtitle.Size = UDim2.new(1, 0, 0.28, 0)
            subtitle.Position = UDim2.new(0, 0, 0.67, 0)
            subtitle.BackgroundTransparency = 1
            subtitle.Text = "- By Mingo the mango"
            subtitle.TextScaled = true
            subtitle.Font = Enum.Font.GothamMedium
            subtitle.TextColor3 = Color3.fromRGB(205, 214, 255)
            subtitle.TextTransparency = 1
            subtitle.Parent = holder
            local line = Instance.new("Frame")
            line.Size = UDim2.fromOffset(0, 2)
            line.Position = UDim2.new(0.5, 0, 0.63, 0)
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.BackgroundColor3 = Palette.Accent
            line.BackgroundTransparency = 1
            line.BorderSizePixel = 0
            line.Parent = holder
            refs = { backdrop = backdrop, holderScale = holderScale, title = title, titleGlow = titleGlow, titleGradient = titleGradient, subtitle = subtitle, line = line }
        end)
        if not ok then
            warn("[MingoHub] Intro skipped: " .. tostring(err))
        elseif refs then
            pcall(function()
                tween(refs.backdrop, 0.5, { GroupTransparency = 0 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                tween(ensureBlur(), 1.0, { Size = 26 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                tween(refs.holderScale, 1.0, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                tween(refs.title, 0.45, { TextTransparency = 0 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                tween(refs.titleGlow, 1.2, { Transparency = 0.1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                tween(refs.titleGradient, 2.4, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                tween(refs.line, 0.7, { Size = UDim2.fromOffset(220, 2), BackgroundTransparency = 0.15 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                task.delay(0.35, function()
                    if refs.subtitle.Parent then
                        tween(refs.subtitle, 0.6, { TextTransparency = 0 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                    end
                end)
            end)
            task.wait(2.0)
            pcall(function()
                setOpen(true)
                tween(refs.backdrop, 0.55, { GroupTransparency = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
                tween(ensureBlur(), 0.8, { Size = Appearance.Blur and BLUR_SIZE or 0 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            end)
            task.wait(0.6)
        end
        introActive = false
        if introGui and introGui.Parent then introGui:Destroy() end
        local showOk = pcall(setOpen, true)
        if not showOk then
            pcall(function()
                root.Visible = true
                window.GroupTransparency = 0
                rootScale.Scale = 1
            end)
        end
        pcall(function() ensureBlur().Size = Appearance.Blur and BLUR_SIZE or 0 end)
    end

    return {
        autoLoadOnStart = autoLoadOnStart,
        applyBackground = applyBackground,
        applyTheme = applyTheme,
        selectTab = selectTab,
        playIntro = playIntro,
        setOpen = setOpen,
        forceShow = forceShow,
        isOpen = function() return isOpen end,
        dock = dock,
    }
end

local function reportBuildError(err)
    local msg = tostring(err)
    warn("[MingoHub] UI build failed: " .. msg)
    task.spawn(function()
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "MingoHub",
                Text = "UI error: " .. msg:sub(1, 120),
                Duration = 10,
            })
        end)
    end)
    local parent = player.PlayerGui or player:FindFirstChild("PlayerGui")
    if not parent and gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then parent = hui end
    end
    if not parent then return end
    local box = Instance.new("ScreenGui")
    box.Name = "VelaBuildError"
    box.ResetOnSpawn = false
    box.DisplayOrder = 2147483647
    box.Parent = parent
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(0.86, 0.6)
    label.Position = UDim2.fromScale(0.07, 0.2)
    label.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    label.BackgroundTransparency = 0.05
    label.TextColor3 = Color3.fromRGB(255, 130, 130)
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.TextSize = 18
    label.Font = Enum.Font.Code
    label.Text = "MingoHub build failed:\n" .. msg
    label.Parent = box
    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(255, 80, 80)
    s.Thickness = 2
    s.Parent = label
end

local buildOk, Hub = pcall(buildUI)
if not buildOk then
    reportBuildError(Hub)
    return
end
print("[MingoHub] UI built — applying startup state")
notifySystem(VERSION .. " — UI built", 2)

local function runStage(label, fn)
    local ok, err = pcall(fn)
    if not ok then warn("[MingoHub] " .. label .. " failed: " .. tostring(err)) end
end

runStage("auto-load", function() Hub.autoLoadOnStart() end)
runStage("background", function() Hub.applyBackground(Appearance.Background) end)
runStage("theme", function() Hub.applyTheme() end)
runStage("tabs", function() Hub.selectTab("Main", true) end)
runStage("dock", function() Hub.dock.Visible = isMobile end)
runStage("show", function()
    if not Hub.isOpen() then Hub.setOpen(true) end
    Hub.forceShow()
end)
runStage("intro", function()
    task.spawn(function() pcall(Hub.playIntro) end)
end)

task.delay(3.5, function() pcall(Hub.forceShow) end)
task.delay(9, function() pcall(Hub.forceShow) end)

notifySystem(isMobile and (VERSION .. " — tap SHOW UI") or (VERSION .. " — RightShift to toggle"), 5)
print("[MingoHub] Loaded OK — " .. VERSION)
