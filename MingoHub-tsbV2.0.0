-- ── isDowned predicate ────────────────────────────────────
local function mingoIsDowned(char, hum)
    if not (char and hum) then return false end
    if hum.Health <= 0 then return true end
    if char:FindFirstChild("Ragdoll") or char:GetAttribute("Ragdoll") then return true end
    if char:FindFirstChild("BeingLaunched") or char:FindFirstChild("KnockedDown") then return true end
    if char:FindFirstChild("WallCombo") then return true end
    if char:FindFirstChild("Freeze") or char:FindFirstChild("Stun") then return true end
    if char:GetAttribute("BreakJointed") then return true end
    if hum.PlatformStand
        or hum:GetState() == Enum.HumanoidStateType.Ragdoll
        or hum:GetState() == Enum.HumanoidStateType.FallingDown then return true end
    return false
end

-- ── Free autorotate ───────────────────────────────────────
local function mingoFreeRotate()
    local hum = currentHumanoid
    if not hum or mingoTechLocked then return end
    local char = currentCharacter
    hum.AutoRotate = not (char and (char:FindFirstChild("Ragdoll") or char:FindFirstChild("NoRotate")))
end

-- ── Friendship classifier ─────────────────────────────────
local function mingoIsFriend(plr, checkToggle)
    if not plr or not plr.Name then return false end
    if mingoPlayerFrames[plr.Name] == "Friend" then
        if checkToggle then
            return Settings.Misc.FriendCheck
        end
        return true
    end
    return false
end
local function mingoClassifyPlayer(plr)
    if not mingoPlayerFrames[plr.Name] then
        mingoPlayerFrames[plr.Name] = "Neutral"
    end
    task.spawn(function()
        local ok, isFriend = pcall(function()
            return plr:IsFriendsWithAsync(Players.LocalPlayer.UserId)
        end)
        if ok and isFriend then
            mingoPlayerFrames[plr.Name] = "Friend"
        end
    end)
end

-- ── Dash-spoof toggle (gate off by default) ───────────────
local function mingoSetDashSpoof(on)
    local target = on and true or mingoServerNoDash
    local effect = on and 1 or mingoServerEffect
    if workspace:GetAttribute("NoDashCooldown") == target
        and workspace:GetAttribute("EffectAffects") == effect then return end
    mingoSpoofingDash = true
    workspace:SetAttribute("NoDashCooldown", target)
    workspace:SetAttribute("EffectAffects", effect)
    mingoSpoofingDash = false
end
mingoConnect(workspace:GetAttributeChangedSignal("NoDashCooldown"), function()
    if not mingoSpoofingDash then
        mingoServerNoDash = workspace:GetAttribute("NoDashCooldown")
    end
end)
mingoConnect(workspace:GetAttributeChangedSignal("EffectAffects"), function()
    if not mingoSpoofingDash then
        mingoServerEffect = workspace:GetAttribute("EffectAffects")
    end
end)

-- ── Dash availability check ───────────────────────────────
local function mingoInfiniteDash()
    if currentCharacter and currentCharacter:FindFirstChild("DashReset3rd") then return true end
    if not mingoServerNoDash then return false end
    return mingoServerEffect == 1
        or workspace:GetAttribute("VIPServerOwner") == Players.LocalPlayer.Name
end

-- ── Camera helper ─────────────────────────────────────────
local function mingoSetCamCF(pos, yaw, pitch)
    workspace.CurrentCamera.CFrame =
        CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end

-- ── Rotate helpers (smooth-rotate, angle-lock) ──
local function mingoLockAngles(angle, targetPos, lockChar, rotateCam, precision)
    if not (currentRootPart and currentHumanoid) then return end
    precision = precision or 1
    local camCF  = workspace.CurrentCamera.CFrame
    local camPos = camCF.Position
    if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
        camPos = camPos - camCF.RightVector * 1.75
    end
    local pitch = math.asin(math.clamp(camCF.LookVector.Y, -1, 1))
    local curYaw, tgtYaw
    if targetPos then
        local vec = lockChar
            and (targetPos - currentRootPart.Position).Unit
            or  (targetPos - camPos).Unit
        curYaw = lockChar
            and math.atan2(-currentRootPart.CFrame.LookVector.X, -currentRootPart.CFrame.LookVector.Z)
            or  math.atan2(-camCF.LookVector.X, -camCF.LookVector.Z)
        tgtYaw = math.atan2(-vec.X, -vec.Z)
        if not lockChar and not rotateCam then
            local camVec = (targetPos - camPos).Unit
            local cp     = math.asin(math.clamp(camVec.Y, -1, 1))
            pitch = pitch + (cp - pitch) * precision
        end
    else
        local lv = lockChar and currentRootPart.CFrame.LookVector or camCF.LookVector
        curYaw = math.atan2(-lv.X, -lv.Z)
        tgtYaw = curYaw + math.rad(angle or 0)
    end
    local diff = math.atan2(math.sin(tgtYaw - curYaw), math.cos(tgtYaw - curYaw))
    local finalYaw = curYaw + diff * precision
    if lockChar then
        currentHumanoid.AutoRotate = false
        pcall(function()
            currentRootPart.CFrame = CFrame.new(currentRootPart.Position) * CFrame.Angles(0, finalYaw, 0)
        end)
        if not rotateCam then return end
    end
    mingoSetCamCF(camCF.Position, finalYaw, pitch)
end

-- ── Smooth rotate camera (angle-based) ───────────────────
local function mingoSmoothRotateCam(angle, duration, rotateChar)
    local startTick = tick()
    local startCF   = rotateChar and currentRootPart.CFrame or workspace.CurrentCamera.CFrame
    local startYaw  = math.atan2(-startCF.LookVector.X, -startCF.LookVector.Z)
    local targetYaw = startYaw + math.rad(angle)
    local name = "MingoSmoothRotate" .. tostring(tick()):gsub("%.", "")
    mingoBind(name, Enum.RenderPriority.Camera.Value + 1, function()
        local t     = math.clamp((tick() - startTick) / math.max(duration, 0.001), 0, 1)
        local alpha = t * t * (3 - 2 * t)
        local yaw   = startYaw + (targetYaw - startYaw) * alpha
        if rotateChar then
            if not (currentHumanoid and currentRootPart) then
                mingoUnbind(name); return
            end
            currentHumanoid.AutoRotate = false
            pcall(function()
                currentRootPart.CFrame = CFrame.new(currentRootPart.Position) * CFrame.Angles(0, yaw, 0)
            end)
        else
            local cf = workspace.CurrentCamera.CFrame
            mingoSetCamCF(cf.Position, yaw, math.asin(math.clamp(cf.LookVector.Y, -1, 1)))
        end
        if t >= 1 then mingoUnbind(name) end
    end)
end

-- ── Smooth rotate camera toward position ─────────────────
local function mingoSmoothRotateCamToPos(targetPos, duration)
    duration = math.max(duration or 0.08, 0.001)
    local startTick = tick()
    local startCF   = workspace.CurrentCamera.CFrame
    local startPos  = startCF.Position
    local tv        = (targetPos - startPos)
    if tv.Magnitude < 0.1 then return end
    local startYaw  = math.atan2(-startCF.LookVector.X, -startCF.LookVector.Z)
    local targetYaw = math.atan2(-tv.X, -tv.Z)
    local name = "MingoSmoothRotateCamPos" .. tostring(tick()):gsub("%.", "")
    mingoBind(name, Enum.RenderPriority.Camera.Value + 1, function()
        local t     = math.clamp((tick() - startTick) / duration, 0, 1)
        local alpha = t * t * (3 - 2 * t)
        local yaw   = startYaw + (targetYaw - startYaw) * alpha
        local cf    = workspace.CurrentCamera.CFrame
        mingoSetCamCF(cf.Position, yaw, math.asin(math.clamp(cf.LookVector.Y, -1, 1)))
        if t >= 1 then mingoUnbind(name) end
    end)
end

-- ── Health-watcher loop (ragdoll window) ──────────────────
local function mingoRagdollWatcher(method, duration, targetChar, targetHum, callback)
    local conn
    conn = RunService[method]:Connect(function()
        if not targetChar
            or targetChar:FindFirstChild("BeingLaunched")
            or not targetChar:FindFirstChild("Ragdoll")
            or not targetHum or targetHum.Health <= 0
            or not currentHumanoid or currentHumanoid.Health <= 0
            or not isAnimationPlaying(mingoAnimIDs.frontDash) then
            mingoTechLocked = false
            pcall(function() conn:Disconnect() end)
            return
        end
        callback()
    end)
    task.wait(duration)
    pcall(function() conn:Disconnect() end)
    mingoTechLocked = false
end

-- ── isTargetAbove helper ──────────────────────────────────
local function mingoTargetAbove(hrp)
    local my  = currentRootPart.Position
    local tgt = hrp.Position
    local hd  = (Vector3.new(my.X,0,my.Z) - Vector3.new(tgt.X,0,tgt.Z)).Magnitude
    return hd <= 0.2 and my.Y < tgt.Y
end

-- ── Dash helper ───────────────────────────────────────────
local mingoFrontDashAt = 0
local mingoDashCooldown = false
local function mingoFireFrontDash()
    if not mingoInfiniteDash() then
        if mingoDashCooldown or not currentCommunicate then return false end
    end
    if not currentCommunicate then return false end
    currentCommunicate:FireServer(leftclick.frontDash)
    mingoFrontDashAt = tick()
    if not mingoInfiniteDash() then
        mingoDashCooldown = true
        task.delay(5, function() mingoDashCooldown = false end)
    end
    return true
end
local function mingoDashWithDelay(extraDelay)
    mingoTechLocked = true
    mingoFireFrontDash()
    task.wait(pingScaledDelay(1000) + 0.05 + (extraDelay or 0))
end

-- ═══════════════════════════════════════════════════════════
--  AUTO LETHAL
-- ═══════════════════════════════════════════════════════════
local mingoLethalState = { busy = false, armedUntil = 0, highlight = nil }

mingoLethalState.getTarget = function(maxDist)
    local live = mingoWorld.Live
    local best, bestDist = nil, maxDist or 20
    if not (currentRootPart and live) then return nil end
    for _, m in ipairs(live:GetChildren()) do
        if m ~= currentCharacter and m:IsA("Model") then
            local plr = Players:GetPlayerFromCharacter(m)
            if not (plr and mingoIsFriend(plr, true)) then
                local hrp = m:FindFirstChild("HumanoidRootPart")
                local hum = m:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local d = (hrp.Position - currentRootPart.Position).Magnitude
                    if d < bestDist then bestDist = d; best = m end
                end
            end
        end
    end
    return best
end

mingoLethalState.setHighlight = function(target)
    if mingoLethalState.highlight then
        pcall(function() mingoLethalState.highlight:Destroy() end)
        mingoLethalState.highlight = nil
    end
    local c = Settings.AutoLethal
    if not (target and c.Highlight) then return end
    local hl = Instance.new("Highlight")
    hl.Name = "MingoLethalTarget"
    hl.FillColor    = c.HighlightColor
    hl.OutlineColor = c.HighlightColor
    hl.FillTransparency    = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = target
    hl.Parent  = target
    mingoLethalState.highlight = hl
end

local function mingoLethalJump()
    local root = currentRootPart
    if not root then return end
    root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 50, root.AssemblyLinearVelocity.Z)
    local n = 0
    local c
    c = RunService.Heartbeat:Connect(function()
        n += 1
        if n > 3 or not root.Parent then c:Disconnect(); return end
        if root.AssemblyLinearVelocity.Y < 35 then
            root.AssemblyLinearVelocity = Vector3.new(
                root.AssemblyLinearVelocity.X, 50, root.AssemblyLinearVelocity.Z)
        end
    end)
end

mingoLethalState.run = function(target, miss, graveTrack)
    local al  = Settings.AutoLethal
    local hrp = target:FindFirstChild("HumanoidRootPart")
    local hum = target:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return end
    mingoLethalState.setHighlight(target)
    local t0 = tick()
    if graveTrack then
        local adj = math.min(al.GraveTiming, 0)
        repeat RunService.Heartbeat:Wait()
        until not graveTrack.IsPlaying
            or (graveTrack.Length > 0 and graveTrack.TimePosition >= graveTrack.Length + adj)
            or tick() - t0 >= 3
        if al.GraveTiming > 0 then task.wait(al.GraveTiming) end
    else
        repeat RunService.Heartbeat:Wait()
        until not (currentCharacter and currentCharacter:FindFirstChildOfClass("ForceField"))
            or tick() - t0 >= 2.5
        task.wait(0.1)
    end
    if not currentHumanoid or currentHumanoid.Health <= 0 or hum.Health <= 0 then return end
    if al.Jump then mingoLethalJump() end
    mingoTechLocked = true
    mingoLockAngles(al.FirstFlickAngle, nil, true, al.RotateCam)
    mingoFireFrontDash()
    task.wait(pingScaledDelay(1000) + 0.05 + al.SecondFlick)
    local t1 = tick()
    local conn2
    conn2 = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - t1
        if elapsed > 0.4 or not hrp.Parent or hum.Health <= 0
            or not currentHumanoid or currentHumanoid.Health <= 0 then
            pcall(function() conn2:Disconnect() end); return
        end
        if not miss then
            mingoLockAngles(nil, hrp.Position, true, al.RotateCam, al.Precision)
        end
    end)
    task.wait(0.4)
    pcall(function() conn2:Disconnect() end)
end

mingoLethalState.onAnim = function(track)
    if mingoUnloaded then return end
    local al = Settings.AutoLethal
    local id = track.Animation and track.Animation.AnimationId:match("%d+")
    local isGrave = id == al.GraveAnim
    if not (id == al.HitAnim or (isGrave and al.Grave)) then return end
    if not (al.Enabled or tick() < mingoLethalState.armedUntil) then return end
    if mingoLethalState.busy then return end
    mingoLethalState.armedUntil = 0
    local tgt = mingoLethalState.getTarget(20)
    if tgt then
        task.spawn(function()
            local miss = al.MissChance > 0 and math.random(1,100) <= al.MissChance
            mingoLethalState.busy = true
            pcall(mingoLethalState.run, tgt, miss, isGrave and track or nil)
            mingoTechLocked = false
            mingoFreeRotate()
            mingoLethalState.setHighlight(nil)
            task.wait(0.3)
            mingoLethalState.busy = false
        end)
    end
end

-- ═══════════════════════════════════════════════════════════
--  LOCK-ON
-- ═══════════════════════════════════════════════════════════
local mingoLockOn = {}

mingoLockOn.targetPart = function(char)
    if not char then return nil end
    local part = Settings.Misc.LockOnTargetPart
    if part == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    elseif part == "Torso" then
        return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild("HumanoidRootPart")
end

mingoLockOn.valid = function(char)
    if not (char and char.Parent and char ~= currentCharacter) then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0) then return nil end
    local plr = Players:GetPlayerFromCharacter(char)
    if plr then
        if plr == Players.LocalPlayer then return nil end
        if Settings.Misc.FriendCheck and mingoIsFriend(plr, false) then return nil end
    elseif not Settings.Misc.LockOnDummies then
        return nil
    end
    return hrp, hum
end

mingoLockOn.pick = function(skip)
    if not currentRootPart then return nil end
    local cam = workspace.CurrentCamera
    local touch = UIS.TouchEnabled and not UIS.KeyboardEnabled
    local mousePos = touch and (cam.ViewportSize / 2) or UIS:GetMouseLocation()
    local myPos = currentRootPart.Position
    local best, bestHum, bestScore

    local function check(char)
        if char == skip then return end
        local hrp, hum = mingoLockOn.valid(char)
        if not hrp then return end
        local tp = mingoLockOn.targetPart(char) or hrp
        local d  = (tp.Position - myPos).Magnitude
        if d > Settings.Misc.LockOnMaxDist then return end
        local score = d
        if Settings.Misc.LockOnMode == "Mouse" then
            local vp, vis = cam:WorldToViewportPoint(tp.Position)
            if not vis then return end
            score = (Vector2.new(vp.X, vp.Y) - mousePos).Magnitude
            if score > Settings.Misc.LockOnFOV then return end
        end
        if not best or score < bestScore then
            best = hrp; bestHum = hum; bestScore = score
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then check(plr.Character) end
    end
    if Settings.Misc.LockOnDummies and mingoWorld.Live then
        for _, m in ipairs(mingoWorld.Live:GetChildren()) do
            if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then
                check(m)
            end
        end
    end
    return best, bestHum
end

local mingoLockOnConn
local mingoLockOnMark = nil

local function mingoSetMark(target, color)
    if mingoLockOnMark then
        pcall(function() mingoLockOnMark:Destroy() end)
        mingoLockOnMark = nil
    end
    if not target then return end
    local hl = Instance.new("Highlight")
    hl.Name = "MingoMark"
    hl.FillColor    = color or Color3.fromRGB(255, 60, 60)
    hl.OutlineColor = color or Color3.fromRGB(255, 60, 60)
    hl.FillTransparency    = 0.6
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = target
    hl.Parent  = target
    mingoLockOnMark = hl
end

mingoLockOn.stop = function()
    mingoDisconnect(mingoLockOnConn)
    mingoLockOnConn = nil
    mingoLockOn.hrp, mingoLockOn.human = nil, nil
    mingoSetMark(nil)
    mingoFreeRotate()
end

mingoLockOn.start = function()
    local hrp, hum = mingoLockOn.pick()
    if not hrp then
        mingoNotifyShim({ Title = "MingoHub", Description = "LockOn: no target found" })
        return
    end
    mingoLockOn.hrp   = hrp
    mingoLockOn.human = hum
    mingoLockOnConn = mingoConnect(RunService.Heartbeat, function(dt)
        local h, hu = mingoLockOn.hrp, mingoLockOn.human
        if not (h and h.Parent and hu and hu.Health > 0 and currentRootPart) then
            if Settings.Misc.LockOnSwitch and currentRootPart then
                local nh, nhu = mingoLockOn.pick(h and h.Parent)
                if nh then mingoLockOn.hrp = nh; mingoLockOn.human = nhu; return end
            end
            mingoLockOn.stop(); return
        end
        if (h.Position - currentRootPart.Position).Magnitude > Settings.Misc.LockOnMaxDist * 1.5 then
            mingoLockOn.stop(); return
        end
        if Settings.Misc.LockOnHighlight then
            mingoSetMark(h.Parent, Color3.fromRGB(255,60,60))
        else
            mingoSetMark(nil)
        end
        local diff = h.Position - currentRootPart.Position
        if Vector3.new(diff.X,0,diff.Z).Magnitude < 1.5 then return end
        local prec = Settings.Misc.LockOnPrecision
        if prec < 1 then prec = 1 - (1-prec)^(math.min(dt,0.1)*60) end
        local tp = mingoLockOn.targetPart(h.Parent) or h
        local aimPos = tp.Position
        if Settings.Misc.LockOnPredict > 0 then
            local vel = h.AssemblyLinearVelocity
            local lead = Settings.Misc.LockOnPredict/100 + pingScaledDelay(1000)*0.5
            aimPos = aimPos + Vector3.new(vel.X, vel.Y*0.4, vel.Z)*lead
        end
        local fc = Settings.Misc.LockOnFaceChar
        local cc = Settings.Misc.LockOnCam
        if mingoIsDowned(h.Parent, hu) then
            if cc then mingoLockAngles(0, aimPos, false, false, prec) end
            return
        end
        if fc and cc then
            mingoLockAngles(nil, aimPos, false, true, prec)
        elseif fc then
            mingoLockAngles(nil, aimPos, true,  false, prec)
        elseif cc then
            mingoLockAngles(0,   aimPos, false, false, prec)
        end
    end)
end

-- ═══════════════════════════════════════════════════════════
--  MAGNET
-- ═══════════════════════════════════════════════════════════
local function mingoMagnetGetTarget()
    local root = currentRootPart
    if not root then return nil end
    local cfg = Settings.Misc.Magnet
    local best, bestDist = nil, cfg.MaxDistance or 100
    local myPos = root.Position

    if mingoWorld.Live then
        for _, m in ipairs(mingoWorld.Live:GetChildren()) do
            if m ~= currentCharacter and m:IsA("Model") then
                local plr = Players:GetPlayerFromCharacter(m)
                if not (plr and mingoIsFriend(plr, true)) then
                    local h = m:FindFirstChild("HumanoidRootPart")
                    local hum = m:FindFirstChildOfClass("Humanoid")
                    if h and hum and hum.Health > 0 then
                        local d = (myPos - h.Position).Magnitude
                        if d < bestDist and d > 0.1 then bestDist = d; best = h end
                    end
                end
            end
        end
    end
    if not best then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Players.LocalPlayer and plr.Character then
                if not mingoIsFriend(plr, true) then
                    local h = plr.Character:FindFirstChild("HumanoidRootPart")
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if h and hum and hum.Health > 0 then
                        local d = (myPos - h.Position).Magnitude
                        if d < bestDist and d > 0.1 then bestDist = d; best = h end
                    end
                end
            end
        end
    end
    return best
end

local function mingoMagnetStop()
    if mingoMagnetState.conn then
        pcall(function() mingoMagnetState.conn:Disconnect() end)
        mingoMagnetState.conn = nil
    end
end

local function mingoMagnetStep()
    local cfg = Settings.Misc.Magnet
    if not cfg.Enabled or mingoUnloaded then mingoMagnetStop(); return end
    if not (currentRootPart and currentHumanoid and currentHumanoid.Health > 0) then
        mingoMagnetStop(); return
    end
    local elapsed = tick() - mingoMagnetState.startTime
    if elapsed >= mingoMagnetState.duration then mingoMagnetStop(); return end
    local tgt = (mingoMagnetState.targetOverride and mingoMagnetState.targetOverride.Parent
        and mingoMagnetState.targetOverride) or mingoMagnetGetTarget()
    if not tgt then return end
    local myPos = currentRootPart.Position
    local hPos  = Vector3.new(tgt.Position.X, myPos.Y, tgt.Position.Z)
    local dir   = hPos - myPos
    if dir.Magnitude > 1 then
        local desired = dir.Unit * mingoMagnetState.strength
        local cur     = currentRootPart.AssemblyLinearVelocity
        local lerped  = cur:Lerp(desired, mingoMagnetState.smoothness)
        pcall(function()
            currentRootPart.AssemblyLinearVelocity = Vector3.new(lerped.X*0.85, cur.Y, lerped.Z*0.85)
        end)
    end
end

local function mingoMagnetStartPull(overrideTarget)
    mingoMagnetStop()
    local cfg = Settings.Misc.Magnet
    mingoMagnetState.startTime      = tick()
    mingoMagnetState.duration       = cfg.Duration  or 0.5
    mingoMagnetState.strength       = cfg.Strength  or 50
    mingoMagnetState.smoothness     = cfg.Smoothness or 0.65
    mingoMagnetState.targetOverride = overrideTarget
    mingoMagnetStep()
    mingoMagnetState.conn = RunService.Heartbeat:Connect(mingoMagnetStep)
end

local function mingoMagnetExecute(overrideTarget)
    if not Settings.Misc.Magnet.Enabled then return end
    if not (currentCharacter and currentHumanoid and currentRootPart
        and currentHumanoid.Health > 0 and currentCharacter.Parent) then return end
    local cfg = Settings.Misc.Magnet
    if cfg.DashCancel then
        for _, c in ipairs(currentCharacter:GetChildren()) do
            if c:IsA("BodyVelocity") or c:IsA("LinearVelocity") then c:Destroy() end
        end
        for _, c in ipairs(currentRootPart:GetChildren()) do
            if c:IsA("BodyVelocity") or c:IsA("LinearVelocity") then c:Destroy() end
        end
        local v = currentRootPart.AssemblyLinearVelocity
        currentRootPart.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
    end
    local tgt = (overrideTarget and overrideTarget.Parent and overrideTarget)
        or mingoMagnetGetTarget()
    if tgt then
        local h = cfg.Height or 2
        local wp = tgt.Position + Vector3.new(0, h, 0)
        pcall(function() currentRootPart.CFrame = CFrame.new(wp.X, wp.Y, wp.Z) end)
        mingoMagnetStartPull(tgt)
    end
end

-- magnet tech trigger (called by autotech dispatcher)
local function mingoMagnetTechTrigger(techName, overrideHrp)
    if not Settings.Misc.Magnet.Enabled then return end
    local t = Settings.Misc.Magnet.TechTrigger
    if not t or t == "Disabled" or t == "None" then return end
    local fire = false
    if t == "All 3" or t == "All" then
        fire = (techName == "Loop Dash v2" or techName == "Custom Dash" or techName == "Custom Dash v2")
    else
        fire = (techName == t)
    end
    if fire then
        task.spawn(function()
            local delay = Settings.Misc.Magnet.TechDelay or 0
            if delay > 0 then task.wait(delay / 1000) end
            mingoMagnetExecute(overrideHrp)
        end)
    end
end

-- ═══════════════════════════════════════════════════════════
--  SELF CHAMS
-- ═══════════════════════════════════════════════════════════
local mingoChamsState = { highlight = nil, headMask = nil, mats = {} }

local function mingoRestoreChams()
    for part, orig in pairs(mingoChamsState.mats) do
        if part and part.Parent then
            pcall(function()
                part.Material = orig[1]; part.Color = orig[2]
                part.CustomPhysicalProperties = orig[3]
            end)
        end
    end
    table.clear(mingoChamsState.mats)
end

local function mingoApplySelfChams()
    local char = currentCharacter or Players.LocalPlayer.Character
    local cfg  = Settings.MingoVisuals.SelfChams
    if not (cfg.Enabled and char and char.Parent) then
        if mingoChamsState.highlight then
            pcall(function() mingoChamsState.highlight:Destroy() end)
            mingoChamsState.highlight = nil
        end
        if mingoChamsState.headMask then
            pcall(function() mingoChamsState.headMask:Destroy() end)
            mingoChamsState.headMask = nil
        end
        mingoRestoreChams()
        return
    end
    local color = cfg.Color
    -- highlight adornee
    if not (mingoChamsState.highlight and mingoChamsState.highlight.Parent == char) then
        if mingoChamsState.highlight then pcall(function() mingoChamsState.highlight:Destroy() end) end
        local hl = char:FindFirstChild("MingoSelfChams")
        if hl and hl:IsA("Highlight") then
            mingoChamsState.highlight = hl
        else
            hl = Instance.new("Highlight")
            hl.Name = "MingoSelfChams"
            hl.Adornee = char; hl.Parent = char
            mingoChamsState.highlight = hl
        end
    end
    local hl = mingoChamsState.highlight
    hl.FillColor           = color
    hl.OutlineColor        = color
    hl.FillTransparency    = cfg.FillTransparency
    hl.OutlineTransparency = cfg.OutlineTransparency
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    -- headless mask
    local head = currentHumanoid and char:FindFirstChild("Head")
    if Settings.MingoVisuals.NoSmoke and head then  -- repurpose flag: headless handled elsewhere
        -- skip head mask here, MingoHub handles headless
    end
    -- material swap
    local matName = cfg.Material
    if matName and matName ~= "None" then
        local mat = Enum.Material[matName] or Enum.Material.ForceField
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart"
                and not part:FindFirstAncestorWhichIsA("Tool") then
                if not mingoChamsState.mats[part] then
                    mingoChamsState.mats[part] = {
                        part.Material, part.Color, part.CustomPhysicalProperties
                    }
                    part.CustomPhysicalProperties = part.CurrentPhysicalProperties
                end
                if part.Material ~= mat then part.Material = mat end
                part.Color = color
            end
        end
    else
        mingoRestoreChams()
    end
end

-- ═══════════════════════════════════════════════════════════
--  CUSTOM ULTBAR
-- ═══════════════════════════════════════════════════════════
local function mingoSetupUltbar()
    local gui = Players.LocalPlayer.PlayerGui
    local bar = gui:FindFirstChild("Bar") or (gui.WaitForChild and gui:WaitForChild("Bar", 0.1))
    if not bar then return end
    local mh = bar:FindFirstChild("MagicHealth") or bar:WaitForChild("MagicHealth", 0.1)
    if not mh then return end
    local hBar = mh:WaitForChild("Health",0.05)
    local fill = hBar and hBar:WaitForChild("Bar",0.05) and hBar:WaitForChild("Bar",0.05):WaitForChild("Bar",0.05)
    local lbl  = mh:WaitForChild("TextLabel",0.05)
    local cdh  = mh:WaitForChild("cdholder",0.05)
    local hotbar = gui:FindFirstChild("Hotbar")
    local bp  = hotbar and hotbar:FindFirstChild("Backpack")
    local hbg = bp and bp:FindFirstChild("Hotbar")

    local uc  = Settings.MingoVisuals.CustomUltbar
    if cdh then
        for _, k in ipairs({"forward","side","evasive","burst"}) do
            local slot = cdh:FindFirstChild(k)
            if slot then
                local tmpl = slot:FindFirstChild("template",true)
                local f2   = tmpl and tmpl:FindFirstChild("Fill")
                if f2 and uc.UltbarColor.Enabled then
                    mingoSetShadow(f2, "BackgroundColor3", uc.UltbarColor.Color)
                end
            end
        end
        local cconn = mingoConnect(cdh.ChildAdded, function(child)
            if child.Name == "forward" or child.Name == "side"
                or child.Name == "evasive" or child.Name == "burst" then
                local tmpl = child:WaitForChild("template",0.1)
                local f2   = tmpl and tmpl:FindFirstChild("Fill")
                if f2 and uc.UltbarColor.Enabled then
                    mingoSetShadow(f2, "BackgroundColor3", uc.UltbarColor.Color)
                end
            end
        end)
        table.insert(mingoDashRJ, cconn)
    end
    if hbg then
        for i = 1, 4 do
            local slot = hbg:FindFirstChild(tostring(i))
            local base = slot and slot:FindFirstChild("Base")
            if base then
                local conn = mingoConnect(base.ChildAdded, function(child)
                    if child.Name == "Cooldown" and uc.UltbarColor.Enabled then
                        mingoSetShadow(child, "BackgroundColor3", uc.UltbarColor.Color)
                    end
                end)
                table.insert(mingoDashRJ, conn)
            end
        end
    end
    if lbl and uc.UltbarText.Enabled then
        mingoSetShadow(lbl, "Text", uc.UltbarText.Text)
    end
    if fill and uc.UltbarColor.Enabled then
        mingoSetShadow(fill, "ImageColor3", uc.UltbarColor.Color)
    end
end

local function mingoPendUltbar()
    if mingoUltbarPending then return end
    mingoUltbarPending = true
    task.delay(0.1, function()
        mingoUltbarPending = false
        if not mingoUnloaded then pcall(mingoSetupUltbar) end
    end)
end

-- ═══════════════════════════════════════════════════════════
--  EFFECTS-COLOR / NO-SMOKE / NO-CAPES / NO-AURAS / NO-LIGHTS
-- ═══════════════════════════════════════════════════════════
local function mingoOnDescendantAdded(inst)
    local mv = Settings.MingoVisuals
    if not (mv.NoNewLight or mv.NoSmoke or mv.NoGarouC
        or mv.NoAuras or mv.NoCapes or mv.NoRings
        or mv.EffectsColor.Enabled) then return end
    local name = inst.Name
    if (inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight"))
        and mv.NoNewLight then
        mingoSetShadow(inst, "Enabled", false)
    elseif (mingoSmokeSet[name] and mv.NoSmoke)
        or (name == "Clone_Rig" and mv.NoGarouC)
        or ((mingoAuraSet[name] or name == "CosmeticAuras") and mv.NoAuras)
        or (mingoCapeSet[name] and mv.NoCapes)
        or (name == "Ring" and mv.NoRings) then
        task.defer(inst.Destroy, inst)
    elseif mv.EffectsColor.Enabled
        and (inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")) then
        mingoSetShadow(inst, "Color", ColorSequence.new(mv.EffectsColor.Color))
        mingoEffectObjects[inst] = true
    end
end

local function mingoRefreshEffectsColor()
    if not Settings.MingoVisuals.EffectsColor.Enabled then return end
    local cs = ColorSequence.new(Settings.MingoVisuals.EffectsColor.Color)
    for obj in pairs(mingoEffectObjects) do
        if obj.Parent then mingoSetShadow(obj, "Color", cs)
        else mingoEffectObjects[obj] = nil end
    end
end

-- ═══════════════════════════════════════════════════════════
--  FOV CIRCLE (zombie sniper)
-- ═══════════════════════════════════════════════════════════
local mingoFovGui, mingoFovCircle, mingoFovConn

local function mingoUpdateFovCircle()
    local cfg = Settings.Zombie
    if not (cfg.FovCircle and cfg.SniperSilentAim and cfg.SilentAimMode ~= "Distance") then
        if mingoFovConn then mingoDisconnect(mingoFovConn); mingoFovConn = nil end
        if mingoFovCircle then mingoFovCircle.Visible = false end
        return
    end
    if mingoFovConn then return end
    if not mingoFovCircle then
        mingoFovGui = Instance.new("ScreenGui")
        mingoFovGui.Name = "MingoFovCircle"
        mingoFovGui.IgnoreGuiInset = true
        mingoFovGui.ResetOnSpawn = false
        mingoFovGui.DisplayOrder = 9998
        pcall(function()
            mingoFovGui.Parent = gethui and gethui() or game:GetService("CoreGui")
        end)
        if not mingoFovGui.Parent then
            mingoFovGui.Parent = Players.LocalPlayer.PlayerGui
        end
        local frame = Instance.new("Frame")
        frame.AnchorPoint = Vector2.new(0.5, 0.5)
        frame.BackgroundTransparency = 1
        frame.Visible = false
        frame.Parent = mingoFovGui
        Instance.new("UICorner", frame).CornerRadius = UDim.new(1, 0)
        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1.5
        stroke.Color = Color3.fromRGB(132, 145, 255)
        stroke.Parent = frame
        mingoFovCircle = frame
    end
    local touch = UIS.TouchEnabled and not UIS.KeyboardEnabled
    mingoFovConn = mingoConnect(RunService.RenderStepped, function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local mp   = touch and (cam.ViewportSize / 2) or UIS:GetMouseLocation()
        local diam = (Settings.Zombie.SilentAimFOV or 500) * 2
        mingoFovCircle.Position = UDim2.fromOffset(mp.X, mp.Y)
        mingoFovCircle.Size     = UDim2.fromOffset(diam, diam)
        -- show only when zombie char is active
        local char = currentCharacter
        mingoFovCircle.Visible = char ~= nil
            and (char:GetAttribute("Character") == "Zombie"
                 or char:FindFirstChild("Sniper") ~= nil)
    end)
end

-- ═══════════════════════════════════════════════════════════
--  ZOMBIE / SNIPER SCOPE
-- ═══════════════════════════════════════════════════════════
local mingoScope = {
    active = false, eye = nil,
    bind   = "MingoSniperScope",
    conns  = {}, body = {}, vm = {},
    spin   = 0, spinning = false,
    sens   = 1, icon = nil,
    gui    = nil, holding = false,
    ray    = nil,
}

local function mingoIsSniperView(char)
    char = char or currentCharacter
    if not char then return false end
    if char:GetAttribute("InterventionAiming")  then return true end
    if char:GetAttribute("InterventionChamber") then return true end
    if char:GetAttribute("OldInterventionAiming")  then return true end
    if char:GetAttribute("OldInterventionChamber") then return true end
    local gui = Players.LocalPlayer.PlayerGui
    if gui and gui:FindFirstChild("InterventionScope") then return true end
    local cv = char:FindFirstChild("CurrentWeapon")
    if cv then
        local v = tostring(cv.Value):lower()
        if v:find("sniper") then return true end
        if v ~= "" and v ~= "nil" then return false end
    end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local n = tool.Name:lower()
        if n:find("sniper") or n:find("intervention") then return true end
        return false
    end
    local cam = workspace.CurrentCamera
    if cam and (cam:FindFirstChild("SniperViewmodel") or cam:FindFirstChild("Sniper")) then
        return true
    end
    return false
end

local function mingoScopeStep()
    local cam = workspace.CurrentCamera
    if not (currentCharacter and cam) then return end
    for _, p in ipairs(mingoScope.body) do
        if p.LocalTransparencyModifier ~= 0 then p.LocalTransparencyModifier = 0 end
    end
    for _, p in ipairs(mingoScope.vm) do
        if p.LocalTransparencyModifier ~= 1 then p.LocalTransparencyModifier = 1 end
    end
    local fov = Settings.MingoVisuals.FOV or 70
    if cam.FieldOfView ~= fov then cam.FieldOfView = fov end
    if UIS.MouseDeltaSensitivity ~= mingoScope.sens then
        UIS.MouseDeltaSensitivity = mingoScope.sens
    end
    if cam:GetAttribute("AimSensitivity") then cam:SetAttribute("AimSensitivity", nil) end
    if cam:GetAttribute("AimAssist")      then cam:SetAttribute("AimAssist", nil)      end
    if not UIS.MouseIconEnabled then UIS.MouseIconEnabled = true end
    mingoScope.eye = cam.CFrame
    local dist = Settings.Zombie.ThirdPersonDist or 12
    local gap  = dist - (cam.CFrame.Position - cam.Focus.Position).Magnitude
    if gap <= 0 then return end
    local offset = cam.CFrame:VectorToWorldSpace(
        Vector3.new(2*gap/dist, 0.5*gap/dist, gap)
    )
    local hit = workspace:Raycast(cam.CFrame.Position, offset, mingoScope.ray)
    if hit then offset = offset.Unit * math.max(hit.Distance - 0.5, 0) end
    cam.CFrame = cam.CFrame + offset
end

local function mingoScopeStart(char)
    mingoScope.active = true
    mingoScope.sens   = UIS.MouseDeltaSensitivity
    mingoScope.icon   = UIS.MouseIconEnabled
    mingoScope.body, mingoScope.vm = {}, {}
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") then
            if not d:FindFirstAncestorOfClass("Tool") then
                table.insert(mingoScope.body, d)
            end
        end
    end
    local cam = workspace.CurrentCamera
    mingoScope.ray = RaycastParams.new()
    mingoScope.ray.FilterType = Enum.RaycastFilterType.Exclude
    mingoScope.ray.FilterDescendantsInstances = { char, cam, mingoWorld.Live }
    for _, c in ipairs(cam:GetChildren()) do
        if c:IsA("Model") and c:FindFirstChildOfClass("Humanoid") then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then table.insert(mingoScope.vm, p) end
            end
        elseif c:IsA("BlurEffect") or c:IsA("DepthOfFieldEffect") then
            c.Enabled = false
        end
    end
    local gui = Players.LocalPlayer.PlayerGui
    local scope = gui and gui:FindFirstChild("InterventionScope")
    if scope then scope.Enabled = false end
    mingoScope.conns = {
        mingoConnect(cam.ChildAdded, function(c)
            if c:IsA("BlurEffect") or c:IsA("DepthOfFieldEffect") then c.Enabled = false end
        end),
        mingoConnect(char.DescendantAdded, function(d)
            if (d:IsA("BasePart") or d:IsA("Decal"))
                and not d:FindFirstAncestorOfClass("Tool") then
                table.insert(mingoScope.body, d)
            end
        end),
        mingoConnect(gui and gui.ChildAdded or Players.LocalPlayer.PlayerGui.ChildAdded, function(c)
            if c.Name == "InterventionScope" then c.Enabled = false end
        end),
    }
    mingoBind(mingoScope.bind, Enum.RenderPriority.Camera.Value + 3, mingoScopeStep)
end

local function mingoScopeStop()
    if not mingoScope.active then return end
    mingoScope.active = false
    mingoScope.eye    = nil
    mingoUnbind(mingoScope.bind)
    for _, c in ipairs(mingoScope.conns) do pcall(function() c:Disconnect() end) end
    mingoScope.conns = {}
    mingoScope.body, mingoScope.vm = {}, {}
    local gui   = Players.LocalPlayer.PlayerGui
    local scope = gui and gui:FindFirstChild("InterventionScope")
    if scope then scope.Enabled = true end
    UIS.MouseDeltaSensitivity = mingoScope.sens
    if mingoScope.icon ~= nil then UIS.MouseIconEnabled = mingoScope.icon end
end

local function mingoScopeSync()
    local char   = currentCharacter
    local active = Settings.Zombie.SniperThirdPerson and char and mingoIsSniperView(char)
    if active and not mingoScope.active then
        task.defer(function()
            if Settings.Zombie.SniperThirdPerson
                and currentCharacter == char
                and mingoIsSniperView(char)
                and not mingoScope.active then
                mingoScopeStart(char)
            end
        end)
    elseif not active and mingoScope.active then
        mingoScopeStop()
    end
end

local function mingoScopeHookChar(char)
    for _, attr in ipairs({"InterventionAiming","InterventionChamber",
        "OldInterventionAiming","OldInterventionChamber"}) do
        mingoConnect(char:GetAttributeChangedSignal(attr), mingoScopeSync)
    end
end

-- spinbot
local mingoSpinConn
local function mingoSetScopeSpinbot(on)
    if mingoSpinConn then mingoDisconnect(mingoSpinConn); mingoSpinConn = nil end
    if mingoScope.spinning then mingoScope.spinning = false; mingoFreeRotate() end
    if not on then return end
    mingoSpinConn = mingoConnect(RunService.RenderStepped, function(dt)
        local root = currentRootPart
        local hum  = currentHumanoid
        if mingoScope.holding and root and hum and hum.Health > 0
            and not mingoIsDowned(currentCharacter, hum) then
            mingoScope.spinning = true
            hum.AutoRotate = false
            mingoScope.spin = (mingoScope.spin
                + math.rad(Settings.Zombie.SpinSpeed or 35)
                * math.min(dt, 0.1) * 60) % (math.pi * 2)
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, mingoScope.spin, 0)
        elseif mingoScope.spinning then
            mingoScope.spinning = false
            mingoFreeRotate()
        end
    end)
end

-- silent aim ray builder
local function mingoGetAimRay()
    local cam   = workspace.CurrentCamera
    if not cam then return nil end
    local char  = currentCharacter
    local root  = currentRootPart
    local origin = root and root.Position or cam.CFrame.Position
    local touch  = UIS.TouchEnabled and not UIS.KeyboardEnabled
    local mouseP = touch and (cam.ViewportSize / 2) or UIS:GetMouseLocation()
    local cfg    = Settings.Zombie
    local maxD   = cfg.SilentAimMaxDist or 1500
    local fov    = cfg.SilentAimFOV    or 500
    local mode   = cfg.SilentAimMode   or "Mouse"
    local best, bestPart, bestHrp, bestScore

    local function check(c)
        if not c or not c.Parent or c == char then return end
        local hum = c:FindFirstChildOfClass("Humanoid")
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not (hum and hrp and hum.Health > 0) then return end
        local plr = Players:GetPlayerFromCharacter(c)
        if plr then
            if plr == Players.LocalPlayer then return end
            if cfg.FriendCheck and mingoIsFriend(plr, false) then return end
        end
        if (hrp.Position - origin).Magnitude > maxD then return end
        local torso = c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")
        local tp = (cfg.TargetPart == "Head" and c:FindFirstChild("Head")) or torso or hrp
        if not tp then return end
        if cfg.WallCheck then
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            rp.FilterDescendantsInstances = { char, c }
            local hit = workspace:Raycast(cam.CFrame.Position, tp.Position - cam.CFrame.Position, rp)
            if hit and hit.Instance and hit.Instance.CanCollide then return end
        end
        local score
        if mode == "Distance" then
            score = (hrp.Position - origin).Magnitude
        else
            local vp, vis = cam:WorldToViewportPoint(tp.Position)
            if not vis then return end
            score = (Vector2.new(vp.X, vp.Y) - mouseP).Magnitude
            if fov > 0 and score > fov then return end
        end
        if mingoLockOn.hrp == hrp then score = -1 end
        if not best or score < bestScore then
            best = c; bestPart = tp; bestHrp = hrp; bestScore = score
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then check(plr.Character) end
    end
    if mingoWorld.Live then
        for _, m in ipairs(mingoWorld.Live:GetChildren()) do
            if m:IsA("Model") then check(m) end
        end
    end
    return best, bestPart, bestHrp
end

-- ═══════════════════════════════════════════════════════════
--  RAGE: FREEZE-HOLD
-- ═══════════════════════════════════════════════════════════
local mingoFreezeState = { held = false, root = nil, velocity = nil }
local mingoFreezeKeyBtn

local function mingoFreezeHold()
    if mingoFreezeState.held or not (currentRootPart and currentRootPart.Parent) then return end
    mingoFreezeState.held     = true
    mingoFreezeState.root     = currentRootPart
    mingoFreezeState.velocity = currentRootPart.AssemblyLinearVelocity
    currentRootPart.Anchored  = true
end
local function mingoFreezeRelease()
    if not mingoFreezeState.held then return end
    mingoFreezeState.held = false
    local root = mingoFreezeState.root
    mingoFreezeState.root = nil
    if root and root.Parent then
        root.Anchored = false
        if mingoFreezeState.velocity then
            root.AssemblyLinearVelocity = mingoFreezeState.velocity
        end
    end
end

-- ═══════════════════════════════════════════════════════════
--  RAGE: SIDE-DASH ASSIST
-- ═══════════════════════════════════════════════════════════
local mingoSDA = { busy = false }

local function mingoSDAVelocity(inst)
    if inst:IsA("BodyVelocity") then return inst.Velocity end
    if inst:IsA("LinearVelocity") then return inst.VectorVelocity end
    return currentRootPart and currentRootPart.AssemblyLinearVelocity or Vector3.zero
end

local function mingoSDAAngle(v) return math.atan2(v.Z, v.X) end

local function mingoSDATarget()
    local root = currentRootPart
    if not root then return nil end
    local cfg  = Settings.Rage.SideDashAssist
    local myPos = root.Position
    local look  = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    look = look.Magnitude > 0 and look.Unit or Vector3.zAxis
    local best, bestChar, bestScore

    local function check(char)
        if not (char and char ~= currentCharacter and char.Parent) then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum and hum.Health > 0) then return end
        local plr = Players:GetPlayerFromCharacter(char)
        if plr and plr == Players.LocalPlayer then return end
        if plr and Settings.Misc.FriendCheck and mingoIsFriend(plr, false) then return end
        local diff = hrp.Position - myPos
        local d    = diff.Magnitude
        if d > cfg.Range or d < 0.5 then return end
        local flat = Vector3.new(diff.X,0,diff.Z)
        local dot  = flat.Magnitude > 0 and flat.Unit:Dot(look) or 1
        if dot < -0.25 then return end
        local score = d * (1.6 - dot * 0.6)
        if not best or score < bestScore then
            best = hrp; bestChar = char; bestScore = score
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do check(plr.Character) end
    if mingoWorld.Live then
        for _, m in ipairs(mingoWorld.Live:GetChildren()) do
            if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then check(m) end
        end
    end
    return best, bestChar
end

local function mingoSDAWaypoint(myPos, tgtPos, tgtLook, side, cfg)
    local flat = Vector3.new(tgtPos.X - myPos.X, 0, tgtPos.Z - myPos.Z)
    if flat.Magnitude < 0.1 then return tgtPos, true, 0 end
    local back  = -flat.Unit
    local right = Vector3.new(-back.Z, 0, back.X) * side
    if cfg.Mode ~= "Behind" then
        local wp = tgtPos + right * cfg.Offset
        wp = Vector3.new(wp.X, myPos.Y, wp.Z)
        return wp, false, (wp - myPos).Magnitude
    end
    local tgtBack = Vector3.new(-tgtLook.X, 0, -tgtLook.Z)
    if tgtBack.Magnitude < 0.1 then tgtBack = flat end
    tgtBack = tgtBack.Unit
    local R    = cfg.Offset
    local cross = (flat.X * right.Z - flat.Z * right.X) >= 0 and 1 or -1
    local ka    = mingoSDAAngle(flat)
    local kb    = mingoSDAAngle(tgtBack)
    local arc   = ((kb - ka) * cross) % (2 * math.pi)
    if arc > math.rad(300) then arc = 0 end
    if arc < math.rad(12) then
        local wp = Vector3.new(tgtPos.X, myPos.Y, tgtPos.Z) + tgtBack * R
        return wp, true, (wp - myPos).Magnitude
    end
    local newA  = ka + math.min(arc, math.rad(70)) * cross
    local reach = math.max(R, math.min(flat.Magnitude, R+6) - 2)
    local wp    = Vector3.new(tgtPos.X + math.cos(newA)*reach, myPos.Y, tgtPos.Z + math.sin(newA)*reach)
    return wp, false, math.max(0, flat.Magnitude - R) + R*arc
end

local function mingoSDARun(dashInst)
    local cfg = Settings.Rage.SideDashAssist
    if mingoSDA.busy or not (cfg.Enabled and currentRootPart and currentHumanoid
        and currentHumanoid.Health > 0) then return end
    RunService.Heartbeat:Wait()
    -- detect direction
    local rsid = isAnimationPlaying(mingoAnimIDs.rsideDash)
    local lsid = isAnimationPlaying(mingoAnimIDs.lsideDash)
    if rsid == lsid then
        rsid = UIS:IsKeyDown(Enum.KeyCode.D) and not UIS:IsKeyDown(Enum.KeyCode.S)
        lsid = UIS:IsKeyDown(Enum.KeyCode.A) and not UIS:IsKeyDown(Enum.KeyCode.S)
        if rsid == lsid then return end
    end
    if isAnimationPlaying(mingoAnimIDs.backDash) then return end
    if mingoSDA.busy then return end
    local tgtHrp, tgtChar = mingoSDATarget()
    local root = currentRootPart
    if not (tgtHrp and root) then return end
    mingoSDA.busy = true

    local sideSign = rsid and 1 or -1
    if dashInst and dashInst.Parent then dashInst:Destroy() end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "MingoSideDash"
    bv.MaxForce = Vector3.new(50000, 0, 50000)
    bv.P        = 4000
    bv.Velocity = Vector3.zero
    bv.Parent   = root

    local startTime = tick()
    local arrived   = nil
    local duration  = nil
    local prevDir   = nil
    local yaw       = select(2, root.CFrame:ToOrientation())

    local faceName = "MingoSDAFace"
    mingoBind(faceName, Enum.RenderPriority.Camera.Value + 1, function(dt)
        if root ~= currentRootPart or not (root.Parent and tgtHrp.Parent) then return end
        local diff = tgtHrp.Position - root.Position
        if Vector3.new(diff.X,0,diff.Z).Magnitude < 0.5 then return end
        local steps = math.min(dt,0.1) * 60
        if cfg.FaceTarget then
            local target_yaw = math.atan2(-diff.X, -diff.Z)
            local delta = math.atan2(math.sin(target_yaw - yaw), math.cos(target_yaw - yaw))
            yaw = yaw + delta * (1 - (1 - (arrived and 0.5 or 0.3))^steps)
            if currentHumanoid then currentHumanoid.AutoRotate = false end
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
        end
        if cfg.RotateCam then
            mingoLockAngles(0, tgtHrp.Position, false, false, 1-(1-0.25)^steps)
        end
    end)

    local steppedConn
    steppedConn = mingoConnect(RunService.Stepped, function(_, dt)
        if mingoUnloaded or root ~= currentRootPart
            or not (root.Parent and tgtHrp.Parent and currentHumanoid
                and currentHumanoid.Health > 0)
            or mingoIsDowned(currentCharacter, currentHumanoid)
            or tick() - startTime > (duration and duration + 0.3 or 1)
            or (not arrived and not bv.Parent) then
            mingoDisconnect(steppedConn)
            mingoUnbind(faceName)
            pcall(function() bv:Destroy() end)
            mingoSDA.busy = false
            mingoFreeRotate()
            return
        end
        local tgtPos = tgtHrp.Position
        if cfg.Predict then
            local vel = tgtHrp.AssemblyLinearVelocity
            local lead = math.min((tgtPos - root.Position).Magnitude / 60, 0.3)
            tgtPos = tgtPos + Vector3.new(vel.X, 0, vel.Z) * lead
        end
        local wp, done, dist = mingoSDAWaypoint(root.Position, tgtPos,
            tgtHrp.CFrame.LookVector, sideSign, cfg)
        local flat = Vector3.new(wp.X - root.Position.X, 0, wp.Z - root.Position.Z)
        local elapsed = tick() - startTime
        duration = duration or math.clamp(dist / 45, 0.3, 0.55) / math.clamp(cfg.Speed, 0.5, 2)
        local remaining = math.max(duration - elapsed, 0.06)
        local speed     = math.clamp(2 * dist / remaining, 12, 120)
        if (done or cfg.Mode ~= "Behind") and flat.Magnitude <= math.max(1.2, speed*dt*1.2) then
            pcall(function() bv:Destroy() end)
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(v.X*0.25, v.Y, v.Z*0.25)
            arrived = tick()
            return
        end
        if flat.Magnitude < 0.05 then return end
        local dir = flat.Unit
        if prevDir then
            local blend = 1 - (1 - math.clamp(cfg.Strength,0.05,1))^(math.min(dt,0.1)*60)
            local mixed = prevDir:Lerp(dir, blend)
            prevDir = mixed.Magnitude > 0.05 and mixed.Unit or dir
        else
            prevDir = dir
        end
        bv.Velocity = prevDir * speed
    end)
end

-- ═══════════════════════════════════════════════════════════
--  NO-STUN / NO-SLOW / NO-FATIGUE / NO-SIDE-DASH-COOLDOWN
-- ═══════════════════════════════════════════════════════════
local function mingoOnLiveChildAdded(inst)
    if not inst then return end
    local name = inst.Name
    -- effects-color / visual suppression
    mingoOnDescendantAdded(inst)
    -- rage toggles on local character
    local char = currentCharacter
    if not char then return end
    local ancestor = inst:FindFirstAncestorWhichIsA("Model")
    if not ancestor then
        ancestor = inst.Parent and inst.Parent:FindFirstAncestorWhichIsA("Model")
    end
    if ancestor == char then
        if (name == "Freeze" and Settings.Rage.NoStun)
            or (name == "Slowed" and Settings.Rage.NoSlow) then
            task.defer(inst.Destroy, inst)
        elseif Settings.Rage.NoSideDashCooldown
            and (name == "UsedDash" or name == "InDash"
                 or name == "DashCooldown" or name == "SideDashCooldown") then
            task.defer(inst.Destroy, inst)
        elseif name == "dodgevelocity" and Settings.Rage.SideDashAssist.Enabled then
            task.spawn(mingoSDARun, inst)
        end
    end
    -- autoblock: dash events on enemy chars
    if ancestor and ancestor ~= char then
        local dashEventSet = {
            dodgevelocity = true, InDash = true, SideDashCooldown = true
        }
        if dashEventSet[name] and Settings.Autoblock.DashPredict then
            -- forward to MingoHub's existing autoblock system via watchEnemyModel
            task.spawn(watchEnemyModel, inst)
        elseif Settings.Autoblock.Enabled then
            task.spawn(watchEnemyModel, inst)
        end
    end
end

-- ═══════════════════════════════════════════════════════════
--  CUSTOM FRONT / SIDE DASH BOOST
-- ═══════════════════════════════════════════════════════════
local function mingoDashBoost(mult, delay)
    task.wait(delay)
    if not (currentRootPart and currentHumanoid) then return end
    if isAnimationPlaying(mingoAnimIDs.backDash) then return end
    local vel = currentRootPart.AssemblyLinearVelocity
    currentRootPart.AssemblyLinearVelocity = Vector3.new(vel.X * mult, vel.Y, vel.Z * mult)
end

