local Character, Humanoid, RootPart, HeadPart, HeadFace, Animator, Communicate, RigType
local liveFolder = workspace:FindFirstChild("Live") or workspace
local Live = { Live = liveFolder, Map = workspace:FindFirstChild("Map") or Instance.new("Folder") }
local hookedModels = setmetatable({}, {__mode = "k"})
local PlayerRelations = {}  -- name -> "friend" | "enemy"
local ActiveConnections = {}
local Unloaded = false

local sdkx = setmetatable({}, {__mode = "k"})
local function storeProp(obj, key)
    local t = sdkx[obj]
    if not t then t = {}; sdkx[obj] = t end
    if t[key] == nil then t[key] = { value = obj[key] } end
    return t[key].value
end
local function setTracked(obj, key, value)
    storeProp(obj, key)
    obj[key] = value
end
local function restoreAll()
    for obj, props in pairs(sdkx) do
        for k, rec in pairs(props) do
            pcall(function() obj[k] = rec.value end)
        end
    end
    table.clear(sdkx)
end

local function connect(signal, fn)
    local c = signal:Connect(function(...) if Unloaded then return end return fn(...) end)
    ActiveConnections[c] = true
    return c
end

-- =========================================================================
-- Input dispatch — send keystrokes, mouse clicks, key taps
-- =========================================================================
local function jitter(base) task.wait((base or 0) + math.random(2, 6) / 1000) end
local function keyDown(k) pcall(function() VirtualInputManager:SendKeyEvent(true, k, false, game) end) end
local function keyUp(k) pcall(function() VirtualInputManager:SendKeyEvent(false, k, false, game) end) end
local function tapKey(k) keyDown(k) jitter() keyUp(k) end
local function clickM1()
    local vp = Camera and Camera.ViewportSize or Vector2.new(400, 300)
    local hx, hy = math.floor(vp.X / 2), math.floor(vp.Y / 2)
    pcall(function() VirtualInputManager:SendMouseButtonEvent(hx, hy, 0, true, game, 0) end)
    jitter()
    pcall(function() VirtualInputManager:SendMouseButtonEvent(hx, hy, 0, false, game, 0) end)
end
local function pressAndClick(numKey)
    keyDown(numKey) jitter(0.01) keyUp(numKey)
    if not sAutoUnequip then jitter() clickM1() end
end

-- =========================================================================
-- Ping helpers
-- =========================================================================
local DataPing
pcall(function() DataPing = Stats.Network.ServerStatsItem["Data Ping"] end)
local PingState = { value = 0 }
task.spawn(function()
    while not Unloaded do
        if DataPing then
            local ok, v = pcall(DataPing.GetValue, DataPing)
            if ok then PingState.value = v end
        end
        task.wait(0.25)
    end
end)
local function getPing(div) return PingState.value / (div or 1) end

-- =========================================================================
-- Animation inspection
-- =========================================================================
local function animPlaying(id, hum)
    hum = hum or Humanoid
    if not hum then return false end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return false end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        local a = track.Animation
        if a and a.AnimationId and string.find(a.AnimationId, tostring(id), 1, true) then
            return true
        end
    end
    return false
end

local function stopAnim(id)
    if not Animator then return end
    for _, track in ipairs(Animator:GetPlayingAnimationTracks()) do
        if track.Animation and track.Animation.AnimationId == "rbxassetid://" .. tostring(id) then
            track:Stop()
        end
    end
end

-- =========================================================================
-- Character / world helpers
-- =========================================================================
local function getCommunicate()
    if Communicate and Communicate.Parent then return Communicate end
    if Character then
        Communicate = Character:FindFirstChild("Communicate") or Character:WaitForChild("Communicate", 2)
    end
    return Communicate
end

local function playerFromModel(model)
    return model and Players:GetPlayerFromCharacter(model) or nil
end

local function isFriend(plr, strict)
    if not plr or not plr.Name then return false end
    local rel = PlayerRelations[plr.Name]
    if rel == "friend" then return strict and Settings.Autoblock.FriendCheck or true end
    return false
end

local function friendCheckActive()
    return Settings.Autoblock.FriendCheck
end

local function notInStates(char, set)
    if not char then return false end
    for _, c in ipairs(char:GetChildren()) do
        if set[c.Name] then return false end
    end
    return true
end

local function isCCFrozen()
    local c = Character or (player and player.Character)
    local h = Humanoid or (c and c:FindFirstChildOfClass("Humanoid"))
    local r = RootPart or (c and c:FindFirstChild("HumanoidRootPart"))
    if not (c and h and r) then return true end
    if h.Health <= 0 then return true end
    if c:FindFirstChild("Ragdoll") or c:GetAttribute("Ragdoll") then return true end
    if c:FindFirstChild("BeingLaunched") or c:FindFirstChild("KnockedDown") then return true end
    if c:FindFirstChild("WallCombo") then return true end
    if c:FindFirstChild("Freeze") or c:FindFirstChild("Stun") then return true end
    if h.PlatformStand or h:GetState() == Enum.HumanoidStateType.Ragdoll then return true end
    return false
end

-- Target part for lock-on / techs
local function targetPartFromModel(model)
    if not model then return nil end
    local pick = Settings.AutoTech.TargetPart
    if pick == "Head" or pick == "Torso" then
        local p = model:FindFirstChild(pick) or (pick == "Torso" and model:FindFirstChild("UpperTorso"))
        if p then return p end
    end
    return model:FindFirstChild("HumanoidRootPart")
end
local function targetPos(model)
    local p = targetPartFromModel(model)
    return p and p.Position or Vector3.zero
end

-- =========================================================================
-- Camera / character rotation helpers
-- =========================================================================
local activeRenderNames = {}
local function bindRender(name, prio, fn)
    activeRenderNames[name] = true
    RunService:BindToRenderStep(name, prio, fn)
end
local function unbindRender(name)
    if activeRenderNames[name] then
        pcall(RunService.UnbindFromRenderStep, RunService, name)
        activeRenderNames[name] = nil
    end
end

local function applyCF(pos, yaw, pitch)
    Camera.CFrame = CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end

-- Rotate character and/or camera to angle/target
local function rotateAim(angle, targetPosition, rotateChar, rotateCam, precision, lookAtOffset)
    if not rotateChar and not rotateCam and not angle then rotateChar = true end
    rotateChar = rotateChar or false
    rotateCam = rotateCam or false
    local doChar = rotateChar or rotateCam
    local doCam = not rotateChar or rotateCam
    if doChar and not (RootPart and Humanoid) then return end

    precision = precision or 1
    local camCF = Camera.CFrame
    local camPos = camCF.Position
    if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
        camPos = camPos - camCF.RightVector * 1.75
    end

    local currentPitch = math.asin(math.clamp(camCF.LookVector.Y, -1, 1))
    local currentYaw, targetYaw

    if targetPosition then
        local lookVector
        if rotateChar then
            lookVector = (targetPosition - RootPart.Position).Unit
            currentYaw = math.atan2(-RootPart.CFrame.LookVector.X, -RootPart.CFrame.LookVector.Z)
        else
            lookVector = (targetPosition - camPos).Unit
            currentYaw = math.atan2(-camCF.LookVector.X, -camCF.LookVector.Z)
        end
        targetYaw = math.atan2(-lookVector.X, -lookVector.Z)
    else
        local lookV = rotateChar and RootPart.CFrame.LookVector or camCF.LookVector
        currentYaw = math.atan2(-lookV.X, -lookV.Z)
        targetYaw = currentYaw + math.rad(angle or 0)
    end

    local diff = math.atan2(math.sin(targetYaw - currentYaw), math.cos(targetYaw - currentYaw))
    local finalYaw = currentYaw + diff * precision

    if rotateChar then
        Humanoid.AutoRotate = false
        RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, finalYaw, 0)
        if not rotateCam then return end
    end
    applyCF(camPos, finalYaw, currentPitch)
end

-- Smooth camera-only rotation to a world position
local function smoothCamToPos(targetPos, duration)
    if not Camera or not targetPos then return end
    duration = math.max(tonumber(duration) or 0, 1/240)
    local startTick = tick()
    local startCF = Camera.CFrame
    local startYaw = math.atan2(-startCF.LookVector.X, -startCF.LookVector.Z)
    local pitch = math.asin(math.clamp(startCF.LookVector.Y, -1, 1))
    local name = "MingoCamToPos" .. tick()
    bindRender(name, Enum.RenderPriority.Camera.Value + 1, function()
        local t = math.clamp((tick() - startTick) / duration, 0, 1)
        local eased = t * t * (3 - 2 * t)
        local pos = Camera.CFrame.Position
        local dir = targetPos - pos
        if dir.Magnitude < 0.01 then unbindRender(name) return end
        local yaw = math.atan2(-dir.Unit.X, -dir.Unit.Z)
        local finalYaw = startYaw + math.atan2(math.sin(yaw - startYaw), math.cos(yaw - startYaw)) * eased
        applyCF(pos, finalYaw, pitch)
        if t >= 1 then unbindRender(name) end
    end)
end

-- Smooth character rotation (angle) with easing
local function smoothRotateChar(angle, duration)
    if not RootPart or not Humanoid then return end
    duration = math.max(tonumber(duration) or 0, 1/240)
    local startYaw = math.atan2(-RootPart.CFrame.LookVector.X, -RootPart.CFrame.LookVector.Z)
    local targetYaw = startYaw + math.rad(angle)
    local startTick = tick()
    local name = "MingoRotChar" .. tick()
    bindRender(name, Enum.RenderPriority.Camera.Value + 1, function()
        local t = math.clamp((tick() - startTick) / duration, 0, 1)
        local eased = t * t * (3 - 2 * t)
        local yaw = startYaw + (targetYaw - startYaw) * eased
        Humanoid.AutoRotate = false
        RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, yaw, 0)
        if t >= 1 then unbindRender(name) end
    end)
end

-- Frame-watch: while a ragdoll tag lives, keep aiming/looking. Callback per frame.
local function watchRagdoll(method, duration, targetChar, targetHum, cb)
    local conn
    conn = RunService[method]:Connect(function()
        if not targetChar or not targetChar.Parent or targetChar:FindFirstChild("BeingLaunched")
            or not targetChar:FindFirstChild("Ragdoll")
            or not targetHum or targetHum.Health <= 0
            or not Humanoid or Humanoid.Health <= 0
            or not animPlaying(Anims.frontDash) then
            if conn then conn:Disconnect() end
            return
        end
        cb()
    end)
    task.wait(duration)
    if conn then conn:Disconnect() end
end

local function freeRotate()
    if not Humanoid or State.freeRotateLocked then return end
    local c = Character
    Humanoid.AutoRotate = not (c and (c:FindFirstChild("Ragdoll") or c:FindFirstChild("NoRotate")))
end

-- =========================================================================
-- Front dash helper (Server-fire with cooldown tracking)
-- =========================================================================
local dashCooling = false
local function canDash()
    if workspace:GetAttribute("NoDashCooldown") or (Character and Character:FindFirstChild("DashReset3rd")) then
        return true
    end
    return not dashCooling and (tick() - State.frontDashAt >= 0.5)
end

local function fireFrontDash()
    local comm = getCommunicate()
    if not comm then return false end
    if not canDash() then return false end
    comm:FireServer(Comms.frontDash)
    State.frontDashAt = tick()
    if not workspace:GetAttribute("NoDashCooldown") then
        dashCooling = true
        task.delay(5, function() dashCooling = false end)
    end
    return true
end

local function dashWithDelay(extra)
    fireFrontDash()
    task.wait(getPing(1000) + 0.05 + (extra or 0))
end

-- =========================================================================
-- Server attribute mirroring for dash cooldown state
-- =========================================================================
local function spoofDashState(on)
    if workspace:GetAttribute("NoDashCooldown") == (on and true or State.serverNoDash) and
       workspace:GetAttribute("EffectAffects") == (on and 1 or State.serverEffect) then
        return
    end
    State.spoofingDash = true
    workspace:SetAttribute("NoDashCooldown", on and true or State.serverNoDash)
    workspace:SetAttribute("EffectAffects", on and 1 or State.serverEffect)
    State.spoofingDash = false
end

connect(workspace:GetAttributeChangedSignal("NoDashCooldown"), function()
    if not State.spoofingDash then State.serverNoDash = workspace:GetAttribute("NoDashCooldown") end
end)
connect(workspace:GetAttributeChangedSignal("EffectAffects"), function()
    if not State.spoofingDash then State.serverEffect = workspace:GetAttribute("EffectAffects") end
end)

local function hasNoDash()
    if Character and Character:FindFirstChild("DashReset3rd") then return true end
    if not State.serverNoDash then return false end
    return State.serverEffect == 1 or workspace:GetAttribute("VIPServerOwner") == player.Name
end

-- =========================================================================
-- Block hold / release
-- =========================================================================
local blockHeld = false
local function holdBlock()
    if blockHeld then return end
    local comm = getCommunicate()
    if not comm then return end
    blockHeld = true
    if Humanoid then Humanoid.AutoRotate = false end
    comm:FireServer(Comms.holdBlock)
end
local function releaseBlock()
    if not blockHeld then return end
    local comm = getCommunicate()
    blockHeld = false
    if comm then comm:FireServer(Comms.releaseBlock) end
    freeRotate()
end

-- =========================================================================
-- Autoblock — engage blocking session with easing
-- =========================================================================
local function engageBlock(duration, targetRoot, targetHum)
    if Character and Character:FindFirstChild("Counter") then return false end
    duration = duration or 0.25
    local bs = State.blockState
    local now = tick()
    bs.untilT = math.max(bs.untilT, now + duration)
    if bs.active then return false end
    bs.active = true
    bs.session = {}

    local session = bs.session
    local rotConn
    local ok, err = pcall(function()
        holdBlock()
        if Settings.Autoblock.RotateChar and targetRoot and targetHum then
            rotConn = RunService.Heartbeat:Connect(function(dt)
                if not targetRoot.Parent or not RootPart or not Humanoid.Health or Humanoid.Health <= 0 then
                    if rotConn then rotConn:Disconnect() end
                    return
                end
                if notInStates(Character, State.ignoreLocal) then
                    Humanoid.AutoRotate = false
                    local cf = RootPart.CFrame
                    local facePos = Vector3.new(targetRoot.Position.X, cf.Position.Y, targetRoot.Position.Z)
                    local targetCF = CFrame.new(cf.Position, facePos)
                    local easing = math.clamp(dt / math.max(Settings.Autoblock.CharEasing, 0.001), 0, 1)
                    RootPart.CFrame = Settings.Autoblock.CharEasing > 0 and cf:Lerp(targetCF, easing) or targetCF
                end
            end)
        end
        if Settings.Autoblock.RotateCam and targetRoot then
            smoothCamToPos(targetRoot.Position, Settings.Autoblock.CamEasing)
        end
        while tick() < bs.untilT and not Unloaded and bs.session == session do
            task.wait()
        end
    end)
    if not ok then warn("[MingoHub] block err: " .. tostring(err)) end
    if rotConn then rotConn:Disconnect() end

    if bs.session == session then
        bs.active = false
        bs.session = nil
        releaseBlock()
    end
    return true
end

-- Auto M1 punish after block
local function punishM1(targetRoot, targetHum)
    if tick() - State.lastPunish < 0.25 then return end
    State.lastPunish = tick()
    if not (targetRoot.Parent and notInStates(targetRoot.Parent, State.ignoreM1)) then return end
    if Character and Character:FindFirstChild("CanBringUp") then return end
    local rotConn
    if Settings.Autoblock.RotateChar and targetRoot then
        rotConn = RunService.Heartbeat:Connect(function(dt)
            if not targetRoot.Parent or not RootPart then
                if rotConn then rotConn:Disconnect() end
                return
            end
            if notInStates(Character, State.ignoreLocal) then
                Humanoid.AutoRotate = false
                local cf = RootPart.CFrame
                local facePos = Vector3.new(targetRoot.Position.X, cf.Position.Y, targetRoot.Position.Z)
                local targetCF = CFrame.new(cf.Position, facePos)
                local easing = math.clamp(dt / math.max(Settings.Autoblock.CharEasing, 0.001), 0, 1)
                RootPart.CFrame = Settings.Autoblock.CharEasing > 0 and cf:Lerp(targetCF, easing) or targetCF
            end
        end)
    end
    if Settings.Autoblock.RotateCam and targetRoot then
        smoothCamToPos(targetRoot.Position, Settings.Autoblock.CamEasing)
    end
    pressAndClick(Enum.KeyCode.One)
    jitter()
    clickM1()
    task.wait(0.1)
    if rotConn then rotConn:Disconnect() end
end

-- Auto counter tool trigger
local function fireAutoCounter(targetRoot, targetHum, dashPredicted)
    if not Settings.Autoblock.AutoCounter then return true end
    local counterTool = player.Backpack and (player.Backpack:FindFirstChild("Prey's Peril") or player.Backpack:FindFirstChild("Split Second Counter"))
    if not counterTool then return true end

    local hotbar = PlayerGui:FindFirstChild("Hotbar")
    local backpackGui = hotbar and hotbar:FindFirstChild("Backpack")
    local hotbarInner = backpackGui and backpackGui:FindFirstChild("Hotbar")
    local slot4 = hotbarInner and hotbarInner:FindFirstChild("4")
    local base = slot4 and slot4:FindFirstChild("Base")
    local cd = base and base:FindFirstChild("Cooldown")
    if dashPredicted or cd then return true end

    local comm = getCommunicate()
    if comm then
        comm:FireServer({ IsAutoActivate = true, Goal = "Console Move", Tool = counterTool, ToolName = counterTool.Name })
        return false
    end
    return true
end

-- Velocity threat check
local function dashComingAtMe(targetRoot)
    local vel = targetRoot.AssemblyLinearVelocity
    if vel.Magnitude < 0.1 then return false end
    local toMe = RootPart.Position - targetRoot.Position
    if toMe.Magnitude < 0.01 then return true end
    return vel.Unit:Dot(toMe.Unit) > 0.7
end

local function inFOV(targetRoot)
    local fov = Settings.Autoblock.FOV or 360
    if fov >= 360 then return true end
    local look = RootPart.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local d = targetRoot.Position - RootPart.Position
    local flatd = Vector3.new(d.X, 0, d.Z)
    if flat.Magnitude < 0.001 or flatd.Magnitude < 0.001 then return true end
    local angle = math.deg(math.acos(math.clamp(flat.Unit:Dot(flatd.Unit), -1, 1)))
    return angle <= fov / 2
end

local function blockEngage(targetRoot, targetHum, dashPredicted)
    if Character:FindFirstChild("Counter") then return end
    if not engageBlock(0.25 + getPing(1000) * -0.001, targetRoot, targetHum) then return end
    local dist = (RootPart.Position - targetRoot.Position).Magnitude
    local isClose = dist <= (Settings.Autoblock.Range or 9)
    local isMoving = dist <= Dist.MovingM1 and dashComingAtMe(targetRoot)
    if Settings.Autoblock.AutoM1 and (isClose or isMoving or dashPredicted) then
        if not targetRoot.Parent or Character:FindFirstChild("CanBringUp") then return end
        local rotConn
        if Settings.Autoblock.RotateChar and targetRoot then
            rotConn = RunService.Heartbeat:Connect(function(dt)
                if not targetRoot.Parent or not RootPart then
                    if rotConn then rotConn:Disconnect() end
                    return
                end
                if notInStates(Character, State.ignoreLocal) then
                    Humanoid.AutoRotate = false
                    local cf = RootPart.CFrame
                    local facePos = Vector3.new(targetRoot.Position.X, cf.Position.Y, targetRoot.Position.Z)
                    RootPart.CFrame = CFrame.new(cf.Position, facePos)
                end
            end)
        end
        pressAndClick(Enum.KeyCode.One)
        task.wait(0.1)
        if rotConn then rotConn:Disconnect() end
    end
end

local function blockBarrage(targetRoot, targetHum, targetChar)
    if State.barrageActive then return end
    State.barrageActive = true
    local started = tick()
    local rotConn = Settings.Autoblock.RotateChar and RunService.Heartbeat:Connect(function(dt)
        if not targetRoot.Parent or not RootPart then
            if rotConn then rotConn:Disconnect() end
            return
        end
        if notInStates(Character, State.ignoreLocal) then
            Humanoid.AutoRotate = false
            local cf = RootPart.CFrame
            local facePos = Vector3.new(targetRoot.Position.X, cf.Position.Y, targetRoot.Position.Z)
            RootPart.CFrame = CFrame.new(cf.Position, facePos)
        end
    end) or nil
    local loopConn
    loopConn = RunService.Heartbeat:Connect(function()
        if not (RootPart and RootPart.Parent and targetRoot.Parent) then
            if rotConn then rotConn:Disconnect() end
            if loopConn then loopConn:Disconnect() end
            State.barrageActive = false
            releaseBlock()
            return
        end
        holdBlock()
        local elapsed = tick() - started
        if (targetChar and targetChar:FindFirstChild("NoBlock")) or (RootPart.Position - targetRoot.Position).Magnitude >= Dist.Barrage + 5 then
            if rotConn then rotConn:Disconnect() end
            if loopConn then loopConn:Disconnect() end
            State.barrageActive = false
            releaseBlock()
            if Settings.Autoblock.AutoM1 and (RootPart.Position - targetRoot.Position).Magnitude <= (Settings.Autoblock.Range or 9) then
                punishM1(targetRoot, targetHum)
            end
            return
        end
        if elapsed >= 0.1 and not (targetChar and targetChar:FindFirstChild("Slowed")) then
            if rotConn then rotConn:Disconnect() end
            if loopConn then loopConn:Disconnect() end
            State.barrageActive = false
            releaseBlock()
        end
    end)
end

-- Dash prediction state
local DashPred = { ids = {}, active = {}, acc = 0 }
DashPred.ids[Anims.frontDash] = true
DashPred.ids[Anims.rsideDash] = true
DashPred.ids[Anims.lsideDash] = true

function DashPred.start(model, root, hum)
    if DashPred.active[model] and tick() - DashPred.active[model].started < 0.4 then return end
    DashPred.active[model] = { hrp = root, human = hum, started = tick() }
end

function DashPred.threat(root)
    local toMe = RootPart.Position - root.Position
    toMe = Vector3.new(toMe.X, 0, toMe.Z)
    local v = root.AssemblyLinearVelocity
    v = Vector3.new(v.X, 0, v.Z)
    local vv = v:Dot(v)
    if vv < 25 then return toMe.Magnitude, 0, 0 end
    local closing = toMe.Magnitude > 0 and toMe.Unit:Dot(v) or 0
    local t = math.clamp(toMe:Dot(v) / vv, 0, 0.45 + getPing(1000))
    return (toMe - v * t).Magnitude, t, closing
end

function DashPred.step()
    for model, rec in pairs(DashPred.active) do
        if tick() - rec.started > 0.65 or not (rec.hrp.Parent and rec.human.Health > 0) then
            DashPred.active[model] = nil
        elseif not rec.blocked then
            local plr = playerFromModel(model)
            if not (Settings.Autoblock.FriendCheck and plr and isFriend(plr, true))
                and notInStates(Character, State.ignoreLocal)
                and notInStates(model, State.ignoreEnemy) then
                local dist, eta, closing = DashPred.threat(rec.hrp)
                local direct = (rec.hrp.Position - RootPart.Position).Magnitude
                if direct <= Dist.M1 or (closing > 8 and dist <= Dist.M1 + 2) then
                    rec.blocked = true
                    local dur = math.clamp(eta + 0.3 + getPing(1000), 0.3, 0.8)
                    task.spawn(function()
                        if fireAutoCounter(rec.hrp, rec.human, false) then
                            engageBlock(dur, rec.hrp, rec.human)
                        end
                    end)
                end
            end
        end
    end
end

connect(RunService.Heartbeat, function(dt)
    if not (Settings.Autoblock.Enabled and Settings.Autoblock.DashPredict) then
        table.clear(DashPred.active)
        return
    end
    DashPred.acc += dt
    if DashPred.acc < 1/30 then return end
    DashPred.acc = 0
    if not (RootPart and Humanoid and Humanoid.Health > 0 and Live.Live) then return end
    pcall(DashPred.step)
end)

-- Autoblock main reaction
local lastM1 = setmetatable({}, {__mode = "k"})
local function reactToThreat(model, eventName)
    if not Settings.Autoblock.Enabled or model == Character then return end
    if not (RootPart and Humanoid and Humanoid.Health > 0) then return end
    local root = model:FindFirstChild("HumanoidRootPart")
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not (root and hum and hum.Health > 0) then return end
    local plr = playerFromModel(model)
    if plr == player then return end
    if Settings.Autoblock.FriendCheck and plr and isFriend(plr, false) then return end

    local isM1 = eventName == "M1ing"
    local isInterrupt = State.interruptMoves[eventName]
    local isBarrage = State.barrageMoves[eventName]
    if not (isM1 or isInterrupt or isBarrage) then return end

    local dist = (RootPart.Position - root.Position).Magnitude
    local isClose = dist <= Dist.M1
    local isMoving = dist <= Dist.MovingM1 and dashComingAtMe(root)
    local isDashPred = Settings.Autoblock.DashPredict and dist <= Dist.FarDash
        and (animPlaying(Anims.lsideDash, hum) or animPlaying(Anims.rsideDash, hum))
    if not (isClose or isMoving or isDashPred) then return end
    if not (notInStates(Character, State.ignoreLocal) and notInStates(model, State.ignoreEnemy)) then return end
    if not inFOV(root) then return end

    if isM1 then
        local last = lastM1[model]
        if last and tick() - last < 0.15 then return end
        lastM1[model] = tick()
    end

    if fireAutoCounter(root, hum, isMoving) then
        if isM1 then
            blockEngage(root, hum, isDashPred)
        elseif isInterrupt then
            punishM1(root, hum)
        elseif isBarrage then
            blockBarrage(root, hum, model)
        end
    end
end

-- Hook every live model for animation events
local function hookModel(model)
    if not model or model == Character or hookedModels[model] then return end
    hookedModels[model] = true
    task.spawn(function()
        local hum = model:WaitForChild("Humanoid", 10)
        local animator = hum and hum:WaitForChild("Animator", 10)
        if not animator then return end
        connect(animator.AnimationPlayed, function(track)
            if Unloaded or not Settings.Autoblock.Enabled or model == Character then return end
            local id = track.Animation and track.Animation.AnimationId:match("%d+")
            if not id then return end
            local m1Ids = {
                ["10469493270"]=1,["10469630950"]=1,["10469639222"]=1,["10469643643"]=1,
                ["14004222985"]=1,["13997092940"]=1,["14001963401"]=1,["14136436157"]=1,
                ["13370310513"]=1,["13390230973"]=1,["13378751717"]=1,["13378708199"]=1,
                ["15259161390"]=1,["15240216931"]=1,["15240176873"]=1,["15162694192"]=1,
                ["89044067797964"]=1,["74334194837918"]=1,["94353845974131"]=1,
                ["80601239139774"]=1,["13532562418"]=1,["13532600125"]=1,
                ["13532604085"]=1,["13294471966"]=1,["125361499827663"]=1,
                ["105701432344953"]=1,["104293439261333"]=1,["114460992057353"]=1,
                ["111644455066361"]=1,["112778933066374"]=1,["80488470577181"]=1,
                ["117726521294150"]=1,["97702234977209"]=1,["136834606687014"]=1,
                ["137556620675474"]=1,["115406134600395"]=1,["13491635433"]=1,
                ["13296577783"]=1,["13295919399"]=1,["13295936866"]=1,["16515503507"]=1,
                ["16515520431"]=1,["16515448089"]=1,["16552234590"]=1,["17325510002"]=1,
                ["17325513870"]=1,["17325522388"]=1,["17325537719"]=1,["17889458563"]=1,
                ["17889461810"]=1,["17889471098"]=1,["17889290569"]=1,["123005629431309"]=1,
                ["100059874351664"]=1,["104895379416342"]=1,["134775406437626"]=1,
                ["122482492364036"]=1,["125882667406347"]=1,["134822631853770"]=1,
                ["76602138940033"]=1,["13379003796"]=1,["10503381238"]=1,["10470104242"]=1,
            }
            if m1Ids[id] then
                task.spawn(reactToThreat, model, "M1ing")
            elseif DashPred.ids[id] and Settings.Autoblock.DashPredict then
                local root = model:FindFirstChild("HumanoidRootPart")
                if root and RootPart and (root.Position - RootPart.Position).Magnitude <= 45 then
                    DashPred.start(model, root, hum)
                end
            end
        end)
    end)
end

-- Live-folder listener
local function onLiveChild(inst)
    if not inst then return end
    local name = inst.Name
    if not (State.watchedEvents[name] or State.interruptMoves[name] or State.barrageMoves[name]) then return end
    if isrbxactive and not isrbxactive() then return end
    local model = inst:FindFirstAncestorWhichIsA("Model") or (inst.Parent and inst.Parent:FindFirstAncestorWhichIsA("Model"))
    if not model then return end
    local plr = Players:FindFirstChild(model.Name)
    local isLocal = (model == Character) or (plr and plr == player)

    if not isLocal then
        if name == "Counter" and plr then
            -- notification
            if Settings.Misc.Notifications.Enabled and Settings.Misc.Notifications.Counter then
                local ok, url = pcall(function()
                    return Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                end)
                pushNotification({
                    Title = "MingoHub",
                    Description = string.format("%s used Death Counter!", plr.DisplayName),
                    Image = ok and url or nil,
                })
            end
        elseif Settings.Autoblock.Enabled then
            if State.dashEvents[name] then
                if Settings.Autoblock.DashPredict then
                    local root = model:FindFirstChild("HumanoidRootPart")
                    local hum = model:FindFirstChildOfClass("Humanoid")
                    if root and hum then DashPred.start(model, root, hum) end
                end
            else
                reactToThreat(model, name)
            end
        end
    else
        if name == "dodgevelocity" and Settings.Player.SideDashAssist.Enabled then
            task.spawn(SideDashAssist.run, inst)
        end
        if (name == "Freeze" and Settings.Player.NoStun) or (name == "Slowed" and Settings.Player.NoSlow) then
            task.defer(inst.Destroy, inst)
        elseif Settings.Player.NoSideDashCooldown and (name == "UsedDash" or name == "InDash" or name == "DashCooldown" or name == "SideDashCooldown") then
            task.defer(inst.Destroy, inst)
        elseif name == "moveme" and Settings.Player.CustomFrontDash.Enabled and not Settings.Player.CustomFrontDash.OnlyOnKeybind and Settings.Player.CustomFrontDash.Distance > 1 then
            amplifyDash(Settings.Player.CustomFrontDash.Distance, 0.05)
        elseif name == "dodgevelocity" and Settings.Player.CustomSideDash.Distance > 1
            and Settings.Player.CustomSideDash.Enabled and not Settings.Player.CustomSideDash.OnlyOnKeybind
            and not (Settings.Player.SideDashAssist.Enabled and SideDashAssist.target()) then
            amplifyDash(Settings.Player.CustomSideDash.Distance, 0.05)
        end
    end
end

local function amplifyDash(mult, delay)
    task.wait(delay)
    if not (RootPart and Humanoid) then return end
    if animPlaying(Anims.backDash, Humanoid) then return end
    State.boostUntil = tick() + 1
    RootPart.AssemblyLinearVelocity = Vector3.new(
        RootPart.AssemblyLinearVelocity.X * mult,
        RootPart.AssemblyLinearVelocity.Y,
        RootPart.AssemblyLinearVelocity.Z * mult
    )
end

-- =========================================================================
-- Tech handlers
-- =========================================================================
local function pivotTo(part, cf)
    if not Character or not RootPart then return end
    RootPart.CFrame = cf
    pcall(function() Character:PivotTo(cf) end)
end

local function isAboveTarget(hrp)
    if not RootPart or not hrp then return false end
    local myPos = RootPart.Position
    local tPos = hrp.Position
    local hDist = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(tPos.X, 0, tPos.Z)).Magnitude
    return hDist <= 0.2 and myPos.Y < tPos.Y
end

local function techSupa(target, hrp, hum, miss)
    dashWithDelay()
    local offset = hrp.CFrame:PointToObjectSpace(RootPart.Position)
    local method = Settings.AutoTech.SupaHeartbeat and "Heartbeat" or "RenderStepped"
    watchRagdoll(method, 0.3, target, hum, function()
        local worldPos = hrp.CFrame:PointToWorldSpace(offset)
        local aimPos = targetPos(hrp.Parent)
        if miss then worldPos = worldPos + (hrp.CFrame.RightVector * (math.random() > 0.5 and 7 or -7)) end
        pivotTo(RootPart, CFrame.lookAt(worldPos, Vector3.new(aimPos.X, worldPos.Y + 1.5, aimPos.Z), Vector3.new(0, 1, 0)))
    end)
end

local function techLockOn(target, hrp, hum, miss)
    dashWithDelay()
    watchRagdoll("Heartbeat", 0.7, target, hum, function()
        local aimPos = targetPos(hrp.Parent)
        if miss then aimPos = aimPos + (hrp.CFrame.RightVector * (math.random() > 0.5 and 8 or -8)) end
        rotateAim(nil, aimPos, true, false, Settings.AutoTech.LockonPrecision)
    end)
end

local function techLoopDash(target, hrp, hum, miss)
    dashWithDelay()
    rotateAim(90, nil, true)
    smoothRotateChar(270, 0.35)
    task.wait(0.3)
    local cachedCF
    watchRagdoll("Heartbeat", 0.4, target, hum, function()
        local aimPos = targetPos(hrp.Parent)
        if miss then aimPos = aimPos + (hrp.CFrame.RightVector * (math.random() > 0.5 and 7 or -7)) end
        if cachedCF or isAboveTarget(hrp) then
            if not cachedCF then
                cachedCF = Settings.AutoTech.LoopDashLooksUp
                    and CFrame.lookAt(RootPart.Position, Vector3.new(RootPart.Position.X + 1.5, RootPart.Position.Y + 1.5, RootPart.Position.Z))
                    or RootPart.CFrame
            end
            pivotTo(RootPart, cachedCF)
        else
            rotateAim(nil, aimPos, true)
        end
    end)
end

local function techKiba(target, hrp, hum, miss)
    dashWithDelay()
    watchRagdoll("Heartbeat", 0.4, target, hum, function()
        local aimPos = targetPos(hrp.Parent)
        local pos = aimPos - Vector3.new(0, 3, 2)
        if miss then pos = pos + (hrp.CFrame.RightVector * (math.random() > 0.5 and 7 or -7)) end
        pivotTo(RootPart, CFrame.new(pos, aimPos))
    end)
end

local function techLoopV2(target, hrp, hum, miss)
    local c = Settings.AutoTech.Loopv2
    if c.Jump and RootPart then
        RootPart.AssemblyLinearVelocity = Vector3.new(RootPart.AssemblyLinearVelocity.X, 50, RootPart.AssemblyLinearVelocity.Z)
    end
    rotateAim(c.FirstFlickAngle, nil, true, c.RotateCam)
    dashWithDelay(c.SecondFlick)
    watchRagdoll("Heartbeat", 0.4, target, hum, function()
        local aimPos = targetPos(hrp.Parent)
        if miss then aimPos = aimPos + (hrp.CFrame.RightVector * (math.random() > 0.5 and 8 or -8)) end
        rotateAim(nil, aimPos, true, c.RotateCam, c.Precision)
    end)
    freeRotate()
end

local function techCustomDash(target, hrp, hum, miss)
    local c = Settings.AutoTech.Customdash
    if c.Jump and RootPart then
        RootPart.AssemblyLinearVelocity = Vector3.new(RootPart.AssemblyLinearVelocity.X, 50, RootPart.AssemblyLinearVelocity.Z)
    end
    local aimPos = targetPos(hrp.Parent)
    if miss then aimPos = aimPos + (hrp.CFrame.RightVector * (math.random() > 0.5 and 8 or -8)) end
    local lockTable = { nil, aimPos, false, c.RotateCam, c.LockOnPrecision }
    rotateAim(c.StartFlickAngle, nil, true, c.RotateCam)
    dashWithDelay(c.SecondFlickDelay)
    rotateAim(c.SecondFlickAngle, nil, true, c.RotateCam)
    if c.LockOn and c.LockOnAfter == "Second Flick" then
        task.wait(c.LockOnDelay)
        watchRagdoll("Heartbeat", 0.4, target, hum, function() rotateAim(unpack(lockTable)) end)
    else
        task.wait(c.ThirdFlickDelay)
        rotateAim(c.ThirdFlickAngle, nil, true, c.RotateCam)
        if c.LockOn and c.LockOnAfter == "Third Flick" then
            task.wait(c.LockOnDelay)
            watchRagdoll("Heartbeat", 0.4, target, hum, function() rotateAim(unpack(lockTable)) end)
        end
    end
    freeRotate()
end

local function techCustomDashV2(target, hrp, hum, miss)
    local c = Settings.AutoTech.Customdashv2
    if c.Jump and RootPart then
        RootPart.AssemblyLinearVelocity = Vector3.new(RootPart.AssemblyLinearVelocity.X, 50, RootPart.AssemblyLinearVelocity.Z)
    end
    local aimPos = targetPos(hrp.Parent)
    if miss then aimPos = aimPos + (hrp.CFrame.RightVector * (math.random() > 0.5 and 8 or -8)) end
    local lockTable = { nil, aimPos, false, c.RotateCam, c.LockOnPrecision }
    rotateAim(c.StartFlickAngle, nil, true, c.RotateCam)
    dashWithDelay(c.SecondFlickDelay)
    if c.SecondFlickDuration > 0 then
        smoothRotateChar(c.SecondFlickAngle, c.SecondFlickDuration)
    else
        rotateAim(c.SecondFlickAngle, nil, true, c.RotateCam)
    end
    if c.LockOn and c.LockOnAfter == "Second Flick" then
        task.wait(c.LockOnDelay)
        watchRagdoll("Heartbeat", 0.4, target, hum, function() rotateAim(unpack(lockTable)) end)
    else
        task.wait(c.ThirdFlickDelay)
        if c.ThirdFlickDuration > 0 then
            smoothRotateChar(c.ThirdFlickAngle, c.ThirdFlickDuration)
        else
            rotateAim(c.ThirdFlickAngle, nil, true, c.RotateCam)
        end
        if c.LockOn and c.LockOnAfter == "Third Flick" then
            task.wait(c.LockOnDelay)
            watchRagdoll("Heartbeat", 0.4, target, hum, function() rotateAim(unpack(lockTable)) end)
        end
    end
    freeRotate()
end

local TECH_HANDLERS = {
    ["Supa"] = techSupa,
    ["Lock On Dash"] = techLockOn,
    ["Loop Dash"] = techLoopDash,
    ["Kiba"] = techKiba,
    ["Loop Dash v2"] = techLoopV2,
    ["Custom Dash"] = techCustomDash,
    ["Custom Dash v2"] = techCustomDashV2,
}

-- Auto Lethal — grave maker + instant lethal shift-lock
local Lethal = { busy = false, armedUntil = 0, highlight = nil }

function Lethal.getTarget(maxDist)
    local best, bestDist = nil, maxDist or 16
    for _, m in ipairs(Live.Live:GetChildren()) do
        if m ~= Character and m:IsA("Model") and not isFriend(playerFromModel(m), true) then
            local root = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local d = (root.Position - RootPart.Position).Magnitude
                if d < bestDist then best, bestDist = m, d end
            end
        end
    end
    if not best then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character ~= Character then
                if not isFriend(plr, true) then
                    local root = plr.Character:FindFirstChild("HumanoidRootPart")
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if root and hum and hum.Health > 0 then
                        local d = (root.Position - RootPart.Position).Magnitude
                        if d < bestDist then best, bestDist = plr.Character, d end
                    end
                end
            end
        end
    end
    return best
end

function Lethal.setHighlight(char)
    if Lethal.highlight then Lethal.highlight:Destroy(); Lethal.highlight = nil end
    if not (char and Settings.AutoLethal.Highlight) then return end
    local hl = Instance.new("Highlight")
    hl.Name = "MingoLethalHL"
    hl.FillColor = Settings.AutoLethal.HighlightColor
    hl.OutlineColor = Settings.AutoLethal.HighlightColor
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char
    hl.Parent = char
    Lethal.highlight = hl
end

local function lethalJump()
    local root = RootPart
    if not root then return end
    local function boost()
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(v.X, 50, v.Z)
    end
    boost()
    local count = 0
    local conn
    conn = RunService.Heartbeat:Connect(function()
        count += 1
        if count > 3 or not root.Parent then conn:Disconnect() return end
        if root.AssemblyLinearVelocity.Y < 35 then boost() end
    end)
end

function Lethal.run(target, miss, graveTrack)
    local c = Settings.AutoLethal
    local hrp = target:FindFirstChild("HumanoidRootPart")
    local hum = target:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return end
    Lethal.setHighlight(target)
    local started = tick()
    if graveTrack then
        local minTiming = math.min(c.GraveTiming, 0)
        repeat RunService.Heartbeat:Wait()
        until not graveTrack.IsPlaying or (graveTrack.Length > 0 and graveTrack.TimePosition >= graveTrack.Length + minTiming) or tick() - started >= 3
        if c.GraveTiming > 0 then task.wait(c.GraveTiming) end
    else
        repeat RunService.Heartbeat:Wait()
        until not (Character and Character:FindFirstChildOfClass("ForceField")) or tick() - started >= 2.5
        task.wait(0.1)
    end
    if not Humanoid or Humanoid.Health <= 0 or hum.Health <= 0 then return end
    if c.Jump then lethalJump() end
    State.freeRotateLocked = true
    rotateAim(c.FirstFlickAngle, nil, true, c.RotateCam)
    local comm = getCommunicate()
    if comm then comm:FireServer(Comms.frontDash) end
    State.frontDashAt = tick()
    dashCooling = true
    task.delay(5, function() dashCooling = false end)
    task.wait(getPing(1000) + 0.05 + c.SecondFlick)
    local lockTick = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - lockTick
        if elapsed > 0.4 or (elapsed > 0.2 and not animPlaying(Anims.frontDash))
            or not hrp.Parent or hum.Health <= 0 or Humanoid.Health <= 0 then
            conn:Disconnect()
            return
        end
        local aimPos = targetPos(hrp.Parent)
        if miss then aimPos = aimPos + (hrp.CFrame.RightVector * (math.random() > 0.5 and 8 or -8)) end
        rotateAim(nil, aimPos, true, c.RotateCam, c.Precision)
    end)
    task.wait(0.4)
    if conn.Connected then conn:Disconnect() end
end

function Lethal.trigger(target, graveTrack)
    if Lethal.busy then return end
    local c = Settings.AutoLethal
    local miss = c.MissChance > 0 and math.random(1, 100) <= c.MissChance
    Lethal.busy = true
    local ok, err = pcall(Lethal.run, target, miss, graveTrack)
    if not ok then warn("[MingoHub] lethal: " .. tostring(err)) end
    State.freeRotateLocked = false
    freeRotate()
    Lethal.setHighlight(nil)
    task.wait(0.3)
    Lethal.busy = false
end

function Lethal.onAnim(track)
    if Unloaded then return end
    local c = Settings.AutoLethal
    local id = track.Animation and track.Animation.AnimationId:match("%d+")
    local isGrave = id == c.GraveAnim
    if not (id == c.HitAnim or (isGrave and c.Grave)) or Lethal.busy then return end
    if not (c.Enabled or tick() < Lethal.armedUntil) then return end
    Lethal.armedUntil = 0
    local target = Lethal.getTarget(20)
    if target then task.spawn(Lethal.trigger, target, isGrave and track or nil) end
end

function Lethal.elapsed()
    if not Animator then return nil end
    for _, t in ipairs(Animator:GetPlayingAnimationTracks()) do
        local id = t.Animation and t.Animation.AnimationId:match("%d+")
        if id == Settings.AutoLethal.HitAnim then return t.TimePosition end
    end
    return nil
end

function Lethal.fire()
    Lethal.armedUntil = tick() + 3
    local isZombie = Character and Character:GetAttribute("Character") == "Zombie"
    pressAndClick(isZombie and Enum.KeyCode.One or Enum.KeyCode.Two)
end

-- =========================================================================
-- Fling
-- =========================================================================
local FlingState = { savedDestroy = nil, busy = false, loopRunning = false }
local DefaultDestroyHeight = workspace.FallenPartsDestroyHeight

local function findFlingTarget()
    local name = tostring(Settings.Player.Fling.Target or ""):match("^%s*(.-)%s*$")
    if name == "" then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and (plr.Name == name or plr.DisplayName == name) then
            return plr.Character
        end
    end
    return nil
end

local function flingTarget(targetChar)
    if not RootPart or not Character or not targetChar then return end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    if FlingState.savedDestroy == nil then
        FlingState.savedDestroy = workspace.FallenPartsDestroyHeight
    end
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    local origCF = RootPart.CFrame
    local startT = tick()
    local n = 0
    while tick() - startT < 1.5 and RootPart and RootPart.Parent and targetRoot.Parent do
        n += 1
        pcall(function()
            local cf = CFrame.new(targetRoot.Position) * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(n * 100), 0, 0)
            RootPart.CFrame = cf
            if Character.PrimaryPart then Character:PivotTo(cf) end
            RootPart.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
            RootPart.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
        end)
        task.wait()
    end
    if RootPart and RootPart.Parent and Character then
        pcall(function()
            RootPart.CFrame = origCF
            if Character.PrimaryPart then Character:PivotTo(origCF) end
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    if FlingState.savedDestroy ~= nil then
        pcall(function() workspace.FallenPartsDestroyHeight = FlingState.savedDestroy end)
        FlingState.savedDestroy = nil
    end
end

local function flingOnce()
    if FlingState.busy then return end
    local t = findFlingTarget()
    if not t then notifySystem("Fling: target not found", 2) return end
    FlingState.busy = true
    pcall(flingTarget, t)
    FlingState.busy = false
end

local function startFlingLoop()
    if FlingState.loopRunning then return end
    FlingState.loopRunning = true
    task.spawn(function()
        while FlingState.loopRunning and Settings.Player.Fling.LoopFling do
            local t = findFlingTarget()
            if t then
                FlingState.busy = true
                pcall(flingTarget, t)
                FlingState.busy = false
            end
            task.wait(0.5)
        end
        FlingState.loopRunning = false
    end)
end

local function stopFlingLoop()
    FlingState.loopRunning = false
    Settings.Player.Fling.LoopFling = false
end

-- =========================================================================
-- Side Dash Assist
-- =========================================================================
local SDA = { busy = false, color = Color3.fromRGB(142, 187, 255) }

function SDA.velocity(inst)
    if inst:IsA("BodyVelocity") then return inst.Velocity end
    if inst:IsA("LinearVelocity") then return inst.VectorVelocity end
    return RootPart and RootPart.AssemblyLinearVelocity or Vector3.zero
end

function SDA.target()
    if not RootPart then return nil end
    local c = Settings.Player.SideDashAssist
    local myPos = RootPart.Position
    local look = RootPart.CFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    flatLook = flatLook.Magnitude > 0 and flatLook.Unit or Vector3.zAxis
    local bestRoot, bestModel, bestScore

    local function check(model)
        if not (model and model ~= Character and model.Parent) then return end
        local root = model:FindFirstChild("HumanoidRootPart")
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not (root and hum and hum.Health > 0) then return end
        local plr = playerFromModel(model)
        if plr == player then return end
        if plr and Settings.Autoblock.FriendCheck and isFriend(plr, false) then return end
        local delta = root.Position - myPos
        local dist = delta.Magnitude
        if dist > c.Range or dist < 0.5 then return end
        local flatDelta = Vector3.new(delta.X, 0, delta.Z)
        local dot = flatDelta.Magnitude > 0 and flatDelta.Unit:Dot(flatLook) or 1
        if dot < -0.25 then return end
        local score = dist * (1.6 - dot * 0.6)
        if not bestScore or score < bestScore then
            bestRoot, bestModel, bestScore = root, model, score
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do check(plr.Character) end
    if Live.Live then
        for _, m in ipairs(Live.Live:GetChildren()) do
            if m:IsA("Model") and not playerFromModel(m) then check(m) end
        end
    end
    return bestRoot, bestModel
end

function SDA.waypoint(myPos, targetPos, targetLook, sideSign, cfg)
    local delta = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
    if delta.Magnitude < 0.1 then return myPos, true, 0 end
    local forward = -delta.Unit
    local perp = Vector3.new(-forward.Z, 0, forward.X) * sideSign
    if cfg.Mode ~= "Behind" then
        local sidePos = myPos + perp * cfg.Offset
        local target = Vector3.new(sidePos.X, targetPos.Y, sidePos.Z)
        return target, false, (target - targetPos).Magnitude
    end
    local behind = Vector3.new(-targetLook.X, 0, -targetLook.Z)
    if behind.Magnitude < 0.1 then behind = delta end
    behind = behind.Unit
    local ideal = Vector3.new(myPos.X, targetPos.Y, myPos.Z) + behind * cfg.Offset
    local angle1 = math.atan2(delta.Z, delta.X)
    local angle2 = math.atan2(behind.Z, behind.X)
    local crossSign = (delta.X * perp.Z - delta.Z * perp.X) >= 0 and 1 or -1
    local angleDiff = ((angle2 - angle1) * crossSign) % (2 * math.pi)
    if angleDiff > math.rad(300) then angleDiff = 0 end
    if angleDiff < math.rad(12) then return ideal, true, (ideal - targetPos).Magnitude end
    local arcAngle = angle1 + math.min(angleDiff, math.rad(70)) * crossSign
    local radius = math.max(cfg.Offset, math.min(delta.Magnitude, cfg.Offset + 6) - 2)
    local arcPos = Vector3.new(myPos.X + math.cos(arcAngle) * radius, targetPos.Y, myPos.Z + math.sin(arcAngle) * radius)
    return arcPos, false, math.max(0, delta.Magnitude - cfg.Offset) + cfg.Offset * angleDiff
end

function SDA.run(dashTag)
    local cfg = Settings.Player.SideDashAssist
    if SDA.busy or not (cfg.Enabled and RootPart and Humanoid and Humanoid.Health > 0) then return end
    RunService.Heartbeat:Wait()
    if animPlaying(Anims.backDash) or not (dashTag and dashTag.Parent) then return end
    local right = animPlaying(Anims.rsideDash)
    local left = animPlaying(Anims.lsideDash)
    if right == left then
        local back = UIS:IsKeyDown(KeyS)
        right = UIS:IsKeyDown(KeyD) and not back
        left = UIS:IsKeyDown(KeyA) and not back
        if right == left then return end
    end
    local tRoot, tModel = SDA.target()
    if not (tRoot and RootPart) then return end
    SDA.busy = true
    if cfg.Highlight then State.mark("sda", tModel, SDA.color) end
    local sideSign = right and 1 or -1
    if dashTag and dashTag.Parent then dashTag:Destroy() end
    local bv = Instance.new("BodyVelocity")
    bv.Name = "MingoSDA"
    bv.MaxForce = Vector3.new(50000, 0, 50000)
    bv.P = 4000
    bv.Velocity = Vector3.zero
    bv.Parent = RootPart
    local started = tick()
    local phase2
    local duration
    local direction
    do
        local v = RootPart.AssemblyLinearVelocity
        local flat = Vector3.new(v.X, 0, v.Z)
        if flat.Magnitude > 5 then direction = flat.Unit end
    end
    local steppedConn
    local yaw, _ = RootPart.CFrame:ToOrientation()
    local facingName = "MingoSDAFace"
    local function cleanup()
        if steppedConn then steppedConn:Disconnect() end
        unbindRender(facingName)
        if bv.Parent then bv:Destroy() end
        SDA.busy = false
        freeRotate()
    end
    bindRender(facingName, Enum.RenderPriority.Camera.Value + 1, function(dt)
        local r = RootPart
        if r ~= RootPart or not (r and r.Parent and tRoot.Parent) or isCCFrozen() then return end
        local delta = tRoot.Position - r.Position
        if Vector3.new(delta.X, 0, delta.Z).Magnitude < 0.5 then return end
        local step = math.min(dt, 0.1) * 60
        if cfg.FaceTarget then
            local targetYaw = math.atan2(-delta.X, -delta.Z)
            local smooth = math.atan2(math.sin(targetYaw - yaw), math.cos(targetYaw - yaw))
            yaw = yaw + smooth * (1 - (1 - (phase2 and 0.5 or 0.3))^step)
            if Humanoid then Humanoid.AutoRotate = false end
            r.CFrame = CFrame.new(r.Position) * CFrame.Angles(0, yaw, 0)
        end
        if cfg.RotateCam then
            rotateAim(0, tRoot.Position, false, false, 1 - (1 - 0.25)^step)
        end
    end)
    steppedConn = RunService.Stepped:Connect(function(_, dt)
        local r = RootPart
        if Unloaded or not (r and r.Parent and tRoot.Parent and Humanoid and Humanoid.Health > 0)
            or isCCFrozen() or tick() - started > ((duration and duration + 0.3) or 1)
            or (not phase2 and not bv.Parent) then
            cleanup()
            return
        end
        local target = tRoot.Position
        if phase2 then
            if tick() - phase2 > 0.3 then cleanup() end
            return
        end
        if cfg.Predict then
            local v = tRoot.AssemblyLinearVelocity
            local eta = math.min((target - r.Position).Magnitude / 60, 0.3)
            target = target + Vector3.new(v.X, 0, v.Z) * eta
        end
        local waypoint, arrived, travel = SDA.waypoint(r.Position, target, tRoot.CFrame.LookVector, sideSign, cfg)
        local moveDir = Vector3.new(waypoint.X - r.Position.X, 0, waypoint.Z - r.Position.Z)
        local elapsed = tick() - started
        duration = duration or math.clamp(travel / 45, 0.3, 0.55) / math.clamp(cfg.Speed, 0.5, 2)
        local remaining = math.max(duration - elapsed, 0.06)
        local speed = math.clamp(2 * travel / remaining, 12, 120)
        if (arrived or cfg.Mode ~= "Behind") and moveDir.Magnitude <= math.max(1.2, speed * dt * 1.2) then
            bv:Destroy()
            local v = r.AssemblyLinearVelocity
            r.AssemblyLinearVelocity = Vector3.new(v.X * 0.25, v.Y, v.Z * 0.25)
            phase2 = tick()
            return
        end
        if moveDir.Magnitude < 0.05 then return end
        local unit = moveDir.Unit
        if direction then
            local lerp = 1 - (1 - math.clamp(cfg.Strength, 0.05, 1))^(math.min(dt, 0.1) * 60)
            local blended = direction:Lerp(unit, lerp)
            direction = blended.Magnitude > 0.05 and blended.Unit or unit
        else
            direction = unit
        end
        bv.Velocity = direction * speed
    end)
end

-- background highlight watcher for SDA target
task.spawn(function()
    while not Unloaded do
        task.wait(0.1)
        local cfg = Settings.Player.SideDashAssist
        if not SDA.busy then
            local tModel
            if cfg.Enabled and cfg.Highlight and Humanoid and Humanoid.Health > 0 then
                local _, m = SDA.target()
                tModel = m
            end
            State.mark("sda", tModel, SDA.color)
        end
    end
end)

-- Highlight marks helper
function State.mark(key, model, color)
    local h = State.marks[key]
    if not model then
        if h then h:Destroy() State.marks[key] = nil end
        return
    end
    if not (h and h.Parent) then
        h = Instance.new("Highlight")
        h.Name = "MingoMark_" .. key
        h.FillTransparency = 0.6
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        State.marks[key] = h
    end
    h.FillColor = color or Color3.new(1, 1, 1)
    h.OutlineColor = color or Color3.new(1, 1, 1)
    if h.Adornee ~= model then h.Adornee = model end
    if h.Parent ~= model then h.Parent = model end
end

-- =========================================================================
-- Lock-on
-- =========================================================================
local LockOn = { conn = nil, hrp = nil, human = nil }

function LockOn.valid(model)
    if not (model and model.Parent and model ~= Character) then return nil end
    local root = model:FindFirstChild("HumanoidRootPart")
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not (root and hum and hum.Health > 0) then return nil end
    local plr = playerFromModel(model)
    if plr then
        if plr == player then return nil end
        if Settings.Autoblock.FriendCheck and isFriend(plr, false) then return nil end
    elseif not Settings.Player.LockOn.Dummies then
        return nil
    end
    return root, hum
end

function LockOn.targetPart(model)
    if not model then return nil end
    local c = Settings.Player.LockOn
    if c.TargetPart == "Head" then return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") end
    if c.TargetPart == "Torso" then return model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart") end
    return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head")
end

function LockOn.pick(exclude)
    if not RootPart then return nil end
    local c = Settings.Player.LockOn
    local mousePos = UIS:GetMouseLocation()
    local best, bestHum, bestScore
    local function check(model)
        if model == exclude then return end
        local root, hum = LockOn.valid(model)
        if not root then return end
        local part = LockOn.targetPart(model) or root
        local dist = (part.Position - RootPart.Position).Magnitude
        if dist > c.MaxDist then return end
        local score = dist
        if c.Mode == "Mouse" then
            local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then return end
            score = (Vector2.new(screen.X, screen.Y) - mousePos).Magnitude
            if score > c.FOV then return end
        end
        if not bestScore or score < bestScore then
            best, bestHum, bestScore = root, hum, score
        end
    end
    for _, plr in ipairs(Players:GetPlayers()) do check(plr.Character) end
    if Live.Live and c.Dummies then
        for _, m in ipairs(Live.Live:GetChildren()) do
            if m:IsA("Model") and not playerFromModel(m) then check(m) end
        end
    end
    return best, bestHum
end

function LockOn.stop()
    if LockOn.conn then LockOn.conn:Disconnect() LockOn.conn = nil end
    LockOn.hrp = nil LockOn.human = nil
    State.mark("lockon", nil)
    freeRotate()
end

function LockOn.start()
    local root, hum = LockOn.pick()
    if not root then
        notifySystem("Lock On: no target in range", 2)
        return
    end
    LockOn.hrp, LockOn.human = root, hum
    local c = Settings.Player.LockOn
    LockOn.conn = RunService.Heartbeat:Connect(function(dt)
        local hrp, human = LockOn.hrp, LockOn.human
        local lost = not (hrp and hrp.Parent and human and human.Health > 0 and RootPart)
            or (hrp.Position - RootPart.Position).Magnitude > c.MaxDist * 1.5
        if lost then
            if c.Switch and RootPart then
                local r, h = LockOn.pick(hrp and hrp.Parent)
                if r then LockOn.hrp, LockOn.human = r, h return end
            end
            LockOn.stop()
            return
        end
        if c.Highlight then
            State.mark("lockon", hrp.Parent, Color3.fromRGB(255, 60, 60))
        else
            State.mark("lockon", nil)
        end
        local delta = hrp.Position - RootPart.Position
        if Vector3.new(delta.X, 0, delta.Z).Magnitude < 1.5 then return end
        local precision = c.Precision
        if precision < 1 then
            precision = 1 - (1 - precision)^(math.min(dt, 0.1) * 60)
        end
        local part = LockOn.targetPart(hrp.Parent) or hrp
        local aimPos = part.Position
        if c.Predict > 0 then
            local v = hrp.AssemblyLinearVelocity
            local eta = c.Predict / 100 + getPing(1000) * 0.5
            aimPos = aimPos + Vector3.new(v.X, v.Y * 0.4, v.Z) * eta
        end
        if isCCFrozen() then
            if c.Cam then rotateAim(0, aimPos, false, false, precision) end
            return
        end
        if c.FaceChar and c.Cam then
            rotateAim(nil, aimPos, false, true, precision)
        elseif c.FaceChar then
            rotateAim(nil, aimPos, true, false, precision)
        elseif c.Cam then
            rotateAim(0, aimPos, false, false, precision)
        end
    end)
end

-- =========================================================================
-- ESP
-- =========================================================================
local BoxESP = { entries = {}, gui = nil, conn = nil }

function BoxESP.getGui()
    if BoxESP.gui and BoxESP.gui.Parent then return BoxESP.gui end
    local g = Instance.new("ScreenGui")
    g.Name = "MingoBoxes"
    g.ResetOnSpawn = false
    g.IgnoreGuiInset = true
    g.DisplayOrder = 10
    local ok = pcall(function() g.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
    if not ok or not g.Parent then g.Parent = PlayerGui end
    BoxESP.gui = g
    return g
end

function BoxESP.bounds(model, cam, hrp)
    local wcf = hrp.CFrame
    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local abs = math.abs
    for _, p in ipairs(model:GetChildren()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            local w, h = wcf:ToObjectSpace(p.CFrame), p.Size / 2
            local xV, yV, zV, pos = w.XVector, w.YVector, w.ZVector, w.Position
            local ex = abs(xV.X) * h.X + abs(yV.X) * h.Y + abs(zV.X) * h.Z
            local ey = abs(xV.Y) * h.X + abs(yV.Y) * h.Y + abs(zV.Y) * h.Z
            local ez = abs(xV.Z) * h.X + abs(yV.Z) * h.Y + abs(zV.Z) * h.Z
            minX = math.min(minX, pos.X - ex) maxX = math.max(maxX, pos.X + ex)
            minY = math.min(minY, pos.Y - ey) maxY = math.max(maxY, pos.Y + ey)
            minZ = math.min(minZ, pos.Z - ez) maxZ = math.max(maxZ, pos.Z + ez)
        end
    end
    if minX == math.huge then return nil end
    local sX, sY, sW, sH = math.huge, math.huge, -math.huge, -math.huge
    local visible = false
    for i = 0, 7 do
        local corner = Vector3.new(
            (i % 2 == 0) and minX or maxX,
            (i % 4 < 2) and minY or maxY,
            (i < 4) and minZ or maxZ
        )
        local vp = cam:WorldToViewportPoint(wcf:PointToWorldSpace(corner))
        if vp.Z > 0 then
            visible = true
            sX = math.min(sX, vp.X) sY = math.min(sY, vp.Y)
            sW = math.max(sW, vp.X) sH = math.max(sH, vp.Y)
        end
    end
    if not visible then return nil end
    return math.floor(sX + 0.5), math.floor(sY + 0.5), math.floor(sW - sX + 0.5), math.floor(sH - sY + 0.5)
end

local function makeRing(parent, color)
    local lines = {}
    for i = 1, 4 do
        local f = Instance.new("Frame")
        f.BorderSizePixel = 0
        f.BackgroundColor3 = color
        f.Parent = parent
        lines[i] = f
    end
    return lines
end

local function placeRing(lines, inset, thick, totalW, totalH)
    lines[1].Position = UDim2.fromOffset(inset, inset)
    lines[1].Size = UDim2.fromOffset(totalW - 2*inset, thick)
    lines[2].Position = UDim2.fromOffset(inset, totalH - inset - thick)
    lines[2].Size = UDim2.fromOffset(totalW - 2*inset, thick)
    lines[3].Position = UDim2.fromOffset(inset, inset + thick)
    lines[3].Size = UDim2.fromOffset(thick, totalH - 2*inset - 2*thick)
    lines[4].Position = UDim2.fromOffset(totalW - inset - thick, inset + thick)
    lines[4].Size = UDim2.fromOffset(thick, totalH - 2*inset - 2*thick)
end

function BoxESP.set(model, color)
    local e = BoxESP.entries[model]
    if not e then
        local root = Instance.new("Frame")
        root.BackgroundTransparency = 1
        root.BorderSizePixel = 0
        root.Visible = false
        local fill = Instance.new("Frame")
        fill.BorderSizePixel = 0
        fill.Parent = root
        e = {
            root = root, fill = fill,
            outer = makeRing(root, Color3.new(0,0,0)),
            main = makeRing(root, color),
            inner = makeRing(root, Color3.new(0,0,0)),
        }
        root.Parent = BoxESP.getGui()
        BoxESP.entries[model] = e
    end
    e.thick = math.clamp(math.floor(Settings.ESP.BoxThickness + 0.5), 1, 6)
    e.key = nil
    for _, line in ipairs(e.main) do line.BackgroundColor3 = color end
    e.fill.BackgroundColor3 = color
    e.fill.BackgroundTransparency = Settings.ESP.BoxFilled and 0.85 or 1
    if not BoxESP.conn then
        BoxESP.conn = RunService.RenderStepped:Connect(BoxESP.step)
    end
end

function BoxESP.step()
    local cam = Camera
    if not cam then return end
    local camPos = cam.CFrame.Position
    for model, e in pairs(BoxESP.entries) do
        local hrp = model.Parent and model:FindFirstChild("HumanoidRootPart")
        local hum = hrp and model:FindFirstChildOfClass("Humanoid")
        if not hrp then
            pcall(function() e.root:Destroy() end)
            BoxESP.entries[model] = nil
        elseif hum and hum.Health <= 0 then
            e.root.Visible = false
        else
            local pos = hrp.Position
            local dx, dy, dz = pos.X - camPos.X, pos.Y - camPos.Y, pos.Z - camPos.Z
            if dx*dx + dy*dy + dz*dz > 40000 then
                e.root.Visible = false
            else
                local sx, sy, sw, sh = BoxESP.bounds(model, cam, hrp)
                if sx and sw >= 4 and sh >= 4 then
                    local thick = e.thick
                    local inset = thick + 2
                    local totalW, totalH = sw + 2*inset, sh + 2*inset
                    e.root.Position = UDim2.fromOffset(sx - inset, sy - inset)
                    e.root.Size = UDim2.fromOffset(totalW, totalH)
                    placeRing(e.outer, 0, 1, totalW, totalH)
                    placeRing(e.main, 1, thick, totalW, totalH)
                    placeRing(e.inner, 1 + thick, 1, totalW, totalH)
                    e.fill.Position = UDim2.fromOffset(inset, inset)
                    e.fill.Size = UDim2.fromOffset(sw, sh)
                    e.root.Visible = true
                else
                    e.root.Visible = false
                end
            end
        end
    end
end

function BoxESP.remove(model)
    local e = BoxESP.entries[model]
    if e then e.root:Destroy() BoxESP.entries[model] = nil end
    if BoxESP.conn and not next(BoxESP.entries) then
        BoxESP.conn:Disconnect() BoxESP.conn = nil
    end
end

-- ESP color resolver
local function rgb3(c) return Color3.fromRGB(c[1] or 0, c[2] or 0, c[3] or 0) end
local function storeRGB(c) return {math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5)} end

local function espColorFor(plr, char)
    local esp = Settings.ESP
    if char and char:FindFirstChild("Counter") then return rgb3(esp.DeathCounterColor) end
    if char and char:GetAttribute("Ulted") then
        if char:GetAttribute("Character") == "Bald" then return rgb3(esp.SaitamaUltColor) end
        return rgb3(esp.UltColor)
    end
    local rel = PlayerRelations[plr and plr.Name]
    if rel == "friend" then return rgb3(esp.FriendColor) end
    if rel == "enemy" then return rgb3(esp.EnemyColor) end
    return rgb3(esp.NeutralColor)
end

local function drawESP(plr, char, override)
    local esp = Settings.ESP
    if not (esp.Enabled or ((esp.DeathCounterESP or esp.SaitamaUltESP) and override)) then return end
    if not char or not char.Parent then return end
    local color = espColorFor(plr, char)

    local existingHL = char:FindFirstChild("MingoESP")
    if existingHL then task.defer(existingHL.Destroy, existingHL) end
    if esp.Highlight then
        pcall(function()
            local hl = Instance.new("Highlight")
            hl.Name = "MingoESP"
            hl.FillTransparency = math.clamp(esp.OutlineTransparency, 0, 100) / 100
            hl.FillColor = color
            hl.OutlineTransparency = 1
            hl.Parent = char
        end)
    end

    if esp.Boxes then
        local boxColor = esp.TeamColors and color or (esp.CustomBoxColor and rgb3(esp.CustomBoxColorValue) or color)
        BoxESP.set(char, boxColor)
    else
        BoxESP.remove(char)
    end

    local head = char:FindFirstChild("Head")
    if not (head and esp.NameUltText) then return end
    pcall(function()
        local bb = head:FindFirstChild("MingoTag") or Instance.new("BillboardGui", head)
        local lbl = bb:FindFirstChild("TextLabel") or Instance.new("TextLabel", bb)
        bb.Name = "MingoTag"
        bb.Size = UDim2.fromScale(10, 2)
        bb.StudsOffset = Vector3.new(0, 4, 0)
        bb.AlwaysOnTop = true
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.TextScaled = true
        lbl.Font = Enum.Font.RobotoMono
        lbl.TextColor3 = color
        lbl.BackgroundTransparency = 1
        lbl.TextStrokeTransparency = 0.3
        local charAttr = char:GetAttribute("Character") or "Other"
        local ultName = CharacterNames[charAttr] or "Other"
        local pct = math.floor((plr and plr:GetAttribute("Ultimate")) or 0)
        local suffix = ""
        if esp.DeathCounterESP and char:FindFirstChild("Counter") then suffix = " [DC]" end
        if esp.SaitamaUltESP and char:GetAttribute("Ulted") and charAttr == "Bald" then
            suffix = " [SAITAMA ULT]"
        elseif char:GetAttribute("Ulted") then
            suffix = " [ULT]"
        end
        lbl.Text = ultName .. " " .. pct .. "% Ult\n" .. (plr and plr.Name or char.Name) .. suffix
    end)
end

local function clearESPFrom(char)
    if not char then return end
    local hl = char:FindFirstChild("MingoESP")
    if hl then hl:Destroy() end
    local head = char:FindFirstChild("Head")
    if head then
        local tag = head:FindFirstChild("MingoTag")
        if tag then tag:Destroy() end
    end
    BoxESP.remove(char)
end

local espConn
local espTick = 0
local function setESP(on)
    if on then
        if not espConn then
            espTick = 0
            espConn = RunService.RenderStepped:Connect(function(dt)
                espTick += dt
                if espTick < 0.12 then return end
                espTick = 0
                for _, plr in ipairs(Players:GetChildren()) do
                    if plr ~= player and plr.Character then
                        drawESP(plr, plr.Character)
                    end
                end
            end)
        end
    else
        if espConn then espConn:Disconnect() espConn = nil end
        for _, plr in ipairs(Players:GetChildren()) do
            if plr ~= player and plr.Character then clearESPFrom(plr.Character) end
        end
    end
end

-- =========================================================================
-- Motion blur / sky / atmosphere / anti-lag
-- =========================================================================
local MotionBlur = { blur = nil, conn = nil, last = nil, current = 0 }

function MotionBlur.getBlur()
    if MotionBlur.blur and MotionBlur.blur.Parent then return MotionBlur.blur end
    local b = Lighting:FindFirstChild("MingoBlur")
    if not (b and b:IsA("BlurEffect")) then
        b = Instance.new("BlurEffect")
        b.Name = "MingoBlur"
    end
    b.Size = 0
    b.Parent = Lighting
    MotionBlur.blur = b
    return b
end

function MotionBlur.step(dt)
    local cam = Camera
    if not cam then return end
    local cf = cam.CFrame
    if not MotionBlur.last then MotionBlur.last = cf return end
    local last = MotionBlur.last
    local dot = math.clamp(last.LookVector:Dot(cf.LookVector), -1, 1)
    local angleRate = dt > 0 and (math.acos(dot) / dt) or 0
    local moveSpeed = dt > 0 and ((cf.Position - last.Position).Magnitude / dt) or 0
    local intensity = math.clamp(tonumber(Settings.Visuals.MotionBlurIntensity) or 9, 1, 30)
    local rotBlur = angleRate * 1.5 * (intensity / 10)
    local speedBlur = math.max(0, (moveSpeed - 20) * 0.04)
    local target = math.clamp(rotBlur + speedBlur, 0, intensity)
    local alpha = math.clamp(dt * 15, 0, 1)
    MotionBlur.current += (target - MotionBlur.current) * alpha
    if MotionBlur.current < 0.05 then MotionBlur.current = 0 end
    MotionBlur.getBlur().Size = MotionBlur.current
    MotionBlur.last = cf
end

function MotionBlur.set(on)
    if MotionBlur.conn then MotionBlur.conn:Disconnect() MotionBlur.conn = nil end
    MotionBlur.last = nil
    MotionBlur.current = 0
    if on then
        MotionBlur.getBlur().Size = 0
        MotionBlur.conn = RunService.RenderStepped:Connect(MotionBlur.step)
    else
        if MotionBlur.blur then pcall(function() MotionBlur.blur:Destroy() end) MotionBlur.blur = nil end
        local b = Lighting:FindFirstChild("MingoBlur")
        if b then pcall(function() b:Destroy() end) end
    end
end

-- Sky presets
local SKY_PRESETS = {
    ["Blood Moon"] = { Ambient = Color3.fromRGB(60, 10, 16), OutdoorAmbient = Color3.fromRGB(90, 20, 28), FogColor = Color3.fromRGB(70, 16, 24), FogEnd = 400, Brightness = 0.7, ClockTime = 22 },
    ["Night"]      = { Ambient = Color3.fromRGB(14, 16, 30), OutdoorAmbient = Color3.fromRGB(18, 20, 38), FogColor = Color3.fromRGB(10, 12, 24), FogEnd = 500, Brightness = 0.5, ClockTime = 0 },
    ["Sunset"]     = { Ambient = Color3.fromRGB(80, 45, 30), OutdoorAmbient = Color3.fromRGB(150, 85, 55), FogColor = Color3.fromRGB(120, 70, 45), FogEnd = 600, Brightness = 1.2, ClockTime = 17.5 },
    ["Dawn"]       = { Ambient = Color3.fromRGB(70, 60, 80), OutdoorAmbient = Color3.fromRGB(110, 100, 130), FogColor = Color3.fromRGB(90, 80, 110), FogEnd = 600, Brightness = 1.0, ClockTime = 6 },
}
local skySnapshot, skyInst, skyMade = nil, nil, false

local function applySky()
    local s = Settings.Visuals.CustomSky
    if not s.Enabled then return end
    if not skySnapshot then
        skySnapshot = {
            Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
            FogColor = Lighting.FogColor, FogStart = Lighting.FogStart, FogEnd = Lighting.FogEnd,
            Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
        }
    end
    local p = SKY_PRESETS[s.Preset] or SKY_PRESETS["Blood Moon"]
    Lighting.Ambient = p.Ambient
    Lighting.OutdoorAmbient = p.OutdoorAmbient
    Lighting.FogColor = p.FogColor
    Lighting.FogEnd = p.FogEnd
    Lighting.Brightness = p.Brightness
    Lighting.ClockTime = p.ClockTime
    if not skyInst then
        skyInst = Lighting:FindFirstChildOfClass("Sky")
        if not skyInst then
            skyInst = Instance.new("Sky")
            skyInst.Name = "MingoCustomSky"
            skyInst.Parent = Lighting
            skyMade = true
        end
    end
    pcall(function() skyInst.StarCount = tonumber(s.Stars) or 0 end)
    local id = tostring(s.SkyboxId or ""):match("%d+")
    if id then
        for _, face in ipairs({"SkyboxBk","SkyboxDn","SkyboxFt","SkyboxLf","SkyboxRt","SkyboxUp"}) do
            pcall(function() skyInst[face] = "rbxassetid://" .. id end)
        end
    end
end

local function setSky(on)
    Settings.Visuals.CustomSky.Enabled = on and true or false
    if on then
        applySky()
    else
        if skySnapshot then
            pcall(function()
                Lighting.Ambient = skySnapshot.Ambient
                Lighting.OutdoorAmbient = skySnapshot.OutdoorAmbient
                Lighting.FogColor = skySnapshot.FogColor
                Lighting.FogStart = skySnapshot.FogStart
                Lighting.FogEnd = skySnapshot.FogEnd
                Lighting.Brightness = skySnapshot.Brightness
                Lighting.ClockTime = skySnapshot.ClockTime
            end)
            skySnapshot = nil
        end
        if skyMade and skyInst then pcall(function() skyInst:Destroy() end) end
        skyInst, skyMade = nil, false
    end
end

-- Atmosphere
local atmSnapshot = { exists = false }
local atmInst, atmMade = nil, false

local function applyAtmosphere()
    local s = Settings.Visuals.CustomAtmosphere
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if not atm then
        atm = Instance.new("Atmosphere")
        atm.Name = "MingoAtmosphere"
        atm.Parent = Lighting
        atmMade = true
    elseif not atmSnapshot.exists then
        atmSnapshot.exists = true
        atmSnapshot.Density = atm.Density
        atmSnapshot.Offset = atm.Offset
        atmSnapshot.Color = atm.Color
        atmSnapshot.Decay = atm.DecayColor
        atmSnapshot.Glare = atm.Glare
        atmSnapshot.Haze = atm.Haze
    end
    atmInst = atm
    pcall(function()
        atm.Density = math.clamp(tonumber(s.Density) or 35, 0, 100) / 100
        atm.Color = rgb3(s.Color)
        atm.DecayColor = rgb3(s.Decay)
        atm.Haze = math.clamp(tonumber(s.Haze) or 0, 0, 100) / 10
        atm.Glare = math.clamp(tonumber(s.Glare) or 0, 0, 100) / 100
    end)
end

local function setAtmosphere(on)
    Settings.Visuals.CustomAtmosphere.Enabled = on and true or false
    if on then
        applyAtmosphere()
    else
        if atmInst and atmInst.Parent then
            if atmSnapshot.exists then
                pcall(function()
                    atmInst.Density = atmSnapshot.Density
                    atmInst.Offset = atmSnapshot.Offset
                    atmInst.Color = atmSnapshot.Color
                    atmInst.DecayColor = atmSnapshot.Decay
                    atmInst.Glare = atmSnapshot.Glare
                    atmInst.Haze = atmSnapshot.Haze
                end)
                atmSnapshot.exists = false
            elseif atmMade then
                pcall(function() atmInst:Destroy() end)
            end
        end
        atmInst, atmMade = nil, false
    end
end

-- Anti-lag (textures/effects/shadows stripped)
local AntiLag = { active = false, textures = {}, effects = {}, mats = {}, partSet = setmetatable({}, {__mode="k"}), lighting = nil, cc = nil, conns = {} }

local function isCharPart(part)
    local model = part:FindFirstAncestorOfClass("Model")
    if not model then return false end
    if model:FindFirstChildOfClass("Humanoid") then return true end
    local ok, plr = pcall(function() return Players:GetPlayerFromCharacter(model) end)
    return ok and plr ~= nil
end

local function stripPart(part)
    if AntiLag.partSet[part] or isCharPart(part) then return end
    AntiLag.partSet[part] = true
    table.insert(AntiLag.mats, {inst=part, material=part.Material, castShadow=part.CastShadow, reflectance=part.Reflectance})
    pcall(function()
        part.Material = Enum.Material.SmoothPlastic
        part.CastShadow = false
        part.Reflectance = 0
        if part:IsA("MeshPart") then part.TextureID = "" end
    end)
end

local function stripInstance(inst)
    if not AntiLag.active then return end
    local cls = inst.ClassName
    if cls == "Decal" or cls == "Texture" then
        local ok, tex = pcall(function() return inst.Texture end)
        if ok and tex ~= "" then
            table.insert(AntiLag.textures, {inst=inst, prop="Texture", old=tex})
            pcall(function() inst.Texture = "" end)
        end
    elseif cls == "MeshPart" then
        local ok, tex = pcall(function() return inst.TextureID end)
        if ok and tex ~= "" then
            table.insert(AntiLag.textures, {inst=inst, prop="TextureID", old=tex})
            pcall(function() inst.TextureID = "" end)
        end
    elseif cls == "ParticleEmitter" or cls == "Smoke" or cls == "Fire" or cls == "Sparkles"
        or cls == "Beam" or cls == "Trail" or cls == "Highlight"
        or cls == "PointLight" or cls == "SpotLight" or cls == "SurfaceLight" then
        local ok, en = pcall(function() return inst.Enabled end)
        if ok and en then
            table.insert(AntiLag.effects, inst)
            pcall(function() inst.Enabled = false end)
        end
    end
    if inst:IsA("BasePart") then stripPart(inst) end
end

local function applyGrayLighting()
    local L = Lighting
    AntiLag.lighting = {
        Ambient=L.Ambient, OutdoorAmbient=L.OutdoorAmbient, Brightness=L.Brightness,
        ClockTime=L.ClockTime, FogColor=L.FogColor, FogStart=L.FogStart, FogEnd=L.FogEnd,
        GlobalShadows=L.GlobalShadows,
    }
    L.Ambient = Color3.fromRGB(72, 74, 84)
    L.OutdoorAmbient = Color3.fromRGB(84, 88, 100)
    L.Brightness = 1.1
    L.ClockTime = 14
    L.FogColor = Color3.fromRGB(104, 106, 118)
    L.FogStart = 0
    L.FogEnd = 100000
    L.GlobalShadows = false
    for _, eff in ipairs(L:GetChildren()) do
        if eff:IsA("PostEffect") and eff.Name ~= "MingoBlur" and eff.Name ~= "MingoAntiLagGray" then
            if eff.Enabled then
                table.insert(AntiLag.effects, eff)
                pcall(function() eff.Enabled = false end)
            end
        end
    end
    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "MingoAntiLagGray"
    cc.Brightness = 0 cc.Contrast = 0 cc.Saturation = -0.5
    cc.TintColor = Color3.fromRGB(225, 228, 238)
    cc.Parent = L
    AntiLag.cc = cc
end

local function restoreAntiLag()
    for _, r in ipairs(AntiLag.textures) do pcall(function() r.inst[r.prop] = r.old end) end
    for _, e in ipairs(AntiLag.effects) do pcall(function() e.Enabled = true end) end
    for _, r in ipairs(AntiLag.mats) do
        pcall(function()
            r.inst.Material = r.material
            r.inst.CastShadow = r.castShadow
            r.inst.Reflectance = r.reflectance
        end)
    end
    AntiLag.mats = {}
    AntiLag.partSet = setmetatable({}, {__mode="k"})
    if AntiLag.cc then pcall(function() AntiLag.cc:Destroy() end) AntiLag.cc = nil end
    if AntiLag.lighting then
        for k, v in pairs(AntiLag.lighting) do pcall(function() Lighting[k] = v end) end
        AntiLag.lighting = nil
    end
    AntiLag.textures, AntiLag.effects = {}, {}
end

local function setAntiLag(on, silent)
    on = on and true or false
    Settings.Visuals.AntiLag = on
    if on == AntiLag.active then return end
    AntiLag.active = on
    if on then
        AntiLag.textures, AntiLag.effects, AntiLag.mats = {}, {}, {}
        AntiLag.partSet = setmetatable({}, {__mode="k"})
        applyGrayLighting()
        for _, inst in ipairs(workspace:GetDescendants()) do stripInstance(inst) end
        for _, inst in ipairs(Lighting:GetDescendants()) do stripInstance(inst) end
        table.insert(AntiLag.conns, workspace.DescendantAdded:Connect(stripInstance))
        table.insert(AntiLag.conns, Lighting.DescendantAdded:Connect(stripInstance))
    else
        for _, c in ipairs(AntiLag.conns) do pcall(function() c:Disconnect() end) end
        AntiLag.conns = {}
        restoreAntiLag()
    end
    if not silent then notifySystem(on and "Anti-Lag on" or "Anti-Lag off", 2) end
end

-- =========================================================================
-- Self Chams
-- =========================================================================
local Chams = { highlight = nil, mats = {} }

local function restoreChams()
    for part, rec in pairs(Chams.mats) do
        if part and part.Parent then
            pcall(function()
                part.Material = rec[1]
                part.Color = rec[2]
            end)
        end
    end
    table.clear(Chams.mats)
end

local function applySelfChams()
    local c = Character or (player and player.Character)
    if not (Settings.Visuals.SelfChams.Enabled and c and c.Parent) then
        if Chams.highlight then pcall(function() Chams.highlight:Destroy() end) Chams.highlight = nil end
        restoreChams()
        return
    end
    local color = Settings.Visuals.SelfChams.Color
    if not (Chams.highlight and Chams.highlight.Parent == c) then
        if Chams.highlight then pcall(function() Chams.highlight:Destroy() end) end
        Chams.highlight = Instance.new("Highlight")
        Chams.highlight.Name = "MingoSelfChams"
        Chams.highlight.Adornee = c
        Chams.highlight.Parent = c
    end
    Chams.highlight.FillColor = color
    Chams.highlight.OutlineColor = color
    Chams.highlight.FillTransparency = Settings.Visuals.SelfChams.FillTransparency
    Chams.highlight.OutlineTransparency = Settings.Visuals.SelfChams.OutlineTransparency
    Chams.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    local matName = Settings.Visuals.SelfChams.Material
    if matName and matName ~= "None" then
        local mat = Enum.Material[matName] or Enum.Material.ForceField
        for _, part in ipairs(c:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not part:FindFirstAncestorWhichIsA("Tool") then
                if not Chams.mats[part] then
                    Chams.mats[part] = {part.Material, part.Color}
                end
                part.Material = mat
                part.Color = color
            end
        end
    else
        restoreChams()
    end
end

-- =========================================================================
-- Headless + Korblox
-- =========================================================================
local function applyHeadless(char)
    char = char or Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    local face = head and head:FindFirstChild("face")
    local t = Settings.Player.Headless and 1 or 0
    if head then head.Transparency = t end
    if face then face.Transparency = t end
end

local korbloxOriginals = setmetatable({}, {__mode="k"})
local korbloxApplied = setmetatable({}, {__mode="k"})

local function applyKorblox(char)
    char = char or Character
    if not char then return end
    local on = Settings.Player.Korblox
    local upper = char:FindFirstChild("RightUpperLeg")
    local lower = char:FindFirstChild("RightLowerLeg")
    local foot = char:FindFirstChild("RightFoot")
    if upper and lower and foot and upper:IsA("MeshPart") then
        if on and not korbloxApplied[upper] then
            local ok = pcall(function()
                for _, p in ipairs({upper, lower, foot}) do
                    if not korbloxOriginals[p] then
                        korbloxOriginals[p] = {mesh=p.MeshId, tex=p.TextureID, transparency=p.Transparency}
                    end
                end
                lower.MeshId = "rbxassetid://902942093"
                upper.MeshId = "rbxassetid://902942096"
                foot.MeshId = "rbxassetid://902942089"
                upper.TextureID = "rbxassetid://902843398"
                lower.Transparency = 1
                foot.Transparency = 1
            end)
            if ok then korbloxApplied[upper] = true end
        elseif (not on) and korbloxApplied[upper] then
            pcall(function()
                for _, p in ipairs({upper, lower, foot}) do
                    local o = korbloxOriginals[p]
                    if o then
                        p.MeshId = o.mesh
                        p.TextureID = o.tex
                        p.Transparency = o.transparency
                    end
                end
            end)
            korbloxApplied[upper] = nil
        end
    end
    if char:FindFirstChild("Right Leg") then
        local existing = char:FindFirstChild("MingoKorblox")
        if on and not existing then
            pcall(function()
                local cm = Instance.new("CharacterMesh")
                cm.Name = "MingoKorblox"
                cm.BodyPart = Enum.BodyPart.RightLeg
                cm.MeshId = 101851696
                cm.OverlayTextureId = 101851254
                cm.Parent = char
            end)
        elseif (not on) and existing then
            existing:Destroy()
        end
    end
end

-- =========================================================================
-- Anti-fling
-- =========================================================================
local antiFlingConn
local function setAntiFling(on)
    if antiFlingConn then antiFlingConn:Disconnect() antiFlingConn = nil end
    if not on then return end
    local lastGood
    antiFlingConn = RunService.Heartbeat:Connect(function()
        local root = RootPart
        if not (root and root.Parent and Character) then return end
        local gameMove = root:FindFirstChild("moveme") or root:FindFirstChild("dodgevelocity")
            or Character:GetAttribute("BeingLaunched") or Character:GetAttribute("Ragdoll")
        local speed = root.AssemblyLinearVelocity.Magnitude
        local angular = root.AssemblyAngularVelocity.Magnitude
        if (not gameMove and speed > 250) or angular > 250 then
            pcall(function()
                root.AssemblyAngularVelocity = Vector3.zero
                root.AssemblyLinearVelocity = Vector3.zero
                if lastGood then root.CFrame = lastGood end
            end)
        elseif speed < 50 and angular < 50 then
            lastGood = root.CFrame
        end
    end)
end

-- =========================================================================
-- Anti Death Counter
-- =========================================================================
local antiDCConn
local function applyAntiDeathCounter()
    if antiDCConn then antiDCConn:Disconnect() antiDCConn = nil end
    if not Settings.Player.AntiDeathCounter then return end
    antiDCConn = RunService.Heartbeat:Connect(function()
        if not Character then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local c = plr.Character:FindFirstChild("Counter")
                if c then pcall(function() c:Destroy() end) end
            end
        end
    end)
end

-- =========================================================================
-- Character Copy (disguise)
-- =========================================================================
local CharCopy = { userId = nil, keep = true, name = "", cache = {}, rigAttachments = buildSet({
    "HatAttachment","HairAttachment","FaceFrontAttachment","FaceCenterAttachment",
    "NeckAttachment","BodyFrontAttachment","BodyBackAttachment","LeftCollarAttachment",
    "RightCollarAttachment","WaistFrontAttachment","WaistCenterAttachment","WaistBackAttachment",
    "LeftShoulderAttachment","RightShoulderAttachment","LeftGripAttachment","RightGripAttachment",
    "LeftFootAttachment","RightFootAttachment"
}), watch = nil }

function CharCopy.resolve(input)
    input = tostring(input or ""):match("^%s*(.-)%s*$")
    if input == "" then return nil end
    if input:match("^%d+$") then return tonumber(input), input end
    local lower = input:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == lower or p.DisplayName:lower() == lower then return p.UserId, p.Name end
    end
    local ok, id = pcall(Players.GetUserIdFromNameAsync, Players, input)
    if ok and id then return id, input end
    return nil
end

function CharCopy.build(userId)
    if CharCopy.cache[userId] then return CharCopy.cache[userId] end
    local ok, desc = pcall(Players.GetHumanoidDescriptionFromUserId, Players, userId)
    if not ok or not desc then return nil, "couldn't get avatar" end
    local rig = (Humanoid and Humanoid.RigType) or Enum.HumanoidRigType.R6
    local ok2, model = pcall(Players.CreateHumanoidModelFromDescription, Players, desc, rig)
    if not ok2 or not model then return nil, "couldn't load avatar" end
    local data = { model = model, desc = desc }
    CharCopy.cache[userId] = data
    return data
end

function CharCopy.isOld(char, inst)
    local isAcc = inst:IsA("Accoutrement")
    if not (isAcc or inst:IsA("Clothing") or inst:IsA("ShirtGraphic") or inst:IsA("BodyColors") or inst:IsA("CharacterMesh")) then return false end
    if inst:GetAttribute("MingoChar") then return false end
    if isAcc then
        local handle = inst:FindFirstChild("Handle")
        local att = handle and handle:FindFirstChildOfClass("Attachment")
        if not (att and CharCopy.rigAttachments[att.Name]) then return false end
    end
    return true
end

function CharCopy.weldAccessory(char, acc)
    local handle = acc:FindFirstChild("Handle")
    if not handle then return end
    local att = handle:FindFirstChildOfClass("Attachment")
    local targetAtt
    for _, p in ipairs(char:GetChildren()) do
        if att and p:IsA("BasePart") then
            targetAtt = p:FindFirstChild(att.Name)
            if targetAtt then break end
        end
    end
    acc.Parent = char
    if targetAtt then
        handle.CFrame = targetAtt.WorldCFrame * att.CFrame:Inverse()
        local weld = Instance.new("Weld")
        weld.Name = "AccessoryWeld"
        weld.Part0 = handle
        weld.Part1 = targetAtt.Parent
        weld.C0 = att.CFrame
        weld.C1 = targetAtt.CFrame
        weld.Parent = handle
    end
end

function CharCopy.apply(char, data)
    if not (char and data and data.model) then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if CharCopy.watch then CharCopy.watch:Disconnect() CharCopy.watch = nil end
    for _, inst in ipairs(char:GetDescendants()) do
        if inst:GetAttribute("MingoChar") or CharCopy.isOld(char, inst) then inst:Destroy() end
    end
    for _, inst in ipairs(data.model:GetChildren()) do
        if inst:IsA("Accoutrement") then
            local clone = inst:Clone()
            clone:SetAttribute("MingoChar", true)
            for _, p in ipairs(clone:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false p.Massless = true end
            end
            local ok = pcall(hum.AddAccessory, hum, clone)
            if not ok or not clone:FindFirstChild("AccessoryWeld", true) then CharCopy.weldAccessory(char, clone) end
        elseif inst:IsA("Clothing") or inst:IsA("ShirtGraphic") or inst:IsA("BodyColors") or inst:IsA("CharacterMesh") then
            local clone = inst:Clone()
            clone:SetAttribute("MingoChar", true)
            clone.Parent = char
        end
    end
    CharCopy.watch = char.DescendantAdded:Connect(function(inst)
        if CharCopy.userId and char == Character then
            if CharCopy.isOld(char, inst) then task.defer(inst.Destroy, inst) end
        elseif CharCopy.watch then
            CharCopy.watch:Disconnect() CharCopy.watch = nil
        end
    end)
    if data.desc then
        local colors = {
            Head = data.desc.HeadColor, Torso = data.desc.TorsoColor,
            UpperTorso = data.desc.TorsoColor, LowerTorso = data.desc.TorsoColor,
            ["Left Arm"] = data.desc.LeftArmColor, LeftUpperArm = data.desc.LeftArmColor,
            LeftLowerArm = data.desc.LeftArmColor, LeftHand = data.desc.LeftArmColor,
            ["Right Arm"] = data.desc.RightArmColor, RightUpperArm = data.desc.RightArmColor,
            RightLowerArm = data.desc.RightArmColor, RightHand = data.desc.RightArmColor,
            ["Left Leg"] = data.desc.LeftLegColor, LeftUpperLeg = data.desc.LeftLegColor,
            LeftLowerLeg = data.desc.LeftLegColor, LeftFoot = data.desc.LeftLegColor,
            ["Right Leg"] = data.desc.RightLegColor, RightUpperLeg = data.desc.RightLegColor,
            RightLowerLeg = data.desc.RightLegColor, RightFoot = data.desc.RightLegColor,
        }
        for name, col in pairs(colors) do
            local p = char:FindFirstChild(name)
            if p and p:IsA("BasePart") then p.Color = col end
        end
    end
    local head = char:FindFirstChild("Head")
    local modelHead = data.model:FindFirstChild("Head")
    local face = modelHead and (modelHead:FindFirstChild("face") or modelHead:FindFirstChildWhichIsA("Decal"))
    local myFace = head and (head:FindFirstChild("face") or head:FindFirstChildWhichIsA("Decal"))
    if myFace and not CharCopy.ownFace then CharCopy.ownFace = myFace.Texture end
    if myFace and (face or CharCopy.userId == nil) then
        myFace.Texture = face and face.Texture or CharCopy.ownFace
    elseif head and face then
        face:Clone().Parent = head
    end
end

function CharCopy.set(input)
    local userId, name = CharCopy.resolve(input)
    if not userId then notifySystem("Couldn't find player", 2) return end
    local data, err = CharCopy.build(userId)
    if not data then notifySystem("Char: " .. tostring(err), 3) return end
    CharCopy.userId = userId
    CharCopy.apply(Character, data)
    notifySystem("Disguised as " .. (name or tostring(userId)), 3)
end

function CharCopy.reset()
    if not CharCopy.userId then return end
    CharCopy.userId = nil
    if CharCopy.watch then CharCopy.watch:Disconnect() CharCopy.watch = nil end
    local data = CharCopy.build(player.UserId)
    if data then CharCopy.apply(Character, data) end
    notifySystem("Back to own avatar", 2)
end

player.CharacterAdded:Connect(function(char)
    if CharCopy.keep and CharCopy.userId then
        task.spawn(function()
            task.wait(0.5)
            if char == Character and CharCopy.userId then
                local data = CharCopy.build(CharCopy.userId)
                if data then CharCopy.apply(char, data) end
            end
        end)
    end
end)

-- =========================================================================
-- Ping spoofer + device spoofer (namecall hook)
-- =========================================================================
local PingSpoofState = { hooked = false, thread = false, ping = 30, last = 0 }
local DeviceSpoofState = { hooked = false, real = { touch = UIS.TouchEnabled, gamepad = UIS.GamepadEnabled } }

local function pingCurrentValue()
    local s = Settings.Player.PingSpoof
    local t = os.clock()
    local step = math.max(0.05, (tonumber(s.ReportRate) or 10) * 0.1)
    if t - PingSpoofState.last >= step then
        PingSpoofState.last = t
        local jitter = tonumber(s.Jitter) or 0
        PingSpoofState.ping = math.max(1, (tonumber(s.Ping) or 30) + (math.random() * 2 - 1) * jitter)
    end
    return PingSpoofState.ping
end

local sharedHookOld = nil

local function installNamecallHook()
    if PingSpoofState.hooked then return true end
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" or type(checkcaller) ~= "function" then
        return false
    end
    PingSpoofState.hooked = true
    sharedHookOld = hookmetamethod(game, "__namecall", function(self, ...)
        if checkcaller() then return sharedHookOld(self, ...) end
        if getnamecallmethod() ~= "FireServer" then return sharedHookOld(self, ...) end
        if typeof(self) ~= "Instance" or self.ClassName ~= "RemoteEvent" or self.Name ~= "Communicate" then
            return sharedHookOld(self, ...)
        end
        local args = {...}
        local first = args[1]
        if type(first) ~= "table" then return sharedHookOld(self, ...) end
        local needPing = Settings.Player.PingSpoof.Enabled
        local needDev = Settings.Player.DeviceSpoof.Enabled
        if not (needPing or needDev) then return sharedHookOld(self, ...) end
        local clone
        local function ensureClone()
            if not clone then
                clone = {}
                for k, v in pairs(first) do clone[k] = v end
            end
        end
        local goal = first.Goal
        if needPing and goal == "ReportPing" and first.ms ~= nil then
            ensureClone()
            clone.ms = pingCurrentValue()
        end
        if needDev then
            local dev = Settings.Player.DeviceSpoof
            local mobile = dev.Device == "Mobile"
            local console = dev.Device == "Console"
            if goal == "Platform" or goal == " Platform " or goal == "SetPlatform" then
                ensureClone()
                if clone.mobile ~= nil then clone.mobile = mobile end
                if clone.console ~= nil then clone.console = console end
            elseif goal == "LeftClick" or goal == "LeftClickRelease" then
                if mobile or console then
                    ensureClone()
                    clone.Mobile = true
                    if goal == "LeftClick" and dev.TapClicks then
                        task.delay(0.06, function()
                            if not Settings.Player.DeviceSpoof.TapClicks then return end
                            local c = Communicate
                            if c and c.Parent then
                                pcall(function() c:FireServer({Goal = "LeftClickRelease", Mobile = true}) end)
                            end
                        end)
                    end
                end
            end
        end
        if clone then
            args[1] = clone
            return sharedHookOld(self, table.unpack(args))
        end
        return sharedHookOld(self, ...)
    end)
    return true
end

local function reportLoop()
    if PingSpoofState.thread then return end
    PingSpoofState.thread = task.spawn(function()
        while Settings.Player.PingSpoof.Enabled and not Unloaded do
            local c = Communicate
            if c and c.Parent then
                pcall(function() c:FireServer({Goal = "ReportPing", ms = pingCurrentValue()}) end)
            end
            task.wait(math.max(0.1, (tonumber(Settings.Player.PingSpoof.ReportRate) or 10) * 0.1))
        end
        PingSpoofState.thread = false
    end)
end

local function setPingSpoof(on)
    Settings.Player.PingSpoof.Enabled = on and true or false
    if not on then return end
    if not installNamecallHook() then
        Settings.Player.PingSpoof.Enabled = false
        notifySystem("Ping spoofer needs hookmetamethod", 3)
        return
    end
    reportLoop()
end

local deviceHookOld = nil
local function setDeviceSpoof(on)
    Settings.Player.DeviceSpoof.Enabled = on and true or false
    if deviceHookOld then
        pcall(function() hookmetamethod(UIS, "__index", deviceHookOld) end)
        deviceHookOld = nil
    end
    if not on then return end
    if not installNamecallHook() then
        Settings.Player.DeviceSpoof.Enabled = false
        notifySystem("Device spoofer needs hookmetamethod", 3)
        return
    end
    local dev = Settings.Player.DeviceSpoof.Device
    local flags
    if dev == "Mobile" then
        flags = { TouchEnabled = true, KeyboardEnabled = false, MouseEnabled = false, GamepadEnabled = false }
    elseif dev == "Console" then
        flags = { TouchEnabled = false, KeyboardEnabled = false, MouseEnabled = false, GamepadEnabled = true }
    else
        flags = { TouchEnabled = false, KeyboardEnabled = true, MouseEnabled = true, GamepadEnabled = false }
    end
    if Settings.Player.DeviceSpoof.TapClicks then flags.TouchEnabled = true end
    if type(hookmetamethod) == "function" then
        local old
        local ok = pcall(function()
            old = hookmetamethod(UIS, "__index", function(self, k)
                if self == UIS and flags[k] ~= nil then return flags[k] end
                return old(self, k)
            end)
        end)
        if ok then
            deviceHookOld = old
            local mobile = dev == "Mobile"
            local console = dev == "Console"
            local c = Communicate
            if c and c.Parent then
                pcall(function() c:FireServer({Goal = "Platform", mobile = mobile}) end)
                pcall(function() c:FireServer({Goal = "Platform", console = console}) end)
            end
        end
    end
end

-- =========================================================================
-- Hitbox display (ping ghost)
-- =========================================================================
local PingHistory = {}
local hitboxGhost

local function setHitboxDisplay(on)
    if hitboxGhost then
        pcall(function() hitboxGhost:Destroy() end)
        hitboxGhost = nil
    end
    if not on then return end
    hitboxGhost = Instance.new("Part")
    hitboxGhost.Size = Vector3.new(2, 2, 1)
    hitboxGhost.Color = Color3.new(1, 0, 0)
    hitboxGhost.Transparency = 0.5
    hitboxGhost.Anchored = true
    hitboxGhost.CanCollide = false
    hitboxGhost.CanQuery = false
    hitboxGhost.CanTouch = false
    hitboxGhost.Name = "MingoPingGhost"
    hitboxGhost.Parent = workspace
    RunService.Heartbeat:Connect(function()
        if not (RootPart and RootPart.Parent) then return end
        local now = tick()
        table.insert(PingHistory, {time = now, cf = RootPart.CFrame})
        while PingHistory[1] and now - PingHistory[1].time > 2 do
            table.remove(PingHistory, 1)
        end
    end)
    RunService.RenderStepped:Connect(function()
        if not hitboxGhost then return end
        local target = tick() - getPing(1000)
        for i = #PingHistory, 2, -1 do
            local a, b = PingHistory[i], PingHistory[i-1]
            if b.time <= target and a.time >= target then
                local t = (target - b.time) / (a.time - b.time)
                hitboxGhost.CFrame = b.cf:Lerp(a.cf, t)
                break
            end
        end
    end)
end

-- =========================================================================
-- Custom front/side dash keybinds
-- =========================================================================
local function execCustomFrontDash()
    if not Settings.Player.CustomFrontDash.Enabled then return end
    if fireFrontDash() then
        amplifyDash(Settings.Player.CustomFrontDash.Distance, 0.05)
    end
end

local function execCustomSideDash()
    local cfg = Settings.Player.CustomSideDash
    if not (cfg.Enabled and Humanoid and RootPart and Humanoid.Health > 0) then return end
    keyUp(KeyW) keyUp(KeyS)
    if cfg.Side == "Straight" then smoothRotateChar(90, 0.05) end
    if cfg.Side == "Straight" or cfg.Side == "Right" then keyDown(KeyD) else keyDown(KeyA) end
    if cfg.Jump then keyDown(KeySpace) end
    task.wait(0.005)
    tapKey(KeyQ)
    if cfg.RemoveInertia then
        task.wait(cfg.RMIDelay)
        local dv = RootPart:FindFirstChild("dodgevelocity")
        if dv then
            dv:Destroy()
            stopAnim(Anims.rsideDash)
            stopAnim(Anims.lsideDash)
        end
    end
    keyUp(KeySpace) keyUp(KeyD) keyUp(KeyA)
    if cfg.Side == "Straight" then smoothRotateChar(-90, 0.05) end
    amplifyDash(cfg.Distance, 0.05)
end

-- =========================================================================
-- Macro helpers
-- =========================================================================
local function backdashMacro(numKey)
    pressAndClick(numKey)
    jitter()
    keyDown(KeyS)
    tapKey(KeyQ)
    jitter(0.1)
    keyUp(KeyS)
end

local function execTechHelper(tech)
    local pingRange = { getPing(1) + 0.36, 0 }
    pingRange[1] = 0.36 + (getPing() - 50) * -0.0003846
    pingRange[2] = 0.36 - pingRange[1]
    if tech == "Humbled Twisted" then
        pressAndClick(Enum.KeyCode.One)
        task.wait(math.max(0, pingRange[1] - 0.05))
        fireFrontDash()
        task.wait(math.max(0, 0.075 - pingRange[2]))
        smoothRotateChar(-90, 0.1)
        task.wait(0.1)
        smoothRotateChar(180, 0.1)
        task.wait(0.125)
        smoothRotateChar(-90, 0.1)
    elseif tech == "Loop Dash" then
        keyDown(KeySpace) jitter(0.01) pressAndClick(Enum.KeyCode.One) keyUp(KeySpace)
        task.wait(math.max(0, pingRange[1]))
        fireFrontDash()
        rotateAim(45, nil, true)
        smoothRotateChar(340, math.max(0, 0.4 - pingRange[2]))
    elseif tech == "Instant Lee" then
        pressAndClick(Enum.KeyCode.One)
        task.wait(math.max(0, pingRange[1] - 0.05))
        fireFrontDash()
        task.wait(math.max(0, pingRange[2]))
        rotateAim(145, nil, true)
        task.wait(math.max(0, 0.075 + pingRange[2]))
        smoothRotateChar(-175, 0.1)
    elseif tech == "Oreo Tech" then
        keyDown(KeySpace) jitter(0.01) pressAndClick(Enum.KeyCode.One) keyUp(KeySpace)
        task.wait(math.max(0, pingRange[1]))
        rotateAim(180, nil, true)
        fireFrontDash()
        task.wait(math.max(0, 0.18 + pingRange[2]))
        rotateAim(180, nil, true)
    elseif tech == "Lix Tech" then
        keyDown(KeySpace) jitter(0.01) pressAndClick(Enum.KeyCode.One) keyUp(KeySpace)
        task.wait(math.max(0, pingRange[1]))
        fireFrontDash()
        task.wait(math.max(0, 0.16 + pingRange[2]))
        rotateAim(180, nil, true)
    end
end

local function execTrueM1Reset()
    if not Settings.Macros.TrueM1Reset.Enabled then return end
    local pingRange = 0.28 + (getPing() - 50) * -0.0003846
    pressAndClick(Enum.KeyCode.One)
    task.wait(math.max(0, pingRange))
    rotateAim(-90, nil, true)
    keyDown(KeyD)
    tapKey(KeyQ)
    task.wait(math.max(0, pingRange))
    keyUp(KeyD)
    rotateAim(90, nil, true)
    fireFrontDash()
end

local function execEmoteDash()
    if not (Settings.Macros.EmoteDash.Enabled and Humanoid and RootPart and Humanoid.Health > 0) then return end
    keyUp(KeyW) keyUp(KeyS)
    local cfg = Settings.Macros.EmoteDash
    if cfg.Type == "Straight" then smoothRotateChar(90, 0.05) end
    if cfg.Type == "Straight" or cfg.Type == "Right" then keyDown(KeyD) elseif cfg.Type == "Left" then keyDown(KeyA) end
    Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    task.wait(0.005)
    tapKey(KeyQ)
    task.wait(cfg.Delay)
    local dv = RootPart:FindFirstChild("dodgevelocity")
    if dv then
        dv:Destroy()
        stopAnim(Anims.rsideDash)
        stopAnim(Anims.lsideDash)
    end
    keyUp(KeyD) keyUp(KeyA)
    if cfg.Type == "Straight" then smoothRotateChar(-90, 0.05) end
end

-- =========================================================================
-- Character lifecycle
-- =========================================================================
local function cleanupCharacter()
    releaseBlock()
    State.blockState.active = false
    State.blockState.untilT = 0
    State.blockState.session = nil
    State.barrageActive = false
    State.frontDashAt = 0
    dashCooling = false
    State.freeRotateLocked = false
    if Chams.highlight then pcall(function() Chams.highlight:Destroy() end) Chams.highlight = nil end
    table.clear(Chams.mats)
    if Lethal.setHighlight then Lethal.setHighlight(nil) Lethal.busy = false end
    table.clear(PingHistory)
end

local function initCharacter(char)
    if not char then return end
    Character = char
    cleanupCharacter()
    Humanoid = char:WaitForChild("Humanoid", 3) or char:FindFirstChildOfClass("Humanoid")
    RootPart = char:WaitForChild("HumanoidRootPart", 3) or (Humanoid and Humanoid.RootPart)
    HeadPart = char:WaitForChild("Head", 3) or char:FindFirstChild("Head")
    HeadFace = HeadPart and (HeadPart:FindFirstChild("face") or HeadPart:WaitForChild("face", 0.5))
    Communicate = char:FindFirstChild("Communicate") or char:WaitForChild("Communicate", 1.5)
    if Humanoid then
        Animator = Humanoid:FindFirstChildOfClass("Animator") or Humanoid:WaitForChild("Animator", 1.5)
        if not Animator and Humanoid.Parent then
            pcall(function()
                Animator = Instance.new("Animator")
                Animator.Parent = Humanoid
            end)
        end
    end
    pcall(function() Camera.FieldOfView = Settings.Visuals.FOV end)

    if Animator then
        connect(Animator.AnimationPlayed, Lethal.onAnim)
        connect(Animator.AnimationPlayed, function(track)
            local a = track.Animation
            if not a then return end
            if a.AnimationId:find(Anims.uppercut) or a.AnimationId:find(Anims.euppercut) then
                if not Settings.AutoTech.Enabled then return end
                if not (Character and RootPart and Humanoid and Humanoid.Health > 0) then return end
                -- find most recent hit target
                local lastHit = Character:GetAttribute("LastM1Hitted")
                local target = nil
                if lastHit then
                    local name = lastHit:match("^(.-);;")
                    if name then target = Live.Live:FindFirstChild(name) end
                end
                if not target then
                    local bestDist = 50
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= player and plr.Character then
                            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                            if hrp and hum and hum.Health > 0 and RootPart then
                                local d = (hrp.Position - RootPart.Position).Magnitude
                                if d < bestDist then bestDist, target = d, plr.Character end
                            end
                        end
                    end
                end
                if not target then return end
                local targetRoot = target:FindFirstChild("HumanoidRootPart")
                local targetHum = target:FindFirstChildOfClass("Humanoid")
                if not (targetRoot and targetHum) then return end
                local dist = (RootPart.Position - targetRoot.Position).Magnitude
                if dist > 15 then return end
                local miss = Settings.AutoTech.MissChance > 0 and math.random(1, 100) <= Settings.AutoTech.MissChance
                task.wait(math.max(0, 0.38 - getPing(1000)))
                if Settings.AutoTech.Enabled and canDash() then
                    local handler = TECH_HANDLERS[Settings.AutoTech.Tech]
                    if handler then
                        task.spawn(function()
                            local ok, err = pcall(handler, target, targetRoot, targetHum, miss)
                            if not ok then warn("[MingoHub] tech: " .. tostring(err)) end
                            State.freeRotateLocked = false
                            freeRotate()
                        end)
                    end
                end
            end
        end)
    end

    if Humanoid then
        connect(Humanoid:GetPropertyChangedSignal("JumpPower"), function()
            if Settings.Player.NoFatigue and Character and not Character:FindFirstChild("NoJump")
                and notInStates(Character, State.ignoreLocal) then
                Humanoid.JumpPower = 50
            end
        end)
        connect(Humanoid:GetPropertyChangedSignal("AutoRotate"), function()
            if State.freeRotateLocked then Humanoid.AutoRotate = false end
        end)
        connect(Humanoid.Died, cleanupCharacter)
    end

    if Settings.Player.WalkSpeedEnabled and Humanoid then
        Humanoid.WalkSpeed = Settings.Player.WalkSpeed
    end

    task.defer(applyHeadless, char)
    task.defer(applyKorblox, char)

    if CharCopy.keep and CharCopy.userId then
        task.spawn(function()
            task.wait(0.5)
            if char == Character and CharCopy.userId then
                local data = CharCopy.build(CharCopy.userId)
                if data then CharCopy.apply(char, data) end
            end
        end)
    end
end

local function onCharacterRemoving()
    cleanupCharacter()
end

player.CharacterAdded:Connect(initCharacter)
player.CharacterRemoving:Connect(onCharacterRemoving)
if player.Character then
    task.spawn(initCharacter, player.Character)
end

-- Global per-frame upkeep
connect(RunService.Heartbeat, function()
    if Humanoid and State.freeRotateLocked then Humanoid.AutoRotate = false end
    if Settings.Player.NoSideDashCooldown and Character then
        if Character:GetAttribute("CustomSideDashCooldown") ~= 0 then
            pcall(Character.SetAttribute, Character, "CustomSideDashCooldown", 0)
        end
        local a = Character:FindFirstChild("InDash") if a then pcall(a.Destroy, a) end
        local b = Character:FindFirstChild("UsedDash") if b then pcall(b.Destroy, b) end
        spoofDashState(true)
    end
    if Settings.Player.WalkSpeedEnabled and Humanoid then
        if Humanoid.WalkSpeed ~= Settings.Player.WalkSpeed then
            Humanoid.WalkSpeed = Settings.Player.WalkSpeed
        end
    end
    if Settings.Player.Korblox and Character then
        if os.clock() - (State.lastKorblox or 0) > 0.5 then
            State.lastKorblox = os.clock()
            applyKorblox(Character)
        end
    end
end)

-- Player added/removed
local function onPlayerAdded(plr)
    if plr == player then return end
    if plr.Character then hookModel(plr.Character) end
    if Live.Live then
        local m = Live.Live:FindFirstChild(plr.Name)
        if m then hookModel(m) end
    end
    plr.CharacterAdded:Connect(function(c)
        hookModel(c)
        if Live.Live then
            local m = Live.Live:FindFirstChild(plr.Name)
            if m then hookModel(m) end
        end
    end)
end
Players.PlayerAdded:Connect(onPlayerAdded)
for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= player then onPlayerAdded(plr) end
end

if Live.Live then
    for _, m in ipairs(Live.Live:GetChildren()) do hookModel(m) end
    connect(Live.Live.ChildAdded, function(child)
        if child.Name ~= player.Name and Players:FindFirstChild(child.Name) then hookModel(child) end
        task.spawn(onLiveChild, child)
    end)
    connect(Live.Live.DescendantAdded, onLiveChild)
end

connect(Players.PlayerRemoving, function(plr)
    PlayerRelations[plr.Name] = nil
end)

-- =========================================================================
-- Notifications
-- =========================================================================
local notifGui = Instance.new("ScreenGui")
notifGui.Name = "MingoNotify"
notifGui.ResetOnSpawn = false
notifGui.DisplayOrder = 50
notifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
do
    local ok, hui = pcall(function() return gethui() end)
    notifGui.Parent = ok and hui or PlayerGui
end

local notifContainer = Instance.new("Frame")
notifContainer.BackgroundTransparency = 1
notifContainer.Position = UDim2.new(0, 20, 0.5, -20)
notifContainer.Size = UDim2.new(0, 300, 0.5, 0)
notifContainer.Parent = notifGui
local notifLayout = Instance.new("UIListLayout")
notifLayout.Padding = UDim.new(0, 8)
notifLayout.SortOrder = Enum.SortOrder.LayoutOrder
notifLayout.Parent = notifContainer
local notifOrder = 0

local function textHeight(text, font, size, width)
    local clean = tostring(text):gsub("<[^>]->", "")
    return TextService:GetTextSize(clean, size, font, Vector2.new(width, math.huge)).Y
end

function pushNotification(data)
    if not Settings.Misc.Notifications.Enabled then return end
    local title = data.Title or "MingoHub"
    local desc = data.Description
    local img = data.Image
    if type(img) ~= "string" or img == "" then img = nil end
    local duration = tonumber(data.Duration) or 5
    local pad, imgSize = 10, 36
    local padX = pad + (img and imgSize + pad or 0)
    local width = 300 - padX - pad
    local titleH = textHeight(title, FONT_BOLD, 12, width)
    local descH = desc and textHeight(desc, FONT, 11, width) or 0
    local gap = desc and 4 or 0
    local height = math.max(pad + titleH + gap + descH + pad, img and imgSize + pad*2 or 0)

    notifOrder += 1
    local frame = Instance.new("Frame")
    frame.BackgroundTransparency = 1
    frame.LayoutOrder = notifOrder
    frame.Size = UDim2.fromOffset(300, height)
    frame.Parent = notifContainer

    local bg = Instance.new("Frame")
    bg.BackgroundColor3 = Color3.fromRGB(10, 15, 39)
    bg.BackgroundTransparency = 0.34
    bg.BorderSizePixel = 0
    bg.Size = UDim2.fromScale(1, 1)
    bg.Position = UDim2.fromOffset(-330, 0)
    bg.Parent = frame
    local cornerBg = Instance.new("UICorner")
    cornerBg.CornerRadius = UDim.new(0, 10)
    cornerBg.Parent = bg
    local strokeBg = Instance.new("UIStroke")
    strokeBg.Color = Palette.Border
    strokeBg.Thickness = 1.5
    strokeBg.Transparency = 0.35
    strokeBg.Parent = bg

    if img then
        local il = Instance.new("ImageLabel")
        il.BackgroundColor3 = Color3.fromRGB(40, 40, 44)
        il.BackgroundTransparency = 0.3
        il.BorderSizePixel = 0
        il.Image = img
        il.ScaleType = Enum.ScaleType.Crop
        il.Size = UDim2.fromOffset(imgSize, imgSize)
        il.Position = UDim2.fromOffset(pad, math.floor((height - imgSize) / 2))
        il.Parent = bg
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = il
    end

    local y = pad
    local tl = Instance.new("TextLabel")
    tl.BackgroundTransparency = 1
    tl.RichText = true
    tl.TextWrapped = true
    tl.TextXAlignment = Enum.TextXAlignment.Left
    tl.TextYAlignment = Enum.TextYAlignment.Top
    tl.Font = FONT_BOLD
    tl.TextSize = 12
    tl.TextColor3 = Palette.Accent
    tl.Text = title
    tl.Position = UDim2.fromOffset(padX, y)
    tl.Size = UDim2.fromOffset(width, titleH)
    tl.Parent = bg
    y += titleH + gap
    if desc then
        local dl = Instance.new("TextLabel")
        dl.BackgroundTransparency = 1
        dl.RichText = true
        dl.TextWrapped = true
        dl.TextXAlignment = Enum.TextXAlignment.Left
        dl.TextYAlignment = Enum.TextYAlignment.Top
        dl.Font = FONT
        dl.TextSize = 11
        dl.TextColor3 = Color3.fromRGB(220, 225, 245)
        dl.Text = desc
        dl.Position = UDim2.fromOffset(padX, y)
        dl.Size = UDim2.fromOffset(width, descH)
        dl.Parent = bg
    end

    TweenService:Create(bg, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.fromOffset(0, 0)}):Play()
    task.delay(duration, function()
        if not frame.Parent then return end
        for _, d in ipairs(frame:GetDescendants()) do
            if d:IsA("TextLabel") then
                TweenService:Create(d, TweenInfo.new(0.25), {TextTransparency = 1}):Play()
            elseif d:IsA("ImageLabel") then
                TweenService:Create(d, TweenInfo.new(0.25), {ImageTransparency = 1, BackgroundTransparency = 1}):Play()
            elseif d:IsA("UIStroke") then
                TweenService:Create(d, TweenInfo.new(0.25), {Transparency = 1}):Play()
            elseif d:IsA("Frame") and d.BackgroundTransparency < 1 then
                TweenService:Create(d, TweenInfo.new(0.25), {BackgroundTransparency = 1}):Play()
            end
        end
        task.wait(0.25)
        TweenService:Create(frame, TweenInfo.new(0.2), {Size = UDim2.fromOffset(300, 0)}):Play()
        task.wait(0.2)
        frame:Destroy()
    end)
end

-- Watch ult / death counter notifications
local function watchNotifications(model)
    local plr = playerFromModel(model)
    if not plr or plr == player then return end
    model:GetAttributeChangedSignal("Ulted"):Connect(function()
        if model:GetAttribute("Ulted") and Settings.Misc.Notifications.Enabled and Settings.Misc.Notifications.Ult then
            local attr = model:GetAttribute("Character")
            local ultName = CharacterNames[attr] or "Other"
            local ok, url = pcall(function()
                return Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
            end)
            pushNotification({
                Title = "MingoHub",
                Description = string.format("%s used %s Ult!", plr.DisplayName, ultName),
                Image = ok and url or nil,
            })
        end
    end)
    model.ChildAdded:Connect(function(child)
        if child.Name == "Counter" and Settings.Misc.Notifications.Enabled and Settings.Misc.Notifications.Counter then
            local ok, url = pcall(function()
                return Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
            end)
            pushNotification({
                Title = "MingoHub",
                Description = string.format("%s used Death Counter!", plr.DisplayName),
                Image = ok and url or nil,
            })
        end
    end)
end

Players.PlayerAdded:Connect(function(plr)
    if plr ~= player then
        plr.CharacterAdded:Connect(function(c)
            task.wait(0.2)
            if c.Parent then watchNotifications(c) end
        end)
        if plr.Character then watchNotifications(plr.Character) end
    end
end)
for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= player and plr.Character then watchNotifications(plr.Character) end
end

-- =========================================================================
-- Config save/load
-- =========================================================================
local CONFIG_DIR = "MingoHub_Configs"
local memoryFiles = {}
local function fsReady() return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function" end
local function ensureDir()
    if type(makefolder) == "function" and type(isfolder) == "function" then
        pcall(function() if not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end end)
    end
end
local function configPath(name) return CONFIG_DIR .. "/" .. name .. ".json" end
local function readText(path)
    if fsReady() then
        local ok, exists = pcall(isfile, path)
        if ok and exists then
            local ok2, data = pcall(readfile, path)
            if ok2 and type(data) == "string" then return data end
        end
    end
    return memoryFiles[path]
end
local function writeText(path, data)
    memoryFiles[path] = data
    if fsReady() then ensureDir() pcall(writefile, path, data) end
end
local function sanitize(name)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    name = name:gsub('[\\/:*?"<>|]', "_")
    if name == "" then return nil end
    return name
end

local function deepCopy(t)
    local out = {}
    for k, v in pairs(t) do out[k] = type(v) == "table" and deepCopy(v) or v end
    return out
end
local function deepApply(dst, src)
    for k, v in pairs(src) do
        local cur = dst[k]
        if type(cur) == "table" and type(v) == "table" then
            deepApply(cur, v)
        elseif cur ~= nil and type(v) == type(cur) then
            dst[k] = v
        end
    end
end

local function listConfigs()
    local names, seen = {}, {}
    if fsReady() and type(listfiles) == "function" then
        local ok, files = pcall(listfiles, CONFIG_DIR)
        if ok and type(files) == "table" then
            for _, path in ipairs(files) do
                local fn = tostring(path):match("([^/\\]+)$")
                if fn and fn:sub(-5) == ".json" and fn:sub(1, 1) ~= "_" then
                    local n = fn:sub(1, #fn - 5)
                    if not seen[n] then seen[n] = true table.insert(names, n) end
                end
            end
        end
    end
    for path in pairs(memoryFiles) do
        if path:sub(1, #CONFIG_DIR) == CONFIG_DIR then
            local fn = path:match("([^/\\]+)$")
            if fn and fn:sub(-5) == ".json" and fn:sub(1, 1) ~= "_" then
                local n = fn:sub(1, #fn - 5)
                if not seen[n] then seen[n] = true table.insert(names, n) end
            end
        end
    end
    table.sort(names)
    return names
end

local function collectConfig()
    local s = deepCopy(Settings)
    if s.Macros and s.Macros.Backdash and s.Macros.Backdash.Keys then
        for i, k in ipairs(s.Macros.Backdash.Keys) do s.Macros.Backdash.Keys[i] = k and k.Name or nil end
    end
    return { version = VERSION, settings = s, appearance = deepCopy(Appearance) }
end

local function applyRGB(dst, src)
    if type(src) == "table" and #src == 3 then
        for i = 1, 3 do
            local v = tonumber(src[i])
            if v then dst[i] = math.clamp(math.floor(v), 0, 255) end
        end
    end
end

local syncUIControls = {}
local function registerControl(fn) table.insert(syncUIControls, fn) end
local function syncAllControls() for _, fn in ipairs(syncUIControls) do pcall(fn) end end

local applyAppearanceRef

local function applyConfigTable(data)
    if type(data) ~= "table" then return false end
    if type(data.settings) == "table" then
        for group, values in pairs(Settings) do
            if type(values) == "table" and type(data.settings[group]) == "table" then
                deepApply(values, data.settings[group])
            end
        end
        if data.settings.Macros and data.settings.Macros.Backdash and type(data.settings.Macros.Backdash.Keys) == "table" then
            for i, k in ipairs(data.settings.Macros.Backdash.Keys) do
                if type(k) == "string" then Settings.Macros.Backdash.Keys[i] = Enum.KeyCode[k] end
            end
        end
    end
    if type(data.appearance) == "table" then
        local ap = data.appearance
        if type(ap.Background) == "string" then Appearance.Background = ap.Background end
        if type(ap.Blur) == "boolean" then Appearance.Blur = ap.Blur end
        if type(ap.EdgeGlow) == "boolean" then Appearance.EdgeGlow = ap.EdgeGlow end
        if tonumber(ap.Scale) then Appearance.Scale = math.clamp(tonumber(ap.Scale), 0.75, 2) end
        applyRGB(Appearance.Accent, ap.Accent)
        applyRGB(Appearance.Button, ap.Button)
        applyRGB(Appearance.Border, ap.Border)
    end
    if applyAppearanceRef then applyAppearanceRef() end
    syncAllControls()
    return true
end

