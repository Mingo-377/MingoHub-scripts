            sda.Speed = v / 100
        end, function() return math.floor((sda.Speed or 1)*100) end)
        addSlider(exploit, "Range##SDA", "Studs", 1, 60, sda.Range or 25, function(v)
            sda.Range = v
        end, function() return sda.Range or 25 end)
        addSlider(exploit, "Offset##SDA", "Side clearance studs*10", 0, 100, math.floor((sda.Offset or 3.5)*10), function(v)
            sda.Offset = v / 10
        end, function() return math.floor((sda.Offset or 3.5)*10) end)
        addSlider(exploit, "Strength##SDA", "0-100", 0, 100, math.floor((sda.Strength or 0.8)*100), function(v)
            sda.Strength = v / 100
        end, function() return math.floor((sda.Strength or 0.8)*100) end)
        addToggle(exploit, "Face Target##SDA", "", sda.FaceTarget, function(on) sda.FaceTarget = on end, function() return sda.FaceTarget end)
        addToggle(exploit, "Rotate Camera##SDA", "", sda.RotateCam, function(on) sda.RotateCam = on end, function() return sda.RotateCam end)
        addToggle(exploit, "Highlight##SDA", "", sda.Highlight, function(on) sda.Highlight = on end, function() return sda.Highlight end)
        addToggle(exploit, "Predict##SDA", "Lead target velocity", sda.Predict, function(on) sda.Predict = on end, function() return sda.Predict end)
    end

    addSection(exploit, "Custom Front Dash")
    do
        local cfd = Settings.Rage.CustomFrontDash
        addToggle(exploit, "Enabled##CFD", "", cfd.Enabled, function(on) cfd.Enabled = on end, function() return cfd.Enabled end)
        addToggle(exploit, "Only on Keybind##CFD", "", cfd.OnlyOnKeybind, function(on) cfd.OnlyOnKeybind = on end, function() return cfd.OnlyOnKeybind end)
        addSlider(exploit, "Distance Mult##CFD", "50-300", 50, 300, math.floor((cfd.Distance or 1)*100), function(v)
            cfd.Distance = v / 100
            if cfd.Enabled then task.spawn(mingoDashBoost, cfd.Distance, 0.08) end
        end, function() return math.floor((cfd.Distance or 1)*100) end)
