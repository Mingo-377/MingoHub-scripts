    addToggle(exploit,"No Stun","Remove Freeze attribute",Settings.Rage.NoStun,function(on) Settings.Rage.NoStun=on end,function() return Settings.Rage.NoStun end)
    addToggle(exploit,"No Slow","Remove Slowed attribute",Settings.Rage.NoSlow,function(on) Settings.Rage.NoSlow=on end,function() return Settings.Rage.NoSlow end)
    addToggle(exploit,"No Fatigue","Maintain 50 JumpPower",Settings.Rage.NoFatigue,function(on) Settings.Rage.NoFatigue=on end,function() return Settings.Rage.NoFatigue end)
    addToggle(exploit,"Always Jump","Force JumpPower = 50",Settings.Rage.AlwaysJump,function(on) Settings.Rage.AlwaysJump=on end,function() return Settings.Rage.AlwaysJump end)
    addToggle(exploit,"No Side Dash Cooldown","Remove side dash cooldown",Settings.Rage.NoSideDashCooldown,function(on) Settings.Rage.NoSideDashCooldown=on; applyNoSideDashCooldown(on) end,function() return Settings.Rage.NoSideDashCooldown end)
    addToggle(exploit,"Freeze Hold","Hold key to anchor in place",Settings.Rage.FreezeHold,function(on) Settings.Rage.FreezeHold=on; if not on then State_Freeze.release() end end,function() return Settings.Rage.FreezeHold end)
    addKeybind(exploit,"Freeze Key","",Settings.Rage.FreezeKey,nil,function(k) Settings.Rage.FreezeKey=k end,function() return Settings.Rage.FreezeKey end)
    connectSignal(UIS.InputBegan, function(input)
        if not Settings.Rage.FreezeHold or UIS:GetFocusedTextBox() then return end
        if input.KeyCode == Settings.Rage.FreezeKey then State_Freeze.hold() end
    end)
    connectSignal(UIS.InputEnded, function(input)
        if State_Freeze.held and input.KeyCode == Settings.Rage.FreezeKey then State_Freeze.release() end
    end)

