local function setEdgeGlow(on)
    Appearance.EdgeGlow = on and true or false
    if on then
        glowStroke.Transparency = 0.45
        tween(glowStroke, 1.7, { Transparency = 0.10 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    else
        glowStroke.Transparency = 1
