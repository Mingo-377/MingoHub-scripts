    function() return Settings.Player.CustomSideDash.OnlyOnKeybind end)
addSlider(playerTab, "Side Dash Distance", "×10", 10, 1000, math.floor(Settings.Player.CustomSideDash.Distance * 10),
    function(v) Settings.Player.CustomSideDash.Distance = v / 10 end,
