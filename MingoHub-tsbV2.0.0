end

-- =========================================================================
-- Open / close handlers
-- =========================================================================
local function setOpen(open)
    local wasVisible = isOpen and root.Visible
    isOpen = open
    if open then
        root.Visible = true
        if not wasVisible then
            rootScale.Scale = 0.93
            window.GroupTransparency = 0.35
            tween(rootScale, 0.32, {Scale = 1})
            tween(window, 0.28, {GroupTransparency = 0})
        end
        pcall(function() tween(ensureBlur(), 0.6, {Size = Appearance.Blur and BLUR_SIZE or 0}) end)
    else
        tween(rootScale, 0.18, {Scale = 0.94}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
        local fadeOut = tween(window, 0.19, {GroupTransparency = 1}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
        fadeOut.Completed:Connect(function(state)
            if not isOpen and state == Enum.PlaybackState.Completed then
                root.Visible = false
                rootScale.Scale = 1
            end
        end)
        pcall(function() tween(ensureBlur(), 0.3, {Size = 0}) end)
    end
end

closeDot.Activated:Connect(function() setOpen(false) end)
minDot.MouseButton1Click:Connect(function()
    minimized = not minimized
    local h = minimized and BAR_H or WIN_H
    tween(window, 0.5, {Size = UDim2.fromOffset(WIN_W, h)})
    tween(glowEdge, 0.5, {Size = UDim2.fromOffset(WIN_W, h)})
end)
maxDot.MouseButton1Click:Connect(function()
    minimized = false
    tween(window, 0.5, {Size = UDim2.fromOffset(WIN_W, WIN_H)})
    tween(glowEdge, 0.5, {Size = UDim2.fromOffset(WIN_W, WIN_H)})
end)

local lastToggle = 0
local function toggleUI()
    if os.clock() - lastToggle < 0.25 then return end
    lastToggle = os.clock()
    setOpen(not isOpen)
end

UIS.InputBegan:Connect(function(input, processed)
    if input.KeyCode == Enum.KeyCode.RightShift and not UIS:GetFocusedTextBox() then
        toggleUI()
    end
end)
pcall(function()
    ContextActionService:BindActionAtPriority("MingoHubToggleUI", function(_, state)
        if state == Enum.UserInputState.Begin then
            toggleUI()
            return Enum.ContextActionResult.Sink
        end
        return Enum.ContextActionResult.Pass
    end, false, 3000, Enum.KeyCode.RightShift)
end)

-- Initial state
applyAppearanceRef()
selectTab("Main", true)
setOpen(true)
task.delay(0.5, function() pcall(function() ensureBlur().Size = Appearance.Blur and BLUR_SIZE or 0 end) end)

-- Kick off startup effects
if Settings.Visuals.AntiLag then setAntiLag(true, true) end
if Settings.Visuals.MotionBlur then MotionBlur.set(true) end
if Settings.Visuals.CustomSky.Enabled then applySky() end
if Settings.Visuals.CustomAtmosphere.Enabled then applyAtmosphere() end
if Settings.Player.AntiFling then setAntiFling(true) end
if Settings.Player.AntiDeathCounter then applyAntiDeathCounter() end
if Settings.ESP.Enabled then setESP(true) end
if Settings.Player.NoSideDashCooldown then spoofDashState(true) end

-- =========================================================================
-- Unload
-- =========================================================================
local function unloadAll()
    if Unloaded then return end
    Unloaded = true
    for _, key in pairs(State.marks) do
        pcall(function() key:Destroy() end)
    end
    table.clear(State.marks)
    for c in pairs(ActiveConnections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(ActiveConnections)
    for name in pairs(activeRenderNames) do unbindRender(name) end
    MotionBlur.set(false)
    restoreAntiLag()
    setSky(false)
    setAtmosphere(false)
    setESP(false)
    setAntiFling(false)
    setPingSpoof(false)
    setDeviceSpoof(false)
    if hitboxGhost then pcall(function() hitboxGhost:Destroy() end) end
    LockOn.stop()
    restoreChams()
    restoreAll()
    if Chams.highlight then pcall(function() Chams.highlight:Destroy() end) end
    setAntiLag(false, true)
    pcall(function() gui:Destroy() end)
    pcall(function() notifGui:Destroy() end)
    pcall(function() if blur then blur:Destroy() end end)
    for _, k in ipairs({KeyW, KeyA, KeyS, KeyD, KeyQ, KeySpace,
        Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}) do
        pcall(keyUp, k)
    end
end

_G.MingoHub = { unload = unloadAll, version = VERSION }
print("[MingoHub] " .. VERSION .. " loaded")
notifySystem(VERSION .. " ready — RightShift to toggle", 4)