pcall(function() DataPing = Stats.Network.ServerStatsItem["Data Ping"] end)

local function pingScaledDelay(div)
    if DataPing then return DataPing:GetValue() / (div or 1) end
    return 50 / (div or 1)
end
local function pingCompensatedRange(range) return range + (pingScaledDelay() - 50) * -0.0003846 end

