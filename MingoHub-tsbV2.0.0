        pClose.MouseButton1Click:Connect(function() dashPopup:Destroy(); dashPopup = nil end)
        local pScroll = Instance.new("ScrollingFrame")
        pScroll.Size = UDim2.new(1, -20, 1, -BAR_H - 10)
        pScroll.Position = UDim2.fromOffset(10, BAR_H + 5)
        pScroll.BackgroundTransparency = 1
        pScroll.BorderSizePixel = 0
        pScroll.ScrollBarThickness = 2
        pScroll.ScrollBarImageColor3 = Palette.Accent
        pScroll.CanvasSize = UDim2.new()
        pScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        pScroll.ZIndex = 5
        pScroll:SetAttribute("ThemeRole", "scroll")
        pScroll.Parent = pWindow
        local pLay = Instance.new("UIListLayout")
        pLay.Padding = UDim.new(0, 6)
        pLay.SortOrder = Enum.SortOrder.LayoutOrder
        pLay.Parent = pScroll
        local pPad = Instance.new("UIPadding")
        pPad.PaddingTop = UDim.new(0, 2); pPad.PaddingBottom = UDim.new(0, 4)
        pPad.PaddingLeft = UDim.new(0, 2); pPad.PaddingRight = UDim.new(0, 4)
        pPad.Parent = pScroll

        addTextbox(pScroll, "Start Flick Angle", "degrees -360 to 360", cfgTable.StartFlickAngle, function(v) cfgTable.StartFlickAngle = tonumber(v) or 0 end, true)
        addTextbox(pScroll, "Second Flick Angle", "degrees -360 to 360", cfgTable.SecondFlickAngle, function(v) cfgTable.SecondFlickAngle = tonumber(v) or 0 end, true)
        addTextbox(pScroll, "Second Flick Delay", "seconds (e.g. 0.05)", cfgTable.SecondFlickDelay, function(v) cfgTable.SecondFlickDelay = tonumber(v) or 0 end, true)
        if mode == "v2" then
            addTextbox(pScroll, "Second Flick Duration", "seconds (smooth rotate)", cfgTable.SecondFlickDuration, function(v) cfgTable.SecondFlickDuration = tonumber(v) or 0 end, true)
        end
        addTextbox(pScroll, "Third Flick Angle", "degrees -360 to 360", cfgTable.ThirdFlickAngle, function(v) cfgTable.ThirdFlickAngle = tonumber(v) or 0 end, true)
        addTextbox(pScroll, "Third Flick Delay", "seconds (e.g. 0.05)", cfgTable.ThirdFlickDelay, function(v) cfgTable.ThirdFlickDelay = tonumber(v) or 0 end, true)
        if mode == "v2" then
            addTextbox(pScroll, "Third Flick Duration", "seconds (smooth rotate)", cfgTable.ThirdFlickDuration, function(v) cfgTable.ThirdFlickDuration = tonumber(v) or 0 end, true)
        end
        addToggle(pScroll, "Jump", "small vertical boost on start", cfgTable.Jump, function(v) cfgTable.Jump = v end)
        addToggle(pScroll, "Rotate Camera", "turn the camera too", cfgTable.RotateCam, function(v) cfgTable.RotateCam = v end)
        addToggle(pScroll, "Lock On", "aim at target after flicks", cfgTable.LockOn, function(v) cfgTable.LockOn = v end)
        addDropdown(pScroll, "Lock On After", "which flick precedes lock-on", { "Second Flick", "Third Flick" }, cfgTable.LockOnAfter, function(v) cfgTable.LockOnAfter = v end)
        addTextbox(pScroll, "Lock On Precision", "0-1", cfgTable.LockOnPrecision, function(v) cfgTable.LockOnPrecision = tonumber(v) or 0.35 end, true)
        addTextbox(pScroll, "Lock On Delay", "seconds", cfgTable.LockOnDelay, function(v) cfgTable.LockOnDelay = tonumber(v) or 0 end, true)

        local pPos = { x = 0, y = -WIN_H/2 }
        local pTarget = { x = 0, y = -WIN_H/2 }
        local pDrag = false
        local pStart, pStartT
        pTitle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                pDrag = true
                pStart = input.Position
                pStartT = { x = pTarget.x, y = pTarget.y }
                tween(pScale, 0.25, { Scale = 1.015 })
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if pDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - pStart
                local vp = gui.AbsoluteSize
                pTarget.x = math.clamp(pStartT.x + delta.X, -vp.X/2, vp.X/2 - WIN_W)
                pTarget.y = math.clamp(pStartT.y + delta.Y, -vp.Y/2, vp.Y/2 - BAR_H)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if pDrag and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                pDrag = false
                tween(pScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
            end
        end)
        RunService.RenderStepped:Connect(function(dt)
            if not dashPopup or not dashPopup.Parent then return end
            local a = 1 - math.exp(-dt * 22)
            local dx, dy = pTarget.x - pPos.x, pTarget.y - pPos.y
            if math.abs(dx) > 0.05 or math.abs(dy) > 0.05 then
                pPos.x += dx * a
                pPos.y += dy * a
                dashPopup.Position = UDim2.new(0.5, pPos.x, 0.5, pPos.y)
            end
        end)
    end

    local main = createTab("Main")
    local playerTab = createTab("Player")
    local exploit = createTab("Exploit")
    local miscTab = createTab("Misc")
    local setting = createTab("Setting")

