-- Drag
local pos = { x = -WIN_W/2, y = -WIN_H/2 }
local target = { x = pos.x, y = pos.y }
local dragging = false
local dragStart, startTarget
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startTarget = {x = target.x, y = target.y}
        tween(winScale, 0.25, {Scale = 1.015})
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        local vp = gui.AbsoluteSize
        local overflow = (WIN_W * (Appearance.Scale or 1) - WIN_W) / 2
        target.x = math.clamp(startTarget.x + delta.X, -vp.X/2 + overflow, vp.X/2 - WIN_W - overflow)
        target.y = math.clamp(startTarget.y + delta.Y, -vp.Y/2 + overflow, vp.Y/2 - BAR_H - overflow)
    end
end)
UIS.InputEnded:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        dragging = false
        tween(winScale, 0.4, {Scale = 1}, Enum.EasingStyle.Back)
    end
end)
RunService.RenderStepped:Connect(function(dt)
    local a = 1 - math.exp(-dt * 22)
    local dx, dy = target.x - pos.x, target.y - pos.y
    if math.abs(dx) > 0.05 or math.abs(dy) > 0.05 then
        pos.x += dx * a
        pos.y += dy * a
        root.Position = UDim2.new(0.5, pos.x, 0.5, pos.y)
    end
end)

-- Sidebar + tabs
local SIDE_W, TAB_H, TAB_GAP = 100, 28, 6
local sidebar = Instance.new("Frame")
sidebar.Size = UDim2.fromOffset(SIDE_W, WIN_H - BAR_H - 8)
sidebar.Position = UDim2.fromOffset(8, BAR_H + 2)
sidebar.BackgroundTransparency = 1
sidebar.ZIndex = 5
sidebar.Parent = window

local pill = Instance.new("Frame")
pill.Size = UDim2.new(1, 0, 0, TAB_H)
pill.BackgroundColor3 = Palette.Accent
pill.BackgroundTransparency = 0.78
pill.BorderSizePixel = 0
pill.Visible = false
pill.ZIndex = 5
pill:SetAttribute("ThemeRole", "accentBg")
pill.Parent = sidebar
corner(pill, 14)
stroke(pill, 1, 0.55)

local tabList = Instance.new("Frame")
tabList.Size = UDim2.fromScale(1, 1)
tabList.BackgroundTransparency = 1
tabList.ZIndex = 6
tabList.Parent = sidebar
local tabLayout = Instance.new("UIListLayout")
tabLayout.Padding = UDim.new(0, TAB_GAP)
tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
tabLayout.Parent = tabList

local pagesHolder = Instance.new("Frame")
pagesHolder.Size = UDim2.fromOffset(WIN_W - SIDE_W - 24, WIN_H - BAR_H - 8)
pagesHolder.Position = UDim2.fromOffset(SIDE_W + 16, BAR_H + 2)
pagesHolder.BackgroundTransparency = 1
pagesHolder.ZIndex = 5
pagesHolder.Parent = window

local pages = {}
local tabButtons = {}
local tabNames = {}
local currentTab

local function createPage(name)
    local page = Instance.new("CanvasGroup")
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.GroupTransparency = 1
    page.ZIndex = 5
    page.Parent = pagesHolder

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.fromScale(1, 1)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 2
    scroll.ScrollBarImageColor3 = Palette.Accent
    scroll.CanvasSize = UDim2.new()
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.ZIndex = 5
    scroll:SetAttribute("ThemeRole", "scroll")
    scroll.Parent = page

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = scroll
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 2)
    pad.PaddingBottom = UDim.new(0, 38)
    pad.PaddingLeft = UDim.new(0, 2)
    pad.PaddingRight = UDim.new(0, 4)
    pad.Parent = scroll
    pages[name] = { page = page, scroll = scroll }
end

local function selectTab(name, instant)
    local targetData = pages[name]
    if not targetData then return end
    if not instant and currentTab == name and targetData.page.Visible then return end
    currentTab = name
    local index = table.find(tabNames, name) or 1
    pill.Visible = true
    if instant then
        pill.Position = UDim2.fromOffset(0, (index - 1) * (TAB_H + TAB_GAP))
    else
        tween(pill, 0.30, {Position = UDim2.fromOffset(0, (index - 1) * (TAB_H + TAB_GAP))})
    end
    for tabName, btn in pairs(tabButtons) do
        tween(btn, 0.18, {TextColor3 = tabName == name and Color3.new(1,1,1) or Color3.fromRGB(180, 190, 220)})
    end
    for tabName, data in pairs(pages) do
        data.page.Visible = tabName == name
        data.page.GroupTransparency = tabName == name and 0 or 1
        data.page.Position = UDim2.fromOffset(tabName == name and 0 or 5, 0)
    end
end

local function createTab(name)
    table.insert(tabNames, name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, TAB_H)
    btn.BackgroundColor3 = Palette.Accent
    btn.BackgroundTransparency = 1
    btn.Text = "   " .. name
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.TextColor3 = Color3.fromRGB(175, 175, 188)
    btn.Font = FONT
    btn.TextSize = 12
    btn.AutoButtonColor = false
    btn.LayoutOrder = #tabNames
    btn.ZIndex = 7
    btn.Parent = tabList
    corner(btn, 14)
    tabButtons[name] = btn
    btn.Activated:Connect(function() selectTab(name) end)
    createPage(name)
    return pages[name].scroll
end

-- Control builders
local orderCounters = {}
local function nextOrder(parent)
    orderCounters[parent] = (orderCounters[parent] or 0) + 1
    return orderCounters[parent]
end

local function baseRow(parent, height)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, height)
    row.BackgroundColor3 = SURFACE_COLOR
    row.BackgroundTransparency = 0.48
    row.BorderSizePixel = 0
    row.LayoutOrder = nextOrder(parent)
    row.ZIndex = 5
    row.Parent = parent
    corner(row, 14)
    stroke(row, 1, 0.65)
    row.MouseEnter:Connect(function() tween(row, 0.25, {BackgroundTransparency = 0.32}) end)
    row.MouseLeave:Connect(function() tween(row, 0.35, {BackgroundTransparency = 0.48}) end)
    return row
end

local function rowLabels(row, text, desc)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -70, 0, 16)
    label.Position = UDim2.fromOffset(10, 6)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1,1,1)
    label.Font = FONT
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 6
    label.Parent = row
    if desc and desc ~= "" then
        local detail = Instance.new("TextLabel")
        detail.Size = UDim2.new(1, -70, 0, 14)
        detail.Position = UDim2.fromOffset(10, 22)
        detail.BackgroundTransparency = 1
        detail.Text = desc
        detail.TextColor3 = Color3.fromRGB(190, 199, 230)
        detail.Font = FONT
        detail.TextSize = 9
        detail.TextXAlignment = Enum.TextXAlignment.Left
        detail.ZIndex = 6
        detail.Parent = row
    end
end

local function addSection(page, text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 18)
    label.BackgroundTransparency = 1
    label.Text = string.upper(text)
    label.TextColor3 = Palette.Accent
    label.Font = FONT_BOLD
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.LayoutOrder = nextOrder(page)
    label.ZIndex = 6
    label:SetAttribute("ThemeRole", "accentText")
    label.Parent = page
end

local function addToggle(page, text, desc, default, callback, getter)
    local row = baseRow(page, 42)
    rowLabels(row, text, desc)
    local state = default and true or false
    local track = Instance.new("TextButton")
    track.Size = UDim2.fromOffset(38, 20)
    track.Position = UDim2.new(1, -48, 0.5, -10)
    track.Text = ""
    track.AutoButtonColor = false
    track.BackgroundColor3 = state and Palette.Accent or Palette.Off
    track.ZIndex = 6
    track:SetAttribute("ThemeRole", "toggle")
    track:SetAttribute("ToggleState", state)
    track.Parent = row
    corner(track, 10)
    stroke(track, 1, 0.6)
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(16, 16)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.ZIndex = 7
    knob.Parent = track
    corner(knob, 8)
    local function render(animate)
        local x = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        tween(track, animate and 0.25 or 0, {BackgroundColor3 = state and Palette.Accent or Palette.Off})
        tween(knob, animate and 0.35 or 0, {Position = x}, Enum.EasingStyle.Back)
    end
    render(false)
    track.MouseButton1Click:Connect(function()
        state = not state
        track:SetAttribute("ToggleState", state)
        render(true)
        if callback then callback(state) end
    end)
    if getter then
        registerControl(function()
            state = getter() and true or false
            track:SetAttribute("ToggleState", state)
            render(false)
        end)
    end
    return track
end

local function addTextbox(page, text, desc, default, callback, isNumeric, getter)
    local row = baseRow(page, 42)
    rowLabels(row, text, desc)
    local box = Instance.new("TextBox")
    box.Size = UDim2.fromOffset(60, 22)
    box.Position = UDim2.new(1, -70, 0.5, -11)
    box.BackgroundColor3 = Palette.Button
    box.BackgroundTransparency = 0.36
    box.Text = tostring(default or "")
    box.TextColor3 = Color3.new(1,1,1)
    box.Font = FONT
    box.TextSize = 12
    box.ClearTextOnFocus = false
    box.ZIndex = 7
    box:SetAttribute("ThemeRole", "field")
    box.Parent = row
    corner(box, 10)
    stroke(box, 1, 0.6)
    box.FocusLost:Connect(function()
        local val = box.Text
        if isNumeric then
            val = tonumber(val) or default
            box.Text = tostring(val)
        end
        if callback then
            local ret = callback(val)
            if ret ~= nil then box.Text = tostring(ret) end
        end
    end)
    if getter then
        registerControl(function()
            local v = getter()
            if v ~= nil then box.Text = tostring(v) end
        end)
    end
    return box
end

local function addSlider(page, text, desc, min, max, value, callback, getter)
    local row = baseRow(page, 42)
    rowLabels(row, text, desc)
    local box = Instance.new("TextBox")
    box.Size = UDim2.fromOffset(48, 18)
    box.Position = UDim2.new(1, -56, 0, 4)
    box.BackgroundColor3 = Palette.Button
    box.BackgroundTransparency = 0.36
    box.Text = tostring(value)
    box.TextColor3 = Color3.new(1,1,1)
    box.Font = FONT
    box.TextSize = 10
    box.ClearTextOnFocus = false
    box.ZIndex = 7
    box:SetAttribute("ThemeRole", "field")
    box.Parent = row
    corner(box, 8)
    stroke(box, 1, 0.6)
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -150, 0, 6)
    track.Position = UDim2.new(0, 10, 1, -12)
    track.BackgroundColor3 = Palette.Off
    track.BorderSizePixel = 0
    track.ZIndex = 6
    track.Parent = row
    corner(track, 3)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = Palette.Accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 7
    fill.Parent = track
    corner(fill, 3)
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(12, 12)
    knob.Position = UDim2.new(0, -6, 0.5, -6)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.ZIndex = 8
    knob.Parent = track
    corner(knob, 6)
    local current = math.clamp(tonumber(value) or min, min, max)
    local function render()
        local t = (current - min) / math.max(max - min, 1)
        fill.Size = UDim2.new(t, 0, 1, 0)
        knob.Position = UDim2.new(t, -6, 0.5, -6)
        box.Text = tostring(math.floor(current + 0.5))
    end
    local function setValue(v)
        current = math.clamp(math.floor(tonumber(v) or min), min, max)
        render()
        if callback then callback(current) end
    end
    render()
    local isDragging = false
    local function updateFromX(x)
        local ax, aw = track.AbsolutePosition.X, math.max(track.AbsoluteSize.X, 1)
        local t = math.clamp((x - ax) / aw, 0, 1)
        current = math.floor(min + t * (max - min) + 0.5)
        render()
        if callback then callback(current) end
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            updateFromX(input.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            isDragging = false
        end
    end)
    box.FocusLost:Connect(function() setValue(box.Text) end)
    if getter then
        registerControl(function()
            local v = getter()
            if v ~= nil then current = math.clamp(math.floor(tonumber(v) or min), min, max) render() end
        end)
    end
    return { set = setValue, get = function() return current end }
end

local function addButton(page, text, desc, callback, label)
    local row = baseRow(page, 42)
    rowLabels(row, text, desc)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(80, 22)
    btn.Position = UDim2.new(1, -90, 0.5, -11)
    btn.BackgroundColor3 = Palette.Button
    btn.BackgroundTransparency = 0.04
    btn.Text = label or "Open"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = FONT_BOLD
    btn.TextSize = 11
    btn.AutoButtonColor = false
    btn.ZIndex = 7
    btn:SetAttribute("ThemeRole", "button")
    btn.Parent = row
    corner(btn, 10)
    stroke(btn, 1, 0.4)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local keybindListening = false
local function addKeybind(page, text, desc, default, callback, onChange, getter)
    local row = baseRow(page, 42)
    rowLabels(row, text, desc)
    local keyBtn = Instance.new("TextButton")
    keyBtn.Size = UDim2.fromOffset(72, 22)
    keyBtn.Position = UDim2.new(1, -72, 0.5, -11)
    keyBtn.BackgroundColor3 = Palette.Button
    keyBtn.BackgroundTransparency = 0.36
    keyBtn.TextColor3 = Color3.new(1,1,1)
    keyBtn.Font = FONT
    keyBtn.TextSize = 11
    keyBtn.AutoButtonColor = false
    keyBtn.ZIndex = 7
    keyBtn:SetAttribute("ThemeRole", "field")
    keyBtn.Parent = row
    corner(keyBtn, 10)
    stroke(keyBtn, 1, 0.6)
    local boundKey = default
    local function renderKey() keyBtn.Text = boundKey and boundKey.Name or "None" end
    renderKey()
    keyBtn.MouseButton1Click:Connect(function()
        if keybindListening then return end
        keybindListening = true
        keyBtn.Text = "Press key..."
        local conn
        conn = UIS.InputBegan:Connect(function(input, gpe)
            if not gpe and input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode ~= Enum.KeyCode.Escape then
                    boundKey = input.KeyCode
                    if onChange then onChange(boundKey) end
                end
                renderKey()
                keybindListening = false
                conn:Disconnect()
            end
        end)
    end)
    UIS.InputBegan:Connect(function(input, gpe)
        if gpe or not boundKey then return end
        if input.KeyCode == boundKey then
            if callback then callback() end
        end
    end)
    if getter then
        registerControl(function()
            local v = getter()
            if v then boundKey = v renderKey() end
        end)
    end
    return keyBtn
end

local function addDropdown(page, text, desc, options, default, callback, getter)
    local row = baseRow(page, 42)
    rowLabels(row, text, desc)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(100, 22)
    btn.Position = UDim2.new(1, -110, 0.5, -11)
    btn.BackgroundColor3 = Palette.Button
    btn.BackgroundTransparency = 0.36
    btn.Text = tostring(default or "Select")
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = FONT
    btn.TextSize = 11
    btn.AutoButtonColor = false
    btn.ZIndex = 7
    btn:SetAttribute("ThemeRole", "field")
    btn.Parent = row
    corner(btn, 10)
    stroke(btn, 1, 0.6)
    local selected = default
    btn.MouseButton1Click:Connect(function()
        if #options == 0 then return end
        local idx = table.find(options, selected) or 0
        idx = idx % #options + 1
        selected = options[idx]
        btn.Text = selected
        if callback then callback(selected) end
    end)
    if getter then
        registerControl(function()
            local v = getter()
            if v ~= nil then selected = v btn.Text = tostring(v) end
        end)
    end
    return { get = function() return selected end, button = btn }
end

local function addColorRow(page, text, desc, getColor, onApply)
    local row = baseRow(page, 42)
    rowLabels(row, text, desc)
    local swatch = Instance.new("TextButton")
    swatch.Size = UDim2.fromOffset(58, 24)
    swatch.Position = UDim2.new(1, -68, 0.5, -12)
    swatch.Text = ""
    swatch.Font = FONT_BOLD
    swatch.TextSize = 8
    swatch.AutoButtonColor = false
    swatch.ZIndex = 7
    swatch.Parent = row
    corner(swatch, 10)
    stroke(swatch, 1, 0.25)
    local function renderSwatch()
        local c = getColor()
        swatch.BackgroundColor3 = c
        swatch.Text = colorToHex(c)
        local lum = c.R * 0.299 + c.G * 0.587 + c.B * 0.114
        swatch.TextColor3 = lum > 0.62 and Color3.fromRGB(20, 22, 34) or Color3.new(1,1,1)
    end
    renderSwatch()
    swatch.MouseButton1Click:Connect(function()
        local existing = gui:FindFirstChild("ColorPicker")
        if existing then existing:Destroy() end
        local overlay = Instance.new("TextButton")
        overlay.Name = "ColorPicker"
        overlay.Size = UDim2.fromScale(1, 1)
        overlay.BackgroundColor3 = Color3.fromRGB(3, 5, 12)
        overlay.BackgroundTransparency = 0.45
        overlay.Text = ""
        overlay.AutoButtonColor = false
        overlay.ZIndex = 500
        overlay.Parent = gui
        local card = Instance.new("TextButton")
        card.Size = UDim2.fromOffset(280, 320)
        card.Position = UDim2.fromScale(0.5, 0.5)
        card.AnchorPoint = Vector2.new(0.5, 0.5)
        card.BackgroundColor3 = Color3.fromRGB(16, 20, 40)
        card.BackgroundTransparency = 0.03
        card.Text = ""
        card.AutoButtonColor = false
        card.BorderSizePixel = 0
        card.ZIndex = 501
        card.Parent = overlay
        corner(card, 16)
        stroke(card, 1.5, 0.3)
        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, -40, 0, 24)
        title.Position = UDim2.fromOffset(16, 12)
        title.BackgroundTransparency = 1
        title.Text = text
        title.TextColor3 = Color3.fromRGB(226, 232, 255)
        title.Font = FONT_BOLD
        title.TextSize = 13
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.ZIndex = 502
        title.Parent = card
        local h, s, v = Color3.toHSV(getColor())
        local current = getColor()
        local preview = Instance.new("Frame")
        preview.Size = UDim2.fromOffset(52, 32)
        preview.Position = UDim2.fromOffset(16, 48)
        preview.BackgroundColor3 = current
        preview.BorderSizePixel = 0
        preview.ZIndex = 502
        preview.Parent = card
        corner(preview, 10)
        stroke(preview, 1, 0.3)
        local hex = Instance.new("TextBox")
        hex.Size = UDim2.fromOffset(104, 32)
        hex.Position = UDim2.fromOffset(76, 48)
        hex.BackgroundColor3 = Color3.fromRGB(40, 47, 76)
        hex.Text = colorToHex(current)
        hex.TextColor3 = Color3.new(1,1,1)
        hex.Font = FONT
        hex.TextSize = 12
        hex.ClearTextOnFocus = false
        hex.ZIndex = 503
        hex.Parent = card
        corner(hex, 10)
        stroke(hex, 1, 0.4)
        local sv = Instance.new("TextButton")
        sv.Size = UDim2.fromOffset(248, 148)
        sv.Position = UDim2.fromOffset(16, 90)
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        sv.BorderSizePixel = 0
        sv.Text = ""
        sv.AutoButtonColor = false
        sv.ClipsDescendants = true
        sv.ZIndex = 502
        sv.Parent = card
        corner(sv, 8)
        local white = Instance.new("Frame")
        white.Size = UDim2.fromScale(1, 1)
        white.BackgroundColor3 = Color3.new(1,1,1)
        white.BorderSizePixel = 0
        white.ZIndex = 503
        white.Parent = sv
        local wg = Instance.new("UIGradient")
        wg.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
        wg.Parent = white
        local black = Instance.new("Frame")
        black.Size = UDim2.fromScale(1, 1)
        black.BackgroundColor3 = Color3.new(0,0,0)
        black.BorderSizePixel = 0
        black.ZIndex = 504
        black.Parent = sv
        local bg2 = Instance.new("UIGradient")
        bg2.Rotation = 90
        bg2.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)})
        bg2.Parent = black
        local cursor = Instance.new("Frame")
        cursor.Size = UDim2.fromOffset(14, 14)
        cursor.AnchorPoint = Vector2.new(0.5, 0.5)
        cursor.BackgroundTransparency = 1
        cursor.ZIndex = 505
        cursor.Parent = sv
        local cr = Instance.new("UICorner") cr.CornerRadius = UDim.new(1,0) cr.Parent = cursor
        local cs = Instance.new("UIStroke") cs.Color = Color3.new(1,1,1) cs.Thickness = 2 cs.Transparency = 0.05 cs.Parent = cursor
        local hueBar = Instance.new("TextButton")
        hueBar.Size = UDim2.fromOffset(248, 18)
        hueBar.Position = UDim2.fromOffset(16, 246)
        hueBar.BackgroundColor3 = Color3.new(1,1,1)
        hueBar.BorderSizePixel = 0
        hueBar.Text = ""
        hueBar.AutoButtonColor = false
        hueBar.ClipsDescendants = true
        hueBar.ZIndex = 502
        hueBar.Parent = card
        corner(hueBar, 9)
        local hg = Instance.new("UIGradient")
        hg.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
            ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255,255,0)),
            ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0,255,0)),
            ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0,255,255)),
            ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0,0,255)),
            ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255,0,255)),
            ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255,0,0)),
        })
        hg.Parent = hueBar
        local hueCursor = Instance.new("Frame")
        hueCursor.Size = UDim2.fromOffset(6, 22)
        hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
        hueCursor.BackgroundColor3 = Color3.new(1,1,1)
        hueCursor.BorderSizePixel = 0
        hueCursor.ZIndex = 505
        hueCursor.Parent = hueBar
        corner(hueCursor, 3)
        stroke(hueCursor, 1, 0.2)
        local function refresh()
            current = Color3.fromHSV(h, s, v)
            sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            preview.BackgroundColor3 = current
            hex.Text = colorToHex(current)
            cursor.Position = UDim2.new(s, 0, 1 - v, 0)
            hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
        end
        refresh()
        local svDrag, hueDrag = false, false
        local function updateSV(input)
            local ax, ay = sv.AbsolutePosition.X, sv.AbsolutePosition.Y
            local aw, ah = math.max(sv.AbsoluteSize.X, 1), math.max(sv.AbsoluteSize.Y, 1)
            s = math.clamp((input.Position.X - ax) / aw, 0, 1)
            v = 1 - math.clamp((input.Position.Y - ay) / ah, 0, 1)
            refresh()
        end
        local function updateHue(input)
            local ax, aw = hueBar.AbsolutePosition.X, math.max(hueBar.AbsoluteSize.X, 1)
            h = math.clamp((input.Position.X - ax) / aw, 0, 1)
            refresh()
        end
        sv.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                svDrag = true updateSV(input)
            end
        end)
        hueBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                hueDrag = true updateHue(input)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                if svDrag then updateSV(input) end
                if hueDrag then updateHue(input) end
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                svDrag, hueDrag = false, false
            end
        end)
        hex.FocusLost:Connect(function()
            local parsed = hexToColor(hex.Text)
            if parsed then h, s, v = Color3.toHSV(parsed) end
            refresh()
        end)
        local cancelBtn = Instance.new("TextButton")
        cancelBtn.Size = UDim2.fromOffset(120, 30)
        cancelBtn.Position = UDim2.fromOffset(16, 278)
        cancelBtn.BackgroundColor3 = Color3.fromRGB(44, 49, 72)
        cancelBtn.Text = "CANCEL"
        cancelBtn.TextColor3 = Color3.fromRGB(225, 230, 250)
        cancelBtn.Font = FONT_BOLD
        cancelBtn.TextSize = 11
        cancelBtn.AutoButtonColor = false
        cancelBtn.ZIndex = 503
        cancelBtn.Parent = card
        corner(cancelBtn, 10)
        cancelBtn.MouseButton1Click:Connect(function() overlay:Destroy() end)
        local applyBtn = Instance.new("TextButton")
        applyBtn.Size = UDim2.fromOffset(120, 30)
        applyBtn.Position = UDim2.fromOffset(144, 278)
        applyBtn.BackgroundColor3 = current
        applyBtn.Text = "APPLY"
        applyBtn.TextColor3 = Color3.new(1,1,1)
        applyBtn.Font = FONT_BOLD
        applyBtn.TextSize = 11
        applyBtn.AutoButtonColor = false
        applyBtn.ZIndex = 503
        applyBtn.Parent = card
        corner(applyBtn, 10)
        applyBtn.MouseButton1Click:Connect(function()
            if onApply then onApply(current) end
            overlay:Destroy()
        end)
        overlay.MouseButton1Click:Connect(function() overlay:Destroy() end)
        RunService.Heartbeat:Connect(function()
            if not overlay.Parent then return end
            applyBtn.BackgroundColor3 = current
        end)
    end)
    registerControl(renderSwatch)
    return swatch
end

-- =========================================================================
-- Tabs and content
-- =========================================================================
local main = createTab("Main")
local playerTab = createTab("Player")
local exploit = createTab("Exploit")
local miscTab = createTab("Misc")
local setting = createTab("Setting")

-- MAIN — Auto Block
addSection(main, "Auto Block")
addToggle(main, "Enabled", "Toggle auto block", Settings.Autoblock.Enabled,
    function(on) Settings.Autoblock.Enabled = on end,
    function() return Settings.Autoblock.Enabled end)
addTextbox(main, "Auto Block Range", "Radius in studs", Settings.Autoblock.Range,
    function(v) Settings.Autoblock.Range = tonumber(v) or 9 end, true,
    function() return Settings.Autoblock.Range end)
addTextbox(main, "Block Hold (s)", "How long to block", Settings.Autoblock.BlockHold,
    function(v) Settings.Autoblock.BlockHold = tonumber(v) or 0.25 end, true,
    function() return Settings.Autoblock.BlockHold end)
addToggle(main, "Auto Counter", "Use counter tool", Settings.Autoblock.AutoCounter,
    function(on) Settings.Autoblock.AutoCounter = on end,
    function() return Settings.Autoblock.AutoCounter end)
addToggle(main, "Auto M1 Punish", "Click M1 after blocking", Settings.Autoblock.AutoM1,
    function(on) Settings.Autoblock.AutoM1 = on end,
    function() return Settings.Autoblock.AutoM1 end)
addToggle(main, "Dash Prediction", "Predict incoming dashes", Settings.Autoblock.DashPredict,
    function(on) Settings.Autoblock.DashPredict = on end,
    function() return Settings.Autoblock.DashPredict end)
addToggle(main, "Rotate Character", "Ease character towards enemy", Settings.Autoblock.RotateChar,
    function(on) Settings.Autoblock.RotateChar = on end,
    function() return Settings.Autoblock.RotateChar end)
addToggle(main, "Rotate Camera", "Ease camera towards enemy", Settings.Autoblock.RotateCam,
    function(on) Settings.Autoblock.RotateCam = on end,
    function() return Settings.Autoblock.RotateCam end)
addTextbox(main, "Auto Block FOV", "Angle in degrees", Settings.Autoblock.FOV,
    function(v) Settings.Autoblock.FOV = tonumber(v) or 360 end, true,
    function() return Settings.Autoblock.FOV end)
addToggle(main, "Friend Check", "Skip friends in combat logic", Settings.Autoblock.FriendCheck,
    function(on) Settings.Autoblock.FriendCheck = on end,
    function() return Settings.Autoblock.FriendCheck end)

