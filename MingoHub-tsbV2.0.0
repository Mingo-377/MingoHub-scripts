addSection(miscTab, "Configuration")
local nameBox = addTextbox(miscTab, "Config Name", "Name used when saving", "default")
addButton(miscTab, "Save Config", "Save current settings", function()
    local n = sanitize(nameBox.Text)
    if not n then notify("Enter a config name first") return end
    writeText(configPath(n), HttpService:JSONEncode(collectConfig()))
    notify("Saved: " .. n)
end, "Save")
local loadNameBox = addTextbox(miscTab, "Load Name", "Name to load", "default")
addButton(miscTab, "Load Config", "Load settings from a name", function()
    local n = sanitize(loadNameBox.Text)
    if not n then notify("No config name") return end
    local raw = readText(configPath(n))
    if not raw then notify("Config not found: " .. n) return end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if ok and applyConfigTable(data) then notify("Loaded: " .. n)
    else notify("Failed: " .. n) end
end, "Load")
addButton(miscTab, "Delete Config", "Delete the named config", function()
    local n = sanitize(loadNameBox.Text)
    if not n then notify("No config name") return end
    local path = configPath(n)
    memoryFiles[path] = nil
    if fsReady() and type(delfile) == "function" then
        pcall(function() if isfile(path) then delfile(path) end end)
    end
    notify("Deleted: " .. n)
end, "Delete")
addButton(miscTab, "List Configs", "Print config files to console", function()
    local names = listConfigs()
    print("[MingoHub] configs: " .. table.concat(names, ", "))
    notify(#names .. " config(s) in console")
end, "List")

