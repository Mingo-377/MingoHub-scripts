    addDropdown(main, "Tech Mode", "Solitude = magnet on dash", {"Supa", "Lock On Dash", "Loop Dash", "Kiba", "Loop Dash v2", "Custom Dash", "Custom Dash v2", "Solitude Dash"}, Settings.AutoTech.Tech, function(v) Settings.AutoTech.Tech = v end, function() return Settings.AutoTech.Tech end)
