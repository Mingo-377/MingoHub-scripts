-- ── File-scope notify shim ────────────────────────────────
-- extra is local to buildUI(); mingoExt connections fire before buildUI().
-- This shim resolves the real function at call-time via _G, set by buildUI().
_G._mingoNotifyRef = nil   -- buildUI() sets this after createExtraFeatures()
local function mingoNotifyShim(opts)
    local fn = _G._mingoNotifyRef
    if fn then
        if not Settings.MingoNotifs.GlobalEnabled then return end
        local cat = opts and opts.Category
        if cat == "Ult"      and not Settings.MingoNotifs.UltEnabled         then return end
        if cat == "Counter"  and not Settings.MingoNotifs.DeathCounterEnabled then return end
        if cat == "AutoTech" and not Settings.MingoNotifs.AutoTechEnabled     then return end
        if cat == "Fling"    and not Settings.MingoNotifs.FlingEnabled        then return end
        fn(opts)
    end
end

