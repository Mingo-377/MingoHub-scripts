local isDashOnCooldown = false
local function performFrontDash()
    if not isDashOnCooldown and currentCommunicate then
        currentCommunicate:FireServer(leftclick.frontDash)
        if not workspace:GetAttribute("NoDashCooldown") then
            isDashOnCooldown = true
            task.delay(5, function() isDashOnCooldown = false end)
        end
    end
end

local function performDashWithDelay(delay)
    performFrontDash()
    task.wait(pingScaledDelay(1000) + 0.05 + (delay or 0))
end

local function isAnimationPlaying(animId, hum)
    hum = hum or currentHumanoid
    if not hum then return false end
    local animator = hum:FindFirstChild("Animator")
    if not animator then return false end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.Animation and track.Animation.AnimationId == "rbxassetid://" .. tostring(animId) then return true end
    end
    return false
end

local counterLikeAttrs = { "Counter", "AbsoluteImmortal", "AtomicCounter", "HunterCounter", "UpFrames", "Ragdoll", "ForceField", "CanBringUp" }
local enemyBusyAttrs = { "DoingEmote", "CancelEmote", "CancelEmote2", "BeingLaunched", "Freeze" }
local localBusyAttrs = { "Counter", "HunterCounter", "DoingEmote", "CancelEmote", "CancelEmote2", "BeingLaunched", "Ragdoll", "Freeze", "BarrageBind" }
local interruptMoves = {
    "Shove", "Normal Punch", "Uppercut", "Flowing Water", "Lethal Whirlwind Stream", "Hunter's Grasp", "Doom Dive",
    "Crowd Buster", "Hammer Heel", "Binding Cloth", "Jet Dive", "Blitz Shot", "Ignition Burst", "Flash Strike",
    "Scatter", "Explosive Shuriken", "Homerun", "Beatdown", "Four Ball", "Quick Slice", "Atmos Cleave", "Pinpoint Cut",
    "Crushing Pull", "Windstorm Fury", "Stone Coffin", "Expulsive Push", "GoPush", "Vanishing Kick", "Whirlwind Drop",
    "Head First", "Weboom", "Plasma Cannon", "Trinity Tear", "Twin Burst", "TornadoBind"
}
local barrageMoves = { "Consecutive Punches", "Machine Gun Blows", "Bullet Barrage" }
local Distances = { FarDash = 28, NearDash = 22, Barrage = 18, MovingM1 = 15, M1 = 9 }

local function buildSet(arr)
    local s = {}
    for _, v in ipairs(arr) do s[v] = true end
    return s
end

local counterLikeSet = buildSet(counterLikeAttrs)
local enemyBusySet = buildSet(enemyBusyAttrs)
local localBusySet = buildSet(localBusyAttrs)
local interruptMovesSet = buildSet(interruptMoves)
local barrageMovesSet = buildSet(barrageMoves)

local function isFlingTargetValid(char, ignoreSet)
    if not char then return false end
    for _, child in pairs(char:GetChildren()) do
        if ignoreSet[child.Name] then return false end
    end
    return true
end

local function angleBetweenCFrames(part)
    if not currentRootPart or not part then return 0 end
    local look = Vector3.new(currentRootPart.CFrame.LookVector.X, 0, currentRootPart.CFrame.LookVector.Z).Unit
    local vec = part.Position - currentRootPart.Position
    vec = Vector3.new(vec.X, 0, vec.Z)
    if vec.Magnitude == 0 then return 0 end
    return math.deg(math.acos(math.clamp(look:Dot(vec.Unit), -1, 1)))
end

local function isWithinFieldOfView(part, fov)
    return angleBetweenCFrames(part) <= (fov / 2)
end

local blockActive = false
local function fireHoldBlock()
    if not blockActive and currentCommunicate then
        blockActive = true
        currentCommunicate:FireServer(leftclick.holdBlock)
    end
end
local function fireReleaseBlock()
    if blockActive and currentCommunicate then
        blockActive = false
        currentCommunicate:FireServer(leftclick.releaseBlock)
    end
end

local function makeRotCFrame(pos, yaw, pitch)
    workspace.CurrentCamera.CFrame = CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end

local function startSmoothRotateCamToPos(targetPos, duration)
    duration = duration or 0
    local startTick = tick()
    local startCF = workspace.CurrentCamera.CFrame
    local startPos = startCF.Position
    local targetVector = (targetPos - startPos)
    if targetVector.Magnitude < 0.1 then return end
    targetVector = targetVector.Unit
    local startYaw = math.atan2(-startCF.LookVector.X, -startCF.LookVector.Z)
    local targetYaw = math.atan2(-targetVector.X, -targetVector.Z)
    local pitch = math.asin(startCF.LookVector.Y)
    if duration <= 0 then
        makeRotCFrame(startPos, targetYaw, pitch)
        return
    end
    local name = "VelaSmoothRotateCamPos" .. tick()
    RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
        local t = math.clamp((tick() - startTick) / duration, 0, 1)
        local alpha = t * t * (3 - 2 * t)
        local finalYaw = startYaw + (targetYaw - startYaw) * alpha
        makeRotCFrame(startPos, finalYaw, pitch)
        if t >= 1 then RunService:UnbindFromRenderStep(name) end
    end)
end

local function characterRotateEasing(part, hum, duration)
    duration = duration or 0
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not part.Parent or not currentRootPart or not currentRootPart.Parent
            or hum.Health <= 0 or currentHumanoid.Health <= 0 then
            conn:Disconnect()
            return
        end
        if isFlingTargetValid(currentRootPart.Parent, localBusySet) then
            currentHumanoid.AutoRotate = false
            local cf = currentRootPart.CFrame
            local targetPos = Vector3.new(part.Position.X, cf.Position.Y, part.Position.Z)
            local targetCF = CFrame.new(cf.Position, targetPos)
            pcall(function()
                if duration <= 0 then
                    currentRootPart.CFrame = targetCF
                else
                    currentRootPart.CFrame = cf:Lerp(targetCF, math.clamp(dt / duration, 0, 1))
                end
            end)
        end
    end)
    return conn
end

local function stopRotate(conn)
    if conn then
        conn:Disconnect()
        if currentHumanoid then currentHumanoid.AutoRotate = true end
    end
end

local function autoblockEasingTick(part, hum)
    local conn
    if Settings.Autoblock.RotateChar then conn = characterRotateEasing(part, hum, Settings.Autoblock.CharEasing) end
    if Settings.Autoblock.RotateCam then startSmoothRotateCamToPos(part.Position, Settings.Autoblock.CamEasing) end
    return conn
end

local function dashVelocityGuard(part)
    local vel = part.AssemblyLinearVelocity
    if vel.Magnitude < 0.1 then return false end
    local toMe = currentRootPart.Position - part.Position
    if toMe.Magnitude < 0.01 then return false end
    return vel.Unit:Dot(toMe.Unit) > 0.7
end

local function autoCounterCast(enemyRoot, enemyHum, dashPredicted)
    local hotbar = player.PlayerGui:FindFirstChild("Hotbar")
    local backpack = hotbar and hotbar:FindFirstChild("Backpack")
    local hotbarGui = backpack and backpack:FindFirstChild("Hotbar")
    local slot4 = hotbarGui and hotbarGui:FindFirstChild("4")
    local base = slot4 and slot4:FindFirstChild("Base")
    local cooldown = base and base:FindFirstChild("Cooldown")

    if dashPredicted or cooldown or not counterTool or not Settings.Autoblock.AutoCounter then
        return true
    elseif counterTool then
        currentCommunicate:FireServer({
            IsAutoActivate = true, Goal = "Console Move",
            Tool = counterTool, ToolName = counterTool.Name,
        })
        return false
    end
    return true
end

local VirtualInputManager
pcall(function() VirtualInputManager = game:GetService("VirtualInputManager") end)

local function _sendKeyEvent(kc)
    if VirtualInputManager then pcall(function() VirtualInputManager:SendKeyEvent(true, kc, false, game) end) end
end
local function _tapKey(kc)
    if VirtualInputManager then pcall(function() VirtualInputManager:SendKeyEvent(false, kc, false, game) end) end
end

local function autoCounterClicks()
    task.wait()
    if VirtualInputManager then
        pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game) end)
        task.wait()
        pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game) end)
        task.wait()
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(400, 300)
        local hx, hy = math.floor(vp.X / 2), math.floor(vp.Y / 2)
        pcall(function() VirtualInputManager:SendMouseButtonEvent(hx, hy, 0, true, game, 0) end)
        task.wait()
        pcall(function() VirtualInputManager:SendMouseButtonEvent(hx, hy, 0, false, game, 0) end)
    elseif currentCommunicate then
        currentCommunicate:FireServer(leftclick.holdM1)
        task.wait()
        currentCommunicate:FireServer(leftclick.releaseM1)
    end
    task.wait()
end

local function waitForCounterClear(duration, enemyRoot, enemyHum)
    if currentCharacter:FindFirstChild("Counter") then return end
    fireHoldBlock()
    local conn = autoblockEasingTick(enemyRoot, enemyHum)
    task.wait(duration)
    stopRotate(conn)
    fireReleaseBlock()
end

local function waitCanBringUp(enemyRoot, enemyHum)
    if enemyRoot.Parent and isFlingTargetValid(enemyRoot.Parent, counterLikeSet)
        and not currentCharacter:FindFirstChild("CanBringUp") then
        local conn = autoblockEasingTick(enemyRoot, enemyHum)
        autoCounterClicks()
        task.wait(0.1)
        stopRotate(conn)
    end
end

local function autoblockDistanceState(part, hum, dashPredicted)
    if currentCharacter:FindFirstChild("Counter") then return end
    waitForCounterClear(pingCompensatedRange(Settings.Autoblock.BlockHold or 0.25), part, hum)
    local dist = (currentRootPart.Position - part.Position).Magnitude
    local isClose = dist <= (Settings.Autoblock.Range or 9)
    local isMoving = dist <= Distances.MovingM1 and dashVelocityGuard(part)
    if Settings.Autoblock.AutoM1 and (isClose or isMoving or dashPredicted) then
        waitCanBringUp(part, hum)
    end
end

local function autoblockRotateLoop(part, hum, char, dashPredicted)
    local charConn = autoblockEasingTick(part, hum)
    local startTick = tick()
    local loopConn
    loopConn = RunService.Heartbeat:Connect(function()
        fireHoldBlock()
        if char:FindFirstChild("NoBlock") or (currentRootPart.Position - part.Position).Magnitude >= Distances.Barrage + 5 then
            stopRotate(charConn)
            loopConn:Disconnect()
            fireReleaseBlock()
            if Settings.Autoblock.AutoM1 and (currentRootPart.Position - part.Position).Magnitude <= (Settings.Autoblock.Range or 9) then
                waitCanBringUp(part, hum)
            end
            return
        end
        if math.clamp((tick() - startTick) / 0.1, 0, 1) >= 1 and not char:FindFirstChild("Slowed") then
            stopRotate(charConn)
            loopConn:Disconnect()
            fireReleaseBlock()
        end
    end)
end

local function watchEnemyModel(desc)
    if not desc or not Settings.Autoblock.Enabled then return end
    local name = desc.Name
    local isM1ing = name == "M1ing"
    local isInterrupt = interruptMovesSet[name]
    local isBarrage = barrageMovesSet[name]
    if not (isM1ing or isInterrupt or isBarrage) then return end
    if not currentRootPart or not currentCharacter or not currentHumanoid or not currentCommunicate then return end

    local model = desc:FindFirstAncestorWhichIsA("Model") or (desc.Parent and desc.Parent:FindFirstAncestorWhichIsA("Model"))
    if model and not model:FindFirstChild("HumanoidRootPart") then
        local p = model.Parent
        while p and p ~= workspace do
            if p:IsA("Model") and p:FindFirstChild("HumanoidRootPart") then
                model = p
                break
            end
            p = p.Parent
        end
    end
    if not model or model == currentCharacter then return end

    local enemyHum = model:FindFirstChild("Humanoid")
    local enemyRoot = model:FindFirstChild("HumanoidRootPart")
    if not enemyHum or not enemyRoot then return end
    if currentHumanoid.Health <= 0 or enemyHum.Health <= 0 then return end

    local m1Range = Settings.Autoblock.Range or 9
    local dist = (currentRootPart.Position - enemyRoot.Position).Magnitude
    local isMovingM1 = dist <= (m1Range + 6) and dashVelocityGuard(enemyRoot)
    local isDashPredicted = Settings.Autoblock.DashPredict
        and (isAnimationPlaying(animId3, enemyHum) or isAnimationPlaying(animId2, enemyHum))
        and dist <= (m1Range + 19)

    if not (dist <= m1Range or isMovingM1 or isDashPredicted) then return end
    if not isFlingTargetValid(currentCharacter, localBusySet) then return end
    if not isFlingTargetValid(model, enemyBusySet) then return end
    if not isWithinFieldOfView(enemyRoot, Settings.Autoblock.FOV) then return end
    if not autoCounterCast(enemyRoot, enemyHum, isMovingM1) then return end

    if isM1ing then
        autoblockDistanceState(enemyRoot, enemyHum, isDashPredicted)
    elseif isInterrupt then
        autoblockDistanceState(enemyRoot, enemyHum, isDashPredicted)
    elseif isBarrage then
        autoblockRotateLoop(enemyRoot, enemyHum, model, isDashPredicted)
    end
end

local function computeLockAngles(angle, targetPos, lockChar, rotateCam, precision)
    if not currentRootPart or not currentHumanoid then return end
    precision = precision or 1
    local camCF = workspace.CurrentCamera.CFrame
    local camPos = camCF.Position
    if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then camPos = camPos - camCF.RightVector * 1.75 end

    local currentYaw, targetYaw
    if targetPos then
        local targetVector
        if lockChar then
            targetVector = (targetPos - currentRootPart.Position).Unit
            currentYaw = math.atan2(-currentRootPart.CFrame.LookVector.X, -currentRootPart.CFrame.LookVector.Z)
        else
            targetVector = (targetPos - camPos).Unit
            currentYaw = math.atan2(-camCF.LookVector.X, -camCF.LookVector.Z)
        end
        targetYaw = math.atan2(-targetVector.X, -targetVector.Z)
    else
        local lookV = lockChar and currentRootPart.CFrame.LookVector or camCF.LookVector
        currentYaw = math.atan2(-lookV.X, -lookV.Z)
        targetYaw = currentYaw + math.rad(angle or 0)
    end

    local diff = math.atan2(math.sin(targetYaw - currentYaw), math.cos(targetYaw - currentYaw))
    local finalYaw = currentYaw + diff * precision
    local doChar = lockChar or rotateCam
    local doCam = (not lockChar) or rotateCam

    if doChar then
        currentHumanoid.AutoRotate = false
        pcall(function()
            currentRootPart.CFrame = CFrame.new(currentRootPart.Position) * CFrame.Angles(0, finalYaw, 0)
        end)
        if not doCam then return end
    end
    makeRotCFrame(camCF.Position, finalYaw, math.asin(camCF.LookVector.Y))
end

local function startSmoothRotateCamera(angle, duration, rotateChar)
    local startTick = tick()
    local startCF = rotateChar and currentRootPart.CFrame or workspace.CurrentCamera.CFrame
    local startYaw = math.atan2(-startCF.LookVector.X, -startCF.LookVector.Z)
    local targetYaw = startYaw + math.rad(angle)
    local name = "VelaSmoothRotate" .. tick()
    RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
        local t = math.clamp((tick() - startTick) / math.max(duration, 0.001), 0, 1)
        local alpha = t * t * (3 - 2 * t)
        local camCF = workspace.CurrentCamera.CFrame
        local finalYaw = startYaw + (targetYaw - startYaw) * alpha
        if rotateChar then
            currentHumanoid.AutoRotate = false
            pcall(function()
                currentRootPart.CFrame = CFrame.new(currentRootPart.Position) * CFrame.Angles(0, finalYaw, 0)
            end)
        else
            makeRotCFrame(camCF.Position, finalYaw, math.asin(camCF.LookVector.Y))
        end
        if t >= 1 then RunService:UnbindFromRenderStep(name) end
    end)
end

local function ragdollHealthWatcher(method, duration, targetChar, targetHum, callback)
    local conn
    conn = RunService[method]:Connect(function()
        if not targetChar or targetChar:FindFirstChild("BeingLaunched")
            or not targetChar:FindFirstChild("Ragdoll")
            or not targetHum or targetHum.Health <= 0
            or not currentHumanoid or currentHumanoid.Health <= 0 then
            if conn then conn:Disconnect() end
            return
        end
        callback()
    end)
    task.wait(duration)
    if conn then conn:Disconnect() end
    if currentHumanoid then currentHumanoid.AutoRotate = true end
end

local function isTargetAbove(targetHRP)
    local myPos = currentRootPart.Position
    local targetPos = targetHRP.Position
    local hDist = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
    return hDist <= 0.2 and myPos.Y < targetPos.Y
end

local function doTechSupa(target, hrp, hum)
    performDashWithDelay()
    local offset = hrp.CFrame:PointToObjectSpace(currentRootPart.Position)
    ragdollHealthWatcher("Heartbeat", 0.3, target, hum, function()
        local worldPos = hrp.CFrame:PointToWorldSpace(offset)
        pcall(function()
            currentCharacter:PivotTo(CFrame.lookAt(worldPos, Vector3.new(hrp.Position.X, worldPos.Y + 1.5, hrp.Position.Z), Vector3.new(0, 1, 0)))
        end)
    end)
end

local function doTechLockOn(target, hrp, hum)
    performDashWithDelay()
    ragdollHealthWatcher("Heartbeat", 0.7, target, hum, function()
        computeLockAngles(nil, hrp.Position, true, false, Settings.AutoTech.LockonPrecision)
    end)
end

local function doTechLoopDash(target, hrp, hum)
    performDashWithDelay()
    computeLockAngles(90, nil, true)
    startSmoothRotateCamera(270, 0.35, false)
    task.wait(0.3)
    local cachedCF = nil
    ragdollHealthWatcher("Heartbeat", 0.4, target, hum, function()
        if cachedCF or isTargetAbove(hrp) then
            if not cachedCF then cachedCF = currentRootPart.CFrame end
            pcall(function() currentCharacter:PivotTo(cachedCF) end)
        else
            computeLockAngles(nil, hrp.Position, true)
        end
    end)
end

local function doTechKiba(target, hrp, hum)
    performDashWithDelay()
    ragdollHealthWatcher("Heartbeat", 0.4, target, hum, function()
        pcall(function()
            currentCharacter:PivotTo(CFrame.new(hrp.Position - Vector3.new(0, 3, 2), hrp.Position))
        end)
    end)
end

local function doTechLoopV2(target, hrp, hum)
    local c = Settings.AutoTech.Loopv2
    if c.Jump then
        pcall(function()
            currentRootPart.AssemblyLinearVelocity = Vector3.new(currentRootPart.AssemblyLinearVelocity.X, 50, currentRootPart.AssemblyLinearVelocity.Z)
        end)
    end
    computeLockAngles(c.FirstFlickAngle, nil, true, c.RotateCam)
    performDashWithDelay(c.SecondFlick)
    ragdollHealthWatcher("Heartbeat", 0.4, target, hum, function()
        computeLockAngles(nil, hrp.Position, true, c.RotateCam, c.Precision)
    end)
    if currentHumanoid then currentHumanoid.AutoRotate = true end
end

local function doTechCustomDash(target, hrp, hum)
    local c = Settings.AutoTech.Customdash
    if c.Jump then
        pcall(function()
            currentRootPart.AssemblyLinearVelocity = Vector3.new(currentRootPart.AssemblyLinearVelocity.X, 50, currentRootPart.AssemblyLinearVelocity.Z)
        end)
    end
    computeLockAngles(c.StartFlickAngle, nil, true, c.RotateCam)
    performDashWithDelay(c.SecondFlickDelay)
    computeLockAngles(c.SecondFlickAngle, nil, true, c.RotateCam)
    if c.LockOn and c.LockOnAfter == "Second Flick" then
        task.wait(c.LockOnDelay)
        ragdollHealthWatcher("Heartbeat", 0.4, target, hum, function()
            computeLockAngles(nil, hrp.Position, true, c.RotateCam, c.LockOnPrecision)
        end)
    else
        task.wait(c.ThirdFlickDelay)
        computeLockAngles(c.ThirdFlickAngle, nil, true, c.RotateCam)
        if c.LockOn and c.LockOnAfter == "Third Flick" then
            task.wait(c.LockOnDelay)
            ragdollHealthWatcher("Heartbeat", 0.4, target, hum, function()
                computeLockAngles(nil, hrp.Position, true, c.RotateCam, c.LockOnPrecision)
            end)
        end
    end
    if currentHumanoid then currentHumanoid.AutoRotate = true end
end

local function doTechCustomDashV2(target, hrp, hum)
    local c = Settings.AutoTech.Customdashv2
    if c.Jump then
        pcall(function()
            currentRootPart.AssemblyLinearVelocity = Vector3.new(currentRootPart.AssemblyLinearVelocity.X, 50, currentRootPart.AssemblyLinearVelocity.Z)
        end)
    end
    computeLockAngles(c.StartFlickAngle, nil, true, c.RotateCam)
    performDashWithDelay(c.SecondFlickDelay)
    startSmoothRotateCamera(c.SecondFlickAngle, c.SecondFlickDuration, not c.RotateCam)
    if c.LockOn and c.LockOnAfter == "Second Flick" then
        task.wait(c.LockOnDelay)
        ragdollHealthWatcher("Heartbeat", 0.4, target, hum, function()
            computeLockAngles(nil, hrp.Position, true, c.RotateCam, c.LockOnPrecision)
        end)
    else
        task.wait(c.ThirdFlickDelay)
        startSmoothRotateCamera(c.ThirdFlickAngle, c.ThirdFlickDuration, not c.RotateCam)
        if c.LockOn and c.LockOnAfter == "Third Flick" then
            task.wait(c.LockOnDelay)
            ragdollHealthWatcher("Heartbeat", 0.4, target, hum, function()
                computeLockAngles(nil, hrp.Position, true, c.RotateCam, c.LockOnPrecision)
            end)
        end
    end
    if currentHumanoid then currentHumanoid.AutoRotate = true end
end

local TECH_HANDLERS = {
    ["Supa"] = doTechSupa,
    ["Lock On Dash"] = doTechLockOn,
    ["Loop Dash"] = doTechLoopDash,
    ["Kiba"] = doTechKiba,
    ["Loop Dash v2"] = doTechLoopV2,
    ["Custom Dash"] = doTechCustomDash,
    ["Custom Dash v2"] = doTechCustomDashV2,
}

local flingState = { savedDestroy = nil, busy = false, loopRunning = false }

local function findFlingTarget()
    local name = tostring(Settings.Player.Fling.Target or ""):match("^%s*(.-)%s*$")
    if name == "" then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and (plr.Name == name or plr.DisplayName == name) then
            return plr.Character
        end
    end
    return nil
end

local function doFlingOnce(targetChar)
    if not currentRootPart or not currentCharacter or not targetChar then return end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    if flingState.savedDestroy == nil then
        flingState.savedDestroy = workspace.FallenPartsDestroyHeight
    end
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    local origCF = currentRootPart.CFrame
    local startT = tick()
    local n = 0
    while tick() - startT < 1.5 and currentRootPart and currentRootPart.Parent and targetRoot.Parent do
        n += 1
        pcall(function()
            local cf = CFrame.new(targetRoot.Position) * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(n * 100), 0, 0)
            currentRootPart.CFrame = cf
            if currentCharacter.PrimaryPart then currentCharacter:PivotTo(cf) end
            currentRootPart.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
            currentRootPart.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
        end)
        task.wait()
    end
    if currentRootPart and currentRootPart.Parent and currentCharacter then
        pcall(function()
            currentRootPart.CFrame = origCF
            if currentCharacter.PrimaryPart then currentCharacter:PivotTo(origCF) end
            currentRootPart.AssemblyLinearVelocity = Vector3.zero
            currentRootPart.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    if flingState.savedDestroy ~= nil then
        pcall(function() workspace.FallenPartsDestroyHeight = flingState.savedDestroy end)
        flingState.savedDestroy = nil
    end
end

local function runFlingOnce()
    if flingState.busy then return end
    local target = findFlingTarget()
    if not target then notifySystem("Fling: target not found", 2) return end
    flingState.busy = true
    local ok, err = pcall(doFlingOnce, target)
    if not ok then warn("[MingoHub] Fling failed: " .. tostring(err)) end
    flingState.busy = false
end

local function startFlingLoop()
    if flingState.loopRunning then return end
    flingState.loopRunning = true
    task.spawn(function()
        while flingState.loopRunning and Settings.Player.Fling.LoopFling do
            local target = findFlingTarget()
            if target then
                flingState.busy = true
                pcall(doFlingOnce, target)
                flingState.busy = false
            end
            task.wait(0.5)
        end
        flingState.loopRunning = false
    end)
end

local function stopFlingLoop()
    flingState.loopRunning = false
    Settings.Player.Fling.LoopFling = false
end

local function applyHeadless(char)
    local head = char:FindFirstChild("Head")
    local face = head and head:FindFirstChild("face")
    if Settings.Player.Headless then
        if head then head.Transparency = 1 end
        if face then face.Transparency = 1 end
    else
        if head then head.Transparency = 0 end
        if face then face.Transparency = 0 end
    end
end

local korbloxOriginals = setmetatable({}, { __mode = "k" })
local korbloxApplied = setmetatable({}, { __mode = "k" })

local function applyKorblox(char)
    if not char then return end
    local on = Settings.Player.Korblox
    local upper = char:FindFirstChild("RightUpperLeg")
    local lower = char:FindFirstChild("RightLowerLeg")
    local foot = char:FindFirstChild("RightFoot")
    if upper and lower and foot and upper:IsA("MeshPart") and lower:IsA("MeshPart") and foot:IsA("MeshPart") then
        if on and not korbloxApplied[upper] then
            local ok = pcall(function()
                for _, part in ipairs({ upper, lower, foot }) do
                    if not korbloxOriginals[part] then
                        korbloxOriginals[part] = { mesh = part.MeshId, tex = part.TextureID, transparency = part.Transparency }
                    end
                end
                lower.MeshId = "rbxassetid://902942093"
                upper.MeshId = "rbxassetid://902942096"
                foot.MeshId = "rbxassetid://902942089"
                upper.TextureID = "rbxassetid://902843398"
                lower.Transparency = 1
                foot.Transparency = 1
            end)
            if ok then korbloxApplied[upper] = true end
        elseif (not on) and korbloxApplied[upper] then
            pcall(function()
                for _, part in ipairs({ upper, lower, foot }) do
                    local o = korbloxOriginals[part]
                    if o then
                        part.MeshId = o.mesh
                        part.TextureID = o.tex
                        part.Transparency = o.transparency
                    end
                end
            end)
            korbloxApplied[upper] = nil
        end
    end
    if char:FindFirstChild("Right Leg") then
        local existing = char:FindFirstChild("VelaKorblox")
        if on and not existing then
            pcall(function()
                local cm = Instance.new("CharacterMesh")
                cm.Name = "VelaKorblox"
                cm.BodyPart = Enum.BodyPart.RightLeg
                cm.MeshId = 101851696
                cm.OverlayTextureId = 101851254
                cm.Parent = char
            end)
        elseif (not on) and existing then
            existing:Destroy()
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if Settings.Player.Korblox and currentCharacter then
            applyKorblox(currentCharacter)
        end
    end
end)

local function applyPlayerVis(char)
    if not char then return end
    task.spawn(function()
        task.wait(0.5)
        applyHeadless(char)
        applyKorblox(char)
    end)
end

local antiDeathConn
local function applyAntiDeathCounter()
    if antiDeathConn then
        antiDeathConn:Disconnect()
        antiDeathConn = nil
    end
    if not Settings.Player.AntiDeathCounter then return end
    antiDeathConn = RunService.Heartbeat:Connect(function()
        if not currentCharacter then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local counter = plr.Character:FindFirstChild("Counter")
                if counter then pcall(function() counter:Destroy() end) end
            end
        end
    end)
end

RunService.Heartbeat:Connect(function()
    if Settings.Player.WalkSpeedEnabled and currentHumanoid then
        if currentHumanoid.WalkSpeed ~= Settings.Player.WalkSpeed then
            currentHumanoid.WalkSpeed = Settings.Player.WalkSpeed
        end
    end
end)

local dashStates = {}
local rootChildConn

local function getDashVel(inst)
    if inst:IsA("BodyVelocity") then return inst.Velocity end
    return inst.VectorVelocity
end

local function setDashVel(inst, v)
    if inst:IsA("BodyVelocity") then
        inst.Velocity = v
    else
        inst.VectorVelocity = v
    end
end

local function classifyDash(vel)
    local cam = workspace.CurrentCamera
    if not cam then return "None" end
    local flat = Vector3.new(vel.X, 0, vel.Z)
    local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
    if flat.Magnitude < 1 or look.Magnitude < 0.01 then return "None" end
    local dot = flat.Unit:Dot(look.Unit)
    if dot < -0.5 then return "Back" end
    if math.abs(dot) <= 0.5 then return "Side" end
    return "Front"
end

local function trackDashRange(inst)
    if inst:IsA("BodyVelocity") or inst:IsA("LinearVelocity") then
        dashStates[inst] = { kind = false }
    end
end

RunService.Heartbeat:Connect(function()
    if next(dashStates) == nil then return end
    local P = Settings.Player
    for inst, st in pairs(dashStates) do
        if not inst.Parent then
            dashStates[inst] = nil
        else
            local ok, cur = pcall(getDashVel, inst)
            if ok and cur then
                if st.kind == false and Vector3.new(cur.X, 0, cur.Z).Magnitude >= 1 then
                    local kind = classifyDash(cur)
                    local range
                    if kind == "Side" and P.SideDashEnabled then
                        range = P.SideDashRange
                    elseif kind == "Back" and P.BackDashEnabled then
                        range = P.BackDashRange
                    end
                    if range then
                        st.kind = kind
                        st.mult = (tonumber(range) or 15) / 15
                        st.base = cur
                    else
                        st.kind = "Skip"
                    end
                end
                if st.mult then
                    if st.last and (cur - st.last).Magnitude > 0.05 then st.base = cur end
                    local scaled = Vector3.new(st.base.X * st.mult, st.base.Y, st.base.Z * st.mult)
                    st.last = scaled
                    pcall(setDashVel, inst, scaled)
                end
            end
        end
    end
end)

local SOLITUDE_ANIM_A, SOLITUDE_ANIM_B = "10479335397", "13380255751"
local solitudeDashVelocity
local solitudePullConn
local solitudeNpcList, solitudeLastNpcUpdate = {}, 0

local function solitudeActive()
    return Settings.AutoTech.Enabled and Settings.AutoTech.Tech == "Solitude Dash"
end

local function updateSolitudeNpcCache()
    solitudeNpcList = {}
    if not currentRootPart then return end
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and model:FindFirstChild("Humanoid") and model:FindFirstChild("HumanoidRootPart") then
            local root = model.HumanoidRootPart
            if root ~= currentRootPart then
                table.insert(solitudeNpcList, root)
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    if not solitudeActive() then return end
    if tick() - solitudeLastNpcUpdate > 0.5 then
        solitudeLastNpcUpdate = tick()
        updateSolitudeNpcCache()
    end
end)

local function solitudeClosestTarget()
    if not currentRootPart then return nil end
    local closestRoot = nil
    local shortestDistance = math.huge
    local myPos = currentRootPart.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (myPos - root.Position).Magnitude
                if dist < shortestDistance and dist > 0.1 then
                    shortestDistance = dist
                    closestRoot = root
                end
            end
        end
    end
    for _, npcRoot in ipairs(solitudeNpcList) do
        if npcRoot and npcRoot.Parent then
            local dist = (myPos - npcRoot.Position).Magnitude
            if dist < shortestDistance and dist > 0.1 then
                shortestDistance = dist
                closestRoot = npcRoot
            end
        end
    end
    return closestRoot
end

local function startSolitudePull()
    if solitudePullConn then solitudePullConn:Disconnect() end
    local startTime = tick()
    local pullDuration = 0.200
    local pullStrength = 50
    local smoothness = 0.65
    solitudePullConn = RunService.Heartbeat:Connect(function()
        if not currentRootPart or not currentRootPart.Parent then
            solitudePullConn:Disconnect()
            solitudePullConn = nil
            return
        end
        local elapsed = tick() - startTime
        if elapsed >= pullDuration then
            solitudePullConn:Disconnect()
            solitudePullConn = nil
            return
        end
        local targetRoot = solitudeClosestTarget()
        if not targetRoot then return end
        local currentPos = currentRootPart.Position
        local targetHorizontal = Vector3.new(targetRoot.Position.X, currentPos.Y, targetRoot.Position.Z)
        local direction = (targetHorizontal - currentPos)
        local distance = direction.Magnitude
        if distance > 1 then
            direction = direction.Unit
            local desiredVel = direction * pullStrength
            local currentVel = currentRootPart.AssemblyLinearVelocity
            local newVel = currentVel:Lerp(desiredVel, smoothness)
            pcall(function()
                currentRootPart.AssemblyLinearVelocity = Vector3.new(newVel.X * 0.85, currentVel.Y, newVel.Z * 0.85)
            end)
        end
    end)
end

local function doSolitudeTPAndStick()
    if not solitudeActive() then return end
    if not currentRootPart or not currentCharacter then return end
    local targetRoot = solitudeClosestTarget()
    if not targetRoot then return end
    local distance = (currentRootPart.Position - targetRoot.Position).Magnitude
    if distance > 6 then return end
    task.wait(Settings.AutoTech.SolitudeDelay)
    if not currentRootPart or not currentRootPart.Parent then return end
    local targetPos = targetRoot.Position + Vector3.new(0, 2, 0)
    pcall(function() currentRootPart.CFrame = CFrame.new(targetPos) end)
    if solitudeDashVelocity and solitudeDashVelocity.Parent then
        solitudeDashVelocity:Destroy()
        solitudeDashVelocity = nil
    end
    if currentRootPart then
        pcall(function()
            local vel = currentRootPart.AssemblyLinearVelocity
            currentRootPart.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
        end)
    end
    startSolitudePull()
end

local function trackSolitudeDash(child)
    if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") then
        solitudeDashVelocity = child
    end
end

local function detectDevice()
    local ok, ten = pcall(function() return game:GetService("GuiService"):IsTenFootInterface() end)
    if ok and ten then return "Console", false end
    local cam = workspace.CurrentCamera
    local small = cam and cam.ViewportSize.X < 900 and UIS.TouchEnabled
    if (UIS.TouchEnabled and not UIS.KeyboardEnabled) or small then return "Mobile", true end
    return "PC", false
end

local DEVICE
DEVICE, isMobile = detectDevice()
local INFO_TEXT = DEVICE .. "  |  RightShift = hide/show"

local function getExecutorName()
    if identifyexecutor then
        local ok, name = pcall(identifyexecutor)
        if ok and name then return tostring(name) end
    end
    if getexecutorname then
        local ok, name = pcall(getexecutorname)
        if ok and name then return tostring(name) end
    end
    if syn and syn.request then return "Synapse X" end
    if KRNL_LOADED then return "Krnl" end
    if FLUXUS_LOADED then return "Fluxus" end
    return "Unknown"
end
local EXECUTOR_NAME = getExecutorName()

local function tween(obj, duration, props, style, direction)
    local t = TweenService:Create(obj, TweenInfo.new(duration, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
    return c
end

local function stroke(parent, thickness, transparency, role)
    local s = Instance.new("UIStroke")
    s.Color = Palette.Border
    s.Thickness = thickness
    s.Transparency = transparency
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s:SetAttribute("ThemeRole", role or "border")
    s.Parent = parent
    return s
end

local function getThumbnail(plr)
    local ok, url = pcall(function()
        return Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
    end)
    return ok and url or ""
end

local orderCounters = {}
local function nextOrder(parent)
    orderCounters[parent] = (orderCounters[parent] or 0) + 1
    return orderCounters[parent]
end

local charCopy = {
    userId = nil, keep = true, name = "", cache = {},
    rigAttachments = buildSet({
        "HatAttachment", "HairAttachment", "FaceFrontAttachment", "FaceCenterAttachment",
        "NeckAttachment", "BodyFrontAttachment", "BodyBackAttachment", "LeftCollarAttachment",
        "RightCollarAttachment", "WaistFrontAttachment", "WaistCenterAttachment", "WaistBackAttachment",
        "LeftShoulderAttachment", "RightShoulderAttachment", "LeftGripAttachment", "RightGripAttachment",
        "LeftFootAttachment", "RightFootAttachment"
    }),
    watch = nil, input = ""
}

function charCopy.resolve(input)
    input = tostring(input or ""):match("^%s*(.-)%s*$")
    if input == "" then return nil end
    if input:match("^%d+$") then return tonumber(input), input end
    local lower = input:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == lower or p.DisplayName:lower() == lower then return p.UserId, p.Name end
    end
    local ok, id = pcall(Players.GetUserIdFromNameAsync, Players, input)
    if ok and id then return id, input end
    return nil
end

function charCopy.build(userId)
    if charCopy.cache[userId] then return charCopy.cache[userId] end
    local ok, desc = pcall(Players.GetHumanoidDescriptionFromUserId, Players, userId)
    if not ok or not desc then return nil, "couldn't get avatar" end
    local rig = (currentHumanoid and currentHumanoid.RigType) or Enum.HumanoidRigType.R6
    local ok2, model = pcall(Players.CreateHumanoidModelFromDescription, Players, desc, rig)
    if not ok2 or not model then return nil, "couldn't load avatar" end
    local data = { model = model, desc = desc }
    charCopy.cache[userId] = data
    return data
end

function charCopy.isOld(char, inst)
    local isAcc = inst:IsA("Accoutrement")
    if not (isAcc or inst:IsA("Clothing") or inst:IsA("ShirtGraphic") or inst:IsA("BodyColors") or inst:IsA("CharacterMesh")) then return false end
    if inst:GetAttribute("KWChar") then return false end
    if isAcc then
        local handle = inst:FindFirstChild("Handle")
        local att = handle and handle:FindFirstChildOfClass("Attachment")
        if not (att and charCopy.rigAttachments[att.Name]) then return false end
    end
    return true
end

function charCopy.weldAccessory(char, acc)
    local handle = acc:FindFirstChild("Handle")
    if not handle then return end
    local att = handle:FindFirstChildOfClass("Attachment")
    local targetAtt
    for _, p in ipairs(char:GetChildren()) do
        if att and p:IsA("BasePart") then
            targetAtt = p:FindFirstChild(att.Name)
            if targetAtt then break end
        end
    end
    acc.Parent = char
    if targetAtt then
        handle.CFrame = targetAtt.WorldCFrame * att.CFrame:Inverse()
        local weld = Instance.new("Weld")
        weld.Part0 = handle
        weld.Part1 = targetAtt.Parent
        weld.C0 = att.CFrame
        weld.C1 = targetAtt.CFrame
        weld.Parent = handle
    end
end

function charCopy.apply(char, data)
    if not (char and data and data.model) then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if charCopy.watch then
        charCopy.watch:Disconnect()
        charCopy.watch = nil
    end
    for _, inst in ipairs(char:GetDescendants()) do
        if inst:GetAttribute("KWChar") or charCopy.isOld(char, inst) then inst:Destroy() end
    end
    for _, inst in ipairs(data.model:GetChildren()) do
        if inst:IsA("Accoutrement") then
            local clone = inst:Clone()
            clone:SetAttribute("KWChar", true)
            for _, p in ipairs(clone:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false; p.Massless = true end
            end
            local ok = pcall(hum.AddAccessory, hum, clone)
            if not ok or not clone:FindFirstChild("AccessoryWeld", true) then charCopy.weldAccessory(char, clone) end
        elseif inst:IsA("Clothing") or inst:IsA("ShirtGraphic") or inst:IsA("BodyColors") or inst:IsA("CharacterMesh") then
            local clone = inst:Clone()
            clone:SetAttribute("KWChar", true)
            clone.Parent = char
        end
    end
    charCopy.watch = char.DescendantAdded:Connect(function(inst)
        if charCopy.userId and char == currentCharacter then
            if charCopy.isOld(char, inst) then task.defer(inst.Destroy, inst) end
        elseif charCopy.watch then
            charCopy.watch:Disconnect()
            charCopy.watch = nil
        end
    end)
    if data.desc then
        local colors = {
            Head = data.desc.HeadColor, Torso = data.desc.TorsoColor, UpperTorso = data.desc.TorsoColor, LowerTorso = data.desc.TorsoColor,
            ["Left Arm"] = data.desc.LeftArmColor, LeftUpperArm = data.desc.LeftArmColor, LeftLowerArm = data.desc.LeftArmColor, LeftHand = data.desc.LeftArmColor,
            ["Right Arm"] = data.desc.RightArmColor, RightUpperArm = data.desc.RightArmColor, RightLowerArm = data.desc.RightArmColor, RightHand = data.desc.RightArmColor,
            ["Left Leg"] = data.desc.LeftLegColor, LeftUpperLeg = data.desc.LeftLegColor, LeftLowerLeg = data.desc.LeftLegColor, LeftFoot = data.desc.LeftLegColor,
            ["Right Leg"] = data.desc.RightLegColor, RightUpperLeg = data.desc.RightLegColor, RightLowerLeg = data.desc.RightLegColor, RightFoot = data.desc.RightLegColor
        }
        for name, col in pairs(colors) do
            local p = char:FindFirstChild(name)
            if p and p:IsA("BasePart") then p.Color = col end
        end
    end
    local head = char:FindFirstChild("Head")
    local modelHead = data.model:FindFirstChild("Head")
    local face = modelHead and (modelHead:FindFirstChild("face") or modelHead:FindFirstChildWhichIsA("Decal"))
    local myFace = head and (head:FindFirstChild("face") or head:FindFirstChildWhichIsA("Decal"))
    if myFace and not charCopy.ownFace then charCopy.ownFace = myFace.Texture end
    if myFace and (face or charCopy.userId == nil) then
        myFace.Texture = face and face.Texture or charCopy.ownFace
    elseif head and face then
        face:Clone().Parent = head
    end
end

function charCopy.set(input)
    local userId, name = charCopy.resolve(input)
    if not userId then notifySystem("couldn't find player") return end
    local data, err = charCopy.build(userId)
    if not data then notifySystem("char: " .. tostring(err)) return end
    charCopy.userId = userId
    charCopy.apply(currentCharacter, data)
    notifySystem("disguised as " .. (name or tostring(userId)))
end

function charCopy.reset()
    if not charCopy.userId then return end
    charCopy.userId = nil
    if charCopy.watch then
        charCopy.watch:Disconnect()
        charCopy.watch = nil
    end
    local data = charCopy.build(player.UserId)
    if data then charCopy.apply(currentCharacter, data) end
    notifySystem("back to your own avatar")
end

player.CharacterAdded:Connect(function(char)
    if charCopy.keep and charCopy.userId then
        task.spawn(function()
            task.wait(0.5)
            if char == currentCharacter and charCopy.userId then
                local data = charCopy.build(charCopy.userId)
                if data then charCopy.apply(char, data) end
            end
        end)
    end
end)

local function createExtraFeatures()
    local feats = {}
    local function rgb3(c) return Color3.fromRGB(c[1] or 0, c[2] or 0, c[3] or 0) end
    local function storeRGB(c) return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) } end

    -- ===== Notifications =====
    local notifGui = Instance.new("ScreenGui")
    notifGui.Name = "MingoNotif"
    notifGui.ResetOnSpawn = false
    notifGui.DisplayOrder = 50
    notifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local ok, hui = pcall(function() return gethui() end)
    notifGui.Parent = ok and hui or game:GetService("CoreGui")
    if not notifGui.Parent then notifGui.Parent = player.PlayerGui end
    
    local notifContainer = Instance.new("Frame")
    notifContainer.Name = "Container"
    notifContainer.BackgroundTransparency = 1
    notifContainer.Position = UDim2.new(0, 20, 0.5, -20)
    notifContainer.Size = UDim2.new(0, 300, 0.5, 0)
    notifContainer.Parent = notifGui
    
    local notifLayout = Instance.new("UIListLayout")
    notifLayout.Padding = UDim.new(0, 8)
    notifLayout.SortOrder = Enum.SortOrder.LayoutOrder
    notifLayout.Parent = notifContainer
    
    local notifOrder = 0
    local function getTextHeight(text, font, size, width)
        local clean = tostring(text):gsub("<[^>]->", "")
        return TextService:GetTextSize(clean, size, font, Vector2.new(width, math.huge)).Y
    end
    
    feats.mingoNotify = function(data)
        if not Settings.Misc.Notifications.Enabled then return end
        local title = data.Title or "MingoHub"
        local desc = data.Description
        local img = data.Image
        if type(img) ~= "string" or img == "" then img = nil end
        local duration = tonumber(data.Duration) or 5
        
        local pad = 10
        local imgSize = 36
        local padX = pad + (img and imgSize + pad or 0)
        local width = 300 - padX - pad
        local titleH = getTextHeight(title, FONT_BOLD, 12, width)
        local descH = desc and getTextHeight(desc, FONT, 11, width) or 0
        local gap = desc and 4 or 0
        local height = math.max(pad + titleH + gap + descH + pad, img and imgSize + pad*2 or 0)
        
        notifOrder += 1
        local frame = Instance.new("Frame")
        frame.BackgroundTransparency = 1
        frame.LayoutOrder = notifOrder
        frame.Size = UDim2.fromOffset(300, height)
        frame.Parent = notifContainer
        
        local bg = Instance.new("Frame")
        bg.BackgroundColor3 = Color3.fromRGB(10, 15, 39)
        bg.BackgroundTransparency = 0.34
        bg.BorderSizePixel = 0
        bg.Size = UDim2.fromScale(1, 1)
        bg.Position = UDim2.fromOffset(-330, 0)
        bg.Parent = frame
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = bg
        local stroke = Instance.new("UIStroke")
        stroke.Color = Palette.Border
        stroke.Thickness = 1.5
        stroke.Transparency = 0.35
        stroke.Parent = bg
        
        if img then
            local imgLabel = Instance.new("ImageLabel")
            imgLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 44)
            imgLabel.BackgroundTransparency = 0.3
            imgLabel.BorderSizePixel = 0
            imgLabel.Image = img
            imgLabel.ScaleType = Enum.ScaleType.Crop
            imgLabel.Size = UDim2.fromOffset(imgSize, imgSize)
            imgLabel.Position = UDim2.fromOffset(pad, math.floor((height - imgSize) / 2))
            imgLabel.Parent = bg
            local c2 = Instance.new("UICorner")
            c2.CornerRadius = UDim.new(0, 6)
            c2.Parent = imgLabel
        end
        
        local y = pad
        local tl = Instance.new("TextLabel")
        tl.BackgroundTransparency = 1
        tl.RichText = true
        tl.TextWrapped = true
        tl.TextXAlignment = Enum.TextXAlignment.Left
        tl.TextYAlignment = Enum.TextYAlignment.Top
        tl.Font = FONT_BOLD
        tl.TextSize = 12
        tl.TextColor3 = Palette.Accent
        tl.Text = title
        tl.Position = UDim2.fromOffset(padX, y)
        tl.Size = UDim2.fromOffset(width, titleH)
        tl.Parent = bg
        y += titleH + gap
        
        if desc then
            local dl = Instance.new("TextLabel")
            dl.BackgroundTransparency = 1
            dl.RichText = true
            dl.TextWrapped = true
            dl.TextXAlignment = Enum.TextXAlignment.Left
            dl.TextYAlignment = Enum.TextYAlignment.Top
            dl.Font = FONT
            dl.TextSize = 11
            dl.TextColor3 = Color3.fromRGB(220, 225, 245)
            dl.Text = desc
            dl.Position = UDim2.fromOffset(padX, y)
            dl.Size = UDim2.fromOffset(width, descH)
            dl.Parent = bg
        end
        
        TweenService:Create(bg, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.fromOffset(0, 0)}):Play()
        
        task.delay(duration, function()
            if not frame.Parent then return end
            for _, d in ipairs(frame:GetDescendants()) do
                if d:IsA("TextLabel") then
                    TweenService:Create(d, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {TextTransparency = 1}):Play()
                elseif d:IsA("ImageLabel") then
                    TweenService:Create(d, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {ImageTransparency = 1, BackgroundTransparency = 1}):Play()
                elseif d:IsA("UIStroke") then
                    TweenService:Create(d, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Transparency = 1}):Play()
                elseif d:IsA("Frame") and d.BackgroundTransparency < 1 then
                    TweenService:Create(d, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
                end
            end
            task.wait(0.25)
            TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = UDim2.fromOffset(300, 0)}):Play()
            task.wait(0.2)
            frame:Destroy()
        end)
    end

    -- ===== Motion Blur =====
    local blurEffect, blurConn, blurCC
    local function setMotionBlur(on)
        if on then
            if not blurEffect or not blurEffect.Parent then
                blurEffect = Instance.new("BlurEffect")
                blurEffect.Name = "MingoMotionBlur"
                blurEffect.Size = 0
                pcall(function() blurEffect.Parent = workspace.CurrentCamera end)
            end
            if not blurCC or not blurCC.Parent then
                blurCC = Instance.new("ColorCorrectionEffect")
                blurCC.Name = "MingoMotionBlurCC"
                blurCC.Saturation = 0
                blurCC.Parent = Lighting
            end
            if not blurConn then
                blurConn = RunService.RenderStepped:Connect(function(dt)
                    local eff, cc = blurEffect, blurCC
                    if not eff or not currentRootPart then return end
                    local intensity = math.clamp(tonumber(Settings.Visuals.MotionBlurIntensity) or 9, 1, 30)
                    local vel = currentRootPart.AssemblyLinearVelocity
                    local speed = vel and vel.Magnitude or 0
                    local walk = (currentHumanoid and tonumber(currentHumanoid.WalkSpeed)) or 16
                    local excess = math.max(0, speed - (walk + 2))
                    local target = math.clamp(excess / 55 * intensity, 0, intensity)
                    if target > eff.Size then
                        eff.Size = target
                    else
                        eff.Size = math.max(0, eff.Size - intensity * dt * 4)
                    end
                    if cc then
                        local sat = math.clamp((eff.Size / intensity) * 0.4, 0, 0.4)
                        cc.Saturation = sat
                    end
                end)
            end
        else
            if blurConn then
                blurConn:Disconnect()
                blurConn = nil
            end
            if blurEffect then pcall(function() blurEffect.Size = 0 end) end
            if blurCC then
                pcall(function() blurCC.Saturation = 0; blurCC:Destroy() end)
                blurCC = nil
            end
        end
    end
    feats.setMotionBlur = setMotionBlur

    -- ===== Custom Sky =====
    local skyOriginals, skyInstance, madeSky = nil, nil, false
    local SKY_PRESETS = {
        ["Blood Moon"] = { Ambient = Color3.fromRGB(60, 10, 16), OutdoorAmbient = Color3.fromRGB(90, 20, 28), FogColor = Color3.fromRGB(70, 16, 24), FogEnd = 400, Brightness = 0.7, ClockTime = 22 },
        ["Night"] = { Ambient = Color3.fromRGB(14, 16, 30), OutdoorAmbient = Color3.fromRGB(18, 20, 38), FogColor = Color3.fromRGB(10, 12, 24), FogEnd = 500, Brightness = 0.5, ClockTime = 0 },
        ["Sunset"] = { Ambient = Color3.fromRGB(80, 45, 30), OutdoorAmbient = Color3.fromRGB(150, 85, 55), FogColor = Color3.fromRGB(120, 70, 45), FogEnd = 600, Brightness = 1.2, ClockTime = 17.5 },
        ["Dawn"] = { Ambient = Color3.fromRGB(70, 60, 80), OutdoorAmbient = Color3.fromRGB(110, 100, 130), FogColor = Color3.fromRGB(90, 80, 110), FogEnd = 600, Brightness = 1.0, ClockTime = 6 },
    }
    local function applyCustomSky()
        local s = Settings.Visuals.CustomSky
        local light = Lighting
        if not s.Enabled then return end
        if not skyOriginals then
            skyOriginals = {
                Ambient = light.Ambient, OutdoorAmbient = light.OutdoorAmbient, FogColor = light.FogColor,
                FogStart = light.FogStart, FogEnd = light.FogEnd, Brightness = light.Brightness, ClockTime = light.ClockTime,
            }
        end
        local preset = SKY_PRESETS[s.Preset] or SKY_PRESETS["Blood Moon"]
        light.Ambient = preset.Ambient
        light.OutdoorAmbient = preset.OutdoorAmbient
        light.FogColor = preset.FogColor
        light.FogEnd = preset.FogEnd
        light.Brightness = preset.Brightness
        light.ClockTime = preset.ClockTime
        if not skyInstance then
            skyInstance = light:FindFirstChildOfClass("Sky")
            if not skyInstance then
                skyInstance = Instance.new("Sky")
                skyInstance.Name = "MingoCustomSky"
                skyInstance.Parent = light
                madeSky = true
            end
        end
        pcall(function() skyInstance.StarCount = tonumber(s.Stars) or 0 end)
        local id = tostring(s.SkyboxId or ""):match("%d+")
        if id then
            pcall(function()
                for _, face in ipairs({ "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }) do
                    skyInstance[face] = "rbxassetid://" .. id
                end
            end)
        end
    end
    local function setCustomSky(on)
        local s = Settings.Visuals.CustomSky
        s.Enabled = on and true or false
        if on then
            applyCustomSky()
        else
            if skyOriginals then
                pcall(function()
                    local o = skyOriginals
                    Lighting.Ambient = o.Ambient
                    Lighting.OutdoorAmbient = o.OutdoorAmbient
                    Lighting.FogColor = o.FogColor
                    Lighting.FogStart = o.FogStart
                    Lighting.FogEnd = o.FogEnd
                    Lighting.Brightness = o.Brightness
                    Lighting.ClockTime = o.ClockTime
                end)
                skyOriginals = nil
            end
            if madeSky and skyInstance then pcall(function() skyInstance:Destroy() end) end
            skyInstance, madeSky = nil, false
        end
    end
    feats.setCustomSky = setCustomSky
    feats.applySkyNow = function() if Settings.Visuals.CustomSky.Enabled then applyCustomSky() end end

    -- ===== Custom Atmosphere =====
    local atmSnapshot = { exists = false, Density = 0.3, Offset = 0, Color = Color3.fromRGB(199,170,107), Decay = Color3.fromRGB(92,60,13), Glare = 0, Haze = 0 }
    local atmInstance, atmCreatedHere = nil, false

    local function applyCustomAtmosphere()
        local s = Settings.Visuals.CustomAtmosphere
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if not atm then
            atm = Instance.new("Atmosphere")
            atm.Name = "MingoAtmosphere"
            atm.Parent = Lighting
            atmCreatedHere = true
        elseif not atmSnapshot.exists then
            atmSnapshot.exists = true
            atmSnapshot.Density = atm.Density
            atmSnapshot.Offset = atm.Offset
            atmSnapshot.Color = atm.Color
            atmSnapshot.Decay = atm.DecayColor
            atmSnapshot.Glare = atm.Glare
            atmSnapshot.Haze = atm.Haze
        end
        atmInstance = atm
        pcall(function()
            atm.Density = math.clamp(tonumber(s.Density) or 35, 0, 100) / 100
            atm.Color = rgb3(s.Color)
            atm.DecayColor = rgb3(s.Decay)
            atm.Haze = math.clamp(tonumber(s.Haze) or 0, 0, 100) / 10
            atm.Glare = math.clamp(tonumber(s.Glare) or 0, 0, 100) / 100
        end)
    end
    local function setCustomAtmosphere(on)
        Settings.Visuals.CustomAtmosphere.Enabled = on and true or false
        if on then
            applyCustomAtmosphere()
        else
            if atmInstance and atmInstance.Parent then
                if atmSnapshot.exists then
                    pcall(function()
                        atmInstance.Density = atmSnapshot.Density
                        atmInstance.Offset = atmSnapshot.Offset
                        atmInstance.Color = atmSnapshot.Color
                        atmInstance.DecayColor = atmSnapshot.Decay
                        atmInstance.Glare = atmSnapshot.Glare
                        atmInstance.Haze = atmSnapshot.Haze
                    end)
                    atmSnapshot.exists = false
                elseif atmCreatedHere then
                    pcall(function() atmInstance:Destroy() end)
                end
            end
            atmInstance, atmCreatedHere = nil, false
        end
    end
    feats.setCustomAtmosphere = setCustomAtmosphere
    feats.applyAtmosphereNow = function() if Settings.Visuals.CustomAtmosphere.Enabled then applyCustomAtmosphere() end end

    -- ===== Anti Fling =====
    local antiFlingConn
    local function setAntiFling(on)
        if antiFlingConn then
            antiFlingConn:Disconnect()
            antiFlingConn = nil
        end
        if not on then return end
        local lastGoodCF = nil
        antiFlingConn = RunService.Heartbeat:Connect(function()
            local root = currentRootPart
            if not root or not root.Parent or not currentCharacter then return end
            local isGameMove = root:FindFirstChild("moveme")
                or root:FindFirstChild("dodgevelocity")
                or currentCharacter:GetAttribute("BeingLaunched")
                or currentCharacter:GetAttribute("Ragdoll")
            local speed = root.AssemblyLinearVelocity.Magnitude
            local angSpeed = root.AssemblyAngularVelocity.Magnitude
            if (not isGameMove and speed > 250) or angSpeed > 250 then
                pcall(function()
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.AssemblyLinearVelocity = Vector3.zero
                    if lastGoodCF then root.CFrame = lastGoodCF end
                end)
            elseif speed < 50 and angSpeed < 50 then
                lastGoodCF = root.CFrame
            end
        end)
    end
    feats.setAntiFling = setAntiFling

    -- ===== Ping & Device Spoofs =====
    local pingLastUpdate = 0
    local pingCurrent = 30
    local function currentPingValue()
        local s = Settings.Player.PingSpoof
        local t = os.clock()
        local step = math.max(0.05, (tonumber(s.ReportRate) or 10) * 0.1)
        if t - pingLastUpdate >= step then
            pingLastUpdate = t
            local jitter = tonumber(s.Jitter) or 0
            pingCurrent = math.max(1, (tonumber(s.Ping) or 30) + (math.random() * 2 - 1) * jitter)
        end
        return pingCurrent
    end
    feats.pingValue = currentPingValue

    local dataPingHook = nil
    local pingReportThread = nil
    local sharedHookInstalled = false
    local sharedHookRestore = nil

    local function installSharedHook()
        if sharedHookInstalled then return end
        if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" or type(checkcaller) ~= "function" then return end
        local old
        local ok = pcall(function()
            old = hookmetamethod(game, "__namecall", function(self, ...)
                if checkcaller() then return old(self, ...) end
                if getnamecallmethod() ~= "FireServer" then return old(self, ...) end
                if typeof(self) ~= "Instance" or self.ClassName ~= "RemoteEvent" or self.Name ~= "Communicate" then return old(self, ...) end
                local args = {...}
                local first = args[1]
                if type(first) ~= "table" then return old(self, ...) end
                local needsPing = Settings.Player.PingSpoof.Enabled
                local needsDevice = Settings.Player.DeviceSpoof.Enabled
                if not (needsPing or needsDevice) then return old(self, ...) end
                local clone = nil
                local function ensureClone()
                    if not clone then
                        clone = {}
                        for k, v in pairs(first) do clone[k] = v end
                    end
                end
                local goal = first.Goal
                if needsPing and goal == "ReportPing" and first.ms ~= nil then
                    ensureClone()
                    clone.ms = currentPingValue()
                end
                if needsDevice then
                    local dev = Settings.Player.DeviceSpoof
                    if goal == "Platform" or goal == " Platform " or goal == "SetPlatform" then
                        ensureClone()
                        local mobile, console
                        if dev.Device == "Mobile" then mobile, console = true, false
                        elseif dev.Device == "Console" then mobile, console = false, true
                        else mobile, console = false, false end
                        if clone.mobile ~= nil then clone.mobile = mobile end
                        if clone.console ~= nil then clone.console = console end
                    elseif goal == "LeftClick" or goal == "LeftClickRelease" then
                        local forceMobile = (dev.Device == "Mobile" or dev.Device == "Console")
                        if forceMobile then
                            ensureClone()
                            clone.Mobile = true
                            if goal == "LeftClick" and dev.TapClicks then
                                task.delay(0.06, function()
                                    if not Settings.Player.DeviceSpoof.TapClicks then return end
                                    if currentCommunicate and currentCommunicate.Parent then
                                        pcall(function() currentCommunicate:FireServer({Goal = "LeftClickRelease", Mobile = true}) end)
                                    end
                                end)
                            end
                        end
                    end
                end
                if clone then
                    args[1] = clone
                    return old(self, table.unpack(args))
                end
                return old(self, ...)
            end)
        end)
        if ok then
            sharedHookInstalled = true
            sharedHookRestore = function() pcall(hookmetamethod, game, "__namecall", old) end
        end
    end

    local function syncSharedHook()
        local needs = Settings.Player.PingSpoof.Enabled or Settings.Player.DeviceSpoof.Enabled
        if needs and not sharedHookInstalled then
            installSharedHook()
        elseif not needs and sharedHookInstalled then
            if sharedHookRestore then pcall(sharedHookRestore) end
            sharedHookInstalled = false
            sharedHookRestore = nil
        end
    end

    local function stopPingReportLoop()
        if pingReportThread then
            pcall(function() task.cancel(pingReportThread) end)
            pingReportThread = nil
        end
    end

    local function startPingReportLoop()
        if pingReportThread then return end
        pingReportThread = task.spawn(function()
            while Settings.Player.PingSpoof.Enabled do
                local comm = currentCommunicate
                if comm and comm.Parent then
                    pcall(function() comm:FireServer({Goal = "ReportPing", ms = currentPingValue()}) end)
                end
                task.wait(math.max(0.1, (tonumber(Settings.Player.PingSpoof.ReportRate) or 10) * 0.1))
            end
            pingReportThread = nil
        end)
    end

    local function setPingSpoof(on)
        local s = Settings.Player.PingSpoof
        s.Enabled = on and true or false
        if dataPingHook then
            pcall(dataPingHook.restore)
            dataPingHook = nil
        end
        stopPingReportLoop()
        if not on then
            syncSharedHook()
            return
        end
        if DataPing then
            if type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" then
                local old
                local ok = pcall(function()
                    old = hookmetamethod(DataPing, "__namecall", function(self, ...)
                        if getnamecallmethod() == "GetValue" and self == DataPing then
                            return currentPingValue()
                        end
                        return old(self, ...)
                    end)
                end)
                if ok then dataPingHook = { restore = function() pcall(hookmetamethod, DataPing, "__namecall", old) end } end
            end
            if not dataPingHook then
                local orig = DataPing.GetValue
                if type(orig) == "function" then
                    local ok2 = pcall(function()
                        DataPing.GetValue = function(...) return currentPingValue() end
                    end)
                    if ok2 then dataPingHook = { restore = function() pcall(function() DataPing.GetValue = orig end) end } end
                end
            end
        end
        syncSharedHook()
        startPingReportLoop()
    end
    feats.setPingSpoof = setPingSpoof

    local deviceHook = nil
    local function deviceFlags()
        local s = Settings.Player.DeviceSpoof
        local flags
        if s.Device == "Mobile" then
            flags = { TouchEnabled = true, KeyboardEnabled = false, MouseEnabled = false, GamepadEnabled = false }
        elseif s.Device == "Console" then
            flags = { TouchEnabled = false, KeyboardEnabled = false, MouseEnabled = false, GamepadEnabled = true }
        else
            flags = { TouchEnabled = false, KeyboardEnabled = true, MouseEnabled = true, GamepadEnabled = false }
        end
        if s.TapClicks then flags.TouchEnabled = true end
        return flags
    end

    local function sendPlatform(mobile, console)
        if currentCommunicate and currentCommunicate.Parent then
            pcall(function() currentCommunicate:FireServer({Goal = "Platform", mobile = mobile}) end)
            pcall(function() currentCommunicate:FireServer({Goal = "Platform", console = console}) end)
        end
    end

    local function setDeviceSpoof(on)
        local s = Settings.Player.DeviceSpoof
        s.Enabled = on and true or false
        if deviceHook then
            pcall(deviceHook.restore)
            deviceHook = nil
        end
        if not on then
            syncSharedHook()
            return
        end
        local flags = deviceFlags()
        local restorers = {}
        if type(hookmetamethod) == "function" then
            local old
            local ok = pcall(function()
                old = hookmetamethod(UIS, "__index", function(self, k)
                    if self == UIS and flags[k] ~= nil then return flags[k] end
                    return old(self, k)
                end)
            end)
            if ok then restorers[#restorers+1] = function() pcall(hookmetamethod, UIS, "__index", old) end end
        end
        if #restorers == 0 then
            local backed = {}
            for k, v in pairs(flags) do
                backed[k] = UIS[k]
                pcall(function() UIS[k] = v end)
            end
            restorers[#restorers+1] = function()
                for k, v in pairs(backed) do pcall(function() UIS[k] = v end) end
            end
        end
        deviceHook = { restore = function()
            for _, f in ipairs(restorers) do pcall(f) end
        end }
        syncSharedHook()
        local mobile, console
        if s.Device == "Mobile" then mobile, console = true, false
        elseif s.Device == "Console" then mobile, console = false, true
        else mobile, console = false, false end
        sendPlatform(mobile, console)
    end
    feats.setDeviceSpoof = setDeviceSpoof

    -- ===== ESP =====
    local function espColorForPlayer(target, char)
        local esp = Settings.ESP
        if char and char:FindFirstChild("Counter") then return rgb3(esp.DeathCounterColor) end
        if char and char:GetAttribute("Ulted") then
            if char:GetAttribute("Character") == "Bald" then return rgb3(esp.SaitamaUltColor) end
            return rgb3(esp.UltColor)
        end
        local rel = Settings.ESP.Friends[target.Name]
        if rel == "friend" then return rgb3(esp.FriendColor) end
        if rel == "enemy" then return rgb3(esp.EnemyColor) end
        if player.Team and target.Team == player.Team then return rgb3(esp.FriendColor) end
        if not player.Team and not target.Team then return rgb3(esp.NeutralColor) end
        return rgb3(esp.EnemyColor)
    end

    local function createEspHeadLabel(target, char, deathOrUltOverride)
        local esp = Settings.ESP
        if not (esp.Enabled or ((esp.DeathCounterESP or esp.SaitamaUltESP) and deathOrUltOverride)) then return end
        if not char or not char.Parent then return end
        local color = espColorForPlayer(target, char)
        local existingHL = char:FindFirstChild("ESP")
        if existingHL then task.defer(existingHL.Destroy, existingHL) end
        pcall(function()
            local hl = Instance.new("Highlight")
            hl.Name = "ESP"
            hl.FillTransparency = math.clamp(tonumber(esp.OutlineTransparency) or 70, 0, 100) / 100
            hl.FillColor = color
            hl.OutlineTransparency = esp.Boxes and 0 or 1
            hl.OutlineColor = color
            if not esp.Highlight then hl.FillTransparency = 1 end
            hl.Parent = char
        end)
        local existingBox = char:FindFirstChild("MingoBoxESP")
        if esp.Boxes then
            pcall(function()
                local box = existingBox or Instance.new("SelectionBox")
                box.Name = "MingoBoxESP"
                local boxColor
                if esp.CustomBoxColor then
                    boxColor = rgb3(esp.CustomBoxColorValue)
                elseif esp.TeamColors then
                    boxColor = color
                else
                    boxColor = rgb3(esp.CustomBoxColorValue)
                end
                box.Color3 = boxColor
                box.LineThickness = math.clamp(tonumber(esp.BoxThickness) or 1, 1, 6) / 30
                box.SurfaceTransparency = esp.BoxFilled and 0.55 or 1
                box.SurfaceColor3 = boxColor
                box.Adornee = char
                box.Parent = char
            end)
        elseif existingBox then
            existingBox:Destroy()
        end
        local head = char:FindFirstChild("Head")
        if not head or not esp.NameUltText then return end
        pcall(function()
            local bb = head:FindFirstChild("CheatGui") or Instance.new("BillboardGui", head)
            local lbl = bb:FindFirstChild("TextLabel") or Instance.new("TextLabel", bb)
            bb.Name = "CheatGui"
            bb.Size = UDim2.fromScale(10, 2)
            bb.StudsOffset = Vector3.new(0, 4, 0)
            bb.AlwaysOnTop = true
            lbl.Size = UDim2.fromScale(1, 1)
            lbl.TextScaled = true
            lbl.Font = Enum.Font.RobotoMono
            lbl.TextColor3 = color
            lbl.BackgroundTransparency = 1
            lbl.TextStrokeTransparency = 0.3
            local charAttr = char:GetAttribute("Character") or "Other"
            local ultName = ({ Bald="Saitama",Hunter="Garou",Monster="Red Garou",Cyborg="Genos",Ninja="Sonic",Batter="Metal Bat",Blade="Samurai",Esper="Tatsumaki",Purple="Siryu",Tech="Emperor" })[charAttr] or "Other"
            local ultPct = math.floor(target:GetAttribute("Ultimate") or 0)
            local suffix = ""
            if esp.DeathCounterESP and char:FindFirstChild("Counter") then suffix = " [DC]" end
            if esp.SaitamaUltESP and char:GetAttribute("Ulted") and charAttr == "Bald" then
                suffix = " [SAITAMA ULT]"
            elseif char:GetAttribute("Ulted") then
                suffix = " [ULT]"
            end
            lbl.Text = ultName .. " " .. ultPct .. "% Ult\n" .. target.Name .. suffix
        end)
    end

    local function removeBoxESP(char, keepHighlight)
        if not char then return end
        local hl = char:FindFirstChild("ESP")
        local box = char:FindFirstChild("MingoBoxESP")
        local head = char:FindFirstChild("Head")
        if hl and not keepHighlight then hl:Destroy() end
        if box and not keepHighlight then box:Destroy() end
        if head then
            local gui = head:FindFirstChild("CheatGui")
            if gui then gui:Destroy() end
        end
    end

    local function updatePlayerESP(remove, keepHighlight)
        for _, plr in ipairs(Players:GetChildren()) do
            if plr ~= player then
                local char = plr.Character
                if char then
                    if remove then
                        removeBoxESP(char, keepHighlight)
                    else
                        createEspHeadLabel(plr, char)
                    end
                end
            end
        end
    end

    local espConn, espTick = nil, 0
    local function setESP(on)
        if on then
            if not espConn then
                espTick = 0
                espConn = RunService.RenderStepped:Connect(function(dt)
                    espTick += dt
                    if espTick < 0.12 then return end
                    espTick = 0
                    updatePlayerESP(false)
                end)
            end
        else
            if espConn then
                espConn:Disconnect()
                espConn = nil
            end
            updatePlayerESP(true)
        end
    end

    feats.setESP = setESP
    feats.updatePlayerESP = updatePlayerESP
    feats.createEspLabel = createEspHeadLabel
    feats.espAddFriend = function(name) if name and name ~= "" then Settings.ESP.Friends[name] = "friend" end end
    feats.espAddEnemy = function(name) if name and name ~= "" then Settings.ESP.Friends[name] = "enemy" end end
    feats.espColorTo = storeRGB
    feats.espColorFrom = rgb3

    -- ===== Backdash Cancel =====
    local function _vim_randomWait(base) task.wait((base or 0) + math.random(2, 6) / 1000) end
    local function _vim_sendKey(kc, down)
        if VirtualInputManager then pcall(function() VirtualInputManager:SendKeyEvent(down, kc, false, game) end) end
    end
    local function _vim_tapKey(kc)
        _vim_sendKey(kc, true)
        _vim_randomWait()
        _vim_sendKey(kc, false)
    end
    local function _vim_simulateM1Click(numKey)
        _vim_sendKey(numKey, true)
        _vim_randomWait(0.01)
        _vim_sendKey(numKey, false)
        if not sAutoUnequip and VirtualInputManager then
            local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(400, 300)
            local hx, hy = math.floor(vp.X / 2), math.floor(vp.Y / 2)
            _vim_randomWait()
            pcall(function() VirtualInputManager:SendMouseButtonEvent(hx, hy, 0, true, game, 0) end)
            _vim_randomWait()
            pcall(function() VirtualInputManager:SendMouseButtonEvent(hx, hy, 0, false, game, 0) end)
        end
    end
    local function performBackDashMacro(numKey)
        _vim_simulateM1Click(numKey)
        _vim_randomWait()
        _vim_sendKey(Enum.KeyCode.S, true)
        _vim_tapKey(Enum.KeyCode.Q)
        _vim_randomWait(0.1)
        _vim_sendKey(Enum.KeyCode.S, false)
    end

    local dashConns = {}
    local function setBackdash(on)
        for _, c in ipairs(dashConns) do pcall(function() c:Disconnect() end) end
        dashConns = {}
        if not on then return end
        local s = Settings.Macros.Backdash
        for i = 1, 4 do
            local variantIdx = i
            local triggerKey = s.Keys[i]
            if triggerKey then
                dashConns[i] = UIS.InputBegan:Connect(function(input, gpe)
                    if gpe or not s.Variants[variantIdx] then return end
                    if input.KeyCode == triggerKey then
                        task.spawn(function()
                            task.wait(math.max(0, tonumber(s.Delay) or 0.05))
                            performBackDashMacro(triggerKey)
                        end)
                    end
                end)
            end
        end
    end
    feats.setBackdash = setBackdash

    player.CharacterAdded:Connect(function(char)
        task.spawn(function()
            char:WaitForChild("Communicate", 10)
            task.wait(0.15)
            if Settings.Player.DeviceSpoof.Enabled then pcall(function() feats.setDeviceSpoof(true) end) end
            if Settings.Player.PingSpoof.Enabled then pcall(function() feats.setPingSpoof(true) end) end
        end)
    end)

    return feats
end

local function buildUI()
    local extra = createExtraFeatures()
    _G._mingoNotifyRef = extra.mingoNotify   -- expose for mingoNotifyShim
    local keybindListening = false
    local currentListeningButton = nil

    local function getGuiParent()
        local playerGui = player.PlayerGui or player:FindFirstChild("PlayerGui")
        if playerGui then return playerGui end
        if gethui then
            local ok, hui = pcall(gethui)
            if ok and hui then return hui end
        end
        if get_hidden_gui then
            local ok, hui = pcall(get_hidden_gui)
            if ok and hui then return hui end
        end
        local ok, core = pcall(function() return game:GetService("CoreGui") end)
        if ok and core then return core end
        return player:WaitForChild("PlayerGui", 10)
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "VelaUI"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.Enabled = true
    gui.DisplayOrder = 2147483647
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = getGuiParent()
    if not gui.Parent then gui.Parent = player:WaitForChild("PlayerGui", 10) end

    pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
    pcall(function() if protect_gui then protect_gui(gui) end end)

    task.spawn(function()
        while true do
            task.wait(0.5)
            if not gui.Parent then
                pcall(function() gui.Parent = getGuiParent() end)
                pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
            end
            if not gui.Enabled then gui.Enabled = true end
            if gui.DisplayOrder ~= 2147483647 then gui.DisplayOrder = 2147483647 end
        end
    end)

    local toastSerial = 0
    local function notify(text)
        toastSerial += 1
        local myId = toastSerial
        local toast = Instance.new("TextLabel")
        toast.Name = "Toast" .. myId
        toast.Size = UDim2.fromOffset(280, 30)
        toast.Position = UDim2.new(0.5, 0, 0, 14)
        toast.AnchorPoint = Vector2.new(0.5, 0)
        toast.BackgroundColor3 = Color3.fromRGB(12, 17, 38)
        toast.BackgroundTransparency = 0.08
        toast.Text = text
        toast.TextColor3 = Color3.fromRGB(235, 240, 255)
        toast.Font = FONT
        toast.TextSize = 12
        toast.TextTruncate = Enum.TextTruncate.AtEnd
        toast.ZIndex = 120
        toast.Parent = gui
        corner(toast, 10)
        stroke(toast, 1, 0.35)
        toast.Position = UDim2.new(0.5, 0, 0, 4)
        tween(toast, 0.25, { Position = UDim2.new(0.5, 0, 0, 14) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        task.delay(2.2, function()
            if not toast.Parent then return end
            local fade = tween(toast, 0.3, { TextTransparency = 1, BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0, 4) })
            fade.Completed:Connect(function()
                if myId <= toastSerial then toast:Destroy() end
            end)
        end)
    end

    local blur = Instance.new("BlurEffect")
    blur.Name = "VelaBlur"
    blur.Size = 0
    blur.Parent = Lighting

    local function ensureBlur()
        if not blur or not blur.Parent then
            blur = Instance.new("BlurEffect")
            blur.Name = "VelaBlur"
            blur.Size = 0
            blur.Parent = Lighting
        end
        blur.Enabled = true
        return blur
    end

    local isOpen = false
    local minimized = false
    local introActive = false

    local root = Instance.new("Frame")
    root.Name = "Root"
    root.Size = UDim2.fromOffset(WIN_W, WIN_H)
    root.Position = UDim2.new(0.5, -WIN_W/2, 0.5, -WIN_H/2)
    root.BackgroundTransparency = 1
    root.Parent = gui

    local rootScale = Instance.new("UIScale")
    rootScale.Name = "OpenCloseScale"
    rootScale.Scale = 1
    rootScale.Parent = root

    local scaler = Instance.new("Frame")
    scaler.Name = "ScaleHost"
    scaler.Size = UDim2.fromScale(1, 1)
    scaler.AnchorPoint = Vector2.new(0.5, 0.5)
    scaler.Position = UDim2.fromScale(0.5, 0.5)
    scaler.BackgroundTransparency = 1
    scaler.Parent = root

    local uiScaleObj = Instance.new("UIScale")
    uiScaleObj.Name = "UiSize"
    uiScaleObj.Scale = Appearance.Scale
    uiScaleObj.Parent = scaler

    local window = Instance.new("CanvasGroup")
    window.Name = "Window"
    window.Size = UDim2.fromOffset(WIN_W, WIN_H)
    window.BackgroundColor3 = Color3.fromRGB(10, 15, 39)
    window.BackgroundTransparency = 0.34
    window.BorderSizePixel = 0
    window.ClipsDescendants = true
    window.GroupTransparency = 1
    window.Parent = scaler
    corner(window, 24)
    stroke(window, 1.5, 0.35)

    local winScale = Instance.new("UIScale")
    winScale.Scale = 1
    winScale.Parent = window

    local BG_INITIAL_IMAGE = "rbxassetid://120306120997150"
    local bg = Instance.new("ImageLabel")
    bg.Name = "Background"
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundTransparency = 1
    bg.Image = BG_INITIAL_IMAGE
    bg.ImageTransparency = 0.06
    bg.ImageRectSize = Vector2.new(256, 160)
    bg.ImageRectOffset = Vector2.new(0, 0)
    bg.ScaleType = Enum.ScaleType.Stretch
    bg.ZIndex = 1
    bg.Parent = window
    corner(bg, 24)

    local bgNext = Instance.new("ImageLabel")
    bgNext.Name = "BackgroundBlend"
    bgNext.Size = UDim2.fromScale(1, 1)
    bgNext.Position = UDim2.fromScale(0, 0)
    bgNext.BackgroundTransparency = 1
    bgNext.Image = BG_INITIAL_IMAGE
    bgNext.ImageTransparency = 1
    bgNext.ImageRectSize = Vector2.new(256, 160)
    bgNext.ImageRectOffset = Vector2.new(0, 0)
    bgNext.ScaleType = Enum.ScaleType.Stretch
    bgNext.ZIndex = 2
    bgNext.Parent = window
    corner(bgNext, 24)

    local activeLayer, incomingLayer = bg, bgNext
    local frameIndex, frameClock = 0, 0
    local currentBgDef = BACKGROUNDS[1]
    local spriteConnection
    spriteConnection = RunService.Heartbeat:Connect(function(dt)
        if not window:IsDescendantOf(game) then
            if spriteConnection then spriteConnection:Disconnect() end
            return
        end
        if not currentBgDef or not currentBgDef.cols then return end
        if not isOpen then return end
        frameClock += dt
        local spriteFps = currentBgDef.fps or 7
        if frameClock < 1 / spriteFps then return end
        frameClock %= 1 / spriteFps
        frameIndex = (frameIndex + 1) % (currentBgDef.frames or 24)
        local column = frameIndex % currentBgDef.cols
        local row = math.floor(frameIndex / currentBgDef.cols)
        incomingLayer.Image = activeLayer.Image
        incomingLayer.ImageRectOffset = Vector2.new(column * currentBgDef.w, row * currentBgDef.h)
        incomingLayer.ImageRectSize = Vector2.new(currentBgDef.w, currentBgDef.h)
        incomingLayer.ImageTransparency = 0.06
        incomingLayer.Visible = true
        activeLayer.Visible = false
        local previous = activeLayer
        activeLayer = incomingLayer
        incomingLayer = previous
    end)

    local overlay = Instance.new("Frame")
    overlay.Name = "BackgroundOverlay"
    overlay.Size = UDim2.fromScale(1, 1)
    overlay.BackgroundColor3 = Color3.fromRGB(9, 15, 43)
    overlay.BackgroundTransparency = 0.58
    overlay.BorderSizePixel = 0
    overlay.ZIndex = 2
    overlay.Parent = window
    corner(overlay, 24)

    local glass = Instance.new("Frame")
    glass.Name = "Glass"
    glass.Size = UDim2.fromScale(1, 1)
    glass.BackgroundColor3 = Color3.fromRGB(166, 190, 255)
    glass.BackgroundTransparency = 0.94
    glass.BorderSizePixel = 0
    glass.ZIndex = 3
    glass.Parent = window
    corner(glass, 24)

    local glowHalo = Instance.new("Frame")
    glowHalo.Name = "EdgeGlowHalo"
    glowHalo.Size = UDim2.fromScale(1, 1)
    glowHalo.BackgroundTransparency = 1
    glowHalo.BorderSizePixel = 0
    glowHalo.ZIndex = 0
    glowHalo.Parent = scaler
    corner(glowHalo, 24)

    local glowEdge = Instance.new("Frame")
    glowEdge.Name = "EdgeGlowRim"
    glowEdge.Size = UDim2.fromScale(1, 1)
    glowEdge.BackgroundTransparency = 1
    glowEdge.BorderSizePixel = 0
    glowEdge.ZIndex = 0
    glowEdge.Parent = scaler
    corner(glowEdge, 24)

    local glowLayers = {}
    do
        local edge = Instance.new("UIStroke")
        edge.Name = "EdgeGlowEdge"
        edge.Color = Palette.Accent
        edge.Thickness = 7
        edge.Transparency = 1
        edge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        edge:SetAttribute("ThemeRole", "glow")
        edge.Parent = glowEdge

        local halo = Instance.new("UIStroke")
        halo.Name = "EdgeGlowHalo"
        halo.Color = Palette.Accent
        halo.Thickness = 22
        halo.Transparency = 1
        halo.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        halo:SetAttribute("ThemeRole", "glow")
        halo.Parent = glowHalo

        glowLayers[1] = { stroke = edge, idle = 0.45, peak = 0.10, speed = 1.7 }
        glowLayers[2] = { stroke = halo, idle = 0.80, peak = 0.55, speed = 2.3 }
    end

    local function setEdgeGlow(on)
        Appearance.EdgeGlow = on and true or false
        for _, layer in ipairs(glowLayers) do
            if layer.tween then
                layer.tween:Cancel()
                layer.tween = nil
            end
            local s = layer.stroke
            if Appearance.EdgeGlow then
                s.Transparency = layer.idle
                layer.tween = TweenService:Create(s,
                    TweenInfo.new(layer.speed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
                    { Transparency = layer.peak })
                layer.tween:Play()
            else
                s.Transparency = 1
            end
        end
    end

    local function colorToHex(c)
        return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
    end
    local function hexToColor(hex)
        hex = tostring(hex or ""):gsub("%s", ""):gsub("#", "")
        if #hex == 6 and hex:match("^%x%x%x%x%x%x$") then
            return Color3.fromRGB(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16))
        end
        return nil
    end

    local function applyTheme()
        local accent, button, border = Palette.Accent, Palette.Button, Palette.Border
        for _, obj in ipairs(gui:GetDescendants()) do
            local role = obj:GetAttribute("ThemeRole")
            if role == "border" and obj:IsA("UIStroke") then
                obj.Color = border
            elseif role == "glow" and obj:IsA("UIStroke") then
                obj.Color = accent
            elseif role == "accentBg" then
                obj.BackgroundColor3 = accent
            elseif role == "accentText" and obj:IsA("TextLabel") then
                obj.TextColor3 = accent
            elseif role == "scroll" and obj:IsA("ScrollingFrame") then
                obj.ScrollBarImageColor3 = accent
            elseif role == "toggle" and obj:IsA("TextButton") then
                obj.BackgroundColor3 = obj:GetAttribute("ToggleState") and accent or Palette.Off
            elseif role == "field" then
                obj.BackgroundColor3 = button
            elseif role == "button" and obj:IsA("TextButton") then
                obj.BackgroundColor3 = button
            end
        end
    end

    local function applyColors(accent, button, border)
        Palette.Accent = accent
        Palette.AccentLight = accent:Lerp(Color3.new(1, 1, 1), 0.4)
        Palette.Button = button
        Palette.Border = border
        Palette.Off = button:Lerp(Color3.new(0, 0, 0), 0.4)
        Appearance.Accent = { math.floor(accent.R * 255 + 0.5), math.floor(accent.G * 255 + 0.5), math.floor(accent.B * 255 + 0.5) }
        Appearance.Button = { math.floor(button.R * 255 + 0.5), math.floor(button.G * 255 + 0.5), math.floor(button.B * 255 + 0.5) }
        Appearance.Border = { math.floor(border.R * 255 + 0.5), math.floor(border.G * 255 + 0.5), math.floor(border.B * 255 + 0.5) }
        applyTheme()
    end

    local SCALE_OPTIONS = { "75%", "100%", "125%", "150%", "175%", "200%" }
    local SCALE_VALUES = { ["75%"] = 0.75, ["100%"] = 1, ["125%"] = 1.25, ["150%"] = 1.5, ["175%"] = 1.75, ["200%"] = 2 }
    local function scaleLabel(v)
        local best, bestDiff = "100%", math.huge
        for label, val in pairs(SCALE_VALUES) do
            local diff = math.abs(val - (tonumber(v) or 1))
            if diff < bestDiff then
                best, bestDiff = label, diff
            end
        end
        return best
    end

    local function setUiScale(scale, instant)
        scale = math.clamp(tonumber(scale) or 1, 0.75, 2)
        Appearance.Scale = scale
        if instant then
            uiScaleObj.Scale = scale
        else
            tween(uiScaleObj, 0.25, { Scale = scale }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        end
    end

    local function setBlur(on)
        Appearance.Blur = on and true or false
        if introActive then return end
        pcall(function()
            tween(ensureBlur(), 0.4, { Size = (isOpen and Appearance.Blur) and BLUR_SIZE or 0 })
        end)
    end

    local titleBar = Instance.new("Frame")
    titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1, 0, 0, BAR_H)
    titleBar.BackgroundTransparency = 1
    titleBar.ZIndex = 6
    titleBar.Parent = window

    local function makeDot(x, color, glyph)
        local dot = Instance.new("TextButton")
        dot.Size = UDim2.fromOffset(12, 12)
        dot.Position = UDim2.new(0, x, 0.5, -6)
        dot.BackgroundColor3 = color
        dot.Text = glyph
        dot.TextColor3 = Color3.fromRGB(60, 20, 20)
        dot.TextTransparency = 1
        dot.AutoButtonColor = false
        dot.ZIndex = 7
        dot.Parent = titleBar
        corner(dot, 6)
        stroke(dot, 1, 0.6)
        return dot
    end
    local closeDot = makeDot(14, Color3.fromRGB(255, 95, 86), "x")
    local minDot = makeDot(32, Color3.fromRGB(255, 189, 46), "-")
    local maxDot = makeDot(50, Color3.fromRGB(39, 201, 63), "+")

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -140, 0, 15)
    titleLabel.Position = UDim2.new(0, 76, 0, 3)
    titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = TITLE .. "  |  " .. SUBTITLE
    titleLabel.TextColor3 = Color3.fromRGB(235, 235, 242)
