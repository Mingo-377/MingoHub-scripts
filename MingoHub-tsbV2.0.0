    addSection(main, "Solitude Dash")
    addTextbox(main, "Solitude Delay (s)", "TP delay after dash (0-1)", Settings.AutoTech.SolitudeDelay, function(v) Settings.AutoTech.SolitudeDelay = math.clamp(tonumber(v) or 0.18, 0, 1) end, true, function() return Settings.AutoTech.SolitudeDelay end)

    addSection(main, "True DownSlam")
    addToggle(main, "TDS Enabled", "", Settings.Misc.TDSEnabled, function(on) Settings.Misc.TDSEnabled = on end, function() return Settings.Misc.TDSEnabled end)
    addKeybind(main, "TDS Keybind", "", Settings.Misc.TDSKey, function()
        if not Settings.Misc.TDSEnabled then return end
        task.spawn(function()
            if not currentCharacter then return end
            local hum = currentHumanoid
            local root = currentRootPart
            if not (hum and root and hum.Health > 0) then return end
            local noJump = currentCharacter:FindFirstChild("NoJump")
            if noJump then task.defer(noJump.Destroy, noJump) end
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            task.wait(0.01)
            if root and root.Parent then
                root.Velocity = Vector3.new(root.Velocity.X, 35, root.Velocity.Z)
            end
            if currentCommunicate then
                task.wait()
                if VirtualInputManager then
                    pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game) end)
                    task.wait()
                    pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game) end)
                    task.wait()
                    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(400, 300)
                    local hx, hy = math.floor(vp.X / 2), math.floor(vp.Y / 2)
                    pcall(function() VirtualInputManager:SendMouseButtonEvent(hx, hy, 0, true, game, 0) end)
                    task.wait()
                    pcall(function() VirtualInputManager:SendMouseButtonEvent(hx, hy, 0, false, game, 0) end)
                elseif currentCommunicate then
                    currentCommunicate:FireServer(leftclick.holdM1)
                    task.wait()
                    currentCommunicate:FireServer(leftclick.releaseM1)
                end
                task.wait()
            end
        end)
    end, function(k) Settings.Misc.TDSKey = k end, function() return Settings.Misc.TDSKey end)

    addSection(main, "Macro")
    addToggle(main, "Backdash Cancel", "", Settings.Macros.Backdash.Enabled, function(on)
        Settings.Macros.Backdash.Enabled = on
        extra.setBackdash(on)
    end, function() return Settings.Macros.Backdash.Enabled end)
    local function addBackdashVariant(i)
        local v = Settings.Macros.Backdash.Variants
        local row = baseRow(main, 32)
        rowLabels(row, "Backdash Cancel " .. i, nil)

        local track = Instance.new("TextButton")
        track.Size = UDim2.fromOffset(34, 18)
        track.Position = UDim2.new(1, -112, 0.5, -9)
        track.Text = ""
        track.AutoButtonColor = false
        track.BackgroundColor3 = v[i] and Palette.Accent or Palette.Off
        track.ZIndex = 6
        track:SetAttribute("ThemeRole", "toggle")
        track:SetAttribute("ToggleState", v[i] and true or false)
        track.Parent = row
        corner(track, 9)
        stroke(track, 1, 0.6)
        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(14, 14)
        knob.Position = v[i] and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.ZIndex = 7
        knob.Parent = track
        corner(knob, 7)

        local function renderToggle()
            track.BackgroundColor3 = v[i] and Palette.Accent or Palette.Off
            track:SetAttribute("ToggleState", v[i] and true or false)
            knob.Position = v[i] and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        end
        track.MouseButton1Click:Connect(function()
            v[i] = not v[i]
            renderToggle()
            if Settings.Macros.Backdash.Enabled then extra.setBackdash(true) end
        end)

        local keyBtn = Instance.new("TextButton")
        keyBtn.Size = UDim2.fromOffset(72, 22)
        keyBtn.Position = UDim2.new(1, -72, 0.5, -11)
        keyBtn.BackgroundColor3 = Palette.Button
        keyBtn.BackgroundTransparency = 0.36
        keyBtn.TextColor3 = Color3.new(1, 1, 1)
        keyBtn.Font = FONT
        keyBtn.TextSize = 11
        keyBtn.AutoButtonColor = false
        keyBtn.ZIndex = 7
        keyBtn:SetAttribute("ThemeRole", "field")
        keyBtn.Parent = row
        corner(keyBtn, 10)
        stroke(keyBtn, 1, 0.6)

        local function renderKey()
            local k = Settings.Macros.Backdash.Keys[i]
            keyBtn.Text = k and k.Name or "None"
        end
        renderKey()

        keyBtn.MouseButton1Click:Connect(function()
            if keybindListening then return end
            keybindListening = true
            currentListeningButton = keyBtn
            keyBtn.Text = "Press key..."
            local conn
            conn = UIS.InputBegan:Connect(function(input, gpe)
                if not gpe and input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode == Enum.KeyCode.Escape then
                        -- cancel
                    else
                        Settings.Macros.Backdash.Keys[i] = input.KeyCode
                    end
                    renderKey()
                    keybindListening = false
                    currentListeningButton = nil
                    conn:Disconnect()
                    if Settings.Macros.Backdash.Enabled then extra.setBackdash(true) end
                end
            end)
        end)

        registerControl(function()
            renderToggle()
            renderKey()
        end)
    end
    for i = 1, 4 do addBackdashVariant(i) end

