    Sunrise        = { clock=6.4, bright=2, amb=Color3.fromRGB(110,90,80), out=Color3.fromRGB(150,120,100), atmos={0.35,Color3.fromRGB(255,190,150),Color3.fromRGB(255,130,90),0.4,1.2}, stars=1000, tint=Color3.fromRGB(255,245,235) },
    Sunset         = { clock=17.8, bright=2, amb=Color3.fromRGB(120,85,70), out=Color3.fromRGB(160,110,90), atmos={0.35,Color3.fromRGB(255,170,120),Color3.fromRGB(200,90,60),0.6,1.6}, stars=1000, tint=Color3.fromRGB(255,240,225) },
    Night          = { clock=0, bright=1, amb=Color3.fromRGB(40,45,70), out=Color3.fromRGB(60,65,100), atmos={0.25,Color3.fromRGB(70,80,130),Color3.fromRGB(20,25,50),0,0.5}, stars=5000 },
    ["Purple Night"]= { clock=23, bright=1, amb=Color3.fromRGB(70,50,110), out=Color3.fromRGB(100,70,150), atmos={0.3,Color3.fromRGB(150,110,255),Color3.fromRGB(60,30,120),0.3,0.8}, stars=4000, tint=Color3.fromRGB(240,225,255) },
    ["Blood Moon"]  = { clock=0.5, bright=1, amb=Color3.fromRGB(90,30,30), out=Color3.fromRGB(130,40,40), atmos={0.35,Color3.fromRGB(180,40,40),Color3.fromRGB(90,10,10),0.2,1}, stars=1500, tint=Color3.fromRGB(255,200,200) },
    Aurora         = { clock=22, bright=1.2, amb=Color3.fromRGB(40,80,80), out=Color3.fromRGB(60,120,110), atmos={0.3,Color3.fromRGB(90,255,200),Color3.fromRGB(40,90,160),0.4,0.8}, stars=5000, tint=Color3.fromRGB(225,255,245) },
    Foggy          = { clock=9, bright=1.5, amb=Color3.fromRGB(120,120,125), out=Color3.fromRGB(140,140,145), atmos={0.6,Color3.fromRGB(200,200,205),Color3.fromRGB(160,160,170),0,3}, stars=0 },
    Dawn           = { clock=6, bright=1, amb=Color3.fromRGB(70,60,80), out=Color3.fromRGB(110,100,130), atmos={0.3,Color3.fromRGB(90,80,110),Color3.fromRGB(90,80,110),0,0}, stars=500 },
    ["Custom Skybox"]= nil,
}
SkyManager.order = { "Clear Day","Sunrise","Sunset","Night","Purple Night","Blood Moon","Aurora","Foggy","Dawn","Custom Skybox" }
SkyManager.set = function(inst, prop, val) local t = SkyManager.touched[inst]; if not t then t = {}; SkyManager.touched[inst] = t end; if t[prop] == nil then pcall(function() t[prop] = inst[prop] end) end; pcall(function() inst[prop] = val end) end
SkyManager.restore = function() for inst2, props in pairs(SkyManager.touched) do for prop, val in pairs(props) do pcall(function() inst2[prop] = val end) end end; table.clear(SkyManager.touched); for _, inst2 in ipairs(SkyManager.created) do pcall(function() inst2:Destroy() end) end; table.clear(SkyManager.created) end
SkyManager.child = function(class, name) local obj = Lighting:FindFirstChild(name) or Lighting:FindFirstChildOfClass(class); if not obj then obj = Instance.new(class); obj.Name = name; obj.Parent = Lighting; table.insert(SkyManager.created, obj) end; return obj end
local colorCorrection
do colorCorrection = Lighting:FindFirstChild("ColorCorrection"); if not colorCorrection then colorCorrection = Instance.new("ColorCorrectionEffect"); colorCorrection.Name = "ColorCorrection"; colorCorrection.Parent = Lighting end end
SkyManager.apply = function()
    local sky2 = Settings.Visuals.CustomSky
    if not sky2.Enabled then SkyManager.restore(); return end
    local skyInst = SkyManager.child("Sky", "MingoCustomSky")
    SkyManager.set(skyInst, "StarCount", sky2.Stars); SkyManager.set(skyInst, "CelestialBodiesShown", true)
    local preset = SkyManager.presets[sky2.Preset]
    if preset then
        SkyManager.set(Lighting, "ClockTime", preset.clock); SkyManager.set(Lighting, "Brightness", preset.bright)
        SkyManager.set(Lighting, "Ambient", preset.amb); SkyManager.set(Lighting, "OutdoorAmbient", preset.out)
        local atm = SkyManager.child("Atmosphere", "MingoSkyAtmosphere"); local a = preset.atmos
        SkyManager.set(atm, "Density", a[1]); SkyManager.set(atm, "Color", a[2]); SkyManager.set(atm, "Decay", a[3]); SkyManager.set(atm, "Glare", a[4]); SkyManager.set(atm, "Haze", a[5])
        if colorCorrection then SkyManager.set(colorCorrection, "TintColor", preset.tint or Color3.new(1,1,1)) end
    elseif sky2.Preset == "Custom Skybox" then
        local id = tostring(sky2.SkyboxId):match("%d+")
        if id then for _, face in ipairs({"SkyboxBk","SkyboxDn","SkyboxFt","SkyboxLf","SkyboxRt","SkyboxUp"}) do SkyManager.set(skyInst, face, "rbxassetid://" .. id) end end
    end
end

local atmSnapshot = { exists = false, Density=0.3, Offset=0, Color=Color3.fromRGB(199,170,107), Decay=Color3.fromRGB(92,60,13), Glare=0, Haze=0 }
local atmInstance, atmCreatedHere = nil, false
local function applyAtmosphere()
    local s = Settings.Visuals.CustomAtmosphere
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if not atm then atm = Instance.new("Atmosphere"); atm.Name = "MingoAtmosphere"; atm.Parent = Lighting; atmCreatedHere = true
    elseif not atmSnapshot.exists then atmSnapshot = { exists=true, Density=atm.Density, Offset=atm.Offset, Color=atm.Color, Decay=atm.Decay, Glare=atm.Glare, Haze=atm.Haze } end
    atmInstance = atm
    pcall(function() atm.Density = s.Density; atm.Color = s.Color; atm.Decay = s.Decay; atm.Glare = s.Glare; atm.Haze = s.Haze end)
end
local function setCustomAtmosphere(on)
    Settings.Visuals.CustomAtmosphere.Enabled = on and true or false
    if on then applyAtmosphere()
    else
        if atmInstance and atmInstance.Parent then
            if atmSnapshot.exists then pcall(function() atmInstance.Density = atmSnapshot.Density; atmInstance.Offset = atmSnapshot.Offset; atmInstance.Color = atmSnapshot.Color; atmInstance.Decay = atmSnapshot.Decay; atmInstance.Glare = atmSnapshot.Glare; atmInstance.Haze = atmSnapshot.Haze end); atmSnapshot.exists = false
            elseif atmCreatedHere then pcall(function() atmInstance:Destroy() end) end
        end
        atmInstance = nil; atmCreatedHere = false
    end
end

local antiFlingConn
local function setAntiFling(on)
    disconnectConn(antiFlingConn); antiFlingConn = nil
    if not on then return end
    local lastGoodCF = nil
    antiFlingConn = connectSignal(RunService.Heartbeat, function()
        local root5 = RootPart
        if not (root5 and root5.Parent and Character) then return end
        local isGameMove = root5:FindFirstChild("moveme") or root5:FindFirstChild("dodgevelocity") or Character:GetAttribute("BeingLaunched") or Character:GetAttribute("Ragdoll")
        local speed, angSpeed = root5.AssemblyLinearVelocity.Magnitude, root5.AssemblyAngularVelocity.Magnitude
        if (not isGameMove and speed > 250) or angSpeed > 250 then
            pcall(function() root5.AssemblyAngularVelocity = Vector3.zero; root5.AssemblyLinearVelocity = Vector3.zero; if lastGoodCF then root5.CFrame = lastGoodCF end end)
        elseif speed < 50 and angSpeed < 50 then lastGoodCF = root5.CFrame end
    end)
end

local BoxESP = { entries = {}, gui = nil, conn = nil }
BoxESP.getGui = function()
    if BoxESP.gui and BoxESP.gui.Parent then return BoxESP.gui end
    local sg = Instance.new("ScreenGui"); sg.Name = "MingoBoxes"; sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.DisplayOrder = 10
    local ok3 = pcall(function() sg.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
    if not ok3 or not sg.Parent then sg.Parent = PlayerGui end
    BoxESP.gui = sg; return sg
end
BoxESP.bounds = function(model, cam, hrp)
    local cf = hrp.CFrame
    local minX, minY, minZ, maxX, maxY, maxZ = math.huge, math.huge, math.huge, -math.huge, -math.huge, -math.huge
    for _, part in ipairs(model:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local pc, hs = cf:ToObjectSpace(part.CFrame), part.Size / 2
            local xv, yv, zv, px = pc.XVector, pc.YVector, pc.ZVector, pc.Position
            local ex = math.abs(xv.X)*hs.X + math.abs(yv.X)*hs.Y + math.abs(zv.X)*hs.Z
            local ey = math.abs(xv.Y)*hs.X + math.abs(yv.Y)*hs.Y + math.abs(zv.Y)*hs.Z
            local ez = math.abs(xv.Z)*hs.X + math.abs(yv.Z)*hs.Y + math.abs(zv.Z)*hs.Z
            if px.X - ex < minX then minX = px.X - ex end; if px.Y - ey < minY then minY = px.Y - ey end; if px.Z - ez < minZ then minZ = px.Z - ez end
            if px.X + ex > maxX then maxX = px.X + ex end; if px.Y + ey > maxY then maxY = px.Y + ey end; if px.Z + ez > maxZ then maxZ = px.Z + ez end
        end
    end
    if minX == math.huge then return nil end
    local sxMin, syMin, sxMax, syMax, visible = math.huge, math.huge, -math.huge, -math.huge, false
    for i = 0, 7 do
        local corner2 = Vector3.new(i%2==0 and minX or maxX, i%4<2 and minY or maxY, i<4 and minZ or maxZ)
        local sp = cam:WorldToViewportPoint(cf:PointToWorldSpace(corner2))
        if sp.Z > 0 then visible = true; if sp.X < sxMin then sxMin = sp.X end; if sp.Y < syMin then syMin = sp.Y end; if sp.X > sxMax then sxMax = sp.X end; if sp.Y > syMax then syMax = sp.Y end end
    end
    if not visible then return nil end
    return math.floor(sxMin+0.5), math.floor(syMin+0.5), math.floor(sxMax-sxMin+0.5), math.floor(syMax-syMin+0.5)
end
local function ringLines(parent, color) local lines = {}; for i = 1, 4 do local f = Instance.new("Frame"); f.BorderSizePixel = 0; f.BackgroundColor3 = color; f.Parent = parent; lines[i] = f end; return lines end
local function placeRing(lines, off, thick, w, h)
    lines[1].Position = UDim2.fromOffset(off, off); lines[1].Size = UDim2.fromOffset(w - 2*off, thick)
    lines[2].Position = UDim2.fromOffset(off, h-off-thick); lines[2].Size = UDim2.fromOffset(w - 2*off, thick)
    lines[3].Position = UDim2.fromOffset(off, off+thick); lines[3].Size = UDim2.fromOffset(thick, h - 2*off - 2*thick)
    lines[4].Position = UDim2.fromOffset(w-off-thick, off+thick); lines[4].Size = UDim2.fromOffset(thick, h - 2*off - 2*thick)
end
local function layoutBox(entry, x, y, w, h)
    local thick, hw = entry.thick, entry.thick + 2; local fw, fh = w + 2*hw, h + 2*hw
    local key = x.."|"..y.."|"..w.."|"..h.."|"..thick; if entry.key == key then return end; entry.key = key
    entry.root.Position = UDim2.fromOffset(x - hw, y - hw); entry.root.Size = UDim2.fromOffset(fw, fh)
    placeRing(entry.outer, 0, 1, fw, fh); placeRing(entry.main, 1, thick, fw, fh); placeRing(entry.inner, 1+thick, 1, fw, fh)
    entry.fill.Position = UDim2.fromOffset(hw, hw); entry.fill.Size = UDim2.fromOffset(w, h)
end
BoxESP.set = function(model, color)
    local entry = BoxESP.entries[model]
    if not entry then
        local root5 = Instance.new("Frame"); root5.BackgroundTransparency = 1; root5.BorderSizePixel = 0; root5.Visible = false
        local fill2 = Instance.new("Frame"); fill2.BorderSizePixel = 0; fill2.Parent = root5
        local black = Color3.new(0, 0, 0)
        entry = { root = root5, fill = fill2, outer = ringLines(root5, black), main = ringLines(root5, color), inner = ringLines(root5, black) }
        root5.Parent = BoxESP.getGui(); BoxESP.entries[model] = entry
    end
    entry.thick = math.clamp(math.floor((Settings.Visuals.ESP.BoxThickness or 1) + 0.5), 1, 6); entry.key = nil
    for _, l in ipairs(entry.main) do l.BackgroundColor3 = color end
    entry.fill.BackgroundColor3 = color; entry.fill.BackgroundTransparency = Settings.Visuals.ESP.BoxFilled and 0.85 or 1
    if not BoxESP.conn then BoxESP.conn = connectSignal(RunService.RenderStepped, BoxESP.step) end
end
BoxESP.remove = function(model)
    local e = BoxESP.entries[model]; if e then pcall(function() e.root:Destroy() end); BoxESP.entries[model] = nil end
    if BoxESP.conn and not next(BoxESP.entries) then disconnectConn(BoxESP.conn); BoxESP.conn = nil end
end
BoxESP.destroy = function() for model in pairs(BoxESP.entries) do BoxESP.remove(model) end; if BoxESP.gui then BoxESP.gui:Destroy(); BoxESP.gui = nil end end
BoxESP.step = function()
    local cam2 = workspace.CurrentCamera; if not cam2 then return end
    local camPos2 = cam2.CFrame.Position; local vp2 = cam2.ViewportSize; local vpW, vpH = vp2.X + 80, vp2.Y + 80
    for model, entry in pairs(BoxESP.entries) do
        local hrp10 = model.Parent and model:FindFirstChild("HumanoidRootPart")
        local hum10 = hrp10 and model:FindFirstChildOfClass("Humanoid")
        if not hrp10 then pcall(function() entry.root:Destroy() end); BoxESP.entries[model] = nil
        elseif hum10 and hum10.Health <= 0 then entry.root.Visible = false
        else
            local hp = hrp10.Position; local dx, dy, dz = hp.X - camPos2.X, hp.Y - camPos2.Y, hp.Z - camPos2.Z
            if dx*dx + dy*dy + dz*dz > 40000 then entry.root.Visible = false
            else
                local sp2 = cam2:WorldToViewportPoint(hp)
                if sp2.Z <= 0 or sp2.X < -80 or sp2.X > vpW or sp2.Y < -80 or sp2.Y > vpH then entry.root.Visible = false
                else
                    local bx, by, bw, bh = BoxESP.bounds(model, cam2, hrp10)
                    if bx and bw >= 4 and bh >= 4 then layoutBox(entry, bx, by, bw, bh); entry.root.Visible = true else entry.root.Visible = false end
                end
            end
        end
    end
end
end -- END CHUNK 6

do -- CHUNK 7: BUILD UI
local function buildUI()
    local keybindListening   = false
    local currentListenBtn   = nil

    local function getGuiParent()
        local pg = player.PlayerGui or player:FindFirstChild("PlayerGui")
        if pg then return pg end
        if gethui then local ok28, h = pcall(gethui); if ok28 and h then return h end end
        local ok29, cg = pcall(function() return game:GetService("CoreGui") end)
        if ok29 and cg then return cg end
        return player:WaitForChild("PlayerGui", 10)
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "VelaUI"; gui.ResetOnSpawn = false; gui.IgnoreGuiInset = true
    gui.Enabled = true; gui.DisplayOrder = 2147483647; gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = getGuiParent()
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
    pcall(function() if protect_gui then protect_gui(gui) end end)

    task.spawn(function()
        while true do
            task.wait(0.5)
            if not gui.Parent then
                pcall(function() gui.Parent = getGuiParent() end)
                pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
            end
            if not gui.Enabled then gui.Enabled = true end
            if gui.DisplayOrder ~= 2147483647 then gui.DisplayOrder = 2147483647 end
        end
    end)

    local toastSerial = 0
    local function notify(text)
        toastSerial += 1; local myId = toastSerial
        local toast = Instance.new("TextLabel")
        toast.Size = UDim2.fromOffset(280, 30); toast.Position = UDim2.new(0.5,0,0,14)
        toast.AnchorPoint = Vector2.new(0.5,0); toast.BackgroundColor3 = Color3.fromRGB(12,17,38)
        toast.BackgroundTransparency = 0.08; toast.Text = text; toast.TextColor3 = Color3.fromRGB(235,240,255)
        toast.Font = FONT; toast.TextSize = 12; toast.TextTruncate = Enum.TextTruncate.AtEnd; toast.ZIndex = 120
        toast.Parent = gui; corner(toast,10); stroke(toast,1,0.35)
        tween(toast,0.25,{Position=UDim2.new(0.5,0,0,14)},Enum.EasingStyle.Quint,Enum.EasingDirection.Out)
        task.delay(2.2, function()
            if not toast.Parent then return end
            local fade = tween(toast,0.3,{TextTransparency=1,BackgroundTransparency=1,Position=UDim2.new(0.5,0,0,4)})
            fade.Completed:Connect(function() if myId <= toastSerial then toast:Destroy() end end)
        end)
    end

    local blur = Instance.new("BlurEffect"); blur.Name = "VelaBlur"; blur.Size = 0; blur.Parent = Lighting
    local function ensureBlur()
        if not blur or not blur.Parent then
            blur = Instance.new("BlurEffect"); blur.Name = "VelaBlur"; blur.Size = 0; blur.Parent = Lighting
        end
        blur.Enabled = true; return blur
    end

    local isOpen = false; local minimized = false; local introActive = false

    local root = Instance.new("Frame")
    root.Name = "Root"; root.Size = UDim2.fromOffset(WIN_W, WIN_H)
    root.Position = UDim2.new(0.5,-WIN_W/2,0.5,-WIN_H/2); root.BackgroundTransparency = 1; root.Parent = gui

    local rootScale = Instance.new("UIScale"); rootScale.Name = "OpenCloseScale"; rootScale.Scale = 1; rootScale.Parent = root

    local scaler = Instance.new("Frame")
    scaler.Name = "ScaleHost"; scaler.Size = UDim2.fromScale(1,1); scaler.AnchorPoint = Vector2.new(0.5,0.5)
    scaler.Position = UDim2.fromScale(0.5,0.5); scaler.BackgroundTransparency = 1; scaler.Parent = root

    local uiScaleObj = Instance.new("UIScale"); uiScaleObj.Name = "UiSize"; uiScaleObj.Scale = Appearance.Scale; uiScaleObj.Parent = scaler

    local window = Instance.new("CanvasGroup")
    window.Name = "Window"; window.Size = UDim2.fromOffset(WIN_W, WIN_H)
    window.BackgroundColor3 = Color3.fromRGB(10,15,39); window.BackgroundTransparency = 0.34
    window.BorderSizePixel = 0; window.ClipsDescendants = true; window.GroupTransparency = 1; window.Parent = scaler
    corner(window,24); stroke(window,1.5,0.35)

    local winScale = Instance.new("UIScale"); winScale.Scale = 1; winScale.Parent = window

    local BG_INITIAL = "rbxassetid://120306120997150"
    local bg = Instance.new("ImageLabel"); bg.Name = "Background"; bg.Size = UDim2.fromScale(1,1)
    bg.BackgroundTransparency = 1; bg.Image = BG_INITIAL; bg.ImageTransparency = 0.06
    bg.ImageRectSize = Vector2.new(256,160); bg.ScaleType = Enum.ScaleType.Stretch; bg.ZIndex = 1; bg.Parent = window; corner(bg,24)
    local bgNext = Instance.new("ImageLabel"); bgNext.Name = "BackgroundBlend"; bgNext.Size = UDim2.fromScale(1,1)
    bgNext.BackgroundTransparency = 1; bgNext.Image = BG_INITIAL; bgNext.ImageTransparency = 1
    bgNext.ImageRectSize = Vector2.new(256,160); bgNext.ScaleType = Enum.ScaleType.Stretch; bgNext.ZIndex = 2; bgNext.Parent = window; corner(bgNext,24)

    local activeLayer, incomingLayer = bg, bgNext
    local frameIdx, frameClock2 = 0, 0
    local currentBgDef = BACKGROUNDS[1]
    connectSignal(RunService.Heartbeat, function(dt2)
        if not window:IsDescendantOf(game) or not currentBgDef or not currentBgDef.cols then return end
        if not isOpen then return end
        frameClock2 += dt2
        local fps2 = currentBgDef.fps or 7
        if frameClock2 < 1/fps2 then return end
        frameClock2 %= 1/fps2
        frameIdx = (frameIdx+1) % (currentBgDef.frames or 24)
        local col2 = frameIdx % currentBgDef.cols
        local row2 = math.floor(frameIdx / currentBgDef.cols)
        incomingLayer.Image = activeLayer.Image
        incomingLayer.ImageRectOffset = Vector2.new(col2*currentBgDef.w, row2*currentBgDef.h)
        incomingLayer.ImageRectSize = Vector2.new(currentBgDef.w, currentBgDef.h)
        incomingLayer.ImageTransparency = 0.06; incomingLayer.Visible = true
        activeLayer.Visible = false
        activeLayer, incomingLayer = incomingLayer, activeLayer
    end)

    local overlay = Instance.new("Frame"); overlay.Name = "BackgroundOverlay"; overlay.Size = UDim2.fromScale(1,1)
    overlay.BackgroundColor3 = Color3.fromRGB(9,15,43); overlay.BackgroundTransparency = 0.58
    overlay.BorderSizePixel = 0; overlay.ZIndex = 2; overlay.Parent = window; corner(overlay,24)
    local glass = Instance.new("Frame"); glass.Name = "Glass"; glass.Size = UDim2.fromScale(1,1)
    glass.BackgroundColor3 = Color3.fromRGB(166,190,255); glass.BackgroundTransparency = 0.94
    glass.BorderSizePixel = 0; glass.ZIndex = 3; glass.Parent = window; corner(glass,24)

    local glowHalo = Instance.new("Frame"); glowHalo.Name = "EdgeGlowHalo"; glowHalo.Size = UDim2.fromScale(1,1)
    glowHalo.BackgroundTransparency = 1; glowHalo.BorderSizePixel = 0; glowHalo.ZIndex = 0; glowHalo.Parent = scaler; corner(glowHalo,24)
    local glowEdge = Instance.new("Frame"); glowEdge.Name = "EdgeGlowRim"; glowEdge.Size = UDim2.fromScale(1,1)
    glowEdge.BackgroundTransparency = 1; glowEdge.BorderSizePixel = 0; glowEdge.ZIndex = 0; glowEdge.Parent = scaler; corner(glowEdge,24)
    local glowLayers = {}
    do
        local edge = Instance.new("UIStroke"); edge.Name = "EdgeGlowEdge"; edge.Color = Palette.Accent
        edge.Thickness = 7; edge.Transparency = 1; edge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        edge:SetAttribute("ThemeRole","glow"); edge.Parent = glowEdge
        local halo2 = Instance.new("UIStroke"); halo2.Name = "EdgeGlowHalo2"; halo2.Color = Palette.Accent
        halo2.Thickness = 22; halo2.Transparency = 1; halo2.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        halo2:SetAttribute("ThemeRole","glow"); halo2.Parent = glowHalo
        glowLayers[1] = { stroke = edge,  idle = 0.45, peak = 0.10, speed = 1.7 }
        glowLayers[2] = { stroke = halo2, idle = 0.80, peak = 0.55, speed = 2.3 }
    end

    local function setEdgeGlow(on)
        Appearance.EdgeGlow = on and true or false
        for _, layer in ipairs(glowLayers) do
            if layer.tween then layer.tween:Cancel(); layer.tween = nil end
            if Appearance.EdgeGlow then
                layer.stroke.Transparency = layer.idle
                layer.tween = TweenService:Create(layer.stroke,
                    TweenInfo.new(layer.speed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
                    { Transparency = layer.peak })
                layer.tween:Play()
            else
                layer.stroke.Transparency = 1
            end
        end
    end

    local function applyTheme()
        local accent = Palette.Accent; local button = Palette.Button; local border = Palette.Border
        for _, obj in ipairs(gui:GetDescendants()) do
            local role = obj:GetAttribute("ThemeRole")
            if role == "border" and obj:IsA("UIStroke") then obj.Color = border
            elseif role == "glow" and obj:IsA("UIStroke") then obj.Color = accent
            elseif role == "accentBg" then obj.BackgroundColor3 = accent
            elseif role == "accentText" and obj:IsA("TextLabel") then obj.TextColor3 = accent
            elseif role == "scroll" and obj:IsA("ScrollingFrame") then obj.ScrollBarImageColor3 = accent
            elseif role == "toggle" and obj:IsA("TextButton") then
                obj.BackgroundColor3 = obj:GetAttribute("ToggleState") and accent or Palette.Off
            elseif role == "field" then obj.BackgroundColor3 = button
            elseif role == "button" and obj:IsA("TextButton") then obj.BackgroundColor3 = button
            end
        end
    end

    local function applyColors(accent, button, border)
        Palette.Accent      = accent
        Palette.AccentLight = accent:Lerp(Color3.new(1,1,1), 0.4)
        Palette.Button      = button
        Palette.Border      = border
        Palette.Off         = button:Lerp(Color3.new(0,0,0), 0.4)
        Appearance.Accent   = { math.floor(accent.R*255+0.5), math.floor(accent.G*255+0.5), math.floor(accent.B*255+0.5) }
        Appearance.Button   = { math.floor(button.R*255+0.5), math.floor(button.G*255+0.5), math.floor(button.B*255+0.5) }
        Appearance.Border   = { math.floor(border.R*255+0.5), math.floor(border.G*255+0.5), math.floor(border.B*255+0.5) }
        applyTheme()
    end

    local SCALE_OPTIONS = { "75%","100%","125%","150%","175%","200%" }
    local SCALE_VALUES  = { ["75%"]=0.75,["100%"]=1,["125%"]=1.25,["150%"]=1.5,["175%"]=1.75,["200%"]=2 }
    local function scaleLabel(v)
        local best, bestD = "100%", math.huge
        for label, val in pairs(SCALE_VALUES) do
            local d = math.abs(val - (tonumber(v) or 1)); if d < bestD then best, bestD = label, d end
        end
        return best
    end

    local function setUiScale(scale, instant)
        scale = math.clamp(tonumber(scale) or 1, 0.75, 2); Appearance.Scale = scale
        if instant then uiScaleObj.Scale = scale
        else tween(uiScaleObj, 0.25, {Scale=scale}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) end
    end

    local function setBlur(on)
        Appearance.Blur = on and true or false
        if introActive then return end
        pcall(function() tween(ensureBlur(), 0.4, {Size=(isOpen and Appearance.Blur) and BLUR_SIZE or 0}) end)
    end

    local applyAppearanceFunc = function()
        applyColors(
            Color3.fromRGB(Appearance.Accent[1],Appearance.Accent[2],Appearance.Accent[3]),
            Color3.fromRGB(Appearance.Button[1],Appearance.Button[2],Appearance.Button[3]),
            Color3.fromRGB(Appearance.Border[1],Appearance.Border[2],Appearance.Border[3])
        )
        setUiScale(Appearance.Scale, true)
        setEdgeGlow(Appearance.EdgeGlow)
        setBlur(Appearance.Blur)
        if Appearance.Background then
        end
    end

    local function applyBackground(name)
        local b
        if Settings.Visuals.CustomBackground.Enabled and Settings.Visuals.CustomBackground.ImageId ~= "" then
            local img2 = Settings.Visuals.CustomBackground.ImageId
            if not img2:match("^rbxassetid://") then img2 = "rbxassetid://" .. img2 end
            b = { image = img2 }
        else
            for _, x in ipairs(BACKGROUNDS) do if x.name == name then b = x end end
        end
        if not b or b.image == "" then return end
        local img3 = resolveImage(b.image)
        if not img3 then return end
        Appearance.Background = name; currentBgDef = b
        frameIdx = 0; frameClock2 = 0
        local sprite = b.cols ~= nil
        local newW = b.w or 341; local newH = b.h or 213
        local rectSize2 = sprite and Vector2.new(newW, newH) or Vector2.new(0, 0)
        local scaleType2 = sprite and Enum.ScaleType.Stretch or Enum.ScaleType.Crop
        activeLayer.Image = img3; activeLayer.ImageTransparency = 0.06
        activeLayer.ImageRectOffset = Vector2.new(0,0); activeLayer.ImageRectSize = rectSize2
        activeLayer.ScaleType = scaleType2; activeLayer.Visible = true; activeLayer.ZIndex = 1
        incomingLayer.Image = img3; incomingLayer.ImageTransparency = 1
        incomingLayer.ImageRectOffset = Vector2.new(0,0); incomingLayer.ImageRectSize = rectSize2
        incomingLayer.ScaleType = scaleType2; incomingLayer.Visible = false; incomingLayer.ZIndex = 2
    end

    local _origApplyAppearance = applyAppearanceFunc
    local applyAppearance = function()
        _origApplyAppearance()
        if Appearance.Background then applyBackground(Appearance.Background) end
    end

    local titleBar = Instance.new("Frame"); titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1,0,0,BAR_H); titleBar.BackgroundTransparency = 1; titleBar.ZIndex = 6; titleBar.Parent = window

    local function makeDot(x, color2, glyph)
        local dot = Instance.new("TextButton"); dot.Size = UDim2.fromOffset(12,12)
        dot.Position = UDim2.new(0,x,0.5,-6); dot.BackgroundColor3 = color2; dot.Text = glyph
        dot.TextColor3 = Color3.fromRGB(60,20,20); dot.TextTransparency = 1; dot.AutoButtonColor = false
        dot.ZIndex = 7; dot.Parent = titleBar; corner(dot,6); stroke(dot,1,0.6); return dot
    end
    local closeDot = makeDot(14, Color3.fromRGB(255,95,86),  "x")
    local minDot   = makeDot(32, Color3.fromRGB(255,189,46), "-")
    local maxDot   = makeDot(50, Color3.fromRGB(39,201,63),  "+")

    local titleLabel = Instance.new("TextLabel"); titleLabel.Size = UDim2.new(1,-140,0,15)
    titleLabel.Position = UDim2.new(0,76,0,3); titleLabel.BackgroundTransparency = 1
    titleLabel.Text = TITLE .. "  |  " .. SUBTITLE; titleLabel.TextColor3 = Color3.fromRGB(235,235,242)
    titleLabel.Font = FONT; titleLabel.TextSize = 12; titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.ZIndex = 6; titleLabel.TextTruncate = Enum.TextTruncate.AtEnd; titleLabel.Parent = titleBar

    local infoLabel = Instance.new("TextLabel"); infoLabel.Name = "PlayerInfo"
    infoLabel.Size = UDim2.new(1,-140,0,11); infoLabel.Position = UDim2.new(0,76,0,17)
    infoLabel.BackgroundTransparency = 1
    infoLabel.Text = player.Name .. "  |  " .. EXECUTOR_NAME .. "  |  " .. DEVICE .. "  |  " .. (isMobile and "use SHOW UI" or "RightShift = hide/show")
    infoLabel.TextColor3 = Color3.fromRGB(165,165,178); infoLabel.Font = FONT; infoLabel.TextSize = 9
    infoLabel.TextXAlignment = Enum.TextXAlignment.Left; infoLabel.TextTruncate = Enum.TextTruncate.AtEnd
    infoLabel.ZIndex = 6; infoLabel.Parent = titleBar

    local versionLabel = Instance.new("TextLabel"); versionLabel.Name = "Version"
    versionLabel.Size = UDim2.fromOffset(120,14); versionLabel.Position = UDim2.new(0,14,1,-22)
    versionLabel.BackgroundTransparency = 1; versionLabel.Text = VERSION
    versionLabel.TextColor3 = Color3.fromRGB(165,165,178); versionLabel.TextTransparency = 0.2
    versionLabel.Font = FONT; versionLabel.TextSize = 10; versionLabel.TextXAlignment = Enum.TextXAlignment.Left
    versionLabel.ZIndex = 8; versionLabel.Parent = window

    local pos = {x=-WIN_W/2, y=-WIN_H/2}; local target = {x=pos.x, y=pos.y}
    local dragging = false; local dragStart2, startTarget
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart2 = input.Position; startTarget = {x=target.x, y=target.y}
            tween(winScale,0.25,{Scale=1.015})
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart2; local vp = gui.AbsoluteSize
            local overflow = (WIN_W*(Appearance.Scale or 1) - WIN_W)/2
            target.x = math.clamp(startTarget.x+delta.X, -vp.X/2+overflow, vp.X/2-WIN_W-overflow)
            target.y = math.clamp(startTarget.y+delta.Y, -vp.Y/2+overflow, vp.Y/2-BAR_H-overflow)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false; tween(winScale,0.4,{Scale=1},Enum.EasingStyle.Back)
        end
    end)
    connectSignal(RunService.RenderStepped, function(dt3)
        local a = 1 - math.exp(-dt3*22); local dx2, dy2 = target.x-pos.x, target.y-pos.y
        if math.abs(dx2)>0.05 or math.abs(dy2)>0.05 then
            pos.x += dx2*a; pos.y += dy2*a
            root.Position = UDim2.new(0.5,pos.x,0.5,pos.y)
        end
    end)

    local SIDE_W, TAB_H, TAB_GAP = 100, 28, 6

    local sidebar = Instance.new("Frame"); sidebar.Name = "Sidebar"
    sidebar.Size = UDim2.fromOffset(SIDE_W, WIN_H-BAR_H-8); sidebar.Position = UDim2.fromOffset(8, BAR_H+2)
    sidebar.BackgroundTransparency = 1; sidebar.ZIndex = 5; sidebar.Parent = window

    local pill = Instance.new("Frame"); pill.Name = "SelectedTabPill"
    pill.Size = UDim2.new(1,0,0,TAB_H); pill.BackgroundColor3 = Palette.Accent
    pill.BackgroundTransparency = 0.78; pill.BorderSizePixel = 0; pill.Visible = false; pill.ZIndex = 5
    pill:SetAttribute("ThemeRole","accentBg"); pill.Parent = sidebar; corner(pill,14); stroke(pill,1,0.55)

    local tabList = Instance.new("Frame"); tabList.Name = "Tabs"; tabList.Size = UDim2.fromScale(1,1)
    tabList.BackgroundTransparency = 1; tabList.ZIndex = 6; tabList.Parent = sidebar
    local tabLayout = Instance.new("UIListLayout"); tabLayout.Padding = UDim.new(0,TAB_GAP)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder; tabLayout.Parent = tabList

    local pagesHolder = Instance.new("Frame"); pagesHolder.Name = "Pages"
    pagesHolder.Size = UDim2.fromOffset(WIN_W-SIDE_W-24, WIN_H-BAR_H-8)
    pagesHolder.Position = UDim2.fromOffset(SIDE_W+16, BAR_H+2)
    pagesHolder.BackgroundTransparency = 1; pagesHolder.ZIndex = 5; pagesHolder.Parent = window

    local pages = {}; local tabButtons = {}; local tabNames = {}; local currentTab

    local function createPage(name)
        local page = Instance.new("CanvasGroup"); page.Name = name.."Page"
        page.Size = UDim2.fromScale(1,1); page.BackgroundTransparency = 1
        page.Visible = false; page.GroupTransparency = 1; page.ZIndex = 5; page.Parent = pagesHolder
        local scroll = Instance.new("ScrollingFrame"); scroll.Name = "Content"
        scroll.Size = UDim2.fromScale(1,1); scroll.BackgroundTransparency = 1; scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 2; scroll.ScrollBarImageColor3 = Palette.Accent
        scroll.CanvasSize = UDim2.new(); scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.ZIndex = 5; scroll:SetAttribute("ThemeRole","scroll"); scroll.Parent = page
        local layout2 = Instance.new("UIListLayout"); layout2.Padding = UDim.new(0,6)
        layout2.SortOrder = Enum.SortOrder.LayoutOrder; layout2.Parent = scroll
        local padding2 = Instance.new("UIPadding"); padding2.PaddingTop = UDim.new(0,2)
        padding2.PaddingBottom = UDim.new(0,38); padding2.PaddingLeft = UDim.new(0,2)
        padding2.PaddingRight = UDim.new(0,4); padding2.Parent = scroll
        pages[name] = { page = page, scroll = scroll }
    end

    local tabTransSerial = 0
    local function selectTab(name, instant)
        local td = pages[name]; if not td then return end
        if not instant and currentTab == name and td.page.Visible and td.page.GroupTransparency <= 0.02 then return end
        currentTab = name; tabTransSerial += 1; local thisTrans = tabTransSerial
        local idx = table.find(tabNames, name) or 1; pill.Visible = true
        if instant then pill.Position = UDim2.fromOffset(0, (idx-1)*(TAB_H+TAB_GAP))
        else tween(pill, 0.30, {Position=UDim2.fromOffset(0,(idx-1)*(TAB_H+TAB_GAP))}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) end
        for tabName, btn in pairs(tabButtons) do
            tween(btn, 0.18, {TextColor3=tabName==name and Color3.new(1,1,1) or Color3.fromRGB(180,190,220)}, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        end
        if instant then
            for tabName, data10 in pairs(pages) do
                data10.page.Visible = tabName==name; data10.page.GroupTransparency = tabName==name and 0 or 1
                data10.page.Position = UDim2.fromOffset(0,0)
            end; return
        end
        task.spawn(function()
            local fadeOuts = {}
            for tabName, data10 in pairs(pages) do
                if data10.page.Visible and tabName~=name then
                    table.insert(fadeOuts, tween(data10.page, 0.14, {GroupTransparency=1,Position=UDim2.fromOffset(-5,0)}, Enum.EasingStyle.Sine, Enum.EasingDirection.In))
                end
            end
            for _, fo in ipairs(fadeOuts) do fo.Completed:Wait() end
            if thisTrans~=tabTransSerial then return end
            for tabName, data10 in pairs(pages) do
                if tabName~=name then data10.page.Visible=false; data10.page.GroupTransparency=1; data10.page.Position=UDim2.fromOffset(0,0) end
            end
            local tp = td.page; tp.Visible=true; tp.GroupTransparency=1; tp.Position=UDim2.fromOffset(5,0)
            local fi = tween(tp, 0.24, {GroupTransparency=0,Position=UDim2.fromOffset(0,0)}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            fi.Completed:Wait()
            if thisTrans==tabTransSerial and tp.Parent then tp.GroupTransparency=0; tp.Position=UDim2.fromOffset(0,0) end
        end)
    end

    local function createTab(name)
        table.insert(tabNames, name)
        local btn2 = Instance.new("TextButton"); btn2.Name = name.."TabButton"
        btn2.Size = UDim2.new(1,0,0,TAB_H); btn2.BackgroundColor3 = Palette.Accent; btn2.BackgroundTransparency = 1
        btn2.Text = "   "..name; btn2.TextXAlignment = Enum.TextXAlignment.Left
        btn2.TextColor3 = Color3.fromRGB(175,175,188); btn2.Font = FONT; btn2.TextSize = 12
        btn2.AutoButtonColor = false; btn2.LayoutOrder = #tabNames; btn2.ZIndex = 7; btn2.Parent = tabList; corner(btn2,14)
        tabButtons[name] = btn2
        btn2.Activated:Connect(function() selectTab(name) end)
        btn2.MouseEnter:Connect(function() if name~=currentTab then btn2.BackgroundColor3=Palette.Accent; tween(btn2,0.14,{BackgroundTransparency=0.88},Enum.EasingStyle.Sine,Enum.EasingDirection.Out) end end)
        btn2.MouseLeave:Connect(function() tween(btn2,0.14,{BackgroundTransparency=1},Enum.EasingStyle.Sine,Enum.EasingDirection.Out) end)
        createPage(name); return pages[name].scroll
    end

    local function baseRow(parent, height)
        local row = Instance.new("Frame"); row.Size = UDim2.new(1,0,0,height)
        row.BackgroundColor3 = SURFACE_COLOR; row.BackgroundTransparency = 0.48; row.BorderSizePixel = 0
        row.LayoutOrder = nextOrder(parent); row.ZIndex = 5; row.Parent = parent; corner(row,14); stroke(row,1,0.65)
        row.MouseEnter:Connect(function() tween(row,0.25,{BackgroundTransparency=0.32}) end)
        row.MouseLeave:Connect(function() tween(row,0.35,{BackgroundTransparency=0.48}) end)
        return row
    end
    local function rowLabels(row, labelText, desc)
        local lbl2 = Instance.new("TextLabel"); lbl2.Size = UDim2.new(1,-70,0,16); lbl2.Position = UDim2.fromOffset(10,6)
        lbl2.BackgroundTransparency = 1; lbl2.Text = labelText; lbl2.TextColor3 = Color3.new(1,1,1)
        lbl2.Font = FONT; lbl2.TextSize = 12; lbl2.TextXAlignment = Enum.TextXAlignment.Left; lbl2.ZIndex = 6; lbl2.Parent = row
        if desc and desc ~= "" then
            local det = Instance.new("TextLabel"); det.Size = UDim2.new(1,-70,0,14); det.Position = UDim2.fromOffset(10,22)
            det.BackgroundTransparency = 1; det.Text = desc; det.TextColor3 = Color3.fromRGB(190,199,230)
            det.Font = FONT; det.TextSize = 9; det.TextXAlignment = Enum.TextXAlignment.Left; det.ZIndex = 6; det.Parent = row
        end
    end
    local function addSection(page, text)
        local lbl3 = Instance.new("TextLabel"); lbl3.Size = UDim2.new(1,0,0,18)
        lbl3.BackgroundTransparency = 1; lbl3.Text = string.upper(text); lbl3.TextColor3 = Palette.Accent
        lbl3.Font = FONT_BOLD; lbl3.TextSize = 10; lbl3.TextXAlignment = Enum.TextXAlignment.Left
        lbl3.LayoutOrder = nextOrder(page); lbl3.ZIndex = 6; lbl3:SetAttribute("ThemeRole","accentText"); lbl3.Parent = page
    end

    local function addToggle(page, titleText, desc, default, callback, getter)
        local row = baseRow(page,42); rowLabels(row,titleText,desc)
        local state2 = default and true or false
        local track2 = Instance.new("TextButton"); track2.Size = UDim2.fromOffset(38,20)
        track2.Position = UDim2.new(1,-48,0.5,-10); track2.Text = ""; track2.AutoButtonColor = false
        track2.BackgroundColor3 = state2 and Palette.Accent or Palette.Off; track2.ZIndex = 6
        track2:SetAttribute("ThemeRole","toggle"); track2:SetAttribute("ToggleState",state2); track2.Parent = row
        corner(track2,10); stroke(track2,1,0.6)
        local knob2 = Instance.new("Frame"); knob2.Size = UDim2.fromOffset(16,16)
        knob2.BackgroundColor3 = Color3.new(1,1,1); knob2.ZIndex = 7; knob2.Parent = track2; corner(knob2,8)
        local function render2(animate, pressed)
            local w = pressed and 21 or 16
            local x2 = state2 and UDim2.new(1,-(w+2),0.5,-8) or UDim2.new(0,2,0.5,-8)
            tween(track2, animate and 0.25 or 0, {BackgroundColor3=state2 and Palette.Accent or Palette.Off})
            tween(knob2,  animate and 0.35 or 0, {Position=x2, Size=UDim2.fromOffset(w,16)}, Enum.EasingStyle.Back)
        end
        render2(false,false)
        track2.MouseButton1Down:Connect(function() render2(true,true) end)
        track2.MouseButton1Up:Connect(function() render2(true,false) end)
        track2.MouseLeave:Connect(function() render2(true,false) end)
        track2.MouseButton1Click:Connect(function()
            state2 = not state2; track2:SetAttribute("ToggleState",state2); render2(true,false)
            if callback then callback(state2) end
        end)
        if getter then
            registerControl(function()
                state2 = getter() and true or false; track2:SetAttribute("ToggleState",state2); render2(false,false)
            end)
        end
        local ctrl = { set = function(v) state2 = v and true or false; track2:SetAttribute("ToggleState",state2); render2(true,false) end }
        return track2, ctrl
    end

    local function addTextbox(page, titleText, desc, default, callback, isNumeric, getter)
        local row = baseRow(page,42); rowLabels(row,titleText,desc)
        local box2 = Instance.new("TextBox"); box2.Size = UDim2.fromOffset(60,22)
        box2.Position = UDim2.new(1,-70,0.5,-11); box2.BackgroundColor3 = Palette.Button
        box2.BackgroundTransparency = 0.36; box2.Text = tostring(default or "")
        box2.TextColor3 = Color3.new(1,1,1); box2.Font = FONT; box2.TextSize = 12
        box2.ClearTextOnFocus = false; box2.ZIndex = 7; box2:SetAttribute("ThemeRole","field"); box2.Parent = row
        corner(box2,10); stroke(box2,1,0.6)
        box2.FocusLost:Connect(function()
            local val2 = box2.Text
            if isNumeric then val2 = tonumber(val2) or default; box2.Text = tostring(val2) end
            if callback then local ret = callback(val2); if ret ~= nil then box2.Text = tostring(ret) end end
        end)
        if getter then
            registerControl(function() local v = getter(); if v~=nil then box2.Text=tostring(v) end end)
        end
        return box2
    end

    local function addSlider(page, titleText, desc, min2, max2, value2, callback, getter)
        local row = baseRow(page,42); rowLabels(row,titleText,desc)
        local box3 = Instance.new("TextBox"); box3.Size = UDim2.fromOffset(48,18)
        box3.Position = UDim2.new(1,-56,0,4); box3.BackgroundColor3 = Palette.Button
        box3.BackgroundTransparency = 0.36; box3.Text = tostring(value2)
        box3.TextColor3 = Color3.new(1,1,1); box3.Font = FONT; box3.TextSize = 10
        box3.ClearTextOnFocus = false; box3.ZIndex = 7; box3:SetAttribute("ThemeRole","field"); box3.Parent = row
        corner(box3,8); stroke(box3,1,0.6)
        local track3 = Instance.new("Frame"); track3.Size = UDim2.new(1,-150,0,6)
        track3.Position = UDim2.new(0,10,1,-12); track3.BackgroundColor3 = Palette.Off
        track3.BorderSizePixel = 0; track3.ZIndex = 6; track3.Parent = row; corner(track3,3)
        local fill4 = Instance.new("Frame"); fill4.Size = UDim2.fromScale(0,1)
        fill4.BackgroundColor3 = Palette.Accent; fill4.BorderSizePixel = 0; fill4.ZIndex = 7; fill4.Parent = track3; corner(fill4,3)
        local knob3 = Instance.new("Frame"); knob3.Size = UDim2.fromOffset(12,12)
        knob3.Position = UDim2.new(0,-6,0.5,-6); knob3.BackgroundColor3 = Color3.new(1,1,1)
        knob3.ZIndex = 8; knob3.Parent = track3; corner(knob3,6)
        local current2 = math.clamp(tonumber(value2) or min2, min2, max2)
        local function render3()
            local t2 = (current2-min2)/math.max(max2-min2,1)
            fill4.Size = UDim2.new(t2,0,1,0); knob3.Position = UDim2.new(t2,-6,0.5,-6)
            box3.Text = tostring(math.floor(current2+0.5))
        end
        local function setValue2(v)
            current2 = math.clamp(math.floor(tonumber(v) or min2), min2, max2); render3()
            if callback then callback(current2) end
        end
        render3()
        local dragging2 = false
        local function updateFromX(x3)
            local ax2 = track3.AbsolutePosition.X; local aw2 = math.max(track3.AbsoluteSize.X,1)
            current2 = math.floor(min2 + math.clamp((x3-ax2)/aw2,0,1)*(max2-min2)+0.5); render3()
            if callback then callback(current2) end
        end
        track3.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging2 = true; updateFromX(input.Position.X) end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging2 and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromX(input.Position.X) end
        end)
        UIS.InputEnded:Connect(function(input)
            if dragging2 and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                dragging2 = false end
        end)
        box3.FocusLost:Connect(function() setValue2(box3.Text) end)
        if getter then
            registerControl(function() local v = getter(); if v~=nil then current2=math.clamp(math.floor(tonumber(v) or min2),min2,max2); render3() end end)
        end
        return { set = setValue2, get = function() return current2 end }
    end

    local function addButton(page, titleText, desc, callback, label2)
        local row = baseRow(page,42); rowLabels(row,titleText,desc)
        local btn3 = Instance.new("TextButton"); btn3.Size = UDim2.fromOffset(80,22)
        btn3.Position = UDim2.new(1,-90,0.5,-11); btn3.BackgroundColor3 = Palette.Button
        btn3.BackgroundTransparency = 0.04; btn3.Text = label2 or "Open"; btn3.TextColor3 = Color3.new(1,1,1)
        btn3.Font = FONT_BOLD; btn3.TextSize = 11; btn3.AutoButtonColor = false; btn3.ZIndex = 7
        btn3:SetAttribute("ThemeRole","button"); btn3.Parent = row; corner(btn3,10); stroke(btn3,1,0.4)
        btn3.MouseButton1Click:Connect(callback); return btn3
    end

    local function addKeybind(page, titleText, desc, default2, callback, onChange, getter)
        local row = baseRow(page,42); rowLabels(row,titleText,desc)
        local keyBtn2 = Instance.new("TextButton"); keyBtn2.Size = UDim2.fromOffset(72,22)
        keyBtn2.Position = UDim2.new(1,-72,0.5,-11); keyBtn2.BackgroundColor3 = Palette.Button
        keyBtn2.BackgroundTransparency = 0.36; keyBtn2.TextColor3 = Color3.new(1,1,1)
        keyBtn2.Font = FONT; keyBtn2.TextSize = 11; keyBtn2.AutoButtonColor = false; keyBtn2.ZIndex = 7
        keyBtn2:SetAttribute("ThemeRole","field"); keyBtn2.Parent = row; corner(keyBtn2,10); stroke(keyBtn2,1,0.6)
        local boundKey2 = default2
        local function renderKey2() keyBtn2.Text = boundKey2 and boundKey2.Name or "None" end
        renderKey2()
        keyBtn2.MouseButton1Click:Connect(function()
            if keybindListening then return end
            keybindListening = true; currentListenBtn = keyBtn2; keyBtn2.Text = "Press key..."
            local conn2
            conn2 = UIS.InputBegan:Connect(function(input, gpe)
                if not gpe and input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode ~= Enum.KeyCode.Escape then
                        boundKey2 = input.KeyCode; if onChange then onChange(boundKey2) end
                    end
                    renderKey2(); keybindListening = false; currentListenBtn = nil; conn2:Disconnect()
                end
            end)
        end)
        UIS.InputBegan:Connect(function(input, gpe)
            if gpe or not boundKey2 then return end
            if input.KeyCode == boundKey2 then if callback then task.spawn(callback) end end
        end)
        if getter then
            registerControl(function() local v = getter(); if v then boundKey2=v; renderKey2() end end)
        end
        return keyBtn2
    end

    local function addDropdown(page, titleText, desc, options2, default3, callback, getter)
        local row = baseRow(page,42); rowLabels(row,titleText,desc)
        local btn4 = Instance.new("TextButton"); btn4.Size = UDim2.fromOffset(100,22)
        btn4.Position = UDim2.new(1,-110,0.5,-11); btn4.BackgroundColor3 = Palette.Button
        btn4.BackgroundTransparency = 0.36; btn4.Text = tostring(default3 or "Select")
        btn4.TextColor3 = Color3.new(1,1,1); btn4.Font = FONT; btn4.TextSize = 11
        btn4.AutoButtonColor = false; btn4.ZIndex = 7; btn4:SetAttribute("ThemeRole","field"); btn4.Parent = row
        corner(btn4,10); stroke(btn4,1,0.6)
        local selected2 = default3
        btn4.MouseButton1Click:Connect(function()
            if #options2==0 then return end
            local idx2 = table.find(options2, selected2) or 0
            idx2 = idx2 % #options2 + 1; selected2 = options2[idx2]; btn4.Text = selected2
            if callback then callback(selected2) end
        end)
        if getter then
            registerControl(function() local v=getter(); if v~=nil then selected2=v; btn4.Text=tostring(v) end end)
        end
        return { get=function() return selected2 end, button=btn4 }
    end

    local function openColorPicker(titleText2, startColor2, onApply2)
        local existing2 = gui:FindFirstChild("ColorPicker"); if existing2 then existing2:Destroy() end
        local h2, s2, v2 = Color3.toHSV(startColor2 or Color3.new(1,1,1))
        local current3 = startColor2
        local overlay2 = Instance.new("TextButton"); overlay2.Name = "ColorPicker"; overlay2.Size = UDim2.fromScale(1,1)
        overlay2.BackgroundColor3 = Color3.fromRGB(3,5,12); overlay2.BackgroundTransparency = 0.45
        overlay2.Text = ""; overlay2.AutoButtonColor = false; overlay2.ZIndex = 500; overlay2.Parent = gui
        local card2 = Instance.new("TextButton"); card2.Name = "PickerCard"; card2.Size = UDim2.fromOffset(300,368)
        card2.Position = UDim2.fromScale(0.5,0.5); card2.AnchorPoint = Vector2.new(0.5,0.5)
        card2.BackgroundColor3 = Color3.fromRGB(16,20,40); card2.BackgroundTransparency = 0.03
        card2.Text = ""; card2.AutoButtonColor = false; card2.BorderSizePixel = 0; card2.ZIndex = 501; card2.Parent = overlay2
        corner(card2,16); stroke(card2,1.5,0.3)
        local cs2 = Instance.new("UIScale"); cs2.Scale = 0.9; cs2.Parent = card2
        tween(cs2,0.22,{Scale=1},Enum.EasingStyle.Back,Enum.EasingDirection.Out)
        local function lbl4(parent, text3, x3, y3, w3, h3, size2, bold2)
            local l = Instance.new("TextLabel"); l.Size = UDim2.fromOffset(w3,h3); l.Position = UDim2.fromOffset(x3,y3)
            l.BackgroundTransparency = 1; l.Text = text3; l.TextColor3 = Color3.fromRGB(226,232,255)
            l.Font = bold2 and FONT_BOLD or FONT; l.TextSize = size2 or 11; l.TextXAlignment = Enum.TextXAlignment.Left
            l.ZIndex = 502; l.Parent = parent; return l
        end
        lbl4(card2,titleText2,16,12,220,20,13,true)
        local closeBtn2 = Instance.new("TextButton"); closeBtn2.Size = UDim2.fromOffset(24,24)
        closeBtn2.Position = UDim2.new(1,-32,0,10); closeBtn2.BackgroundColor3 = Color3.fromRGB(45,50,72)
        closeBtn2.Text = "x"; closeBtn2.TextColor3 = Color3.fromRGB(235,238,255); closeBtn2.Font = FONT_BOLD
        closeBtn2.TextSize = 12; closeBtn2.AutoButtonColor = false; closeBtn2.ZIndex = 503; closeBtn2.Parent = card2; corner(closeBtn2,8)
        closeBtn2.MouseButton1Click:Connect(function() overlay2:Destroy() end)
        local preview2 = Instance.new("Frame"); preview2.Size = UDim2.fromOffset(52,32); preview2.Position = UDim2.fromOffset(16,40)
        preview2.BackgroundColor3 = current3; preview2.BorderSizePixel = 0; preview2.ZIndex = 502; preview2.Parent = card2; corner(preview2,10); stroke(preview2,1,0.3)
        local hexBox2 = Instance.new("TextBox"); hexBox2.Size = UDim2.fromOffset(104,32); hexBox2.Position = UDim2.fromOffset(76,40)
        hexBox2.BackgroundColor3 = Color3.fromRGB(40,47,76); hexBox2.Text = colorToHex(current3)
        hexBox2.TextColor3 = Color3.new(1,1,1); hexBox2.PlaceholderText = "#RRGGBB"; hexBox2.Font = FONT
        hexBox2.TextSize = 12; hexBox2.ClearTextOnFocus = false; hexBox2.ZIndex = 503; hexBox2.Parent = card2; corner(hexBox2,10); stroke(hexBox2,1,0.4)
        lbl4(card2,"HEX CODE",188,47,96,18,9)
        local sv2 = Instance.new("TextButton"); sv2.Size = UDim2.fromOffset(268,148); sv2.Position = UDim2.fromOffset(16,82)
        sv2.BackgroundColor3 = Color3.fromHSV(h2,1,1); sv2.BorderSizePixel = 0; sv2.Text = ""; sv2.AutoButtonColor = false
        sv2.ClipsDescendants = true; sv2.ZIndex = 502; sv2.Parent = card2; corner(sv2,8)
        local svWhite2 = Instance.new("Frame"); svWhite2.Size = UDim2.fromScale(1,1); svWhite2.BackgroundColor3 = Color3.new(1,1,1); svWhite2.BorderSizePixel = 0; svWhite2.ZIndex = 503; svWhite2.Parent = sv2
        local svWG2 = Instance.new("UIGradient"); svWG2.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}); svWG2.Parent = svWhite2
        local svBlack2 = Instance.new("Frame"); svBlack2.Size = UDim2.fromScale(1,1); svBlack2.BackgroundColor3 = Color3.new(0,0,0); svBlack2.BorderSizePixel = 0; svBlack2.ZIndex = 504; svBlack2.Parent = sv2
        local svBG2 = Instance.new("UIGradient"); svBG2.Rotation = 90; svBG2.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}); svBG2.Parent = svBlack2
        local svCursor2 = Instance.new("Frame"); svCursor2.Size = UDim2.fromOffset(14,14); svCursor2.AnchorPoint = Vector2.new(0.5,0.5)
        svCursor2.BackgroundTransparency = 1; svCursor2.ZIndex = 505; svCursor2.Parent = sv2; Instance.new("UICorner",svCursor2).CornerRadius = UDim.new(1,0)
        local svRing2 = Instance.new("UIStroke"); svRing2.Color = Color3.new(1,1,1); svRing2.Thickness = 2; svRing2.Transparency = 0.05; svRing2.Parent = svCursor2
        local hueBar2 = Instance.new("TextButton"); hueBar2.Size = UDim2.fromOffset(268,18); hueBar2.Position = UDim2.fromOffset(16,238)
        hueBar2.BackgroundColor3 = Color3.new(1,1,1); hueBar2.BorderSizePixel = 0; hueBar2.Text = ""; hueBar2.AutoButtonColor = false
        hueBar2.ClipsDescendants = true; hueBar2.ZIndex = 502; hueBar2.Parent = card2; corner(hueBar2,9)
        local hueGrad2 = Instance.new("UIGradient")
        hueGrad2.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.000,Color3.fromRGB(255,0,0)),   ColorSequenceKeypoint.new(0.167,Color3.fromRGB(255,255,0)),
            ColorSequenceKeypoint.new(0.333,Color3.fromRGB(0,255,0)),   ColorSequenceKeypoint.new(0.500,Color3.fromRGB(0,255,255)),
            ColorSequenceKeypoint.new(0.667,Color3.fromRGB(0,0,255)),   ColorSequenceKeypoint.new(0.833,Color3.fromRGB(255,0,255)),
            ColorSequenceKeypoint.new(1.000,Color3.fromRGB(255,0,0)),
        }); hueGrad2.Parent = hueBar2
        local hueCursor2 = Instance.new("Frame"); hueCursor2.Size = UDim2.fromOffset(6,22); hueCursor2.AnchorPoint = Vector2.new(0.5,0.5)
        hueCursor2.BackgroundColor3 = Color3.new(1,1,1); hueCursor2.BorderSizePixel = 0; hueCursor2.ZIndex = 505; hueCursor2.Parent = hueBar2
        corner(hueCursor2,3); stroke(hueCursor2,1,0.2)
        local function refreshPicker2()
            current3 = Color3.fromHSV(h2,s2,v2); sv2.BackgroundColor3 = Color3.fromHSV(h2,1,1)
            preview2.BackgroundColor3 = current3; hexBox2.Text = colorToHex(current3)
            local lum2 = current3.R*0.299+current3.G*0.587+current3.B*0.114
            hexBox2.TextColor3 = lum2>0.62 and Color3.fromRGB(15,18,30) or Color3.new(1,1,1)
            svCursor2.Position = UDim2.new(s2,0,1-v2,0); hueCursor2.Position = UDim2.new(h2,0,0.5,0)
        end
        refreshPicker2()
        local conns2 = {}; local function track2(c) conns2[#conns2+1]=c end
        overlay2.Destroying:Connect(function() for _, c in ipairs(conns2) do pcall(function() c:Disconnect() end) end end)
        local svDrag, hueDrag = false, false
        sv2.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then svDrag=true; local ax3=sv2.AbsolutePosition.X; local ay3=sv2.AbsolutePosition.Y; s2=math.clamp((input.Position.X-ax3)/math.max(sv2.AbsoluteSize.X,1),0,1); v2=1-math.clamp((input.Position.Y-ay3)/math.max(sv2.AbsoluteSize.Y,1),0,1); refreshPicker2() end end)
        hueBar2.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then hueDrag=true; h2=math.clamp((input.Position.X-hueBar2.AbsolutePosition.X)/math.max(hueBar2.AbsoluteSize.X,1),0,1); refreshPicker2() end end)
        track2(UIS.InputChanged:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
                if svDrag then local ax4=sv2.AbsolutePosition.X; local ay4=sv2.AbsolutePosition.Y; s2=math.clamp((input.Position.X-ax4)/math.max(sv2.AbsoluteSize.X,1),0,1); v2=1-math.clamp((input.Position.Y-ay4)/math.max(sv2.AbsoluteSize.Y,1),0,1); refreshPicker2() end
                if hueDrag then h2=math.clamp((input.Position.X-hueBar2.AbsolutePosition.X)/math.max(hueBar2.AbsoluteSize.X,1),0,1); refreshPicker2() end
            end
        end))
        track2(UIS.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then svDrag=false; hueDrag=false end end))
        hexBox2.FocusLost:Connect(function() local p2=hexToColor(hexBox2.Text); if p2 then h2,s2,v2=Color3.toHSV(p2) end; refreshPicker2() end)
        lbl4(card2,"PRESETS",16,266,80,14,9,true)
        local presets2 = {{132,145,255},{174,193,255},{75,91,190},{255,95,86},{255,189,46},{39,201,63},{0,200,220},{255,105,180}}
        for i3, rgb2 in ipairs(presets2) do
            local p3 = Instance.new("TextButton"); p3.Size = UDim2.fromOffset(28,22); p3.Position = UDim2.fromOffset(16+(i3-1)*33,284)
            p3.BackgroundColor3 = Color3.fromRGB(rgb2[1],rgb2[2],rgb2[3]); p3.Text = ""; p3.AutoButtonColor = false; p3.ZIndex = 503; p3.Parent = card2; corner(p3,6); stroke(p3,1,0.35)
            p3.MouseButton1Click:Connect(function() h2,s2,v2=Color3.toHSV(p3.BackgroundColor3); refreshPicker2() end)
        end
        local cancelBtn2 = Instance.new("TextButton"); cancelBtn2.Size = UDim2.fromOffset(120,30); cancelBtn2.Position = UDim2.fromOffset(16,322)
        cancelBtn2.BackgroundColor3 = Color3.fromRGB(44,49,72); cancelBtn2.Text = "CANCEL"; cancelBtn2.TextColor3 = Color3.fromRGB(225,230,250)
        cancelBtn2.Font = FONT_BOLD; cancelBtn2.TextSize = 11; cancelBtn2.AutoButtonColor = false; cancelBtn2.ZIndex = 503; cancelBtn2.Parent = card2; corner(cancelBtn2,10)
        cancelBtn2.MouseButton1Click:Connect(function() overlay2:Destroy() end)
        local applyBtn2 = Instance.new("TextButton"); applyBtn2.Size = UDim2.fromOffset(120,30); applyBtn2.Position = UDim2.fromOffset(164,322)
        applyBtn2.BackgroundColor3 = current3; applyBtn2.Text = "APPLY"; applyBtn2.TextColor3 = Color3.new(1,1,1)
        applyBtn2.Font = FONT_BOLD; applyBtn2.TextSize = 11; applyBtn2.AutoButtonColor = false; applyBtn2.ZIndex = 503; applyBtn2.Parent = card2; corner(applyBtn2,10)
        applyBtn2.MouseButton1Click:Connect(function() if onApply2 then onApply2(current3) end; overlay2:Destroy() end)
        overlay2.MouseButton1Click:Connect(function() overlay2:Destroy() end)
        track2(connectSignal(RunService.Heartbeat, function() applyBtn2.BackgroundColor3 = current3 end))
    end

    local function addColorRow(page, titleText3, desc, getColor2, onApply3)
        local row = baseRow(page,42); rowLabels(row,titleText3,desc)
        local swatch = Instance.new("TextButton"); swatch.Name = "ColorSwatch"; swatch.Size = UDim2.fromOffset(58,24)
        swatch.Position = UDim2.new(1,-68,0.5,-12); swatch.Text = ""; swatch.Font = FONT_BOLD; swatch.TextSize = 8
        swatch.AutoButtonColor = false; swatch.ZIndex = 7; swatch.Parent = row; corner(swatch,10); stroke(swatch,1,0.25)
        local function renderSwatch2()
            local c2 = getColor2(); swatch.BackgroundColor3 = c2; swatch.Text = colorToHex(c2)
            local lum3 = c2.R*0.299+c2.G*0.587+c2.B*0.114; swatch.TextColor3 = lum3>0.62 and Color3.fromRGB(20,22,34) or Color3.new(1,1,1)
        end
        renderSwatch2()
        swatch.MouseButton1Click:Connect(function()
            openColorPicker(titleText3, getColor2(), function(c3) onApply3(c3); renderSwatch2() end)
        end)
        registerControl(renderSwatch2); return swatch
    end

    local activeMenu2
    local function closeSelectMenu2() if activeMenu2 then pcall(function() activeMenu2:Destroy() end); activeMenu2=nil end end
    local function openSelectMenu2(anchor, options3, onPick2)
        closeSelectMenu2()
        local menu2 = Instance.new("ScrollingFrame"); menu2.Name = "ConfigSelectMenu"
        menu2.Size = UDim2.fromOffset(180, math.min(math.max(#options3,1)*24+8,190))
        menu2.BackgroundColor3 = Color3.fromRGB(13,18,40); menu2.BackgroundTransparency = 0.06
        menu2.BorderSizePixel = 0; menu2.ScrollBarThickness = 3; menu2.ScrollBarImageColor3 = Palette.Accent
        menu2.CanvasSize = UDim2.new(); menu2.AutomaticCanvasSize = Enum.AutomaticSize.Y; menu2.ZIndex = 80; menu2.Parent = gui
        corner(menu2,12); stroke(menu2,1,0.35)
        local layout3 = Instance.new("UIListLayout"); layout3.Padding = UDim.new(0,2); layout3.SortOrder = Enum.SortOrder.LayoutOrder; layout3.Parent = menu2
        local pad3 = Instance.new("UIPadding"); pad3.PaddingTop=UDim.new(0,4); pad3.PaddingBottom=UDim.new(0,4); pad3.PaddingLeft=UDim.new(0,4); pad3.PaddingRight=UDim.new(0,4); pad3.Parent=menu2
        if #options3==0 then
            local empty2=Instance.new("TextLabel"); empty2.Size=UDim2.new(1,0,0,22); empty2.BackgroundTransparency=1
            empty2.Text="No configs yet"; empty2.TextColor3=Color3.fromRGB(190,199,230); empty2.Font=FONT; empty2.TextSize=11; empty2.ZIndex=81; empty2.Parent=menu2
        end
        for i4, opt in ipairs(options3) do
            local ob=Instance.new("TextButton"); ob.Size=UDim2.new(1,0,0,22); ob.LayoutOrder=i4
            ob.BackgroundColor3=Palette.Button; ob.BackgroundTransparency=0.5; ob.Text="  "..tostring(opt)
            ob.TextColor3=Color3.new(1,1,1); ob.TextXAlignment=Enum.TextXAlignment.Left; ob.TextTruncate=Enum.TextTruncate.AtEnd
            ob.Font=FONT; ob.TextSize=11; ob.AutoButtonColor=false; ob.ZIndex=81; ob.Parent=menu2; corner(ob,8)
            ob.MouseButton1Click:Connect(function() closeSelectMenu2(); onPick2(opt) end)
        end
        local ap2,as2=anchor.AbsolutePosition,anchor.AbsoluteSize; local vp3=gui.AbsoluteSize
        local mx=math.clamp(ap2.X+as2.X-180,6,math.max(6,vp3.X-186)); local my=ap2.Y+as2.Y+4
        if my+menu2.Size.Y.Offset>vp3.Y-6 then my=ap2.Y-menu2.Size.Y.Offset-4 end
        menu2.Position=UDim2.fromOffset(mx,math.max(6,my))
        local mc; mc=UIS.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then local p4=input.Position; local map3,mas3=menu2.AbsolutePosition,menu2.AbsoluteSize; if p4.X<map3.X or p4.X>map3.X+mas3.X or p4.Y<map3.Y or p4.Y>map3.Y+mas3.Y then closeSelectMenu2() end end end)
        menu2.Destroying:Connect(function() if mc then mc:Disconnect() end end); activeMenu2=menu2
    end

    local function makeConfigSelector(page, titleText4, desc)
        local row=baseRow(page,42); rowLabels(row,titleText4,desc)
        local btn5=Instance.new("TextButton"); btn5.Size=UDim2.fromOffset(100,22); btn5.Position=UDim2.new(1,-110,0.5,-11)
        btn5.BackgroundColor3=Palette.Button; btn5.BackgroundTransparency=0.36; btn5.Text="None"
        btn5.TextColor3=Color3.new(1,1,1); btn5.Font=FONT; btn5.TextSize=11; btn5.AutoButtonColor=false; btn5.ZIndex=7
        btn5:SetAttribute("ThemeRole","field"); btn5.Parent=row; corner(btn5,10); stroke(btn5,1,0.6)
        local selected3
        local function refresh2(preferred)
            local list2=listConfigNames()
            if preferred and table.find(list2,preferred) then selected3=preferred end
            if not selected3 or not table.find(list2,selected3) then selected3=list2[1] end
            btn5.Text=selected3 or "None"; return list2
        end
        btn5.MouseButton1Click:Connect(function() openSelectMenu2(btn5,listConfigNames(),function(choice) selected3=choice; btn5.Text=choice; if AutoLoadState.Enabled then setAutoLoad(true,choice) end end) end)
        refresh2(AutoLoadState.Config~="" and AutoLoadState.Config or nil)
        local entry2={refresh=refresh2, get=function() return selected3 end, set=function(v) selected3=v; refresh2(v) end}
        configListRefreshers[#configListRefreshers+1]=entry2; return entry2
    end

