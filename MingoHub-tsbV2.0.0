    local lockButton = Instance.new("TextButton")
    lockButton.Name = "DockLockButton"
    lockButton.Size = UDim2.fromOffset(65, 32)
    lockButton.Position = UDim2.fromOffset(86, 7)
    lockButton.BackgroundColor3 = Color3.fromRGB(35, 39, 52)
    lockButton.BackgroundTransparency = 0.02
    lockButton.BorderSizePixel = 0
    lockButton.Text = "LOCKED"
    lockButton.TextColor3 = Color3.fromRGB(232, 235, 255)
    lockButton.Font = FONT_BOLD
