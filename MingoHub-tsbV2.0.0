-- ── Shadow-property helper ────────────────────────────────
local mingoShadowStore = setmetatable({}, { __mode = "k" })
local function mingoGetOriginal(inst, prop)
    local t = mingoShadowStore[inst]
    if not t then t = {}; mingoShadowStore[inst] = t end
    if t[prop] == nil then t[prop] = { value = inst[prop] } end
    return t[prop].value
end
local function mingoSetShadow(inst, prop, val)
    mingoGetOriginal(inst, prop)
    inst[prop] = val
end
local function mingoRestoreAll()
    for inst, props in pairs(mingoShadowStore) do
        for prop, entry in pairs(props) do
            pcall(function() inst[prop] = entry.value end)
        end
    end
    table.clear(mingoShadowStore)
end

-- ── Connection tracker ────────────────────────────────────
local mingoUnloaded = false
local mingoActiveConns = {}
local mingoBindNames  = {}

local function mingoConnect(signal, fn)
    local c = signal:Connect(function(...)
        if mingoUnloaded then return end
        return fn(...)
    end)
    mingoActiveConns[c] = true
    return c
end
local function mingoDisconnect(c)
    if c then c:Disconnect(); mingoActiveConns[c] = nil end
end
local function mingoDisconnectAll()
    for c in pairs(mingoActiveConns) do pcall(function() c:Disconnect() end) end
    table.clear(mingoActiveConns)
end
local function mingoBind(name, prio, fn)
    mingoBindNames[name] = true
    RunService:BindToRenderStep(name, prio, fn)
end
local function mingoUnbind(name)
    RunService:UnbindFromRenderStep(name)
    mingoBindNames[name] = nil
end
local function mingoUnbindAll()
    for name in pairs(mingoBindNames) do
        RunService:UnbindFromRenderStep(name)
    end
    table.clear(mingoBindNames)
end

-- ── Random-wait jitter helper ─────────────────────────────
local function mingoRandomWait(base)
    task.wait((base or 0) + math.random(2, 6) / 1000)
end

-- ── VirtualInputManager helpers ──────────────────────────
local mingoVIM
pcall(function() mingoVIM = game:GetService("VirtualInputManager") end)

local function mingoPressKey(kc)
    if mingoVIM then pcall(function() mingoVIM:SendKeyEvent(true,  kc, false, game) end) end
end
local function mingoReleaseKey(kc)
    if mingoVIM then pcall(function() mingoVIM:SendKeyEvent(false, kc, false, game) end) end
end
local function mingoTapKey(kc)
    mingoPressKey(kc); mingoRandomWait(); mingoReleaseKey(kc)
end

