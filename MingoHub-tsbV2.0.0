    addSection(miscTab, "Stretch")
    addToggle(miscTab, "Enabled##STR", "Scale character body parts", Settings.Misc.StretchEnabled, function(on)
        Settings.Misc.StretchEnabled = on
        local char = currentCharacter
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                local d = hum:FindFirstChild("BodyDepthScale") and hum.BodyDepthScale
                local w = hum:FindFirstChild("BodyWidthScale")  and hum.BodyWidthScale
                local h = hum:FindFirstChild("BodyHeightScale") and hum.BodyHeightScale
                local v = on and Settings.Misc.StretchValue or 1
                if d then d.Value = v end
                if w then w.Value = v end
                if h then h.Value = v end
            end
        end
    end, function() return Settings.Misc.StretchEnabled end)
    addSlider(miscTab, "Stretch Value", "0-200", 0, 200, math.floor((Settings.Misc.StretchValue or 1)*100), function(v)
        Settings.Misc.StretchValue = v / 100
        if not Settings.Misc.StretchEnabled then return end
        local char = currentCharacter
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                for _, key in ipairs({"BodyDepthScale","BodyWidthScale","BodyHeightScale"}) do
                    local s = hum:FindFirstChild(key)
                    if s then s.Value = Settings.Misc.StretchValue end
                end
            end
        end
    end, function() return math.floor((Settings.Misc.StretchValue or 1)*100) end)

