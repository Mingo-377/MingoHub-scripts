addSection(exploit, "Auto Magnet")
addToggle(exploit, "Enabled", "TP+magnet toward target", Settings.Player.Magnet.Enabled,
    function(on) Settings.Player.Magnet.Enabled = on end,
    function() return Settings.Player.Magnet.Enabled end)
addKeybind(exploit, "Magnet Key", "Trigger magnet manually", Settings.Player.Magnet.Keybind, function()
    if not Settings.Player.Magnet.Enabled then return end
    if not (Character and RootPart) then return end
    local best, bestD = nil, Settings.Player.Magnet.MaxDistance
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character ~= Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - RootPart.Position).Magnitude
                if d < bestD and d > 0.1 then best, bestD = hrp, d end
            end
        end
    end
    if not best then return end
    local targetPos = best.Position + Vector3.new(0, Settings.Player.Magnet.Height or 2, 0)
    RootPart.CFrame = CFrame.new(targetPos.X, targetPos.Y, targetPos.Z)
    local started = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not RootPart or tick() - started > (Settings.Player.Magnet.Duration or 0.5) then
            if conn then conn:Disconnect() end
            return
        end
        local dir = Vector3.new(best.Position.X - RootPart.Position.X, 0, best.Position.Z - RootPart.Position.Z)
        if dir.Magnitude < 1 then return end
        local strength = Settings.Player.Magnet.Strength or 50
        local smooth = Settings.Player.Magnet.Smoothness or 0.65
        local desired = dir.Unit * strength
        local cur = RootPart.AssemblyLinearVelocity
        local blended = cur:Lerp(desired, smooth)
        RootPart.AssemblyLinearVelocity = Vector3.new(blended.X * 0.85, cur.Y, blended.Z * 0.85)
    end)
end, function(k) Settings.Player.Magnet.Keybind = k end,
    function() return Settings.Player.Magnet.Keybind end)

