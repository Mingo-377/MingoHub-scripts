    local versionLabel = Instance.new("TextLabel")
    versionLabel.Name = "Version"
    versionLabel.Size = UDim2.fromOffset(120, 14)
    versionLabel.Position = UDim2.new(0, 14, 1, -22)
    versionLabel.BackgroundTransparency = 1
    versionLabel.Text = VERSION
    versionLabel.TextColor3 = Color3.fromRGB(165, 165, 178)
    versionLabel.TextTransparency = 0.2
    versionLabel.Font = FONT
    versionLabel.TextSize = 10
    versionLabel.TextXAlignment = Enum.TextXAlignment.Left
    versionLabel.ZIndex = 8
    versionLabel.Parent = window

    local pos = { x = -WIN_W/2, y = -WIN_H/2 }
    local target = { x = pos.x, y = pos.y }
    local dragging = false
    local dragStart, startTarget

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startTarget = { x = target.x, y = target.y }
            tween(winScale, 0.25, { Scale = 1.015 })
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local vp = gui.AbsoluteSize
            local overflow = (WIN_W * (Appearance.Scale or 1) - WIN_W) / 2
            target.x = math.clamp(startTarget.x + delta.X, -vp.X/2 + overflow, vp.X/2 - WIN_W - overflow)
            target.y = math.clamp(startTarget.y + delta.Y, -vp.Y/2 + overflow, vp.Y/2 - BAR_H - overflow)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            tween(winScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
        end
    end)
    RunService.RenderStepped:Connect(function(dt)
        local a = 1 - math.exp(-dt * 22)
        local dx, dy = target.x - pos.x, target.y - pos.y
        if math.abs(dx) > 0.05 or math.abs(dy) > 0.05 then
            pos.x += dx * a
            pos.y += dy * a
            root.Position = UDim2.new(0.5, pos.x, 0.5, pos.y)
        end
    end)

    local SIDE_W, TAB_H, TAB_GAP = 100, 28, 6

    local sidebar = Instance.new("Frame")
    sidebar.Name = "Sidebar"
    sidebar.Size = UDim2.fromOffset(SIDE_W, WIN_H - BAR_H - 8)
    sidebar.Position = UDim2.fromOffset(8, BAR_H + 2)
    sidebar.BackgroundTransparency = 1
    sidebar.ZIndex = 5
    sidebar.Parent = window

    local pill = Instance.new("Frame")
    pill.Name = "SelectedTabPill"
    pill.Size = UDim2.new(1, 0, 0, TAB_H)
    pill.BackgroundColor3 = Palette.Accent
    pill.BackgroundTransparency = 0.78
    pill.BorderSizePixel = 0
    pill.Visible = false
    pill.ZIndex = 5
    pill:SetAttribute("ThemeRole", "accentBg")
    pill.Parent = sidebar
    corner(pill, 14)
    stroke(pill, 1, 0.55)

    local tabList = Instance.new("Frame")
    tabList.Name = "Tabs"
    tabList.Size = UDim2.fromScale(1, 1)
    tabList.BackgroundTransparency = 1
    tabList.ZIndex = 6
    tabList.Parent = sidebar
    local tabLayout = Instance.new("UIListLayout")
    tabLayout.Padding = UDim.new(0, TAB_GAP)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Parent = tabList

    local pagesHolder = Instance.new("Frame")
    pagesHolder.Name = "Pages"
    pagesHolder.Size = UDim2.fromOffset(WIN_W - SIDE_W - 24, WIN_H - BAR_H - 8)
    pagesHolder.Position = UDim2.fromOffset(SIDE_W + 16, BAR_H + 2)
    pagesHolder.BackgroundTransparency = 1
    pagesHolder.ZIndex = 5
    pagesHolder.Parent = window

    local pages, tabButtons, tabNames = {}, {}, {}
    local currentTab

    local function createPage(name)
        local page = Instance.new("CanvasGroup")
        page.Name = name .. "Page"
        page.Size = UDim2.fromScale(1, 1)
        page.BackgroundTransparency = 1
        page.Visible = false
        page.GroupTransparency = 1
        page.ZIndex = 5
        page.Parent = pagesHolder

        local scroll = Instance.new("ScrollingFrame")
        scroll.Name = "Content"
        scroll.Size = UDim2.fromScale(1, 1)
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 2
        scroll.ScrollBarImageColor3 = Palette.Accent
        scroll.CanvasSize = UDim2.new()
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.ZIndex = 5
        scroll:SetAttribute("ThemeRole", "scroll")
        scroll.Parent = page

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 6)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = scroll
        local padding = Instance.new("UIPadding")
        padding.PaddingTop = UDim.new(0, 2)
        padding.PaddingBottom = UDim.new(0, 38)
        padding.PaddingLeft = UDim.new(0, 2)
        padding.PaddingRight = UDim.new(0, 4)
        padding.Parent = scroll
        pages[name] = { page = page, scroll = scroll }
    end

    local tabTransitionSerial = 0
    local function selectTab(name, instant)
        local targetData = pages[name]
        if not targetData then return end
        if not instant and currentTab == name and targetData.page.Visible and targetData.page.GroupTransparency <= 0.02 then
            return
        end
        currentTab = name
        tabTransitionSerial += 1
        local thisTransition = tabTransitionSerial
        local index = table.find(tabNames, name) or 1
        pill.Visible = true
        if instant then
            pill.Position = UDim2.fromOffset(0, (index - 1) * (TAB_H + TAB_GAP))
        else
            tween(pill, 0.30, { Position = UDim2.fromOffset(0, (index - 1) * (TAB_H + TAB_GAP)) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        end
        for tabName, button in pairs(tabButtons) do
            tween(button, 0.18, {
                TextColor3 = tabName == name and Color3.new(1, 1, 1) or Color3.fromRGB(180, 190, 220),
            }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        end
        if instant then
            for tabName, data in pairs(pages) do
                data.page.Visible = tabName == name
                data.page.GroupTransparency = tabName == name and 0 or 1
                data.page.Position = UDim2.fromOffset(0, 0)
            end
            return
        end
        task.spawn(function()
            local fadeOutTweens = {}
            for tabName, data in pairs(pages) do
                if data.page.Visible and tabName ~= name then
                    table.insert(fadeOutTweens, tween(data.page, 0.14, {
                        GroupTransparency = 1,
                        Position = UDim2.fromOffset(-5, 0),
                    }, Enum.EasingStyle.Sine, Enum.EasingDirection.In))
                end
            end
            for _, fadeOut in ipairs(fadeOutTweens) do fadeOut.Completed:Wait() end
            if thisTransition ~= tabTransitionSerial then return end
            for tabName, data in pairs(pages) do
                if tabName ~= name then
                    data.page.Visible = false
                    data.page.GroupTransparency = 1
                    data.page.Position = UDim2.fromOffset(0, 0)
                end
            end
            local targetPage = targetData.page
            targetPage.Visible = true
            targetPage.GroupTransparency = 1
            targetPage.Position = UDim2.fromOffset(5, 0)
            local fadeIn = tween(targetPage, 0.24, {
                GroupTransparency = 0,
                Position = UDim2.fromOffset(0, 0),
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            fadeIn.Completed:Wait()
            if thisTransition == tabTransitionSerial and targetPage.Parent then
                targetPage.GroupTransparency = 0
                targetPage.Position = UDim2.fromOffset(0, 0)
            end
        end)
    end

    local function createTab(name)
        table.insert(tabNames, name)
        local btn = Instance.new("TextButton")
        btn.Name = name .. "TabButton"
        btn.Size = UDim2.new(1, 0, 0, TAB_H)
        btn.BackgroundColor3 = Palette.Accent
        btn.BackgroundTransparency = 1
        btn.Text = "   " .. name
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.TextColor3 = Color3.fromRGB(175, 175, 188)
        btn.Font = FONT
        btn.TextSize = 12
        btn.AutoButtonColor = false
        btn.LayoutOrder = #tabNames
        btn.ZIndex = 7
        btn.Parent = tabList
        corner(btn, 14)
        tabButtons[name] = btn
        btn.Activated:Connect(function() selectTab(name) end)
        btn.MouseEnter:Connect(function()
            if name ~= currentTab then
                btn.BackgroundColor3 = Palette.Accent
                tween(btn, 0.14, { BackgroundTransparency = 0.88 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            end
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, 0.14, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        end)
        createPage(name)
        return pages[name].scroll
    end

    local uiControls = {}
    local function registerControl(fn) uiControls[#uiControls + 1] = fn end
    local function syncControls()
        for _, fn in ipairs(uiControls) do pcall(fn) end
    end

    local function baseRow(parent, height)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, height)
        row.BackgroundColor3 = SURFACE_COLOR
        row.BackgroundTransparency = 0.48
        row.BorderSizePixel = 0
        row.LayoutOrder = nextOrder(parent)
        row.ZIndex = 5
        row.Parent = parent
        corner(row, 14)
        stroke(row, 1, 0.65)
        row.MouseEnter:Connect(function() tween(row, 0.25, { BackgroundTransparency = 0.32 }) end)
        row.MouseLeave:Connect(function() tween(row, 0.35, { BackgroundTransparency = 0.48 }) end)
        return row
    end

    local function rowLabels(row, labelText, desc)
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -70, 0, 16)
        label.Position = UDim2.fromOffset(10, 6)
        label.BackgroundTransparency = 1
        label.Text = labelText
        label.TextColor3 = Color3.new(1, 1, 1)
        label.Font = FONT
        label.TextSize = 12
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.ZIndex = 6
        label.Parent = row
        if desc and desc ~= "" then
            local detail = Instance.new("TextLabel")
            detail.Size = UDim2.new(1, -70, 0, 14)
            detail.Position = UDim2.fromOffset(10, 22)
            detail.BackgroundTransparency = 1
            detail.Text = desc
            detail.TextColor3 = Color3.fromRGB(190, 199, 230)
            detail.Font = FONT
            detail.TextSize = 9
            detail.TextXAlignment = Enum.TextXAlignment.Left
            detail.ZIndex = 6
            detail.Parent = row
        end
    end

    local function addSection(page, text)
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 0, 18)
        label.BackgroundTransparency = 1
        label.Text = string.upper(text)
        label.TextColor3 = Palette.Accent
        label.Font = FONT_BOLD
        label.TextSize = 10
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.LayoutOrder = nextOrder(page)
        label.ZIndex = 6
        label:SetAttribute("ThemeRole", "accentText")
        label.Parent = page
    end

    local function addToggle(page, titleText, desc, default, callback, getter)
        local row = baseRow(page, 42)
        rowLabels(row, titleText, desc)
        local state = default and true or false
        local track = Instance.new("TextButton")
        track.Size = UDim2.fromOffset(38, 20)
        track.Position = UDim2.new(1, -48, 0.5, -10)
        track.Text = ""
        track.AutoButtonColor = false
        track.BackgroundColor3 = state and Palette.Accent or Palette.Off
        track.ZIndex = 6
        track:SetAttribute("ThemeRole", "toggle")
        track:SetAttribute("ToggleState", state)
        track.Parent = row
        corner(track, 10)
        stroke(track, 1, 0.6)
        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(16, 16)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.ZIndex = 7
        knob.Parent = track
        corner(knob, 8)
        local function render(animate, pressed)
            local w = pressed and 21 or 16
            local x = state and UDim2.new(1, -(w + 2), 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            tween(track, animate and 0.25 or 0, { BackgroundColor3 = state and Palette.Accent or Palette.Off })
            tween(knob, animate and 0.35 or 0, { Position = x, Size = UDim2.fromOffset(w, 16) }, Enum.EasingStyle.Back)
        end
        render(false, false)
        track.MouseButton1Down:Connect(function() render(true, true) end)
        track.MouseButton1Up:Connect(function() render(true, false) end)
        track.MouseLeave:Connect(function() render(true, false) end)
        track.MouseButton1Click:Connect(function()
            state = not state
            track:SetAttribute("ToggleState", state)
            render(true, false)
            if callback then callback(state) end
        end)
        if getter then
            registerControl(function()
                state = getter() and true or false
                track:SetAttribute("ToggleState", state)
                render(false, false)
            end)
        end
        return track
    end

    local function addTextbox(page, titleText, desc, default, callback, isNumeric, getter)
        local row = baseRow(page, 42)
        rowLabels(row, titleText, desc)
        local box = Instance.new("TextBox")
        box.Size = UDim2.fromOffset(60, 22)
        box.Position = UDim2.new(1, -70, 0.5, -11)
        box.BackgroundColor3 = Palette.Button
        box.BackgroundTransparency = 0.36
        box.Text = tostring(default or "")
        box.TextColor3 = Color3.new(1, 1, 1)
        box.Font = FONT
        box.TextSize = 12
        box.ClearTextOnFocus = false
        box.ZIndex = 7
        box:SetAttribute("ThemeRole", "field")
        box.Parent = row
        corner(box, 10)
        stroke(box, 1, 0.6)
        box.FocusLost:Connect(function()
            local val = box.Text
            if isNumeric then
                val = tonumber(val) or default
                box.Text = tostring(val)
            end
            if callback then
                local ret = callback(val)
                if ret ~= nil then box.Text = tostring(ret) end
            end
        end)
        if getter then
            registerControl(function()
                local v = getter()
                if v ~= nil then box.Text = tostring(v) end
            end)
        end
        return box
    end

    local function addSlider(page, titleText, desc, min, max, value, callback, getter)
        local row = baseRow(page, 42)
        rowLabels(row, titleText, desc)
        local box = Instance.new("TextBox")
        box.Size = UDim2.fromOffset(48, 18)
        box.Position = UDim2.new(1, -56, 0, 4)
        box.BackgroundColor3 = Palette.Button
        box.BackgroundTransparency = 0.36
        box.Text = tostring(value)
        box.TextColor3 = Color3.new(1, 1, 1)
        box.Font = FONT
        box.TextSize = 10
        box.ClearTextOnFocus = false
        box.ZIndex = 7
        box:SetAttribute("ThemeRole", "field")
        box.Parent = row
        corner(box, 8)
        stroke(box, 1, 0.6)
        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -150, 0, 6)
        track.Position = UDim2.new(0, 10, 1, -12)
        track.BackgroundColor3 = Palette.Off
        track.BorderSizePixel = 0
        track.ZIndex = 6
        track.Parent = row
        corner(track, 3)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.fromScale(0, 1)
        fill.BackgroundColor3 = Palette.Accent
        fill.BorderSizePixel = 0
        fill.ZIndex = 7
        fill.Parent = track
        corner(fill, 3)
        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(12, 12)
        knob.Position = UDim2.new(0, -6, 0.5, -6)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.ZIndex = 8
        knob.Parent = track
        corner(knob, 6)
        local current = math.clamp(tonumber(value) or min, min, max)
        local function render()
            local t = (current - min) / math.max(max - min, 1)
            fill.Size = UDim2.new(t, 0, 1, 0)
            knob.Position = UDim2.new(t, -6, 0.5, -6)
            box.Text = tostring(math.floor(current + 0.5))
        end
        local function setValue(v)
            current = math.clamp(math.floor(tonumber(v) or min), min, max)
            render()
            if callback then callback(current) end
        end
        render()
        local dragging = false
        local function updateFromX(x)
            local ax, aw = track.AbsolutePosition.X, math.max(track.AbsoluteSize.X, 1)
            local t = math.clamp((x - ax) / aw, 0, 1)
            current = math.floor(min + t * (max - min) + 0.5)
            render()
            if callback then callback(current) end
        end
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateFromX(input.Position.X)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromX(input.Position.X)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                dragging = false
            end
        end)
        box.FocusLost:Connect(function() setValue(box.Text) end)
        if getter then
            registerControl(function()
                local v = getter()
                if v ~= nil then
                    current = math.clamp(math.floor(tonumber(v) or min), min, max)
                    render()
                end
            end)
        end
        return { set = setValue, get = function() return current end }
    end

    local function addButton(page, titleText, desc, callback, label)
        local row = baseRow(page, 42)
        rowLabels(row, titleText, desc)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.fromOffset(80, 22)
        btn.Position = UDim2.new(1, -90, 0.5, -11)
        btn.BackgroundColor3 = Palette.Button
        btn.BackgroundTransparency = 0.04
        btn.Text = label or "Open"
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = FONT_BOLD
        btn.TextSize = 11
        btn.AutoButtonColor = false
        btn.ZIndex = 7
        btn:SetAttribute("ThemeRole", "button")
        btn.Parent = row
        corner(btn, 10)
        stroke(btn, 1, 0.4)
        btn.MouseButton1Click:Connect(callback)
        return btn
    end

    local function addKeybind(page, titleText, desc, default, callback, onChange, getter)
        local row = baseRow(page, 42)
        rowLabels(row, titleText, desc)
        local keyBtn = Instance.new("TextButton")
        keyBtn.Size = UDim2.fromOffset(72, 22)
        keyBtn.Position = UDim2.new(1, -72, 0.5, -11)
        keyBtn.BackgroundColor3 = Palette.Button
        keyBtn.BackgroundTransparency = 0.36
        keyBtn.TextColor3 = Color3.new(1, 1, 1)
        keyBtn.Font = FONT
        keyBtn.TextSize = 11
        keyBtn.AutoButtonColor = false
        keyBtn.ZIndex = 7
        keyBtn:SetAttribute("ThemeRole", "field")
        keyBtn.Parent = row
        corner(keyBtn, 10)
        stroke(keyBtn, 1, 0.6)

        local boundKey = default
        local function renderKey()
            keyBtn.Text = boundKey and boundKey.Name or "None"
        end
        renderKey()

        keyBtn.MouseButton1Click:Connect(function()
            if keybindListening then return end
            keybindListening = true
            currentListeningButton = keyBtn
            keyBtn.Text = "Press key..."
            local conn
            conn = UIS.InputBegan:Connect(function(input, gpe)
                if not gpe and input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode == Enum.KeyCode.Escape then
                        -- cancel
                    else
                        boundKey = input.KeyCode
                        if onChange then onChange(boundKey) end
                    end
                    renderKey()
                    keybindListening = false
                    currentListeningButton = nil
                    conn:Disconnect()
                end
            end)
        end)

        UIS.InputBegan:Connect(function(input, gpe)
            if gpe or not boundKey then return end
            if input.KeyCode == boundKey then
                if callback then callback() end
            end
        end)

        if getter then
            registerControl(function()
                local v = getter()
                if v then
                    boundKey = v
                    renderKey()
                end
            end)
        end
        return keyBtn
    end

    local miniPopup
    local function openMiniPopup(anchorButton, titleText, build)
        if miniPopup and miniPopup.Parent then miniPopup:Destroy() end
        miniPopup = Instance.new("Frame")
        miniPopup.Size = UDim2.fromOffset(224, 160)
        miniPopup.BackgroundColor3 = Color3.fromRGB(10, 15, 39)
        miniPopup.BackgroundTransparency = 0.34
        miniPopup.BorderSizePixel = 0
        miniPopup.ZIndex = 90
        miniPopup.Parent = gui
        corner(miniPopup, 14)
        stroke(miniPopup, 1.2, 0.35)
        local pTitle = Instance.new("TextLabel")
        pTitle.Size = UDim2.new(1, -40, 0, 24)
        pTitle.Position = UDim2.fromOffset(12, 2)
        pTitle.BackgroundTransparency = 1
        pTitle.Text = titleText
        pTitle.TextColor3 = Palette.Accent
        pTitle.Font = FONT_BOLD
        pTitle.TextSize = 11
        pTitle.TextXAlignment = Enum.TextXAlignment.Left
        pTitle.ZIndex = 92
        pTitle.Parent = miniPopup
        local pClose = Instance.new("TextButton")
        pClose.Size = UDim2.fromOffset(18, 18)
        pClose.Position = UDim2.new(1, -24, 0, 4)
        pClose.BackgroundColor3 = Color3.fromRGB(255, 95, 86)
        pClose.Text = "x"
        pClose.TextColor3 = Color3.fromRGB(60, 20, 20)
        pClose.TextSize = 11
        pClose.Font = FONT_BOLD
        pClose.AutoButtonColor = false
        pClose.ZIndex = 92
        pClose.Parent = miniPopup
        corner(pClose, 9)
        stroke(pClose, 1, 0.6)
        pClose.MouseButton1Click:Connect(function()
            if miniPopup then miniPopup:Destroy() end
            miniPopup = nil
        end)
        local pContent = Instance.new("Frame")
        pContent.Size = UDim2.new(1, -20, 1, -34)
        pContent.Position = UDim2.fromOffset(10, 28)
        pContent.BackgroundTransparency = 1
        pContent.ZIndex = 91
        pContent.Parent = miniPopup
        local pLay = Instance.new("UIListLayout")
        pLay.Padding = UDim.new(0, 4)
        pLay.SortOrder = Enum.SortOrder.LayoutOrder
        pLay.Parent = pContent
        if build then pcall(build, pContent) end
        pcall(function()
            local ap, as = anchorButton.AbsolutePosition, anchorButton.AbsoluteSize
            local vp = gui.AbsoluteSize
            miniPopup.Position = UDim2.fromOffset(
                math.clamp(ap.X + as.X - 224, 6, math.max(6, vp.X - 230)),
                math.clamp(ap.Y + as.Y + 4, 6, math.max(6, vp.Y - 166))
            )
        end)
        local inputConn
        inputConn = UIS.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local p = input.Position
                local m = miniPopup
                if not m then return end
                local map, mas = m.AbsolutePosition, m.AbsoluteSize
                if p.X < map.X or p.X > map.X + mas.X or p.Y < map.Y or p.Y > map.Y + mas.Y then
                    m:Destroy()
                    miniPopup = nil
                    if inputConn then inputConn:Disconnect() end
                end
            end
        end)
        miniPopup.Destroying:Connect(function()
            if inputConn then inputConn:Disconnect() end
        end)
        return miniPopup
    end

    local function addDropdown(page, titleText, desc, options, default, callback, getter)
        local row = baseRow(page, 42)
        rowLabels(row, titleText, desc)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.fromOffset(100, 22)
        btn.Position = UDim2.new(1, -110, 0.5, -11)
        btn.BackgroundColor3 = Palette.Button
        btn.BackgroundTransparency = 0.36
        btn.Text = tostring(default or "Select")
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = FONT
        btn.TextSize = 11
        btn.AutoButtonColor = false
        btn.ZIndex = 7
        btn:SetAttribute("ThemeRole", "field")
        btn.Parent = row
        corner(btn, 10)
        stroke(btn, 1, 0.6)
        local selected = default
        btn.MouseButton1Click:Connect(function()
            if #options == 0 then return end
            local idx = table.find(options, selected) or 0
            idx = idx % #options + 1
            selected = options[idx]
            btn.Text = selected
            if callback then callback(selected) end
        end)
        if getter then
            registerControl(function()
                local v = getter()
                if v ~= nil then selected = v; btn.Text = tostring(v) end
            end)
        end
        return { get = function() return selected end, button = btn }
    end

