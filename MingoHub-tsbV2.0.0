    titleLabel.ZIndex = 6
    titleLabel.Parent = titleBar

    local playerInfoLabel = Instance.new("TextLabel")
    playerInfoLabel.Name = "PlayerInfo"
    playerInfoLabel.Size = UDim2.new(1, -140, 0, 11)
    playerInfoLabel.Position = UDim2.new(0, 76, 0, 17)
    playerInfoLabel.BackgroundTransparency = 1
    playerInfoLabel.Text = player.Name .. "  |  " .. EXECUTOR_NAME .. "  |  " .. DEVICE .. "  |  " .. (isMobile and "use SHOW UI" or "RightShift = hide/show")
    playerInfoLabel.TextColor3 = Color3.fromRGB(165, 165, 178)
    playerInfoLabel.Font = FONT
    playerInfoLabel.TextSize = 9
    playerInfoLabel.TextXAlignment = Enum.TextXAlignment.Left
    playerInfoLabel.TextTruncate = Enum.TextTruncate.AtEnd
