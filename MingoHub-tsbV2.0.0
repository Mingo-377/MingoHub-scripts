            local nameBox = addTextbox(c, "Player Name", "Type a username", "", nil, false)
            addButton(c, "Add Friend", "Force friend color", function() extra.espAddFriend(nameBox.Text) end, "Friend")
            addButton(c, "Add Enemy", "Force enemy color", function() extra.espAddEnemy(nameBox.Text) end, "Enemy")
        end)
    end, "...")

    addSection(playerTab, "Disguise As")
    local copyNameBox = addTextbox(playerTab, "Target Username", "Username or ID", "", function(v) charCopy.input = v end, false)
    addToggle(playerTab, "Keep After Respawn", "Re-apply on respawn", true, function(on) charCopy.keep = on end)
    addButton(playerTab, "Become Target", "Apply the disguise", function() task.spawn(function() charCopy.set(copyNameBox.Text) end) end, "Become")
    addButton(playerTab, "Reset To Me", "Revert to your avatar", function() task.spawn(function() charCopy.reset() end) end, "Reset")

    addSection(exploit, "Fling")
    addTextbox(exploit, "Fling Target", "Username or DisplayName", Settings.Player.Fling.Target, function(v) Settings.Player.Fling.Target = tostring(v or "") end, false, function() return Settings.Player.Fling.Target end)
    addButton(exploit, "Fling", "Run one fling on target", runFlingOnce, "Fling")
    addToggle(exploit, "Loop Fling", "Repeat fling while enabled", Settings.Player.Fling.LoopFling, function(on)
        Settings.Player.Fling.LoopFling = on
        if on then startFlingLoop() else stopFlingLoop() end
    end, function() return Settings.Player.Fling.LoopFling end)

    addSection(exploit, "Anti Fling")
    addToggle(exploit, "Anti Fling", "Freeze your character when launched", Settings.Player.AntiFling, function(on)
        Settings.Player.AntiFling = on
        extra.setAntiFling(on)
    end, function() return Settings.Player.AntiFling end)

    addSection(exploit, "Anti Death Counter")
    addToggle(exploit, "Anti Death Counter", "Strip Counter attributes from enemies", Settings.Player.AntiDeathCounter, function(on)
        Settings.Player.AntiDeathCounter = on
        applyAntiDeathCounter()
    end, function() return Settings.Player.AntiDeathCounter end)

    addSection(miscTab, "Notifications")
    addToggle(miscTab, "Enabled", "Show MingoHub notifications", Settings.Misc.Notifications.Enabled, function(on) Settings.Misc.Notifications.Enabled = on end, function() return Settings.Misc.Notifications.Enabled end)
    addToggle(miscTab, "Ultimates", "Notify on enemy ult", Settings.Misc.Notifications.Ult, function(on) Settings.Misc.Notifications.Ult = on end, function() return Settings.Misc.Notifications.Ult end)
    addToggle(miscTab, "Death Counters", "Notify on enemy death counter", Settings.Misc.Notifications.Counter, function(on) Settings.Misc.Notifications.Counter = on end, function() return Settings.Misc.Notifications.Counter end)

    addSection(miscTab, "Custom Background")
    addToggle(miscTab, "Enabled", "Enable custom background image", Settings.Visuals.CustomBackground.Enabled, function(on)
        Settings.Visuals.CustomBackground.Enabled = on
        applyBackground(Appearance.Background)
    end, function() return Settings.Visuals.CustomBackground.Enabled end)
    addTextbox(miscTab, "Image Asset ID", "The asset ID of the image", Settings.Visuals.CustomBackground.ImageId, function(v)
        Settings.Visuals.CustomBackground.ImageId = v
        if Settings.Visuals.CustomBackground.Enabled then applyBackground(Appearance.Background) end
    end, false, function() return Settings.Visuals.CustomBackground.ImageId end)
    addButton(miscTab, "Apply", "Apply the custom background", function() applyBackground(Appearance.Background) end, "Apply")
    addButton(miscTab, "Reset", "Reset to default background", function()
        Settings.Visuals.CustomBackground.Enabled = false
        Settings.Visuals.CustomBackground.ImageId = ""
        applyBackground(Appearance.Background)
    end, "Reset")

    addSection(miscTab, "Configuration")
    local nameBox = addTextbox(miscTab, "Config Name", "Name used when saving / importing", "default")
    addButton(miscTab, "Save Config", "Save the current settings", function() saveConfig(nameBox.Text) end, "Save")
    local selector = makeConfigSelector(miscTab, "Config List", "Pick the active config")
    addButton(miscTab, "Load Config", "Apply the selected config", function() loadConfig(selector.get()) end, "Load")
    addButton(miscTab, "Delete Config", "Delete the selected config", function() deleteConfig(selector.get()) end, "Delete")
    addButton(miscTab, "Export Config", "Copy config JSON to clipboard", function() exportConfig(selector.get() or nameBox.Text) end, "Export")
    local importBox = addTextbox(miscTab, "Import JSON", "Paste JSON, or copy it to clipboard", "")
    addButton(miscTab, "Import Config", "Save the JSON as a config", function() importConfig(nameBox.Text, importBox.Text) end, "Import")
    addToggle(miscTab, "Auto Load", "Load the selected config on execute", AutoLoadState.Enabled, function(on) setAutoLoad(on, selector.get()) end, function() return AutoLoadState.Enabled end)

    do
        local names = {}
        for _, b in ipairs(BACKGROUNDS) do
            if b.image ~= "" then names[#names + 1] = b.name end
        end

        addSection(setting, "Appearance")
        addDropdown(setting, "Background", "Tap to switch", names, Appearance.Background, function(v) applyBackground(v) end, function() return Appearance.Background end)
        addToggle(setting, "Blur Effect", "Blur the game behind the UI", Appearance.Blur, function(on) setBlur(on) end, function() return Appearance.Blur end)
        addToggle(setting, "Edge Glow", "Pulsing accent glow around the window", Appearance.EdgeGlow, function(on) setEdgeGlow(on) end, function() return Appearance.EdgeGlow end)
        addDropdown(setting, "UI Size", "75% - 200%", SCALE_OPTIONS, scaleLabel(Appearance.Scale), function(v) setUiScale(SCALE_VALUES[v] or 1) end, function() return scaleLabel(Appearance.Scale) end)
        addColorRow(setting, "Accent Color", "Tap to open the color picker", function() return Palette.Accent end, function(c) applyColors(c, Palette.Button, Palette.Border) end)
        addColorRow(setting, "Button Color", "Tap to open the color picker", function() return Palette.Button end, function(c) applyColors(Palette.Accent, c, Palette.Border) end)
        addColorRow(setting, "Border Color", "Tap to open the color picker", function() return Palette.Border end, function(c) applyColors(Palette.Accent, Palette.Button, c) end)
    end

    -- ═══════════════════════════════════════════
    --  AUTO LETHAL  (Main tab)
