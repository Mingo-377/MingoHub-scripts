local function colorToHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
end
local function hexToColor(hex)
    hex = tostring(hex or ""):gsub("%s", ""):gsub("#", "")
    if #hex == 6 and hex:match("^%x%x%x%x%x%x$") then
        return Color3.fromRGB(tonumber(hex:sub(1,2), 16), tonumber(hex:sub(3,4), 16), tonumber(hex:sub(5,6), 16))
    end
    return nil
end

local function applyTheme()
    for _, obj in ipairs(gui:GetDescendants()) do
        local role = obj:GetAttribute("ThemeRole")
        if role == "border" and obj:IsA("UIStroke") then obj.Color = Palette.Border
        elseif role == "glow" and obj:IsA("UIStroke") then obj.Color = Palette.Accent
        elseif role == "accentBg" then obj.BackgroundColor3 = Palette.Accent
        elseif role == "accentText" and obj:IsA("TextLabel") then obj.TextColor3 = Palette.Accent
        elseif role == "scroll" and obj:IsA("ScrollingFrame") then obj.ScrollBarImageColor3 = Palette.Accent
        elseif role == "toggle" and obj:IsA("TextButton") then obj.BackgroundColor3 = obj:GetAttribute("ToggleState") and Palette.Accent or Palette.Off
        elseif role == "field" then obj.BackgroundColor3 = Palette.Button
        elseif role == "button" and obj:IsA("TextButton") then obj.BackgroundColor3 = Palette.Button
        end
    end
end

local function applyColors(accent, button, border)
    Palette.Accent = accent
    Palette.AccentLight = accent:Lerp(Color3.new(1,1,1), 0.4)
    Palette.Button = button
    Palette.Border = border
    Palette.Off = button:Lerp(Color3.new(0,0,0), 0.4)
    Appearance.Accent = {math.floor(accent.R*255+0.5), math.floor(accent.G*255+0.5), math.floor(accent.B*255+0.5)}
    Appearance.Button = {math.floor(button.R*255+0.5), math.floor(button.G*255+0.5), math.floor(button.B*255+0.5)}
    Appearance.Border = {math.floor(border.R*255+0.5), math.floor(border.G*255+0.5), math.floor(border.B*255+0.5)}
    applyTheme()
end

local SCALE_LABELS = {"75%","100%","125%","150%","175%","200%"}
local SCALE_VALUES = {["75%"]=0.75, ["100%"]=1, ["125%"]=1.25, ["150%"]=1.5, ["175%"]=1.75, ["200%"]=2}
local function scaleLabelFor(v)
    local best, bestD = "100%", math.huge
    for label, val in pairs(SCALE_VALUES) do
        local d = math.abs(val - (tonumber(v) or 1))
        if d < bestD then best, bestD = label, d end
    end
    return best
end

local function setUIScale(scale, instant)
    scale = math.clamp(tonumber(scale) or 1, 0.75, 2)
    Appearance.Scale = scale
    if instant then uiScale.Scale = scale else tween(uiScale, 0.25, {Scale = scale}) end
end

local function setBlur(on)
    Appearance.Blur = on and true or false
    pcall(function() tween(ensureBlur(), 0.4, {Size = (isOpen and Appearance.Blur) and BLUR_SIZE or 0}) end)
end

local function applyBackground(name)
    local chosen
    for _, x in ipairs(BACKGROUNDS) do if x.name == name then chosen = x end end
    if not chosen or chosen.image == "" then
        if Settings.Visuals.CustomBackground.Enabled and Settings.Visuals.CustomBackground.ImageId ~= "" then
            local id = Settings.Visuals.CustomBackground.ImageId
            if not id:match("^rbxassetid://") then id = "rbxassetid://" .. id end
            bg.Image = id
            Appearance.Background = name
        end
        return
    end
    bg.Image = chosen.image
    Appearance.Background = name
end

applyAppearanceRef = function()
    applyColors(
        Color3.fromRGB(Appearance.Accent[1], Appearance.Accent[2], Appearance.Accent[3]),
        Color3.fromRGB(Appearance.Button[1], Appearance.Button[2], Appearance.Button[3]),
        Color3.fromRGB(Appearance.Border[1], Appearance.Border[2], Appearance.Border[3])
    )
    setUIScale(Appearance.Scale, true)
    setEdgeGlow(Appearance.EdgeGlow)
    setBlur(Appearance.Blur)
    if Appearance.Background then applyBackground(Appearance.Background) end
end

