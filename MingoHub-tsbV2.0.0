addSection(main, "True DownSlam")
addToggle(main, "TDS Enabled", "Enable down-slam macro", Settings.Misc.TDSEnabled,
    function(on) Settings.Misc.TDSEnabled = on end,
    function() return Settings.Misc.TDSEnabled end)
addKeybind(main, "TDS Keybind", "Key for true down-slam", Settings.Misc.TDSKey, function()
    if not Settings.Misc.TDSEnabled then return end
    task.spawn(function()
        if not Character then return end
        local hum, root = Humanoid, RootPart
        if not (hum and root and hum.Health > 0) then return end
        local nj = Character:FindFirstChild("NoJump")
        if nj then task.defer(nj.Destroy, nj) end
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        task.wait(0.01)
        if root and root.Parent then
            root.Velocity = Vector3.new(root.Velocity.X, 35, root.Velocity.Z)
        end
        pressAndClick(Enum.KeyCode.One)
        task.wait()
        clickM1()
    end)
end, function(k) Settings.Misc.TDSKey = k end, function() return Settings.Misc.TDSKey end)

-- MAIN — Macro
addSection(main, "Macros")
addToggle(main, "True M1 Reset", "Reset M1 combo with side+front dash", Settings.Macros.TrueM1Reset.Enabled,
    function(on) Settings.Macros.TrueM1Reset.Enabled = on end,
    function() return Settings.Macros.TrueM1Reset.Enabled end)
addKeybind(main, "M1 Reset Key", "Key to trigger", Settings.Macros.TrueM1Reset.Key,
    function() execTrueM1Reset() end,
    function(k) Settings.Macros.TrueM1Reset.Key = k end,
    function() return Settings.Macros.TrueM1Reset.Key end)
addToggle(main, "Emote Dash", "Emote-dash macro", Settings.Macros.EmoteDash.Enabled,
    function(on) Settings.Macros.EmoteDash.Enabled = on end,
    function() return Settings.Macros.EmoteDash.Enabled end)
addDropdown(main, "Emote Dash Type", "Direction of dash", {"Right","Left","Straight"}, Settings.Macros.EmoteDash.Type,
    function(v) Settings.Macros.EmoteDash.Type = v end,
    function() return Settings.Macros.EmoteDash.Type end)
addTextbox(main, "Emote Dash Delay", "Delay after key tap", Settings.Macros.EmoteDash.Delay,
    function(v) Settings.Macros.EmoteDash.Delay = math.clamp(tonumber(v) or 0.05, 0, 1) end, true,
    function() return Settings.Macros.EmoteDash.Delay end)
addKeybind(main, "Emote Dash Key", "Trigger emote-dash", Settings.Macros.EmoteDash.Key,
    function() execEmoteDash() end,
    function(k) Settings.Macros.EmoteDash.Key = k end,
    function() return Settings.Macros.EmoteDash.Key end)
addToggle(main, "Backdash Cancel", "Backdash-cancel macro", Settings.Macros.Backdash.Enabled,
    function(on) Settings.Macros.Backdash.Enabled = on end,
    function() return Settings.Macros.Backdash.Enabled end)
for i = 1, 4 do
    addToggle(main, "Variant " .. i, nil, Settings.Macros.Backdash.Variants[i],
        function(on) Settings.Macros.Backdash.Variants[i] = on end,
        function() return Settings.Macros.Backdash.Variants[i] end)
    local keyIndex = i
    addKeybind(main, "Variant " .. i .. " Key", nil, Settings.Macros.Backdash.Keys[i],
        function()
            if Settings.Macros.Backdash.Enabled and Settings.Macros.Backdash.Variants[keyIndex] then
                task.spawn(function()
                    task.wait(Settings.Macros.Backdash.Delay)
                    backdashMacro(Settings.Macros.Backdash.Keys[keyIndex])
                end)
            end
        end,
        function(k) Settings.Macros.Backdash.Keys[keyIndex] = k end,
        function() return Settings.Macros.Backdash.Keys[keyIndex] end)
end

addSection(main, "Tech Helper")
addToggle(main, "Enabled", "Manual tech on keypress", Settings.Macros.TechHelper.Enabled,
    function(on) Settings.Macros.TechHelper.Enabled = on end,
    function() return Settings.Macros.TechHelper.Enabled end)
addDropdown(main, "Tech", "Which tech",
    {"Humbled Twisted","Loop Dash","Instant Lee","Oreo Tech","Lix Tech"}, Settings.Macros.TechHelper.Tech,
    function(v) Settings.Macros.TechHelper.Tech = v end,
    function() return Settings.Macros.TechHelper.Tech end)
addKeybind(main, "Tech Helper Key", "Trigger helper tech", Settings.Macros.TechHelper.Key,
    function()
        if not Settings.Macros.TechHelper.Enabled or Settings.Macros.TechHelper.Tech == "" then return end
        task.spawn(execTechHelper, Settings.Macros.TechHelper.Tech)
    end,
    function(k) Settings.Macros.TechHelper.Key = k end,
    function() return Settings.Macros.TechHelper.Key end)

-- PLAYER — Movement
addSection(playerTab, "Movement")
addToggle(playerTab, "WalkSpeed Override", "Enable custom walkspeed", Settings.Player.WalkSpeedEnabled,
    function(on)
        Settings.Player.WalkSpeedEnabled = on
        if Humanoid then Humanoid.WalkSpeed = on and Settings.Player.WalkSpeed or 16 end
    end,
    function() return Settings.Player.WalkSpeedEnabled end)
addTextbox(playerTab, "WalkSpeed Value", "Default: 16", Settings.Player.WalkSpeed,
    function(v)
        Settings.Player.WalkSpeed = tonumber(v) or 16
        if Settings.Player.WalkSpeedEnabled and Humanoid then Humanoid.WalkSpeed = Settings.Player.WalkSpeed end
    end, true,
    function() return Settings.Player.WalkSpeed end)
addToggle(playerTab, "No Side Dash Cooldown", "Spam side dash", Settings.Player.NoSideDashCooldown,
    function(on)
