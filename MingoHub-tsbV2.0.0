local serverNoDash   = workspace:GetAttribute("NoDashCooldown")
local serverEffect   = workspace:GetAttribute("EffectAffects")
local spoofingDash   = false
local frontDashAt    = 0

connectSignal(workspace:GetAttributeChangedSignal("NoDashCooldown"), function() if not spoofingDash then serverNoDash = workspace:GetAttribute("NoDashCooldown") end end)
connectSignal(workspace:GetAttributeChangedSignal("EffectAffects"), function() if not spoofingDash then serverEffect = workspace:GetAttribute("EffectAffects") end end)

local function noDashCooldownActive()
    if Character and Character:FindFirstChild("DashReset3rd") then return true end
    if not serverNoDash then return false end
    return serverEffect == 1 or workspace:GetAttribute("VIPServerOwner") == player.Name
end

local function setSpoofDash(on)
    if workspace:GetAttribute("NoDashCooldown") == (on and true or serverNoDash) and workspace:GetAttribute("EffectAffects") == (on and 1 or serverEffect) then return end
    spoofingDash = true
    workspace:SetAttribute("NoDashCooldown", on and true or serverNoDash)
    workspace:SetAttribute("EffectAffects",  on and 1 or serverEffect)
    spoofingDash = false
end

local function setCamCFrame(pos, yaw, pitch)
    workspace.CurrentCamera.CFrame = CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end
end -- END CHUNK 1

do -- CHUNK 2: CORE FUNCTIONS & LOGIC
local function freeRotate()
    if Humanoid and not lockRotating then
        local c = Character
        Humanoid.AutoRotate = not (c and (c:FindFirstChild("Ragdoll") or c:FindFirstChild("NoRotate")))
    end
end

local function techRotate(angle, targetPos, rotateChar, rotateCam, precision)
    if not rotateChar and not rotateCam and not angle then rotateChar = true end
    local doChar = rotateChar or rotateCam
    local doCam  = (not rotateChar) or rotateCam
    if doChar and not (RootPart and Humanoid) then return end
    precision = precision or 1
    local camCF  = workspace.CurrentCamera.CFrame
    local camPos = camCF.Position
    if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then camPos = camPos - camCF.RightVector * 1.75 end
    local pitchCam = math.asin(math.clamp(camCF.LookVector.Y, -1, 1))
    local curYaw, tgtYaw
    if targetPos then
        if doChar and not doCam then
            local v = (targetPos - RootPart.Position).Unit
            curYaw = math.atan2(-RootPart.CFrame.LookVector.X, -RootPart.CFrame.LookVector.Z)
            tgtYaw = math.atan2(-v.X, -v.Z)
        elseif doCam and not doChar then
            local v = (targetPos - camPos).Unit
            curYaw = math.atan2(-camCF.LookVector.X, -camCF.LookVector.Z)
            tgtYaw = math.atan2(-v.X, -v.Z)
        else
            local vChar = (targetPos - RootPart.Position).Unit
            local vCam  = (targetPos - camPos).Unit
            local charCur = math.atan2(-RootPart.CFrame.LookVector.X, -RootPart.CFrame.LookVector.Z)
            local charTgt = math.atan2(-vChar.X, -vChar.Z)
            local diff    = math.atan2(math.sin(charTgt - charCur), math.cos(charTgt - charCur))
            local finalYaw = charCur + diff * precision
            Humanoid.AutoRotate = false
            local vel = RootPart.AssemblyLinearVelocity
            RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, finalYaw, 0)
            RootPart.AssemblyLinearVelocity = vel
            local camCur = math.atan2(-camCF.LookVector.X, -camCF.LookVector.Z)
            local camTgt = math.atan2(-vCam.X, -vCam.Z)
            local camDiff = math.atan2(math.sin(camTgt - camCur), math.cos(camTgt - camCur))
            setCamCFrame(camCF.Position, camCur + camDiff * precision, pitchCam)
            return
        end
    else
        local lv = doChar and RootPart.CFrame.LookVector or camCF.LookVector
        curYaw = math.atan2(-lv.X, -lv.Z)
        tgtYaw = curYaw + math.rad(angle or 0)
    end
    local diff     = math.atan2(math.sin(tgtYaw - curYaw), math.cos(tgtYaw - curYaw))
    local finalYaw = curYaw + diff * precision
    if doChar then
        Humanoid.AutoRotate = false
        local vel = RootPart.AssemblyLinearVelocity
        RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, finalYaw, 0)
        RootPart.AssemblyLinearVelocity = vel
        if not doCam then return end
    end
    setCamCFrame(camCF.Position, finalYaw, pitchCam)
end

local function smoothRotateByAngle(angle, duration, rotateChar)
    local startTick = tick()
    local startCF   = rotateChar and RootPart.CFrame or workspace.CurrentCamera.CFrame
    local startYaw  = math.atan2(-startCF.LookVector.X, -startCF.LookVector.Z)
    local targetYaw = startYaw + math.rad(angle)
    local name = "MingoSmoothRot" .. tostring(tick())
    renderBindNames[name] = true
    RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
        local t = math.clamp((tick() - startTick) / math.max(duration, 0.001), 0, 1)
        local alpha = t * t * (3 - 2 * t)
        local camCF  = workspace.CurrentCamera.CFrame
        local finalYaw = startYaw + (targetYaw - startYaw) * alpha
        if rotateChar then
            if not (Humanoid and RootPart) then RunService:UnbindFromRenderStep(name); renderBindNames[name] = nil; return end
            Humanoid.AutoRotate = false
            local vel = RootPart.AssemblyLinearVelocity
            RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, finalYaw, 0)
            RootPart.AssemblyLinearVelocity = vel
        else
            setCamCFrame(camCF.Position, finalYaw, math.asin(math.clamp(camCF.LookVector.Y, -1, 1)))
        end
        if t >= 1 then RunService:UnbindFromRenderStep(name); renderBindNames[name] = nil end
    end)
end

local function smoothRotateCamToPos(targetPos, duration)
    duration = math.max(duration or 0.08, 0.001)
    local startTick = tick()
    local startLV   = workspace.CurrentCamera.CFrame.LookVector
    local startYaw  = math.atan2(-startLV.X, -startLV.Z)
    local name = "MingoSmoothRotPos" .. tostring(tick()) .. tostring(math.random(1000, 9999))
    renderBindNames[name] = true
    RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
        local t = math.clamp((tick() - startTick) / duration, 0, 1)
        local alpha   = t * t * (3 - 2 * t)
        local camCF   = workspace.CurrentCamera.CFrame
        local camPos  = camCF.Position
        if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then camPos = camPos - camCF.RightVector * 1.75 end
        local toTarget = targetPos - camPos
        if toTarget.Magnitude < 0.01 then RunService:UnbindFromRenderStep(name); renderBindNames[name] = nil; return end
        local tgtYaw = math.atan2(-toTarget.Unit.X, -toTarget.Unit.Z)
        local diff   = math.atan2(math.sin(tgtYaw - startYaw), math.cos(tgtYaw - startYaw))
        local finalYaw = startYaw + diff * alpha
        local pitch = math.asin(math.clamp(camCF.LookVector.Y, -1, 1))
        setCamCFrame(camCF.Position, finalYaw, pitch)
        if t >= 1 then RunService:UnbindFromRenderStep(name); renderBindNames[name] = nil end
    end)
end

local function characterRotateEasing(targetPart, targetHum, duration)
    duration = duration or 0
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not (targetPart and targetPart.Parent and RootPart and RootPart.Parent and targetHum.Health > 0 and Humanoid and Humanoid.Health > 0) then conn:Disconnect(); return end
        local ok = true
        for _, c in ipairs(Character:GetChildren()) do if localBusySet[c.Name] then ok = false break end end
        if not ok then return end
        Humanoid.AutoRotate = false
        local cf = RootPart.CFrame
        local tgt = Vector3.new(targetPart.Position.X, cf.Position.Y, targetPart.Position.Z)
        local tgtCF = CFrame.new(cf.Position, tgt)
        pcall(function()
            if duration <= 0 then RootPart.CFrame = tgtCF
            else RootPart.CFrame = cf:Lerp(tgtCF, math.clamp(dt / duration, 0, 1)) end
        end)
    end)
    return conn
end

local function stopRotate(conn) if conn then conn:Disconnect() end; if Humanoid then Humanoid.AutoRotate = true end end

local function getTargetPart(hrp)
    local setting = Settings.AutoTech.TargetPart
    local parent  = hrp and hrp.Parent
    if parent and (setting == "Head" or setting == "Torso") then
        local p = parent:FindFirstChild(setting) or (setting == "Torso" and parent:FindFirstChild("UpperTorso"))
        if p then return p end
    end
    return hrp
end

local function getTargetPos(hrp) local p = getTargetPart(hrp); return p and p.Position or Vector3.zero end

local function isTargetAbove(targetHRP)
    local myPos, tgtPos = RootPart.Position, targetHRP.Position
    local hDist = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(tgtPos.X, 0, tgtPos.Z)).Magnitude
    return hDist <= 0.2 and myPos.Y < tgtPos.Y
end

local function isAnimPlaying(animId, hum)
    local anim = hum and (hum:FindFirstChildOfClass("Animator") or hum:FindFirstChild("Animator")) or Animator
    if not anim then return false end
    local id = tostring(animId)
    for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
        if track.Animation and track.Animation.AnimationId:find(id, 1, true) then return true end
    end
    return false
end

local function localClear()
    if not Character then return false end
    for _, c in ipairs(Character:GetChildren()) do if localBusySet[c.Name] then return false end end
    return true
end

local function enemyClear(char)
    if not char then return false end
    for _, c in ipairs(char:GetChildren()) do if enemyBusySet[c.Name] then return false end end
    return true
end

local function charIsRagdolled()
    local c, h = Character, Humanoid
    if not (c and h) or h.Health <= 0 then return true end
    if c:FindFirstChild("Ragdoll") or c:GetAttribute("Ragdoll") or c:FindFirstChild("BeingLaunched") or c:FindFirstChild("KnockedDown") or c:FindFirstChild("Freeze") or c:FindFirstChild("Stun") then return true end
    if h.PlatformStand or h:GetState() == Enum.HumanoidStateType.Ragdoll then return true end
    return false
end

local function canFrontDash()
    if noDashCooldownActive() or not dashOnCD then return true end
    return tick() - frontDashAt >= 0.5
end

local function getCommunicate()
    if Communicate and Communicate.Parent then return Communicate end
    if Character then Communicate = Character:FindFirstChild("Communicate") or Character:WaitForChild("Communicate", 2) end
    return Communicate
end

local function performFrontDash()
    if not canFrontDash() then return false end
    local comm = getCommunicate()
    if not comm then return false end
    comm:FireServer(fireActions.frontDash)
    frontDashAt = tick()
    if not noDashCooldownActive() then dashOnCD = true; task.delay(5, function() dashOnCD = false end) end
    return true
end

local function performDashWithDelay(extraDelay)
    lockRotating = true
    performFrontDash()
    task.wait(getPing(1000) + 0.05 + (extraDelay or 0))
end

local function pressKey(kc)   pcall(function() VIM:SendKeyEvent(true,  kc, false, game) end) end
local function releaseKey(kc) pcall(function() VIM:SendKeyEvent(false, kc, false, game) end) end
local function tapKey(kc) pressKey(kc); task.wait(math.random(2, 6) / 1000); releaseKey(kc) end
local function randomWait(base) task.wait((base or 0) + math.random(2, 6) / 1000) end

local function fireM1Click()
    local comm = getCommunicate()
    if not comm then return end
    local isMob = UIS.TouchEnabled and not UIS.KeyboardEnabled
    local spoof = Settings.Player.DeviceSpoof
    if spoof.Enabled then isMob = spoof.Device == "Mobile" or spoof.Device == "Console" end
    randomWait(); comm:FireServer({ Goal = "LeftClick", Mobile = isMob or nil })
    randomWait(); comm:FireServer({ Goal = "LeftClickRelease", Mobile = isMob or nil }); randomWait()
end

local blockState = { active = false, untilT = 0, session = nil }
local blockRotateConn = nil

local function fireHoldBlock()
    local comm = getCommunicate()
    if not blockActive and comm then
        blockActive = true; Humanoid.AutoRotate = false; comm:FireServer(fireActions.holdBlock)
    end
end

local function fireReleaseBlock()
    local comm = getCommunicate()
    if blockActive and comm then blockActive = false; comm:FireServer(fireActions.releaseBlock); freeRotate() end
end

local function holdBlock(duration, targetHRP, targetHum)
    if Character and Character:FindFirstChild("Counter") then return false end
    duration = duration or 0.25
    blockState.untilT = math.max(blockState.untilT, tick() + duration)
    if blockState.active then return false end
    blockState.active = true
    blockState.session = {}
    local session = blockState.session
    local charConn
    if Settings.Autoblock.RotateChar and targetHRP and targetHum then charConn = characterRotateEasing(targetHRP, targetHum, Settings.Autoblock.CharEasing) end
    if Settings.Autoblock.RotateCam and targetHRP then smoothRotateCamToPos(targetHRP.Position, Settings.Autoblock.CamEasing) end
    fireHoldBlock()
    while tick() < blockState.untilT and not Unloaded and blockState.session == session do task.wait() end
    disconnectConn(charConn)
    if blockState.session == session then blockState.active = false; blockState.session = nil; fireReleaseBlock() end
    return true
end

local function findCounterTool()
    local bp, ch = player:FindFirstChild("Backpack"), Character
    return (bp and (bp:FindFirstChild("Prey's Peril") or bp:FindFirstChild("Split Second Counter"))) or (ch and (ch:FindFirstChild("Prey's Peril") or ch:FindFirstChild("Split Second Counter")))
end

local function tryAutoCounter(hrp, hum, wasMovingM1)
    local tool = findCounterTool()
    if not Settings.Autoblock.AutoCounter or not tool or wasMovingM1 then return true end
    local hotbar = PlayerGui:FindFirstChild("Hotbar")
    local backpack = hotbar and hotbar:FindFirstChild("Backpack")
    local hbGui = backpack and backpack:FindFirstChild("Hotbar")
    local slot4  = hbGui and hbGui:FindFirstChild("4")
    local base   = slot4 and slot4:FindFirstChild("Base")
    if base and base:FindFirstChild("Cooldown") then return true end
    local comm = getCommunicate()
    if comm and tool then comm:FireServer({ IsAutoActivate = true, Goal = "Console Move", Tool = tool, ToolName = tool.Name }); return false end
    return true
end

local lastPunish = 0
local function tryM1Punish(hrp, hum)
    if tick() - lastPunish < 0.25 then return end
    lastPunish = tick()
    if not (hrp.Parent and hrp.Parent:FindFirstChild("CanBringUp") == nil) then return end
    for _, c in ipairs(hrp.Parent:GetChildren()) do if counterLikeSet[c.Name] then return end end
    local charConn
    if Settings.Autoblock.RotateChar and hrp and hum then charConn = characterRotateEasing(hrp, hum, Settings.Autoblock.CharEasing) end
    if Settings.Autoblock.RotateCam and hrp then smoothRotateCamToPos(hrp.Position, Settings.Autoblock.CamEasing) end
    fireM1Click(); task.wait(0.1); disconnectConn(charConn)
end

local function dashVelocityToward(hrp)
    if not (hrp and RootPart) then return false end
    local vel = hrp.AssemblyLinearVelocity
    if vel.Magnitude < 0.1 then return false end
    local toMe = RootPart.Position - hrp.Position
    if toMe.Magnitude < 0.01 then return true end
    return vel.Unit:Dot(toMe.Unit) > 0.7
end

local function inFOV(hrp)
    local fov = Settings.Autoblock.FOV or 360
    if fov >= 360 or not (RootPart and hrp) then return true end
    local look = RootPart.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local toEnemy = hrp.Position - RootPart.Position
    local flatTo  = Vector3.new(toEnemy.X, 0, toEnemy.Z)
    if flat.Magnitude < 0.001 or flatTo.Magnitude < 0.001 then return true end
    return math.deg(math.acos(math.clamp(flat.Unit:Dot(flatTo.Unit), -1, 1))) <= fov / 2
end
end -- END CHUNK 2

do -- CHUNK 3: STATE, AUTO BLOCK, TECH, LETHAL
local State = {}
State.AB = { lastM1 = setmetatable({}, { __mode = "k" }), hooked = setmetatable({}, { __mode = "k" }) }
State.DashPred = { active = {}, acc = 0, ids = DashPredAnimIds }

State.DashPred.start = function(model, hrp, hum)
    local entry = State.DashPred.active[model]
    if entry and tick() - entry.started < 0.4 then return end
    State.DashPred.active[model] = { hrp = hrp, human = hum, started = tick() }
end

State.DashPred.threat = function(hrp)
    local toMe = RootPart.Position - hrp.Position
    toMe = Vector3.new(toMe.X, 0, toMe.Z)
    local vel  = hrp.AssemblyLinearVelocity
    vel = Vector3.new(vel.X, 0, vel.Z)
    local speed2 = vel:Dot(vel)
    if speed2 < 25 then return toMe.Magnitude, 0, 0 end
    local closing = toMe.Magnitude > 0 and toMe.Unit:Dot(vel) or 0
    local tHit   = math.clamp(toMe:Dot(vel) / speed2, 0, 0.45 + getPing(1000))
    return (toMe - vel * tHit).Magnitude, tHit, closing
end

State.DashPred.step = function()
    local now = tick()
    for model, entry in pairs(State.DashPred.active) do
        if now - entry.started > 0.65 or not (entry.hrp.Parent and entry.human.Health > 0) then
            State.DashPred.active[model] = nil
        elseif not entry.blocked then
            local plr = Players:GetPlayerFromCharacter(model)
            if not (Settings.Misc.FriendCheck and plr and isFriend(plr, false)) and localClear() and enemyClear(model) then
                local closest, tHit, closing = State.DashPred.threat(entry.hrp)
                local dist = (entry.hrp.Position - RootPart.Position).Magnitude
                if dist <= Distances.M1 or (closing > 8 and closest <= Distances.M1 + 2) then
                    entry.blocked = true
                    local blockDur = math.clamp(tHit + 0.3 + getPing(1000), 0.3, 0.8)
                    task.spawn(function() if tryAutoCounter(entry.hrp, entry.human, false) then holdBlock(blockDur, entry.hrp, entry.human) end end)
                end
            end
        end
    end
end

connectSignal(RunService.Heartbeat, function(dt)
    local dp = State.DashPred
    if not next(dp.active) then return end
    if Unloaded or not (Settings.Autoblock.Enabled and Settings.Autoblock.DashPredict) then table.clear(dp.active); return end
    dp.acc = dp.acc + dt
    if dp.acc < 1/30 then return end
    dp.acc = 0
    if not (RootPart and Humanoid and Humanoid.Health > 0) then return end
    pcall(State.DashPred.step)
end)

State.AB.react = function(model, eventName)
    if not Settings.Autoblock.Enabled or model == Character then return end
    if not (RootPart and Humanoid and Humanoid.Health > 0) then return end
    local hrp  = model:FindFirstChild("HumanoidRootPart")
    local hum  = model:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0) then return end
    local plr  = Players:GetPlayerFromCharacter(model)
    if plr == player or (Settings.Misc.FriendCheck and plr and isFriend(plr, false)) then return end
    local isM1, isInterrupt, isBarrage = eventName == "M1ing", interruptMovesSet[eventName], barrageMovesSet[eventName]
    if not (isM1 or isInterrupt or isBarrage) then return end
    local dist = (RootPart.Position - hrp.Position).Magnitude
    local inRange = dist <= Distances.M1
    local isMoving = dist <= Distances.MovingM1 and dashVelocityToward(hrp)
    local dashPred = Settings.Autoblock.DashPredict and dist <= Distances.FarDash and (isAnimPlaying(AnimIds.rsideDash, hum) or isAnimPlaying(AnimIds.lsideDash, hum))
    if not (inRange or isMoving or dashPred) or not (localClear() and enemyClear(model)) or not inFOV(hrp) then return end
    if isM1 then
        local last = State.AB.lastM1[model]
        if last and tick() - last < 0.15 then return end
        State.AB.lastM1[model] = tick()
    end
    if not tryAutoCounter(hrp, hum, isMoving) then return end
    if isM1 or isInterrupt then
        task.spawn(function()
            if not holdBlock(pingRangePair(0.25)[1], hrp, hum) then return end
            local d2 = (RootPart.Position - hrp.Position).Magnitude
            if Settings.Autoblock.AutoM1 and (d2 <= (Settings.Autoblock.Range or 9) or (d2 <= Distances.MovingM1 and dashVelocityToward(hrp)) or dashPred) then
                if hrp.Parent and not hrp.Parent:FindFirstChild("CanBringUp") then
                    local charConn2
                    if Settings.Autoblock.RotateChar and hrp and hum then charConn2 = characterRotateEasing(hrp, hum, Settings.Autoblock.CharEasing) end
                    fireM1Click(); task.wait(0.1); disconnectConn(charConn2)
                end
            end
        end)
    elseif isBarrage then
        task.spawn(function()
            if not (RootPart and hrp) then return end
            local charConn2 = characterRotateEasing(hrp, hum, Settings.Autoblock.CharEasing)
            local startT = tick()
            local loopConn = RunService.Heartbeat:Connect(function()
                fireHoldBlock()
                local d3 = (RootPart.Position - hrp.Position).Magnitude
                if model:FindFirstChild("NoBlock") or d3 >= Distances.Barrage + 5 then
                    disconnectConn(charConn2); loopConn:Disconnect(); fireReleaseBlock()
                    if Settings.Autoblock.AutoM1 and d3 <= (Settings.Autoblock.Range or 9) then tryM1Punish(hrp, hum) end
                    return
                end
                if math.clamp((tick() - startT) / 0.1, 0, 1) >= 1 and not model:FindFirstChild("Slowed") then
                    disconnectConn(charConn2); loopConn:Disconnect(); fireReleaseBlock()
                end
            end)
        end)
    end
end

State.AB.hook = function(model)
    if not model:IsA("Model") or model == Character or State.AB.hooked[model] then return end
    State.AB.hooked[model] = true
    task.spawn(function()
        local hum  = model:WaitForChild("Humanoid", 10)
        local anim = hum and hum:WaitForChild("Animator", 10)
        if not anim then return end
        connectSignal(anim.AnimationPlayed, function(track)
            if Unloaded or not Settings.Autoblock.Enabled or model == Character then return end
            local id = track.Animation and track.Animation.AnimationId:match("%d+")
            if not id then return end
            if M1AnimIds[id] then task.spawn(State.AB.react, model, "M1ing")
            elseif State.DashPred.ids[id] and Settings.Autoblock.DashPredict then
                local hrp2 = model:FindFirstChild("HumanoidRootPart")
                if hrp2 and RootPart and (hrp2.Position - RootPart.Position).Magnitude <= 45 then State.DashPred.start(model, hrp2, hum) end
            end
        end)
    end)
end

local function onLiveChildAdded(child)
    if not child then return end
    local name = child.Name
    if not (watchedEvents[name] or interruptMovesSet[name] or barrageMovesSet[name]) then return end
    local model = child:FindFirstAncestorWhichIsA("Model")
    if not model then local p = child.Parent; while p and p ~= workspace do if p:IsA("Model") then model = p; break end; p = p.Parent end end
    if not model then return end
    local plr     = Players:FindFirstChild(model.Name)
    local isLocal = model == Character or (plr and plr == player)
    if isLocal then
        if dashEventSet[name] and Settings.Rage.SideDashAssist.Enabled then
            task.spawn(function() if State_SDA and State_SDA.run then State_SDA.run(child) end end)
        end
        if name == "Freeze" and Settings.Rage.NoStun then task.defer(child.Destroy, child)
        elseif name == "Slowed" and Settings.Rage.NoSlow then task.defer(child.Destroy, child)
        elseif Settings.Rage.NoSideDashCooldown and (name == "UsedDash" or name == "InDash" or name == "DashCooldown" or name == "SideDashCooldown") then task.defer(child.Destroy, child)
        elseif name == "moveme" and Settings.Rage.CustomFrontDash.Enabled and not Settings.Rage.CustomFrontDash.OnlyOnKeybind and Settings.Rage.CustomFrontDash.Distance > 1 then
            local pair = pingRangePair(Settings.Rage.CustomFrontDash.Distance)
            task.spawn(function() task.wait(0.05); if not (RootPart and RootPart.Parent) or isAnimPlaying(AnimIds.backDash) then return end; local vel = RootPart.AssemblyLinearVelocity; RootPart.AssemblyLinearVelocity = Vector3.new(vel.X * pair[1], vel.Y, vel.Z * pair[1]) end)
        elseif name == "dodgevelocity" and Settings.Rage.CustomSideDash.Enabled and not Settings.Rage.CustomSideDash.OnlyOnKeybind and Settings.Rage.CustomSideDash.Distance > 1 then
            local pair = pingRangePair(Settings.Rage.CustomSideDash.Distance)
            task.spawn(function() task.wait(0.05); if not (RootPart and RootPart.Parent) then return end; local vel = RootPart.AssemblyLinearVelocity; RootPart.AssemblyLinearVelocity = Vector3.new(vel.X * pair[1], vel.Y, vel.Z * pair[1]) end)
        end
    else
        local hrp2, hum2 = model:FindFirstChild("HumanoidRootPart"), model:FindFirstChildOfClass("Humanoid")
        if not (hum2 and hrp2 and RootPart and Humanoid and Humanoid.Health > 0 and hum2.Health > 0) then return end
        if name == "Counter" and plr then
            if Settings.Misc.Notifications.Enabled and Settings.Misc.Notifications.Counter then
                pcall(function() Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420) end)
            end
        elseif dashEventSet[name] and Settings.Autoblock.DashPredict then State.DashPred.start(model, hrp2, hum2)
        elseif Settings.Autoblock.Enabled then State.AB.react(model, name) end
    end
end

local function findBestTarget(maxDist)
    maxDist = maxDist or 16
    if not (Character and RootPart) then return nil end
    local myPos = RootPart.Position
    local lastHit = Character:GetAttribute("LastM1Hitted")
    local lastName = type(lastHit) == "string" and lastHit:match("^(.-);;")
    local best, bestDist = nil, maxDist
    local function tryModel(model)
        if not (model and model.IsA and model:IsA("Model") and model ~= Character and model.Parent) then return end
        local hrp3, hum3 = model:FindFirstChild("HumanoidRootPart"), model:FindFirstChildOfClass("Humanoid")
        if not (hrp3 and hum3 and hum3.Health > 0) then return end
        local plr2 = Players:GetPlayerFromCharacter(model)
        if Settings.Misc.FriendCheck and plr2 and isFriend(plr2, false) then return end
        local d = (hrp3.Position - myPos).Magnitude
        if d < bestDist then bestDist = d; best = model end
    end
    if lastName then for _, m in ipairs(liveFolder:GetChildren()) do if m.Name == lastName then tryModel(m) end end; if best then return best end end
    for _, m in ipairs(liveFolder:GetChildren()) do tryModel(m) end
    for _, p in ipairs(Players:GetPlayers()) do if p ~= player and p.Character then tryModel(p.Character) end end
    return best
end

local function ragdollWatch(method, duration, targetChar, targetHum, callback)
    local conn = RunService[method]:Connect(function()
        if not (targetChar and targetChar.Parent and not targetChar:FindFirstChild("BeingLaunched") and targetChar:FindFirstChild("Ragdoll") and targetHum and targetHum.Health > 0 and Humanoid and Humanoid.Health > 0 and isAnimPlaying(AnimIds.frontDash)) then
            lockRotating = false; disconnectConn(conn); return
        end
        callback()
    end)
    task.wait(duration); disconnectConn(conn); lockRotating = false
end

local TECH_HANDLERS = {}
TECH_HANDLERS["Supa"] = function(targetChar, hrp, hum, missChance)
    performDashWithDelay()
    local offset = hrp.CFrame:PointToObjectSpace(RootPart.Position)
    ragdollWatch("Heartbeat", 0.3, targetChar, hum, function()
        local worldPos = hrp.CFrame:PointToWorldSpace(offset)
        if missChance then worldPos = worldPos + hrp.CFrame.RightVector * (math.random() > 0.5 and 7 or -7) end
        pcall(function() Character:PivotTo(CFrame.lookAt(worldPos, Vector3.new(hrp.Position.X, worldPos.Y + 1.5, hrp.Position.Z))) end)
    end)
end
TECH_HANDLERS["Lock On Dash"] = function(targetChar, hrp, hum, missChance)
    performDashWithDelay()
    local tgtPos = getTargetPos(hrp)
    if missChance then tgtPos = tgtPos + hrp.CFrame.RightVector * (math.random() > 0.5 and 8 or -8) end
    ragdollWatch("Heartbeat", 0.7, targetChar, hum, function() techRotate(nil, tgtPos, true, false, Settings.AutoTech.LockonPrecision) end)
end
TECH_HANDLERS["Loop Dash"] = function(targetChar, hrp, hum, missChance)
    performDashWithDelay(); techRotate(90, nil, true); smoothRotateByAngle(270, 0.35, false); task.wait(0.3)
    local cachedCF = nil
    ragdollWatch("Heartbeat", 0.4, targetChar, hum, function()
        if missChance then techRotate(nil, getTargetPos(hrp) + hrp.CFrame.RightVector * (math.random() > 0.5 and 7 or -7), true)
        elseif cachedCF or isTargetAbove(hrp) then
            if not cachedCF then cachedCF = Settings.AutoTech.LoopDashLooksUp and CFrame.lookAt(RootPart.Position, Vector3.new(RootPart.Position.X + 1.5, RootPart.Position.Y + 1.5, RootPart.Position.Z)) or RootPart.CFrame end
            pcall(function() Character:PivotTo(cachedCF) end)
        else techRotate(nil, getTargetPos(hrp), true) end
    end)
end
TECH_HANDLERS["Kiba"] = function(targetChar, hrp, hum, missChance)
    performDashWithDelay()
    ragdollWatch("Heartbeat", 0.4, targetChar, hum, function()
        local tgtPos3 = getTargetPos(hrp)
        local offset2 = missChance and (tgtPos3 + hrp.CFrame.RightVector * (math.random() > 0.5 and 7 or -7) - Vector3.new(0, 3, 2)) or (tgtPos3 - Vector3.new(0, 3, 2))
        pcall(function() Character:PivotTo(CFrame.new(offset2, tgtPos3)) end)
    end)
end
TECH_HANDLERS["Loop Dash v2"] = function(targetChar, hrp, hum, missChance)
    local c = Settings.AutoTech.Loopv2
    if c.Jump then pcall(function() RootPart.AssemblyLinearVelocity = Vector3.new(RootPart.AssemblyLinearVelocity.X, 50, RootPart.AssemblyLinearVelocity.Z) end) end
    lockRotating = true; techRotate(c.FirstFlickAngle, nil, true, c.RotateCam); performDashWithDelay(c.SecondFlick)
    ragdollWatch("Heartbeat", 0.4, targetChar, hum, function()
        local tgtPos4 = getTargetPos(hrp)
        if missChance then tgtPos4 = tgtPos4 + hrp.CFrame.RightVector * (math.random() > 0.5 and 8 or -8) end
        techRotate(nil, tgtPos4, true, c.RotateCam, c.Precision)
    end)
    lockRotating = false; freeRotate()
end
TECH_HANDLERS["Custom Dash"] = function(targetChar, hrp, hum, missChance)
    local c = Settings.AutoTech.Customdash
    if c.Jump then pcall(function() RootPart.AssemblyLinearVelocity = Vector3.new(RootPart.AssemblyLinearVelocity.X, 50, RootPart.AssemblyLinearVelocity.Z) end) end
    lockRotating = true
    local tgtPos5 = getTargetPos(hrp)
    if missChance then tgtPos5 = tgtPos5 + hrp.CFrame.RightVector * (math.random() > 0.5 and 8 or -8) end
    local lockArgs = { nil, tgtPos5, false, c.RotateCam, c.LockOnPrecision }
    techRotate(c.StartFlickAngle, nil, true, c.RotateCam); performDashWithDelay(c.SecondFlickDelay); techRotate(c.SecondFlickAngle, nil, true, c.RotateCam)
    if c.LockOn and c.LockOnAfter == "Second Flick" then task.wait(c.LockOnDelay); ragdollWatch("Heartbeat", 0.4, targetChar, hum, function() techRotate(table.unpack(lockArgs)) end)
    else task.wait(c.ThirdFlickDelay); techRotate(c.ThirdFlickAngle, nil, true, c.RotateCam); if c.LockOn and c.LockOnAfter == "Third Flick" then task.wait(c.LockOnDelay); ragdollWatch("Heartbeat", 0.4, targetChar, hum, function() techRotate(table.unpack(lockArgs)) end) end end
    lockRotating = false; freeRotate()
end
TECH_HANDLERS["Custom Dash v2"] = function(targetChar, hrp, hum, missChance)
    local c = Settings.AutoTech.Customdashv2
    if c.Jump then pcall(function() RootPart.AssemblyLinearVelocity = Vector3.new(RootPart.AssemblyLinearVelocity.X, 50, RootPart.AssemblyLinearVelocity.Z) end) end
    lockRotating = true
    local tgtPos6 = getTargetPos(hrp)
    if missChance then tgtPos6 = tgtPos6 + hrp.CFrame.RightVector * (math.random() > 0.5 and 8 or -8) end
    local lockArgs2 = { nil, tgtPos6, false, c.RotateCam, c.LockOnPrecision }
    techRotate(c.StartFlickAngle, nil, true, c.RotateCam); performDashWithDelay(c.SecondFlickDelay); smoothRotateByAngle(c.SecondFlickAngle, c.SecondFlickDuration, not c.RotateCam)
    if c.LockOn and c.LockOnAfter == "Second Flick" then task.wait(c.LockOnDelay); ragdollWatch("Heartbeat", 0.4, targetChar, hum, function() techRotate(table.unpack(lockArgs2)) end)
    else task.wait(c.ThirdFlickDelay); smoothRotateByAngle(c.ThirdFlickAngle, c.ThirdFlickDuration, not c.RotateCam); if c.LockOn and c.LockOnAfter == "Third Flick" then task.wait(c.LockOnDelay); ragdollWatch("Heartbeat", 0.4, targetChar, hum, function() techRotate(table.unpack(lockArgs2)) end) end end
    lockRotating = false; freeRotate()
end

local LethalState = { busy = false, armedUntil = 0, highlight = nil }
LethalState.getTarget = function(maxDist)
    if not (RootPart and liveFolder) then return nil end
    local best, bestDist = nil, maxDist or 20
    for _, m in ipairs(liveFolder:GetChildren()) do
        if m ~= Character and m:IsA("Model") then
            local plr2 = Players:GetPlayerFromCharacter(m)
            if not (plr2 and Settings.Misc.FriendCheck and isFriend(plr2, true)) then
                local hrp4, hum4 = m:FindFirstChild("HumanoidRootPart"), m:FindFirstChildOfClass("Humanoid")
                if hrp4 and hum4 and hum4.Health > 0 then
                    local d = (hrp4.Position - RootPart.Position).Magnitude
                    if d < bestDist then bestDist = d; best = m end
                end
            end
        end
    end
    return best
end
LethalState.setHighlight = function(target)
    if LethalState.highlight then pcall(function() LethalState.highlight:Destroy() end); LethalState.highlight = nil end
    if not (target and Settings.AutoLethal.Highlight) then return end
    local hl = Instance.new("Highlight")
    hl.Name = "MingoLethalTarget"; hl.FillColor = Settings.AutoLethal.HighlightColor; hl.OutlineColor = Settings.AutoLethal.HighlightColor
    hl.FillTransparency = 0.5; hl.OutlineTransparency = 0; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Adornee = target; hl.Parent = target
    LethalState.highlight = hl
end
LethalState.jump = function()
    if not RootPart then return end
    local function boost() local v = RootPart.AssemblyLinearVelocity; RootPart.AssemblyLinearVelocity = Vector3.new(v.X, 50, v.Z) end
    boost(); local n = 0
    local conn = RunService.Heartbeat:Connect(function()
        n = n + 1
        if n > 3 or not RootPart.Parent then conn:Disconnect(); return end
        if RootPart.AssemblyLinearVelocity.Y < 35 then boost() end
    end)
end
LethalState.getElapsed = function()
    if not Animator then return nil end
    for _, track in ipairs(Animator:GetPlayingAnimationTracks()) do
        if track.Animation and track.Animation.AnimationId:match("%d+") == Settings.AutoLethal.HitAnim then return track.TimePosition end
    end
    return nil
end
LethalState.run = function(targetChar, isMissing, graveTrack)
    local al  = Settings.AutoLethal
    local hrp5, hum5 = targetChar:FindFirstChild("HumanoidRootPart"), targetChar:FindFirstChildOfClass("Humanoid")
    if not (hrp5 and hum5) then return end
    LethalState.setHighlight(targetChar)
    local startT2 = tick()
    if graveTrack then
        local graveFix = math.min(al.GraveTiming, 0)
        repeat RunService.Heartbeat:Wait() until not graveTrack.IsPlaying or (graveTrack.Length > 0 and graveTrack.TimePosition >= graveTrack.Length + graveFix) or tick() - startT2 >= 3
        if al.GraveTiming > 0 then task.wait(al.GraveTiming) end
    else
        repeat RunService.Heartbeat:Wait() until not (Character and Character:FindFirstChildOfClass("ForceField")) or tick() - startT2 >= 2.5
        task.wait(0.1)
    end
    if not (Humanoid and Humanoid.Health > 0 and hum5.Health > 0) then return end
    if al.Jump then LethalState.jump() end
    lockRotating = true; techRotate(al.FirstFlickAngle, nil, true, al.RotateCam)
    local comm2 = getCommunicate()
    if comm2 then comm2:FireServer(fireActions.frontDash) end
    frontDashAt = tick(); dashOnCD = true; task.delay(5, function() dashOnCD = false end)
    task.wait(getPing(1000) + 0.05 + al.SecondFlick)
    local watchStart = tick()
    local watchConn = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - watchStart
        if elapsed > 0.4 or (elapsed > 0.2 and not isAnimPlaying(AnimIds.frontDash)) or not hrp5.Parent or hum5.Health <= 0 or Humanoid.Health <= 0 then watchConn:Disconnect(); return end
        local aimPos = getTargetPos(hrp5)
        if isMissing then aimPos = aimPos + hrp5.CFrame.RightVector * (math.random() > 0.5 and 8 or -8) end
        techRotate(nil, aimPos, true, al.RotateCam, al.Precision)
    end)
    task.wait(0.4); if watchConn.Connected then watchConn:Disconnect() end
end
LethalState.trigger = function(targetChar, graveTrack)
    if LethalState.busy then return end
    local al = Settings.AutoLethal
    local doMiss = al.MissChance > 0 and math.random(1, 100) <= al.MissChance
    LethalState.busy = true
    local ok, err = pcall(LethalState.run, targetChar, doMiss, graveTrack)
    if not ok then warn("[MingoHub] AutoLethal: " .. tostring(err)) end
    lockRotating = false; freeRotate(); LethalState.setHighlight(nil); task.wait(0.3); LethalState.busy = false
end
LethalState.onAnim = function(track)
    if Unloaded then return end
    local al = Settings.AutoLethal
    local id = track.Animation and track.Animation.AnimationId:match("%d+")
    local isGrave = id == al.GraveAnim
    if not (id == al.HitAnim or (isGrave and al.Grave)) or LethalState.busy then return end
    if not (al.Enabled or tick() < LethalState.armedUntil) then return end
    LethalState.armedUntil = 0
    local tgt = LethalState.getTarget(20)
    if tgt then task.spawn(LethalState.trigger, tgt, isGrave and track or nil) end
end
LethalState.fire = function()
    LethalState.armedUntil = tick() + 3
    tapKey((Character and Character:GetAttribute("Character") == "Zombie") and Enum.KeyCode.One or Enum.KeyCode.Two)
    if not sAutoUnequip then
        randomWait(0.01)
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(400, 300)
        local hx2, hy2 = math.floor(vp.X / 2), math.floor(vp.Y / 2)
        pcall(function() VIM:SendMouseButtonEvent(hx2, hy2, 0, true,  game, 0) end)
        randomWait()
        pcall(function() VIM:SendMouseButtonEvent(hx2, hy2, 0, false, game, 0) end)
    end
end

local MagnetState = { conn = nil, startTime = 0, duration = 0.5, strength = 50, smoothness = 0.65, targetOverride = nil }
MagnetState.stop = function() disconnectConn(MagnetState.conn); MagnetState.conn = nil end
MagnetState.onStep = function()
    local mag = Settings.Misc.Magnet
    if not mag.Enabled or Unloaded or not (Character and RootPart and Humanoid and Humanoid.Health > 0) then MagnetState.stop(); return end
    if tick() - MagnetState.startTime >= MagnetState.duration then MagnetState.stop(); return end
    local tgt = (MagnetState.targetOverride and MagnetState.targetOverride.Parent and MagnetState.targetOverride) or MagnetState.getTarget()
    if not tgt then return end
    local myPos3 = RootPart.Position
    local dir = (Vector3.new(tgt.Position.X, myPos3.Y, tgt.Position.Z) - myPos3)
    if dir.Magnitude > 1 then
        local desired = dir.Unit * MagnetState.strength
        local cur = RootPart.AssemblyLinearVelocity
        local lerped = cur:Lerp(desired, MagnetState.smoothness)
        pcall(function() RootPart.AssemblyLinearVelocity = Vector3.new(lerped.X * 0.85, cur.Y, lerped.Z * 0.85) end)
    end
end
MagnetState.startPull = function(override)
    MagnetState.stop(); local mag = Settings.Misc.Magnet
    MagnetState.startTime = tick(); MagnetState.duration = mag.Duration or 0.5; MagnetState.strength = mag.Strength or 50
    MagnetState.smoothness = mag.Smoothness or 0.65; MagnetState.targetOverride = override
    MagnetState.onStep(); MagnetState.conn = connectSignal(RunService.Heartbeat, MagnetState.onStep)
end
MagnetState.execute = function(override)
    local mag = Settings.Misc.Magnet
    if not mag.Enabled or not (Character and Humanoid and Humanoid.Health > 0 and Character.Parent) then return end
    if mag.DashCancel then
        for _, c in ipairs(Character:GetChildren()) do if c:IsA("BodyVelocity") or c:IsA("LinearVelocity") then c:Destroy() end end
        for _, c in ipairs(RootPart:GetChildren()) do if c:IsA("BodyVelocity") or c:IsA("LinearVelocity") then c:Destroy() end end
        local vel2 = RootPart.AssemblyLinearVelocity
        RootPart.AssemblyLinearVelocity = Vector3.new(0, vel2.Y, 0)
    end
    local tgt2 = (override and override.Parent and override) or MagnetState.getTarget()
    if tgt2 then
        local wpPos  = tgt2.Position + Vector3.new(0, mag.Height or 2, 0)
        pcall(function() RootPart.CFrame = CFrame.new(wpPos) end)
        MagnetState.startPull(tgt2)
    end
end
MagnetState.getTarget = function()
    local mag = Settings.Misc.Magnet
    if not (Character and RootPart) then return nil end
    local best, bestDist = nil, mag.MaxDistance or 100
    local myPos2 = RootPart.Position
    for _, m in ipairs(liveFolder:GetChildren()) do
        if m ~= Character and m:IsA("Model") then
            local plr3 = Players:GetPlayerFromCharacter(m)
            if not (plr3 and Settings.Misc.FriendCheck and isFriend(plr3, true)) then
                local hrp6, hum6 = m:FindFirstChild("HumanoidRootPart"), m:FindFirstChildOfClass("Humanoid")
                if hrp6 and hum6 and hum6.Health > 0 then
                    local d = (myPos2 - hrp6.Position).Magnitude
                    if d < bestDist and d > 0.1 then bestDist = d; best = hrp6 end
                end
            end
        end
    end
    if not best then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character ~= Character then
                if not (Settings.Misc.FriendCheck and isFriend(p, true)) then
                    local hrp7, hum7 = p.Character:FindFirstChild("HumanoidRootPart"), p.Character:FindFirstChildOfClass("Humanoid")
                    if hrp7 and hum7 and hum7.Health > 0 then
                        local d = (myPos2 - hrp7.Position).Magnitude
                        if d < bestDist and d > 0.1 then bestDist = d; best = hrp7 end
                    end
                end
            end
        end
    end
    return best
end

local function magnetTechTrigger(techName, targetHRP)
    local mag = Settings.Misc.Magnet
    if not mag.Enabled or not mag.TechTrigger or mag.TechTrigger == "Disabled" or mag.TechTrigger == "None" then return end
    local matches = (mag.TechTrigger == "All 3" or mag.TechTrigger == "All") and (techName == "Loop Dash v2" or techName == "Custom Dash" or techName == "Custom Dash v2") or (techName == mag.TechTrigger)
    if matches then task.spawn(function() local delay = mag.TechDelay or 0; if delay > 0 then task.wait(delay / 1000) end; MagnetState.execute(targetHRP) end) end
end
end -- END CHUNK 3

do -- CHUNK 4: SDA, FLING, VISUALS, ESP
local State_SDA = { busy = false, color = Color3.fromRGB(142, 187, 255) }
State_SDA.angle = function(v) return math.atan2(v.Z, v.X) end
State_SDA.target = function()
    local sda = Settings.Rage.SideDashAssist
    if not RootPart then return nil, nil end
    local myPos4  = RootPart.Position
    local lookV   = RootPart.CFrame.LookVector
    local lookFlat = Vector3.new(lookV.X, 0, lookV.Z)
    lookFlat = lookFlat.Magnitude > 0 and lookFlat.Unit or Vector3.zAxis
    local best2, bestModel2, bestScore2
    local function tryChar(model)
        if not (model and model ~= Character and model.Parent) then return end
        local hrp9, hum9 = model:FindFirstChild("HumanoidRootPart"), model:FindFirstChildOfClass("Humanoid")
        if not (hrp9 and hum9 and hum9.Health > 0) then return end
        local plr4 = Players:GetPlayerFromCharacter(model)
        if plr4 == player or (Settings.Misc.FriendCheck and plr4 and isFriend(plr4, false)) then return end
        local toTarget = hrp9.Position - myPos4
        local dist2 = toTarget.Magnitude
        if dist2 > sda.Range or dist2 < 0.5 then return end
        local flat2 = Vector3.new(toTarget.X, 0, toTarget.Z)
        local dot2  = flat2.Magnitude > 0 and flat2.Unit:Dot(lookFlat) or 1
        if dot2 < -0.25 then return end
        local score = dist2 * (1.6 - dot2 * 0.6)
        if not bestScore2 or score < bestScore2 then best2, bestModel2, bestScore2 = hrp9, model, score end
    end
    for _, p in ipairs(Players:GetPlayers()) do tryChar(p.Character) end
    for _, m in ipairs(liveFolder:GetChildren()) do if m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then tryChar(m) end end
    return best2, bestModel2
end
State_SDA.waypoint = function(myPos, tgtPos, tgtLook, side, cfg)
    local n = Vector3.new(myPos.X - tgtPos.X, 0, myPos.Z - tgtPos.Z)
    if n.Magnitude < 0.1 then return tgtPos, true, 0 end
    local nUnit = -n.Unit
    local perp  = Vector3.new(-nUnit.Z, 0, nUnit.X) * side
    if cfg.Mode ~= "Behind" then
        local wp = tgtPos + perp * cfg.Offset
        wp = Vector3.new(wp.X, myPos.Y, wp.Z)
        return wp, false, (wp - myPos).Magnitude
    end
    local back = Vector3.new(-tgtLook.X, 0, -tgtLook.Z)
    if back.Magnitude < 0.1 then back = n end
    back = back.Unit
    local off  = cfg.Offset
    local base = Vector3.new(tgtPos.X, myPos.Y, tgtPos.Z) + back * off
    local ang1 = State_SDA.angle(n)
    local ang2 = State_SDA.angle(back)
    local sideSign = (n.X * perp.Z - n.Z * perp.X) >= 0 and 1 or -1
    local arcAng = ((ang2 - ang1) * sideSign) % (2 * math.pi)
    if arcAng > math.rad(300) then arcAng = 0 end
    if arcAng < math.rad(12) then return base, true, (base - myPos).Magnitude end
    local newAng = ang1 + math.min(arcAng, math.rad(70)) * sideSign
    local dist3  = math.max(off, math.min(n.Magnitude, off + 6) - 2)
    local wp2 = Vector3.new(tgtPos.X + math.cos(newAng) * dist3, myPos.Y, tgtPos.Z + math.sin(newAng) * dist3)
    return wp2, false, math.max(0, n.Magnitude - off) + off * arcAng
end
State_SDA.run = function(dodgeVelocityInst)
    local sda, sdaS  = Settings.Rage.SideDashAssist, State_SDA
    if sdaS.busy or not (sda.Enabled and RootPart and Humanoid and Humanoid.Health > 0) then return end
    RunService.Heartbeat:Wait()
    if isAnimPlaying(AnimIds.backDash) or not (dodgeVelocityInst and dodgeVelocityInst.Parent) then return end
    local goRight, goLeft = isAnimPlaying(AnimIds.rsideDash), isAnimPlaying(AnimIds.lsideDash)
    if goRight == goLeft then
        local backHeld = UIS:IsKeyDown(Enum.KeyCode.S)
        goRight = UIS:IsKeyDown(Enum.KeyCode.D) and not backHeld
        goLeft  = UIS:IsKeyDown(Enum.KeyCode.A) and not backHeld
        if goRight == goLeft then return end
    end
    if sdaS.busy then return end
    local tgtHRP2, tgtModel2 = sdaS.target()
    local jzdFj = RootPart
    if not (tgtHRP2 and jzdFj) then return end
    sdaS.busy = true
    if sda.Highlight then
        local existing = workspace:FindFirstChild("MingoSDAMark")
        if not existing then
            existing = Instance.new("Highlight"); existing.Name = "MingoSDAMark"
            existing.FillTransparency = 0.6; existing.OutlineTransparency = 0
            existing.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; existing.Parent = workspace
        end
        existing.FillColor = sdaS.color; existing.OutlineColor = sdaS.color; existing.Adornee = tgtModel2
    end
    local sideSign2 = goRight and 1 or -1
    if dodgeVelocityInst and dodgeVelocityInst.Parent then dodgeVelocityInst:Destroy() end
    local bv = Instance.new("BodyVelocity"); bv.Name = "MingoSideDashAssist"; bv.MaxForce = Vector3.new(50000, 0, 50000); bv.P = 4000; bv.Velocity = Vector3.zero; bv.Parent = jzdFj
    local startTick2, arrived, duration4, initVelDir = tick(), nil, nil, nil
    local curYaw2 = select(2, jzdFj.CFrame:ToOrientation())
    local faceName = "MingoSDAFace"
    local function cleanup()
        pcall(RunService.UnbindFromRenderStep, RunService, faceName)
        if bv.Parent then bv:Destroy() end
        sdaS.busy = false; freeRotate()
        local mark = workspace:FindFirstChild("MingoSDAMark")
        if mark then mark.Adornee = nil end
    end
    RunService:BindToRenderStep(faceName, Enum.RenderPriority.Camera.Value + 1, function(dt)
        local root2 = RootPart
        if root2 ~= jzdFj or not (root2 and root2.Parent and tgtHRP2.Parent) or charIsRagdolled() then return end
        local toEnem = tgtHRP2.Position - root2.Position
        if Vector3.new(toEnem.X, 0, toEnem.Z).Magnitude < 0.5 then return end
        local blend = math.min(dt, 0.1) * 60
        if sda.FaceTarget then
            local wantYaw = math.atan2(-toEnem.X, -toEnem.Z)
            local diff2   = math.atan2(math.sin(wantYaw - curYaw2), math.cos(wantYaw - curYaw2))
            curYaw2 = curYaw2 + diff2 * (1 - (1 - (arrived and 0.5 or 0.3))^blend)
            if Humanoid then Humanoid.AutoRotate = false end
            root2.CFrame = CFrame.new(root2.Position) * CFrame.Angles(0, curYaw2, 0)
        end
        if sda.RotateCam then techRotate(0, tgtHRP2.Position, false, false, 1 - (1 - 0.25)^blend) end
    end)
    local steppedConn
    steppedConn = RunService.Stepped:Connect(function(_, physDt)
        local root3 = RootPart
        if Unloaded or root3 ~= jzdFj or not (root3.Parent and tgtHRP2.Parent and Humanoid and Humanoid.Health > 0) or charIsRagdolled() or tick() - startTick2 > (duration4 and duration4 + 0.3 or 1) or (not arrived and not bv.Parent) then
            cleanup(); steppedConn:Disconnect(); return
        end
        local aimPos = tgtHRP2.Position
        if sda.Predict then
            local predVel = tgtHRP2.AssemblyLinearVelocity
            local predT   = math.min((aimPos - root3.Position).Magnitude / 60, 0.3)
            aimPos = aimPos + Vector3.new(predVel.X, 0, predVel.Z) * predT
        end
        if arrived then if tick() - arrived > 0.3 then cleanup(); steppedConn:Disconnect() end; return end
        local wp3, done3, dist4 = sdaS.waypoint(root3.Position, aimPos, tgtHRP2.CFrame.LookVector, sideSign2, sda)
        local toWP = Vector3.new(wp3.X - root3.Position.X, 0, wp3.Z - root3.Position.Z)
        local elapsed2 = tick() - startTick2
        duration4 = duration4 or math.clamp(dist4 / 45, 0.3, 0.55) / math.clamp(sda.Speed, 0.5, 2)
        local remaining = math.max(duration4 - elapsed2, 0.06)
        local speed3 = math.clamp(2 * dist4 / remaining, 12, 120)
        if (done3 or sda.Mode ~= "Behind") and toWP.Magnitude <= math.max(1.2, speed3 * physDt * 1.2) then
            bv:Destroy(); local cv = root3.AssemblyLinearVelocity
            root3.AssemblyLinearVelocity = Vector3.new(cv.X * 0.25, cv.Y, cv.Z * 0.25)
            arrived = tick(); return
        end
        if toWP.Magnitude < 0.05 then return end
        local dir2 = toWP.Unit
        if initVelDir then
            local blend2 = 1 - (1 - math.clamp(sda.Strength, 0.05, 1))^(math.min(physDt, 0.1) * 60)
            local lerped2 = initVelDir:Lerp(dir2, blend2)
            initVelDir = lerped2.Magnitude > 0.05 and lerped2.Unit or dir2
        else initVelDir = dir2 end
        bv.Velocity = initVelDir * speed3
    end)
end

task.spawn(function()
    while not Unloaded do
        task.wait(0.1)
        if Settings.Rage.SideDashAssist.Enabled and Settings.Rage.SideDashAssist.Highlight and not State_SDA.busy and Humanoid and Humanoid.Health > 0 then
            local _, tgtModel3 = State_SDA.target()
            local mark2 = workspace:FindFirstChild("MingoSDAMark")
            if mark2 then mark2.Adornee = tgtModel3 end
        end
    end
end)

local State_Freeze = { held = false, root = nil, velocity = nil }
State_Freeze.hold = function()
    if State_Freeze.held or not (RootPart and RootPart.Parent) then return end
    State_Freeze.held, State_Freeze.root, State_Freeze.velocity = true, RootPart, RootPart.AssemblyLinearVelocity
    RootPart.Anchored = true
end
State_Freeze.release = function()
    if not State_Freeze.held then return end
    State_Freeze.held = false
    local root4 = State_Freeze.root
    State_Freeze.root = nil
    if root4 and root4.Parent then root4.Anchored = false; if State_Freeze.velocity then root4.AssemblyLinearVelocity = State_Freeze.velocity end end
end
end -- END CHUNK 4

do -- CHUNK 5: FLING, ESP, VISUALS
local flingState = { busy = false, loopRunning = false }
local function findFlingTarget()
    local name = tostring(Settings.Player.Fling.Target or ""):match("^%s*(.-)%s*$")
    if name == "" then return nil end
    for _, p in ipairs(Players:GetPlayers()) do if p ~= player and (p.Name == name or p.DisplayName == name) then return p.Character end end
    return nil
end
local function doFlingOnce(targetChar)
    if not (RootPart and Character and targetChar) then return end
    local targetRoot, targetHum = targetChar:FindFirstChild("HumanoidRootPart"), targetChar:FindFirstChildOfClass("Humanoid")
    if not (targetRoot and targetHum) then return end
    local origDestroy = workspace.FallenPartsDestroyHeight
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    local bv2 = Instance.new("BodyVelocity"); bv2.Velocity = Vector3.zero; bv2.MaxForce = Vector3.new(9e9, 9e9, 9e9); bv2.Parent = RootPart
    local origCF, startT3, n2, deg = RootPart.CFrame, tick(), 0, 0
    local function setPos(rootTarget, cfo)
        if not (Character and Character.PrimaryPart and RootPart) then return end
        RootPart.CFrame = cfo; Character:SetPrimaryPartCFrame(cfo)
        RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7); RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
    end
    repeat
        n2 += 1; deg += 100
        if targetHum.MoveDirection.Magnitude < 0.5 then
            setPos(targetRoot, CFrame.new(targetRoot.Position) * CFrame.new(0, n2 % 2 == 0 and 1.5 or -1.5, 0) * CFrame.Angles(math.rad(deg), 0, 0))
        else
            setPos(targetRoot, CFrame.new(targetRoot.Position) * CFrame.new(0, 1.5, targetHum.WalkSpeed) * CFrame.Angles(math.rad(90), 0, 0))
        end
        task.wait()
    until Unloaded or tick() - startT3 >= 3 or not targetRoot.Parent
    bv2:Destroy()
    local returnStart = tick()
    repeat
        pcall(function()
            RootPart.CFrame = origCF * CFrame.new(0, 0.5, 0); Character:SetPrimaryPartCFrame(origCF * CFrame.new(0, 0.5, 0))
            RootPart.Velocity = Vector3.zero; RootPart.RotVelocity = Vector3.zero
        end)
        task.wait()
    until (RootPart.Position - origCF.Position).Magnitude < 25 or tick() - returnStart >= 3 or not Character.Parent
    pcall(function() workspace.FallenPartsDestroyHeight = origDestroy end)
end
local function runFlingOnce()
    if flingState.busy then return end
    local tgt = findFlingTarget()
    if not tgt then notifySystem("Fling: target not found", 2); return end
    flingState.busy = true; local ok, err = pcall(doFlingOnce, tgt); if not ok then warn("[MingoHub] Fling: " .. tostring(err)) end; flingState.busy = false
end
local function startFlingLoop()
    if flingState.loopRunning then return end
    flingState.loopRunning = true
    task.spawn(function()
        while flingState.loopRunning and Settings.Player.Fling.LoopFling do
            local tgt = findFlingTarget()
            if tgt then flingState.busy = true; pcall(doFlingOnce, tgt); flingState.busy = false end
            task.wait(3)
        end
        flingState.loopRunning = false
    end)
end
local function stopFlingLoop() flingState.loopRunning = false; Settings.Player.Fling.LoopFling = false end

local antiDeathConn
local function applyAntiDeathCounter()
    disconnectConn(antiDeathConn); antiDeathConn = nil
    if not Settings.Player.AntiDeathCounter then return end
    antiDeathConn = RunService.Heartbeat:Connect(function()
        if not Character then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local counter = p.Character:FindFirstChild("Counter"); if counter then pcall(function() counter:Destroy() end) end
            end
        end
    end)
end

local dashRangeStates = {}
local function getDashVelInst(inst) if inst:IsA("BodyVelocity") then return inst.Velocity end; if inst:IsA("LinearVelocity") then return inst.VectorVelocity end end
local function setDashVelInst(inst, v) if inst:IsA("BodyVelocity") then inst.Velocity = v elseif inst:IsA("LinearVelocity") then inst.VectorVelocity = v end end
local function classifyDash(vel)
    local cam = workspace.CurrentCamera; if not cam then return "None" end
    local flat, look = Vector3.new(vel.X, 0, vel.Z), Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
    if flat.Magnitude < 1 or look.Magnitude < 0.01 then return "None" end
    local dot = flat.Unit:Dot(look.Unit)
    if dot < -0.5 then return "Back" end
    if math.abs(dot) <= 0.5 then return "Side" end
    return "Front"
end
local function trackDashRange(inst) if inst:IsA("BodyVelocity") or inst:IsA("LinearVelocity") then dashRangeStates[inst] = { kind = false } end end
connectSignal(RunService.Heartbeat, function()
    if not next(dashRangeStates) then return end
    local P = Settings.Player
    for inst, st in pairs(dashRangeStates) do
        if not inst.Parent then dashRangeStates[inst] = nil else
            local ok, cur = pcall(getDashVelInst, inst)
            if ok and cur then
                if st.kind == false and Vector3.new(cur.X, 0, cur.Z).Magnitude >= 1 then
                    local kind = classifyDash(cur); local range
                    if kind == "Side" and P.SideDashEnabled then range = P.SideDashRange elseif kind == "Back" and P.BackDashEnabled then range = P.BackDashRange end
                    if range then st.kind = kind; st.mult = (tonumber(range) or 15) / 15; st.base = cur else st.kind = "Skip" end
                end
                if st.mult then
                    if st.last and (cur - st.last).Magnitude > 0.05 then st.base = cur end
                    local scaled = Vector3.new(st.base.X * st.mult, st.base.Y, st.base.Z * st.mult)
                    st.last = scaled; pcall(setDashVelInst, inst, scaled)
                end
            end
        end
    end
end)

local noTexData, noTexRun = {}, 0
local function applyNoTextures(rescan, enable)
    noTexRun += 1; local run = noTexRun
    task.spawn(function()
        local lastYield = os.clock()
        local function yield() if os.clock() - lastYield > 0.003 then RunService.Heartbeat:Wait(); lastYield = os.clock() end; return run == noTexRun and not Unloaded end
        if rescan or (enable and not next(noTexData)) then
            for _, folder in ipairs({ mapFolder or workspace:FindFirstChild("Map"), workspace:FindFirstChild("Cutscenes") }) do
                if folder then for _, part in ipairs(folder:GetDescendants()) do if part:IsA("BasePart") and noTexData[part] == nil then noTexData[part] = part.Material end; if not yield() then return end end end
            end
        end
        for part, orig in pairs(noTexData) do if part.Parent then part.Material = enable and Enum.Material.Plastic or orig end; if not yield() then return end end
    end)
end

local antiLag = { active = false, textures = {}, effects = {}, skies = {}, atmos = {}, materials = {}, partSet = setmetatable({}, { __mode = "k" }), lighting = nil, cc = nil, conns = {} }
local function isCharPart(part)
    local model = part:FindFirstAncestorOfClass("Model"); if not model then return false end
    if model:FindFirstChildOfClass("Humanoid") then return true end
    local ok4, p = pcall(function() return Players:GetPlayerFromCharacter(model) end); return ok4 and p ~= nil
end
local function stripPartAL(part)
    if antiLag.partSet[part] or isCharPart(part) then return end
    antiLag.partSet[part] = true
    table.insert(antiLag.materials, { inst = part, material = part.Material, castShadow = part.CastShadow, reflectance = part.Reflectance })
    pcall(function() part.Material = Enum.Material.SmoothPlastic; part.CastShadow = false; part.Reflectance = 0; if part:IsA("MeshPart") then part.TextureID = "" end end)
end
local function stripInstAL(inst)
    if not antiLag.active then return end
    local cls = inst.ClassName
    if cls == "Decal" or cls == "Texture" then
        local ok5, tex = pcall(function() return inst.Texture end)
        if ok5 and tex ~= "" then table.insert(antiLag.textures, { inst = inst, prop = "Texture", old = tex }); pcall(function() inst.Texture = "" end) end
    elseif cls == "MeshPart" then
        local ok6, tex = pcall(function() return inst.TextureID end)
        if ok6 and tex ~= "" then table.insert(antiLag.textures, { inst = inst, prop = "TextureID", old = tex }); pcall(function() inst.TextureID = "" end) end
    elseif cls == "SpecialMesh" then
        if inst.TextureId ~= "" then table.insert(antiLag.textures, { inst = inst, prop = "TextureId", old = inst.TextureId }); pcall(function() inst.TextureId = "" end) end
    elseif cls == "SurfaceAppearance" then
        local ok7, m = pcall(function() return inst.ColorMap end)
        if ok7 and m ~= "" then table.insert(antiLag.textures, { inst = inst, prop = "ColorMap", old = m }); pcall(function() inst.ColorMap = "" end) end
    elseif cls == "ParticleEmitter" or cls == "Smoke" or cls == "Fire" or cls == "Sparkles" or cls == "Beam" or cls == "Trail" or cls == "Highlight" or cls == "PointLight" or cls == "SpotLight" or cls == "SurfaceLight" then
        local ok8, en = pcall(function() return inst.Enabled end)
        if ok8 and en then table.insert(antiLag.effects, inst); pcall(function() inst.Enabled = false end) end
    elseif cls == "Sky" then
        local rec2 = { inst = inst, faces = {}, stars = inst.StarCount, bodies = inst.CelestialBodiesShown }
        for _, prop in ipairs({ "SkyboxBk","SkyboxDn","SkyboxFt","SkyboxLf","SkyboxRt","SkyboxUp" }) do rec2.faces[prop] = inst[prop]; pcall(function() inst[prop] = "" end) end
        pcall(function() inst.StarCount = 0; inst.CelestialBodiesShown = false end); table.insert(antiLag.skies, rec2)
    elseif cls == "Atmosphere" then
        table.insert(antiLag.atmos, { inst = inst, density = inst.Density }); pcall(function() inst.Density = 0 end)
    end
    if inst:IsA("BasePart") then stripPartAL(inst) end
end
local function applyGrayLighting()
    local L = Lighting
    antiLag.lighting = { Ambient = L.Ambient, OutdoorAmbient = L.OutdoorAmbient, Brightness = L.Brightness, ClockTime = L.ClockTime, FogColor = L.FogColor, FogStart = L.FogStart, FogEnd = L.FogEnd, GlobalShadows = L.GlobalShadows }
    L.Ambient = Color3.fromRGB(72,74,84); L.OutdoorAmbient = Color3.fromRGB(84,88,100)
    L.Brightness = 1.1; L.ClockTime = 14; L.FogColor = Color3.fromRGB(104,106,118)
    L.FogStart = 0; L.FogEnd = 100000; L.GlobalShadows = false
    for _, eff in ipairs(L:GetChildren()) do
        if eff:IsA("PostEffect") and eff.Name ~= "VelaBlur" and eff.Name ~= "MingoAntiLagGray" then
            if eff.Enabled then table.insert(antiLag.effects, eff); pcall(function() eff.Enabled = false end) end
        elseif eff:IsA("Atmosphere") then
            table.insert(antiLag.atmos, { inst = eff, density = eff.Density }); pcall(function() eff.Density = 0 end)
        end
    end
    local cc2 = Instance.new("ColorCorrectionEffect"); cc2.Name = "MingoAntiLagGray"; cc2.Brightness = 0; cc2.Contrast = 0; cc2.Saturation = 0
    cc2.TintColor = Color3.fromRGB(225,228,238); cc2.Parent = L; antiLag.cc = cc2
    tween(cc2, 0.55, { Brightness = 0.03, Contrast = 0.05, Saturation = -0.5 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
end
local function restoreAntiLag()
    for _, rec in ipairs(antiLag.textures) do pcall(function() rec.inst[rec.prop] = rec.old end) end
    for _, eff in ipairs(antiLag.effects) do pcall(function() eff.Enabled = true end) end
    for _, sky in ipairs(antiLag.skies) do
        for prop, val in pairs(sky.faces) do pcall(function() sky.inst[prop] = val end) end
        pcall(function() sky.inst.StarCount = sky.stars; sky.inst.CelestialBodiesShown = sky.bodies end)
    end
    for _, rec in ipairs(antiLag.atmos) do pcall(function() rec.inst.Density = rec.density end) end
    for _, rec in ipairs(antiLag.materials) do pcall(function() rec.inst.Material = rec.material; rec.inst.CastShadow = rec.castShadow; rec.inst.Reflectance = rec.reflectance end) end
    antiLag.materials = {}; antiLag.partSet = setmetatable({}, { __mode = "k" })
    if antiLag.cc then pcall(function() antiLag.cc:Destroy() end); antiLag.cc = nil end
    if antiLag.lighting then for prop, val in pairs(antiLag.lighting) do pcall(function() Lighting[prop] = val end) end; antiLag.lighting = nil end
    antiLag.textures = {}; antiLag.effects = {}; antiLag.skies = {}; antiLag.atmos = {}
end
local function setAntiLag(on, silent)
    on = on and true or false
    if on == antiLag.active then return end
    antiLag.active = on
    if on then
        antiLag.textures={}; antiLag.effects={}; antiLag.skies={}; antiLag.atmos={}; antiLag.materials={}; antiLag.partSet=setmetatable({},{ __mode="k" })
        applyGrayLighting()
        for _, inst in ipairs(workspace:GetDescendants()) do stripInstAL(inst) end
        for _, inst in ipairs(Lighting:GetDescendants()) do stripInstAL(inst) end
        table.insert(antiLag.conns, connectSignal(workspace.DescendantAdded, stripInstAL))
        table.insert(antiLag.conns, connectSignal(Lighting.DescendantAdded, stripInstAL))
    else
        for _, conn in ipairs(antiLag.conns) do disconnectConn(conn) end
        antiLag.conns = {}; restoreAntiLag()
    end
end

local MotionBlur = { blur = nil, conn = nil, lastCF = nil, currentBlur = 0 }
MotionBlur.getBlur = function()
    if MotionBlur.blur and MotionBlur.blur.Parent then return MotionBlur.blur end
    local b = Lighting:FindFirstChild("MingoMotionBlur")
    if not (b and b:IsA("BlurEffect")) then b = Instance.new("BlurEffect"); b.Name = "MingoMotionBlur" end
    b.Size = 0; b.Parent = Lighting; MotionBlur.blur = b; return b
end
MotionBlur.step = function(dt)
    local cam3 = workspace.CurrentCamera; if not cam3 then return end
    local cf2 = cam3.CFrame
    if not MotionBlur.lastCF then MotionBlur.lastCF = cf2; return end
    local prev = MotionBlur.lastCF
    local rotAngle = math.acos(math.clamp(prev.LookVector:Dot(cf2.LookVector), -1, 1))
    local rotSpeed = dt > 0 and (rotAngle / dt) or 0
    local moveDist = (cf2.Position - prev.Position).Magnitude
    local moveSpeed = dt > 0 and (moveDist / dt) or 0
    local intensity = math.clamp(Settings.Visuals.MotionBlur.Intensity or 10, 1, 30)
    local target = math.clamp(rotSpeed * 1.5 * (intensity / 10) + math.max(0, (moveSpeed - 20) * 0.04), 0, intensity)
    MotionBlur.currentBlur = MotionBlur.currentBlur + (target - MotionBlur.currentBlur) * math.clamp(dt * 15, 0, 1)
    if MotionBlur.currentBlur < 0.05 then MotionBlur.currentBlur = 0 end
    MotionBlur.getBlur().Size = MotionBlur.currentBlur; MotionBlur.lastCF = cf2
end
MotionBlur.set = function(on)
    disconnectConn(MotionBlur.conn); MotionBlur.conn = nil; MotionBlur.lastCF = nil; MotionBlur.currentBlur = 0
    if on then MotionBlur.getBlur().Size = 0; MotionBlur.conn = connectSignal(RunService.RenderStepped, MotionBlur.step)
    else if MotionBlur.blur then pcall(function() MotionBlur.blur:Destroy() end); MotionBlur.blur = nil end; local old2 = Lighting:FindFirstChild("MingoMotionBlur"); if old2 then pcall(function() old2:Destroy() end) end end
end
end -- END CHUNK 5

do -- CHUNK 6: SKY, ATMO, UI HELPERS, ESP
