local function getGuiParent()
    local pg = player.PlayerGui or player:FindFirstChild("PlayerGui")
    if pg then return pg end
    local ok, hui = pcall(function() return gethui() end)
    if ok and hui then return hui end
    local ok2, core = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and core then return core end
    return player:WaitForChild("PlayerGui", 10)
end

local gui = Instance.new("ScreenGui")
gui.Name = "MingoUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Enabled = true
gui.DisplayOrder = 2147483647
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = getGuiParent()
pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
pcall(function() if protect_gui then protect_gui(gui) end end)

task.spawn(function()
    while not Unloaded do
        task.wait(0.5)
        if not gui.Parent then pcall(function() gui.Parent = getGuiParent() end) end
    end
end)

local function tween(obj, dur, props, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(dur, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end
local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
    return c
end
local function stroke(parent, thick, transparency, role)
    local s = Instance.new("UIStroke")
    s.Color = Palette.Border
    s.Thickness = thick
    s.Transparency = transparency
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s:SetAttribute("ThemeRole", role or "border")
    s.Parent = parent
    return s
end

local function notify(text)
    local toast = Instance.new("TextLabel")
    toast.Size = UDim2.fromOffset(280, 30)
    toast.Position = UDim2.new(0.5, 0, 0, 4)
    toast.AnchorPoint = Vector2.new(0.5, 0)
    toast.BackgroundColor3 = Color3.fromRGB(12, 17, 38)
    toast.BackgroundTransparency = 0.08
    toast.Text = text
    toast.TextColor3 = Color3.fromRGB(235, 240, 255)
    toast.Font = FONT
    toast.TextSize = 12
    toast.ZIndex = 120
    toast.Parent = gui
    corner(toast, 10)
    stroke(toast, 1, 0.35)
    tween(toast, 0.25, { Position = UDim2.new(0.5, 0, 0, 14) })
    task.delay(2.2, function()
        if not toast.Parent then return end
        local fade = tween(toast, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
        fade.Completed:Connect(function() toast:Destroy() end)
    end)
end

