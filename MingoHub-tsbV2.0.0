--  AUTOBLOCK UPGRADE: animation-based hooks
-- ═══════════════════════════════════════════════════════════
local mingoM1Ids = {
    ["10469493270"]=true, ["10469630950"]=true, ["10469639222"]=true,
    ["10469643643"]=true, ["14004222985"]=true, ["13997092940"]=true,
    ["14001963401"]=true, ["14136436157"]=true, ["13370310513"]=true,
    ["13390230973"]=true, ["13378751717"]=true, ["13378708199"]=true,
    ["15259161390"]=true, ["15240216931"]=true, ["15240176873"]=true,
    ["15162694192"]=true, ["89044067797964"]=true, ["74334194837918"]=true,
    ["94353845974131"]=true, ["80601239139774"]=true,
    ["13532562418"]=true, ["13532600125"]=true, ["13532604085"]=true,
    ["13294471966"]=true, ["125361499827663"]=true, ["105701432344953"]=true,
    ["104293439261333"]=true, ["114460992057353"]=true, ["111644455066361"]=true,
    ["112778933066374"]=true, ["80488470577181"]=true,
    ["13491635433"]=true, ["13296577783"]=true, ["13295919399"]=true,
    ["13295936866"]=true, ["16515503507"]=true, ["16515520431"]=true,
    ["16515448089"]=true, ["16552234590"]=true,
    ["17325510002"]=true, ["17325513870"]=true, ["17325522388"]=true,
    ["17325537719"]=true, ["17889458563"]=true, ["17889461810"]=true,
    ["17889471098"]=true, ["17889290569"]=true,
    ["123005629431309"]=true, ["100059874351664"]=true,
    ["104895379416342"]=true, ["134775406437626"]=true,
    ["122482492364036"]=true, ["125882667406347"]=true,
    ["134822631853770"]=true, ["76602138940033"]=true,
    ["13379003796"]=true, ["10503381238"]=true, ["10470104242"]=true,
}
local mingoDashIds = {
    [mingoAnimIDs.frontDash]=true,
    [mingoAnimIDs.rsideDash]=true,
    [mingoAnimIDs.lsideDash]=true,
}
local mingoHookedModels = setmetatable({}, { __mode = "k" })

local function mingoHookModel(model)
    if not model or model == currentCharacter or mingoHookedModels[model] then return end
    local ok = model:IsA("Model")
    if not ok then return end
    mingoHookedModels[model] = true
    task.spawn(function()
        local hum  = model:WaitForChild("Humanoid", 10)
        local anim = hum and hum:WaitForChild("Animator", 10)
        if not anim then return end
        mingoConnect(anim.AnimationPlayed, function(track)
            if mingoUnloaded or not Settings.Autoblock.Enabled then return end
            if model == currentCharacter then return end
            local id = track.Animation and track.Animation.AnimationId:match("%d+")
            if not id then return end
            if mingoM1Ids[id] then
                task.spawn(function()
                    -- trigger MingoHub's existing watchEnemyModel via a synthetic "M1ing" child
                    -- (MingoHub already handles this via DescendantAdded — we do the anim route too)
                    local hrp = model:FindFirstChild("HumanoidRootPart")
                    if hrp and currentRootPart then
                        local dist = (hrp.Position - currentRootPart.Position).Magnitude
                        if dist <= (Settings.Autoblock.Range or 9) + 20 then
                            -- create a temporary tag to trigger MingoHub's existing watchEnemyModel
                            local tag = Instance.new("StringValue")
                            tag.Name = "M1ing"; tag.Parent = model
                            task.wait(); pcall(function() tag:Destroy() end)
                        end
                    end
                end)
            elseif mingoDashIds[id] and Settings.Autoblock.DashPredict then
                local hrp = model:FindFirstChild("HumanoidRootPart")
                if hrp and currentRootPart
                    and (hrp.Position - currentRootPart.Position).Magnitude <= 45 then
                    -- trigger dash predict via existing mechanism
                    local tag = Instance.new("StringValue")
                    tag.Name = "dodgevelocity"; tag.Parent = model
                    task.wait(0.01); pcall(function() tag:Destroy() end)
                end
            end
        end)
    end)
end

-- ═══════════════════════════════════════════════════════════
--  MACROS: EmoteDash, m1Reset, TechHelper, ExtraTechHelper
-- ═══════════════════════════════════════════════════════════
local KeyW = Enum.KeyCode.W
local KeyA = Enum.KeyCode.A
local KeyS = Enum.KeyCode.S
local KeyD = Enum.KeyCode.D
local KeyQ = Enum.KeyCode.Q
local KeySpace = Enum.KeyCode.Space

local function mingoFireM1Click()
    if not currentCommunicate then return end
    local vp = workspace.CurrentCamera
        and workspace.CurrentCamera.ViewportSize
        or Vector2.new(400, 300)
    local hx, hy = math.floor(vp.X/2), math.floor(vp.Y/2)
    mingoRandomWait()
    if mingoVIM then
        pcall(function() mingoVIM:SendMouseButtonEvent(hx, hy, 0, true,  game, 0) end)
        mingoRandomWait()
        pcall(function() mingoVIM:SendMouseButtonEvent(hx, hy, 0, false, game, 0) end)
    else
        currentCommunicate:FireServer(leftclick.holdM1)
        task.wait()
        currentCommunicate:FireServer(leftclick.releaseM1)
    end
end

local function mingoSetAutoRotateVIM(numKey)
    mingoPressKey(numKey); mingoRandomWait(0.01); mingoReleaseKey(numKey)
    local sAutoUnequip = player:GetAttribute("S_AutoUnequip")
    if not sAutoUnequip and mingoVIM then
        local vp = workspace.CurrentCamera
            and workspace.CurrentCamera.ViewportSize or Vector2.new(400,300)
        local hx, hy = math.floor(vp.X/2), math.floor(vp.Y/2)
        mingoRandomWait()
        pcall(function() mingoVIM:SendMouseButtonEvent(hx, hy, 0, true,  game, 0) end)
        mingoRandomWait()
        pcall(function() mingoVIM:SendMouseButtonEvent(hx, hy, 0, false, game, 0) end)
    end
end

local function mingoExecEmoteDash()
    local cfg = Settings.Macro2.EmoteDash
    if not cfg.Enabled then return end
    if not (currentHumanoid and currentRootPart and currentHumanoid.Health > 0) then return end
    mingoReleaseKey(KeyW); mingoReleaseKey(KeyS)
    if cfg.Type == "Straight" then mingoLockAngles(90) end
    if cfg.Type == "Straight" or cfg.Type == "Right" then
        mingoPressKey(KeyD)
    elseif cfg.Type == "Left" then
        mingoPressKey(KeyA)
    end
    currentHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    task.wait(0.005)
    mingoTapKey(KeyQ)
    task.wait(cfg.Delay)
    local dv = currentRootPart:FindFirstChild("dodgevelocity")
    if dv then
        dv:Destroy()
        -- stop side-dash anims
        local anim = currentHumanoid and currentHumanoid:FindFirstChildOfClass("Animator")
        if anim then
            for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                local id = track.Animation and track.Animation.AnimationId:match("%d+")
                if id == mingoAnimIDs.rsideDash or id == mingoAnimIDs.lsideDash then
                    track:Stop()
                end
            end
        end
    end
    mingoReleaseKey(KeyD); mingoReleaseKey(KeyA)
    if cfg.Type == "Straight" then mingoLockAngles(-90) end
end

local function mingoExecM1Reset()
    local pp = pingScaledDelay(1000) + 0.05
    mingoFireM1Click()
    task.wait(pp)
    mingoLockAngles(-90)
    mingoPressKey(KeyD)
    mingoTapKey(KeyQ)
    task.wait(pp)
    mingoReleaseKey(KeyD)
    mingoLockAngles(90)
    mingoFireFrontDash()
end

local function mingoExecTechHelper(techName)
    if not Settings.Macro2.TechHelper.Enabled or techName == "" then return end
    local pp = pingScaledDelay(1000) + 0.05
    if techName == "Humbled Twisted" then
        mingoFireM1Click()
        task.wait(pp - 0.05)
        mingoFireFrontDash()
        task.wait(0.075)
        mingoSmoothRotateCam(-90, 0.1)
        task.wait(0.1)
        mingoSmoothRotateCam(180, 0.1)
        task.wait(0.125)
        mingoSmoothRotateCam(-90, 0.1)
    elseif techName == "Loop Dash" then
        mingoPressKey(KeySpace)
        mingoFireM1Click()
        mingoReleaseKey(KeySpace)
        task.wait(pp)
        mingoFireFrontDash()
        mingoLockAngles(45)
        mingoSmoothRotateCam(340, 0.4 - pp)
    elseif techName == "Instant Lee" then
        mingoFireM1Click()
        task.wait(pp - 0.05)
        mingoFireFrontDash()
        task.wait(pp)
        mingoLockAngles(145)
        task.wait(0.075 + pp)
        mingoSmoothRotateCam(-175, 0.1)
    elseif techName == "Oreo Tech" then
        mingoPressKey(KeySpace)
        mingoFireM1Click()
        mingoReleaseKey(KeySpace)
        task.wait(pp)
        mingoLockAngles(180)
        mingoFireFrontDash()
        task.wait(0.18 + pp)
        mingoLockAngles(180)
    elseif techName == "Lix Tech" then
        mingoPressKey(KeySpace)
        mingoFireM1Click()
        mingoReleaseKey(KeySpace)
        task.wait(pp)
        mingoFireFrontDash()
        task.wait(0.16 + pp)
        mingoLockAngles(180)
    end
end

local function mingoLethalElapsed()
    local anim = currentHumanoid and currentHumanoid:FindFirstChildOfClass("Animator")
    if not anim then return nil end
    for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
        local id = track.Animation and track.Animation.AnimationId:match("%d+")
        if id == Settings.AutoLethal.HitAnim then return track.TimePosition end
    end
    return nil
end

local function mingoExecExtraTech()
    if not Settings.Macro2.ExtraTechHelper.Enabled then return end
    local techName = Settings.Macro2.ExtraTechHelper.Tech
    if techName == "" then return end
    local pp = pingScaledDelay(1000) + 0.05
    -- find target
    local tgt = mingoLethalState.getTarget(35)
    local hrp = tgt and tgt:FindFirstChild("HumanoidRootPart")

    if techName == "Instant Lethal Shift Lock" then
        local t = pingScaledDelay(1000) + 0.05
        local elapsed = mingoLethalElapsed()
        if elapsed then
            task.wait(math.max(0, t - elapsed))
        else
            mingoSetAutoRotateVIM(Enum.KeyCode.Two)
            task.wait(t)
        end
        mingoPressKey(KeySpace)
        mingoFireFrontDash()
        task.wait(0.18 + pp)
        mingoLockAngles(180)
        mingoReleaseKey(KeySpace)
    elseif techName == "Instant Lethal Loop Dash" then
        local t = pingScaledDelay(1000) + 0.05
        local elapsed = mingoLethalElapsed()
        if elapsed then
            task.wait(math.max(0, t - elapsed))
        else
            mingoSetAutoRotateVIM(Enum.KeyCode.Two)
            task.wait(t)
        end
        mingoPressKey(KeySpace)
        mingoFireFrontDash()
        task.wait(0.05 - pp)
        mingoLockAngles(45)
        mingoSmoothRotateCam(275, 0.25)
        mingoReleaseKey(KeySpace)
    end
end

-- ═══════════════════════════════════════════════════════════
--  AUTO TECH UPGRADE: MissChance, Method, SupaMethod, etc.
-- ═══════════════════════════════════════════════════════════
-- Wire magnet trigger into existing tech handler TECH_HANDLERS
-- by wrapping each handler with a magnet post-call
local function mingoWrapTechHandlers()
    local orig = {}
    for key, fn in pairs(TECH_HANDLERS) do
        orig[key] = fn
        TECH_HANDLERS[key] = function(target, hrp, hum)
            -- miss chance from new config
            if Settings.AutoLethal and Settings.AutoTech.MissChance
                and Settings.AutoTech.MissChance > 0
                and math.random(1,100) <= Settings.AutoTech.MissChance then
                return
            end
            orig[key](target, hrp, hum)
            -- fire magnet trigger after tech
            task.spawn(mingoMagnetTechTrigger, key, hrp)
        end
    end
end
task.defer(mingoWrapTechHandlers)

-- ═══════════════════════════════════════════════════════════
--  CHARACTER ADD / REMOVE HOOKS (mingoExt layer)
-- ═══════════════════════════════════════════════════════════
local function mingoOnCharAdded(char)
    -- hook for scope
    if Settings.Zombie.CameraLockBypass then
        -- add zombiebypass folder
        local existing = char:FindFirstChild("MingoZombieBypass")
        if not existing then
            local f = Instance.new("Folder")
            f.Name = "MingoZombieBypass"
            f.Parent = char
        end
        if workspace.CurrentCamera
            and workspace.CurrentCamera.CameraType ~= Enum.CameraType.Custom then
            workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
        end
    end
    mingoScopeHookChar(char)
    -- re-apply FOV
    pcall(function()
        mingoSetShadow(workspace.CurrentCamera, "FieldOfView", Settings.MingoVisuals.FOV)
    end)
    -- self-chams re-apply
    if Settings.MingoVisuals.SelfChams.Enabled then
        task.spawn(function()
            task.wait(0.3)
            if currentCharacter == char then
                mingoApplySelfChams()
                task.wait(0.5)
                if currentCharacter == char then mingoApplySelfChams() end
            end
        end)
    end
    -- custom ultbar
    task.spawn(pcall, mingoSetupUltbar)
    -- re-apply rage attrs
    if Settings.Rage.NoSideDashCooldown then
        pcall(function() char:SetAttribute("CustomSideDashCooldown", 0) end)
        task.defer(function() mingoSetDashSpoof(true) end)
    end
    -- sky / atmosphere handled by MingoHub already
    -- effects-color sweep
    task.delay(0.5, function()
        if char.Parent and mingoOnDescendantAdded then
            for _, d in ipairs(char:GetDescendants()) do
                pcall(mingoOnDescendantAdded, d)
            end
        end
    end)
    -- lethal anim hook
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local anim = hum and hum:FindFirstChildOfClass("Animator")
    if anim then
        mingoConnect(anim.AnimationPlayed, mingoLethalState.onAnim)
    end
    -- scope sync
    mingoScopeSync()
end

local function mingoOnCharRemoving()
    mingoScopeStop()
    mingoMagnetStop()
    mingoFreezeRelease()
    mingoChamsState.mats = {}
    if mingoLethalState.highlight then
        pcall(function() mingoLethalState.highlight:Destroy() end)
        mingoLethalState.highlight = nil
    end
end

-- ═══════════════════════════════════════════════════════════
--  GLOBAL HEARTBEAT: rage toggles, FOV guard, Chams tick
-- ═══════════════════════════════════════════════════════════
mingoConnect(RunService.Heartbeat, function()
    if mingoUnloaded then return end

    -- no-side-dash-cooldown
    if Settings.Rage.NoSideDashCooldown and currentCharacter then
        if currentCharacter:GetAttribute("CustomSideDashCooldown") ~= 0 then
            pcall(currentCharacter.SetAttribute, currentCharacter, "CustomSideDashCooldown", 0)
        end
        for _, c in ipairs(currentCharacter:GetChildren()) do
            if c.Name == "InDash" or c.Name == "UsedDash" or c.Name == "SideDashCooldown" then
                pcall(c.Destroy, c)
            end
        end
        mingoSetDashSpoof(true)
    end

    -- AlwaysJump / NoFatigue
    if (Settings.Rage.AlwaysJump or Settings.Rage.NoFatigue) and currentHumanoid then
        if currentHumanoid.JumpPower < 50 and not (currentCharacter
            and currentCharacter:FindFirstChild("NoJump")) then
            pcall(function() currentHumanoid.JumpPower = 50 end)
        end
    end

    -- FOV guard
    local cam = workspace.CurrentCamera
    if cam and Settings.MingoVisuals.FOV and cam.FieldOfView ~= Settings.MingoVisuals.FOV then
        pcall(function() cam.FieldOfView = Settings.MingoVisuals.FOV end)
    end

    -- saturation guard (handled via mingoCC)
end)

-- NoShadows guard
mingoConnect(Lighting:GetPropertyChangedSignal("GlobalShadows"), function()
    if Settings.MingoVisuals.NoShadows and Lighting.GlobalShadows then
        Lighting.GlobalShadows = false
    end
end)

-- camera-bypass guard
local mingoBypassConn
local function mingoSetCamBypass(on)
    if mingoBypassConn then mingoDisconnect(mingoBypassConn); mingoBypassConn = nil end
    if not on then return end
    mingoBypassConn = mingoConnect(workspace.CurrentCamera
        :GetPropertyChangedSignal("CameraType"), function()
        if Settings.Zombie.CameraLockBypass then
            workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
        end
    end)
end

-- Live-folder events
if mingoWorld.Live then
    for _, m in ipairs(mingoWorld.Live:GetChildren()) do
        mingoHookModel(m)
    end
    mingoConnect(mingoWorld.Live.ChildAdded, function(c)
        mingoHookModel(c)
    end)
    mingoConnect(mingoWorld.Live.DescendantAdded, function(d)
        task.spawn(mingoOnLiveChildAdded, d)
    end)
end

-- Player hooks
local function mingoSetupPlayer(plr)
    mingoConnect(plr.CharacterAdded, function(char)
        if plr == Players.LocalPlayer then return end
        mingoConnect(char.DescendantAdded, mingoOnLiveChildAdded)
        task.delay(0.5, function()
            if char.Parent then
                for _, d in ipairs(char:GetDescendants()) do
                    pcall(mingoOnDescendantAdded, d)
                end
            end
        end)
    end)
    mingoConnect(plr.CharacterAdded, function(char)
        if plr == Players.LocalPlayer then return end
        -- ESP notifications (ult, death counter) — MingoHub handles via hookModel
        -- just hook anim for AB
        task.spawn(function()
            local live = mingoWorld.Live
            if live then
                local liveChar = live:FindFirstChild(plr.Name)
                if liveChar then mingoHookModel(liveChar) end
            end
        end)
    end)
    if plr ~= Players.LocalPlayer then
        mingoClassifyPlayer(plr)
    end
end

for _, plr in ipairs(Players:GetPlayers()) do
    mingoSetupPlayer(plr)
end
mingoConnect(Players.PlayerAdded, mingoSetupPlayer)
mingoConnect(Players.PlayerRemoving, function(plr)
    mingoPlayerFrames[plr.Name] = nil
end)

-- Local character hooks
if currentCharacter then task.spawn(mingoOnCharAdded, currentCharacter) end
mingoConnect(player.CharacterAdded, function(char)
    task.spawn(mingoOnCharAdded, char)
end)
mingoConnect(player.CharacterRemoving, function()
    pcall(mingoOnCharRemoving)
end)

-- Input: freeze hold
mingoConnect(UIS.InputBegan, function(input, gpe)
    if gpe or UIS:GetFocusedTextBox() then return end
    if not Settings.Rage.FreezeHold then return end
    if mingoFreezeKeyBtn then
        local cur = mingoFreezeKeyBtn.boundKey
        if cur and input.KeyCode == cur then
            mingoFreezeHold()
        end
    end
end)
mingoConnect(UIS.InputEnded, function(input)
    if mingoFreezeState.held and mingoFreezeKeyBtn then
        local cur = mingoFreezeKeyBtn.boundKey
        if cur and input.KeyCode == cur then
            mingoFreezeRelease()
        end
    end
end)

-- NoDashEndLag
mingoConnect(UIS.InputBegan, function(input, gpe)
    if gpe then return end
    if input.KeyCode ~= KeyQ then return end
    if not currentCharacter then return end
    if not UIS:IsKeyDown(Enum.KeyCode.D) and not UIS:IsKeyDown(Enum.KeyCode.A)
        and Settings.Misc.NoDashEndLag
        and not UIS:IsKeyDown(KeyS)
        and currentCharacter:FindFirstChild("UsedDash") then
        mingoFireFrontDash()
    end
end)

-- Spinbot zombie loop
task.spawn(function()
    while not mingoUnloaded do
        task.wait(0.2)
        if Settings.Zombie.SniperSpinbot then
            mingoScope.holding = mingoIsSniperView(currentCharacter)
        end
        if Settings.Zombie.CameraLockBypass then
            local char = currentCharacter
            if char then
                if not char:FindFirstChild("MingoZombieBypass") then
                    local f = Instance.new("Folder")
                    f.Name = "MingoZombieBypass"
                    f.Parent = char
                end
            end
            if workspace.CurrentCamera
                and workspace.CurrentCamera.CameraType ~= Enum.CameraType.Custom then
                workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
            end
        end
    end
end)

-- ═══════════════════════════════════════════════════════════
--  UNLOAD
-- ═══════════════════════════════════════════════════════════
mingoExt.Unload = function()
    if mingoUnloaded then return end
    mingoUnloaded = true
    mingoDisconnectAll()
    mingoUnbindAll()
    mingoMagnetStop()
    mingoFreezeRelease()
    mingoLockOn.stop()
    mingoScopeStop()
    if mingoSpinConn then pcall(function() mingoSpinConn:Disconnect() end) end
    if mingoFovConn   then pcall(function() mingoFovConn:Disconnect()   end) end
    if mingoBypassConn then pcall(function() mingoBypassConn:Disconnect() end) end
    if mingoFovGui    then pcall(function() mingoFovGui:Destroy()        end) end
    if mingoLockOnMark then pcall(function() mingoLockOnMark:Destroy()   end) end
    if mingoLethalState.highlight then
        pcall(function() mingoLethalState.highlight:Destroy() end)
    end
    -- restore shadow properties
    for _, c in ipairs(mingoDashRJ) do pcall(function() c:Disconnect() end) end
    mingoRestoreChams()
    mingoRestoreAll()
    -- restore FOV
    pcall(function() workspace.CurrentCamera.FieldOfView = 70 end)
    -- restore NoShadows / GlobalShadows
    pcall(function()
        if Settings.MingoVisuals.NoShadows then
            Lighting.GlobalShadows = true
        end
    end)
    -- restore dash spoof
    mingoSetDashSpoof(false)
    -- restore FallenPartsDestroyHeight
    pcall(function() workspace.FallenPartsDestroyHeight = mingoDefaultDestroyHeight end)
    -- release held keys
    for _, kc in ipairs({KeyW, KeyA, KeyS, KeyD, KeyQ, KeySpace,
        Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}) do
        pcall(mingoReleaseKey, kc)
    end
    -- destroy scope gui
    if mingoScope.gui then pcall(function() mingoScope.gui:Destroy() end) end
end

-- ═══════════════════════════════════════════════════════════
--  EXPOSE mingoExt to global scope for UI section below
-- ═══════════════════════════════════════════════════════════
_G.mingoExt        = mingoExt
_G.mingoLockOn     = mingoLockOn
_G.mingoMagnetExecute = mingoMagnetExecute
_G.mingoFreezeKeyBtn  = nil  -- set by UI
_G.mingoApplySelfChams = mingoApplySelfChams
_G.mingoUpdateFovCircle = mingoUpdateFovCircle
_G.mingoPendUltbar = mingoPendUltbar
_G.mingoSetDashSpoof = mingoSetDashSpoof
_G.mingoSetScopeSpinbot = mingoSetScopeSpinbot
_G.mingoScopeSync = mingoScopeSync
_G.mingoSetCamBypass = mingoSetCamBypass
_G.mingoSDARun = mingoSDARun
_G.mingoExecEmoteDash = mingoExecEmoteDash
_G.mingoExecM1Reset = mingoExecM1Reset
_G.mingoExecTechHelper = mingoExecTechHelper
_G.mingoExecExtraTech = mingoExecExtraTech
_G.mingoDashBoost = mingoDashBoost
_G.mingoOnDescendantAdded = mingoOnDescendantAdded
_G.mingoRefreshEffectsColor = mingoRefreshEffectsColor
