    -- ═══════════════════════════════════════════
    --  MAGNET  (Main tab)
    -- ═══════════════════════════════════════════
    addSection(main, "Magnet")
    do
        local mg = Settings.Misc.Magnet
        addToggle(main, "Enabled##MAG", "Toggle magnet pull", mg.Enabled, function(on)
            mg.Enabled = on
            if not on then mingoMagnetStop() end
        end, function() return mg.Enabled end)
        addKeybind(main, "Magnet Keybind", "Hold/tap to activate pull", nil, function()
            if mg.Enabled then task.spawn(mingoMagnetExecute) end
        end, function(kc) mg.Keybind = kc end)
        addDropdown(main, "Tech Trigger##MAG", "Fire magnet after which tech", {
            "Disabled", "Loop Dash v2", "Custom Dash", "Custom Dash v2", "All 3"
        }, mg.TechTrigger, function(v) mg.TechTrigger = v end, function() return mg.TechTrigger end)
        addSlider(main, "Tech Delay ms##MAG", "0-500", 0, 500, mg.TechDelay or 0, function(v)
            mg.TechDelay = v
        end, function() return mg.TechDelay or 0 end)
        addSlider(main, "Duration ms##MAG", "50-2000", 50, 2000, math.floor((mg.Duration or 0.5)*1000), function(v)
            mg.Duration = v / 1000
        end, function() return math.floor((mg.Duration or 0.5)*1000) end)
        addSlider(main, "Height##MAG", "0-10", 0, 10, mg.Height or 2, function(v)
            mg.Height = v
        end, function() return mg.Height or 2 end)
        addSlider(main, "Strength##MAG", "1-150", 1, 150, mg.Strength or 50, function(v)
            mg.Strength = v
        end, function() return mg.Strength or 50 end)
        addSlider(main, "Smoothness##MAG", "0-100", 0, 100, math.floor((mg.Smoothness or 0.65)*100), function(v)
            mg.Smoothness = v / 100
        end, function() return math.floor((mg.Smoothness or 0.65)*100) end)
        addSlider(main, "Max Distance##MAG", "Studs", 5, 400, mg.MaxDistance or 100, function(v)
            mg.MaxDistance = v
        end, function() return mg.MaxDistance or 100 end)
        addToggle(main, "Dash Cancel##MAG", "Kill inertia before pull", mg.DashCancel, function(on)
            mg.DashCancel = on
        end, function() return mg.DashCancel end)
    end

