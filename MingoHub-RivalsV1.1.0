        else
            btn.TextColor3 = Theme.TextDim; btn.BackgroundColor3 = Theme.Bg2
            local outline = tabButtonStrokes[name]
            if outline then outline.Color = Theme.Stroke; outline.Thickness = 0.85; outline.Transparency = 0.78 end
        end
    end
end

