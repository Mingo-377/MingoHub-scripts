end)

-- ==========================================================
-- GLASS DOCK
-- ==========================================================
local dockConnections = {}
local function disconnectDockInput()
    for _, connection in ipairs(dockConnections) do pcall(function() connection:Disconnect() end) end
    table.clear(dockConnections)
end

local function createGlassDock()
    if bubble and bubble.Parent then return bubble end
    local viewport = camera and camera.ViewportSize or screen.AbsoluteSize
    local uiScale = math.max(rootScale and rootScale.Scale or 1, 0.05)
    local localViewport = Vector2.new(viewport.X / uiScale, viewport.Y / uiScale)
    local dockW = math.clamp(localViewport.X * 0.48, 180, 212)
    local dockH = 56
    local startY = isMobile() and 64 or 18
    local startCenterX = localViewport.X * 0.5
    bubble = new("Frame", {Name="MingoHubGlassDock", Size=UDim2.fromOffset(dockW,dockH), Position=UDim2.fromOffset(startCenterX,startY), AnchorPoint=Vector2.new(0.5,0), BackgroundColor3=Color3.fromRGB(4,10,23), BackgroundTransparency=0.14, BorderSizePixel=0, Active=true, Visible=false, ZIndex=20, Parent=screen})
    corner(bubble, UDim.new(1, 0))
    local dockStroke = stroke(bubble, Neon.Cyan, 1.5); dockStroke.Transparency = 0.12
    new("UIGradient", {Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(5,38,55)),ColorSequenceKeypoint.new(0.42,Color3.fromRGB(5,13,30)),ColorSequenceKeypoint.new(1,Color3.fromRGB(37,7,45))}),Rotation=12,Parent=bubble})
    local arrowPad = new("Frame", {Name="MoveArrows", Size=UDim2.fromOffset(42,42), Position=UDim2.new(1,-7,0.5,0), AnchorPoint=Vector2.new(1,0.5), BackgroundColor3=Color3.fromRGB(0,104,127), BackgroundTransparency=0.22, BorderSizePixel=0, ZIndex=22, Parent=bubble})
    corner(arrowPad, UDim.new(1, 0))
    local arrowStroke = stroke(arrowPad, Neon.Cyan, 1); arrowStroke.Transparency = 0.16
    local function arrow(text, position)
        new("TextLabel", {Text=text,Font=Theme.FontBold,TextSize=11,TextColor3=Color3.fromRGB(240,254,255),BackgroundTransparency=1,Position=position,Size=UDim2.fromOffset(14,14),ZIndex=23,Parent=arrowPad})
    end
    arrow("↑", UDim2.new(0.5,-7,0,0)); arrow("↓", UDim2.new(0.5,-7,1,-14))
    arrow("←", UDim2.new(0,0,0.5,-7)); arrow("→", UDim2.new(1,-14,0.5,-7))
    new("TextLabel", {Text="MingoHub-Rivals",Font=Theme.FontBold,TextSize=14,TextColor3=Color3.fromRGB(245,252,255),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,Position=UDim2.new(0,16,0,0),Size=UDim2.new(1,-76,1,0),ZIndex=22,Parent=bubble})
    local dockScale = new("UIScale", {Scale=1, Parent=bubble})
    local hitbox = new("TextButton", {Name="DockInputHitbox",Text="",TextTransparency=1,BackgroundTransparency=1,BorderSizePixel=0,AutoButtonColor=false,Active=true,Selectable=true,Position=UDim2.fromScale(0,0),Size=UDim2.fromScale(1,1),ZIndex=30,Parent=bubble})
    local arrowGrip = new("TextButton", {Name="ArrowDragGrip",Text="",BackgroundTransparency=1,BorderSizePixel=0,AutoButtonColor=false,Active=true,Selectable=false,Position=arrowPad.Position,AnchorPoint=arrowPad.AnchorPoint,Size=arrowPad.Size,ZIndex=32,Parent=bubble})
    hitbox.MouseEnter:Connect(function() playTween(dockScale, {Scale=1.035}, 0.16); playTween(bubble, {BackgroundTransparency=0.035}, 0.16); playTween(arrowPad, {BackgroundTransparency=0.12}, 0.16) end)
    hitbox.MouseLeave:Connect(function() playTween(dockScale, {Scale=1}, 0.18); playTween(bubble, {BackgroundTransparency=0.10}, 0.18); playTween(arrowPad, {BackgroundTransparency=0.22}, 0.18) end)
    local dragging, dragMoved, dragStart, dragOrigin = false, false, nil, nil
    local activePointerType = nil
    local tapStart, tapPointerType, tapMoved = nil, nil, false
    local function reopenFromDock()
        if closed or not bubble or not bubble.Parent or not bubble.Visible then return end
        bubble.Visible = false
        task.spawn(function()
            local deadline = os.clock() + 1.5
            while not closed and animState ~= "idle" and os.clock() < deadline do task.wait() end
            if closed then return end
            if not main.Visible then pcall(animateShow) end
        end)
    end
    local function getDockViewport()
        local vp = camera and camera.ViewportSize or screen.AbsoluteSize
        local scale = math.max(rootScale and rootScale.Scale or 1, 0.05)
        return Vector2.new(vp.X / scale, vp.Y / scale)
    end
    local function clampDockPosition(centerX, top)
        local vp = getDockViewport()
        local width, height = bubble.Size.X.Offset, bubble.Size.Y.Offset
        local minCenter = width * 0.5 + 4
        local maxCenter = math.max(minCenter, vp.X - width * 0.5 - 4)
        local maxY = math.max(4, vp.Y - height - 4)
        return math.clamp(centerX, minCenter, maxCenter), math.clamp(top, 4, maxY)
    end
    local function beginTap(input)
        local t = input.UserInputType
        if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
        tapStart = Vector2.new(input.Position.X, input.Position.Y); tapPointerType = t; tapMoved = false
    end
    local function beginDrag(input)
        local t = input.UserInputType
        if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
        dragging = true; dragMoved = false; activePointerType = t
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        tapStart, tapPointerType = nil, nil
        local vp = getDockViewport()
        dragOrigin = Vector2.new(bubble.Position.X.Scale * vp.X + bubble.Position.X.Offset, bubble.Position.Y.Scale * vp.Y + bubble.Position.Y.Offset)
    end
    local function movePointer(input)
        local pointer = nil
        if activePointerType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement then pointer = Vector2.new(input.Position.X, input.Position.Y)
        elseif activePointerType == Enum.UserInputType.Touch and input.UserInputType == Enum.UserInputType.Touch then pointer = Vector2.new(input.Position.X, input.Position.Y) end
        if dragging and pointer and dragStart and dragOrigin then
            local scale = math.max(rootScale and rootScale.Scale or 1, 0.05)
            local delta = (pointer - dragStart) / scale
            if delta.Magnitude > 6 then dragMoved = true end
            if dragMoved then
                local cx, ty = clampDockPosition(dragOrigin.X + delta.X, dragOrigin.Y + delta.Y)
                bubble.Position = UDim2.fromOffset(cx, ty)
            end
        end
        if tapStart then
            local tp = nil
            if tapPointerType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement then tp = Vector2.new(input.Position.X, input.Position.Y)
            elseif tapPointerType == Enum.UserInputType.Touch and input.UserInputType == Enum.UserInputType.Touch then tp = Vector2.new(input.Position.X, input.Position.Y) end
            if tp and (tp - tapStart).Magnitude > 10 then tapMoved = true end
        end
    end
    local function endPointer(input)
        local rm = input.UserInputType == Enum.UserInputType.MouseButton1
        local rt = input.UserInputType == Enum.UserInputType.Touch
        if dragging then
            local match = (activePointerType == Enum.UserInputType.MouseButton1 and rm) or (activePointerType == Enum.UserInputType.Touch and rt)
            if match then
                dragging = false; local wasDragged = dragMoved
                dragMoved, dragStart, dragOrigin, activePointerType = false, nil, nil, nil
                if not wasDragged then reopenFromDock() end
            end
            return
        end
        local mt = (tapPointerType == Enum.UserInputType.MouseButton1 and rm) or (tapPointerType == Enum.UserInputType.Touch and rt)
        if mt then
            local shouldOpen = not tapMoved
            tapStart, tapPointerType, tapMoved = nil, nil, false
            if shouldOpen then reopenFromDock() end
        end
    end
    hitbox.InputBegan:Connect(beginTap)
    arrowGrip.InputBegan:Connect(beginDrag)
    if UserInputService then
        table.insert(dockConnections, UserInputService.InputChanged:Connect(movePointer))
        table.insert(dockConnections, UserInputService.InputEnded:Connect(endPointer))
    end
    bubble.AncestryChanged:Connect(function(_, parent) if parent == nil then disconnectDockInput() end end)
    return bubble
end

btnMin.Activated:Connect(function()
    if animState ~= "idle" or closed then return end
    local dock = createGlassDock()
    animateHide(function()
        if dock and dock.Parent and not closed then
            dock.Visible = true
            local scale = dock:FindFirstChildOfClass("UIScale")
            if scale then scale.Scale = 0.72; playTween(scale, {Scale=1}, 0.46, Enum.EasingStyle.Back, Enum.EasingDirection.Out) end
            dock.BackgroundTransparency = 0.48
            playTween(dock, {BackgroundTransparency = 0.10}, 0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        end
    end)
end)

if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(recomputeRootScale) end
if UserInputService then
    UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(recomputeRootScale)
    UserInputService:GetPropertyChangedSignal("MouseEnabled"):Connect(recomputeRootScale)
end

-- ==========================================================
-- INTRO SPLASH
-- ==========================================================
local splashConn = nil
local splashOverlay = nil
local introFinished = false

local function playIntroSplash()
    setBlurActive(false, true)
    local overlay = new("Frame", {Name="MingoHubIntroSplash", Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.fromRGB(1,3,12), BackgroundTransparency=1, BorderSizePixel=0, ZIndex=100, Parent=screen})
    splashOverlay = overlay
    local card = new("Frame", {Name="SplashCard", Size=UDim2.fromOffset(370,224), Position=UDim2.new(0.5,0,0.5,38), AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=Color3.fromRGB(4,9,23), BackgroundTransparency=0.04, BorderSizePixel=0, ZIndex=101, Parent=overlay})
    corner(card, UDim.new(0, 22))
    local cardStroke = stroke(card, Neon.Cyan, 1.7); cardStroke.Transparency = 1
    new("UIGradient", {Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(5,34,53)),ColorSequenceKeypoint.new(0.52,Color3.fromRGB(4,9,25)),ColorSequenceKeypoint.new(1,Color3.fromRGB(28,7,40))}),Rotation=0,Parent=card})
    local halo = new("Frame", {Name="SplashHalo", Size=UDim2.fromOffset(84,84), Position=UDim2.new(0.5,0,0,12), AnchorPoint=Vector2.new(0.5,0), BackgroundColor3=Neon.Blue, BackgroundTransparency=0.83, BorderSizePixel=0, ZIndex=102, Parent=card})
    corner(halo, UDim.new(1, 0))
    local outerRing = new("Frame", {Name="OuterNeonRing", Size=UDim2.fromOffset(78,78), Position=UDim2.new(0.5,0,0,15), AnchorPoint=Vector2.new(0.5,0), BackgroundTransparency=1, BorderSizePixel=0, ZIndex=103, Parent=card})
    corner(outerRing, UDim.new(1, 0))
    local outerStroke = stroke(outerRing, Neon.Magenta, 2); outerStroke.Transparency = 1
    local innerRing = new("Frame", {Name="InnerNeonRing", Size=UDim2.fromOffset(64,64), Position=UDim2.new(0.5,0,0,22), AnchorPoint=Vector2.new(0.5,0), BackgroundTransparency=1, BorderSizePixel=0, ZIndex=103, Parent=card})
    corner(innerRing, UDim.new(1, 0))
    local innerStroke = stroke(innerRing, Neon.Cyan, 1.2); innerStroke.Transparency = 1
    local logo = new("Frame", {Name="SplashLogo", Size=UDim2.fromOffset(48,48), Position=UDim2.new(0.5,0,0,30), AnchorPoint=Vector2.new(0.5,0), BackgroundColor3=Neon.Cyan, BackgroundTransparency=0.02, BorderSizePixel=0, ZIndex=104, Parent=card})
    corner(logo, UDim.new(0, 14))
    new("UIGradient", {Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Neon.Cyan),ColorSequenceKeypoint.new(0.5,Neon.Blue),ColorSequenceKeypoint.new(1,Neon.Violet)}),Rotation=25,Parent=logo})
    new("TextLabel", {Text=Config.Logo,Font=Theme.FontBold,TextSize=27,TextColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=1,Size=UDim2.fromScale(1,1),TextTransparency=1,ZIndex=105,Parent=logo})
    local logoText = logo:FindFirstChildOfClass("TextLabel")
    local logoScale = new("UIScale", {Scale=0.4, Parent=logo})
    local cardScale = new("UIScale", {Scale=0.88, Parent=card})
    local title = new("TextLabel", {Text=Config.Title,Font=Theme.FontBold,TextSize=18,TextColor3=Theme.Text,TextTransparency=1,BackgroundTransparency=1,Position=UDim2.new(0,16,0,108),Size=UDim2.new(1,-32,0,24),ZIndex=105,Parent=card})
    local subtitle = new("TextLabel", {Text="RIVALS SPECIALIZED  ·  INITIALIZING",Font=Theme.Font,TextSize=9,TextColor3=Color3.fromRGB(147,205,229),TextTransparency=1,BackgroundTransparency=1,Position=UDim2.new(0,16,0,135),Size=UDim2.new(1,-32,0,16),ZIndex=105,Parent=card})
    local status = new("TextLabel", {Text="LOADING MODULES",Font=Theme.FontMono,TextSize=8,TextColor3=Color3.fromRGB(113,191,216),TextTransparency=1,BackgroundTransparency=1,TextXAlignment=Enum.TextXAlignment.Center,Position=UDim2.new(0,20,1,-48),Size=UDim2.new(1,-40,0,13),ZIndex=105,Parent=card})
    local progressTrack = new("Frame", {Size=UDim2.new(1,-72,0,4), Position=UDim2.new(0,36,1,-27), BackgroundColor3=Color3.fromRGB(24,39,62), BackgroundTransparency=0.06, BorderSizePixel=0, ZIndex=104, Parent=card})
    corner(progressTrack, UDim.new(1, 0))
    local progressFill = new("Frame", {Size=UDim2.fromScale(0,1), BackgroundColor3=Neon.Cyan, BorderSizePixel=0, ZIndex=105, Parent=progressTrack})
    corner(progressFill, UDim.new(1, 0))
    new("UIGradient", {Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Neon.Cyan),ColorSequenceKeypoint.new(0.5,Neon.Blue),ColorSequenceKeypoint.new(1,Neon.Magenta)}),Parent=progressFill})
    local scan = new("Frame", {Name="SplashScanline",Size=UDim2.new(0,2,0,52), Position=UDim2.new(0,12,0,12), BackgroundColor3=Neon.Cyan, BackgroundTransparency=0.25, BorderSizePixel=0, ZIndex=106, Parent=card})
    corner(scan, UDim.new(1, 0))
    local introStart = os.clock(); splashConn = nil
    if RunService then
        splashConn = RunService.RenderStepped:Connect(function()
            if not overlay.Parent then if splashConn then splashConn:Disconnect(); splashConn = nil end; return end
            local t = os.clock() - introStart
            outerRing.Rotation = (t * 76) % 360
            innerRing.Rotation = (t * -108) % 360
            halo.BackgroundTransparency = 0.86 + math.sin(t * 3.2) * 0.045
            outerRing.Size = UDim2.fromOffset(78 + math.sin(t * 3.5) * 4, 78 + math.sin(t * 3.5) * 4)
            scan.Position = UDim2.new(0, 12 + ((t * 112) % 344), 0, 12)
        end)
    end
    playTween(overlay, {BackgroundTransparency=0.12}, 0.42, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    playTween(card, {Position=UDim2.new(0.5,0,0.5,0)}, 0.62, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    playTween(cardScale, {Scale=1}, 0.72, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    playTween(cardStroke, {Transparency=0.12}, 0.35)
    playTween(outerStroke, {Transparency=0.2}, 0.42)
    playTween(innerStroke, {Transparency=0.3}, 0.42)
    task.delay(0.18, function()
        if not overlay.Parent then return end
        playTween(logoScale, {Scale=1}, 0.52, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        if logoText then playTween(logoText, {TextTransparency=0}, 0.28) end
    end)
    task.delay(0.48, function() if title.Parent then playTween(title, {TextTransparency=0}, 0.35) end end)
    task.delay(0.68, function()
        if subtitle.Parent then playTween(subtitle, {TextTransparency=0}, 0.32) end
        if status.Parent then playTween(status, {TextTransparency=0}, 0.32) end
    end)
    task.delay(0.75, function()
        if progressFill.Parent then playTween(progressFill, {Size=UDim2.fromScale(1,1)}, 1.65, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) end
    end)
    task.delay(2.85, function()
        if not overlay.Parent then return end
        playTween(card, {BackgroundTransparency=1}, 0.38)
        playTween(cardStroke, {Transparency=1}, 0.34)
        playTween(outerStroke, {Transparency=1}, 0.30)
        playTween(innerStroke, {Transparency=1}, 0.30)
        playTween(title, {TextTransparency=1}, 0.22)
        playTween(subtitle, {TextTransparency=1}, 0.22)
        playTween(status, {TextTransparency=1}, 0.22)
        playTween(logoText, {TextTransparency=1}, 0.22)
        playTween(overlay, {BackgroundTransparency=1}, 0.48)
        playTween(cardScale, {Scale=0.94}, 0.38)
        task.delay(0.52, function()
            if introFinished then return end
            introFinished = true
            if splashConn then splashConn:Disconnect(); splashConn = nil end
            if overlay.Parent then overlay:Destroy() end
            splashOverlay = nil
            if not closed then
                pcall(animateShow)
                task.delay(0.5, function()
                    if not closed then Notify("MingoHub-Rivals","success","Ready — mode: " .. Rivals.GameMode) end
                end)
            else setBlurActive(false, true) end
        end)
    end)
end

local function recoverFromIntroFailure(reason)
    warn("MingoHub-Rivals: intro failed — opening main. " .. tostring(reason))
    introFinished = true
    if splashConn then pcall(function() splashConn:Disconnect() end); splashConn = nil end
    local overlay = splashOverlay or screen:FindFirstChild("MingoHubIntroSplash")
    if overlay then pcall(function() overlay:Destroy() end) end
    splashOverlay = nil
    setBlurActive(false, true)
    if closed then return end
    animState = "idle"
    main.Visible = false; main.GroupTransparency = 1
    mainScale.Scale = 0.91 * windowSizeScale
    main.Position = UDim2.new(0.5,0,0.5,18)
    local ok = pcall(animateShow)
    if not ok then
        main.Visible = true; main.GroupTransparency = 0
        mainScale.Scale = windowSizeScale; main.Position = UDim2.new(0.5,0,0.5,0)
        animState = "idle"; setBlurActive(true, true)
    end
end

local introOk, introError = pcall(playIntroSplash)
if not introOk then recoverFromIntroFailure(introError) end

task.delay(6.5, function()
    if main and main.Parent and not main.Visible and not closed then
        recoverFromIntroFailure("startup watchdog")
    end
end)