local UI = {}
function UI.Header(parent,text,order)
    local f = new("Frame",{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,LayoutOrder=order or 0,Parent=parent})
    new("TextLabel",{Text=text:upper(),Font=Theme.FontBold,TextSize=10,TextColor3=Theme.TextDim,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Parent=f})
    return f
end
function UI.Divider(parent,order)
    return new("Frame",{Size=UDim2.new(1,0,0,1),BackgroundColor3=Theme.Stroke,BackgroundTransparency=0.5, BorderSizePixel=0,LayoutOrder=order or 0,Parent=parent})
end
function UI.Label(parent,text,order,color)
    return new("TextLabel",{Text=text,Font=Theme.Font,TextSize=12,TextColor3=color or Theme.Text,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,Size=UDim2.new(1,0,0,18),LayoutOrder=order or 0,Parent=parent})
end
function UI.Button(parent,text,desc,callback,order)
    local wrap = new("Frame",{Size=UDim2.new(1,0,0,desc and 54 or 36),BackgroundColor3=Theme.Bg2, BorderSizePixel=0, LayoutOrder=order or 0, Parent=parent})
    corner(wrap,UDim.new(0,8)); stroke(wrap,Theme.Stroke)
    local btnScale = new("UIScale",{Scale=1,Parent=wrap})
    new("TextLabel",{Text=text,Font=Theme.FontBold,TextSize=13,TextColor3=Theme.Text,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,Position=UDim2.new(0,12,0,desc and 8 or 0),Size=UDim2.new(1,-24,0,desc and 18 or 36),Parent=wrap})
    if desc then
        new("TextLabel",{Text=desc,Font=Theme.Font,TextSize=11,TextColor3=Theme.TextDim,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,Position=UDim2.new(0,12,0,28),Size=UDim2.new(1,-24,0,16),Parent=wrap})
    end
    local hit = new("TextButton",{Text="",BackgroundTransparency=1,AutoButtonColor=false,Size=UDim2.fromScale(1,1),Parent=wrap})
    local hovering = false
    hit.MouseEnter:Connect(function() hovering = true
        if Anim.ButtonAnimation and Anim.HoverAnimation then playTween(btnScale, {Scale=1.02}, 0.12); playTween(wrap, {BackgroundColor3=Theme.Bg3}, 0.12) end
    end)
    hit.MouseLeave:Connect(function() hovering = false
        if Anim.ButtonAnimation then playTween(btnScale, {Scale=1}, 0.15); playTween(wrap, {BackgroundColor3=Theme.Bg2}, 0.15) end
    end)
    hit.MouseButton1Down:Connect(function()
        if Anim.ButtonAnimation then playTween(btnScale, {Scale=0.96}, 0.08); playTween(wrap, {BackgroundColor3=Theme.Accent}, 0.1) end
    end)
    hit.MouseButton1Up:Connect(function()
        if Anim.ButtonAnimation then playTween(btnScale, {Scale=hovering and 1.02 or 1}, 0.15); playTween(wrap, {BackgroundColor3=hovering and Theme.Bg3 or Theme.Bg2}, 0.15) end
    end)
    hit.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch and Anim.ButtonAnimation then playTween(btnScale, {Scale=0.96}, 0.08); playTween(wrap, {BackgroundColor3=Theme.Accent}, 0.1) end
    end)
    hit.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch and Anim.ButtonAnimation then playTween(btnScale, {Scale=1}, 0.15); playTween(wrap, {BackgroundColor3=Theme.Bg2}, 0.15) end
    end)
    hit.Activated:Connect(function() pcall(callback) end)
    return hit
end

local toggleSetters, sliderSetters, dropdownSetters = {}, {}, {}

function UI.Toggle(parent,text,default,onChange,order)
    local row = new("Frame",{Size=UDim2.new(1,0,0,40),BackgroundColor3=Theme.Bg2,BorderSizePixel=0,LayoutOrder=order or 0,Parent=parent})
    corner(row,UDim.new(0,8)); stroke(row,Theme.Stroke)
    new("TextLabel",{Text=text,Font=Theme.Font,TextSize=13,TextColor3=Theme.Text,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,Position=UDim2.new(0,12,0,0),Size=UDim2.new(1,-64,1,0),Parent=row})
    local track = new("Frame",{Size=UDim2.fromOffset(38,20),Position=UDim2.new(1,-12,0.5,0),AnchorPoint=Vector2.new(1,0.5),BackgroundColor3=Theme.Bg3,BorderSizePixel=0,Parent=row})
    corner(track,UDim.new(1,0))
    local thumb = new("Frame",{Size=UDim2.fromOffset(16,16),Position=UDim2.new(0,2,0.5,0),AnchorPoint=Vector2.new(0,0.5),BackgroundColor3=Theme.TextDim,BorderSizePixel=0,Parent=track})
    corner(thumb,UDim.new(1,0))
    local state = default
    local function render(animated)
        if state then
            playTween(thumb,{Position=UDim2.new(1,-18,0.5,0),BackgroundColor3=Theme.Accent}, animated and 0.15 or 0)
            playTween(track,{BackgroundColor3=Theme.Accent:Lerp(Color3.new(0,0,0),0.55)}, animated and 0.15 or 0)
        else
            playTween(thumb,{Position=UDim2.new(0,2,0.5,0),BackgroundColor3=Theme.TextDim}, animated and 0.15 or 0)
            playTween(track,{BackgroundColor3=Theme.Bg3}, animated and 0.15 or 0)
        end
    end
    render(false)
    toggleSetters[text] = function(value, fireCallback)
        state = value == true; render(false)
        if fireCallback then pcall(onChange, state) end
    end
    local hit = new("TextButton",{Text="",BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Parent=row})
    hit.Activated:Connect(function() state = not state; render(Anim.ToggleAnimation); pcall(onChange, state) end)
    return row
end

function UI.Slider(parent,text,minV,maxV,defaultV,onChange,order)
    local frame = new("Frame",{Size=UDim2.new(1,0,0,56),BackgroundColor3=Theme.Bg2,BorderSizePixel=0,LayoutOrder=order or 0,Parent=parent})
    corner(frame,UDim.new(0,8)); stroke(frame,Theme.Stroke)
    local lbl = new("TextLabel",{Text=("%s  ·  %s"):format(text,tostring(defaultV)),Font=Theme.Font,TextSize=12,TextColor3=Theme.Text,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,Position=UDim2.new(0,12,0,6),Size=UDim2.new(1,-24,0,16),Parent=frame})
    local track = new("Frame",{Size=UDim2.new(1,-24,0,8),Position=UDim2.new(0,12,0,34),BackgroundColor3=Theme.Bg3,BorderSizePixel=0,Parent=frame})
    corner(track,UDim.new(1,0))
    local fill = new("Frame",{Size=UDim2.fromScale((defaultV-minV)/(maxV-minV),1),BackgroundColor3=Theme.Accent,BorderSizePixel=0,Parent=track})
    corner(fill,UDim.new(1,0))
    local hit = new("TextButton",{Text="",BackgroundTransparency=1,Size=UDim2.fromScale(1,2.5),Position=UDim2.fromScale(0,-0.75),Parent=track})
    local drag = false
    local function setValue(v, animated, fireCallback)
        v = math.clamp(math.floor((tonumber(v) or defaultV) + 0.5), minV, maxV)
        local r = (v-minV)/(maxV-minV)
        playTween(fill,{Size=UDim2.fromScale(r,1)}, animated and 0.1 or 0)
        lbl.Text = ("%s  ·  %s"):format(text,tostring(v))
        if fireCallback then pcall(onChange,v) end
    end
    sliderSetters[text] = function(v, fireCallback) setValue(v, false, fireCallback) end
    local function setFrom(x)
        local r = math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local v = math.floor(minV+(maxV-minV)*r+0.5)
        setValue(v, true, true)
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true; setFrom(i.Position.X) end
    end)
    hit.InputChanged:Connect(function(i)
        if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then setFrom(i.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end
    end)
    return frame
end

function UI.Dropdown(parent,text,options,onChange,order)
    local frame = new("Frame",{Size=UDim2.new(1,0,0,36),BackgroundColor3=Theme.Bg2,BorderSizePixel=0,ClipsDescendants=true,LayoutOrder=order or 0,Parent=parent})
    corner(frame,UDim.new(0,8)); stroke(frame,Theme.Stroke)
    local current = options[1] or "—"
    local head = new("TextButton",{Text=text..":  "..current,Font=Theme.Font,TextSize=12,TextColor3=Theme.Text,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,Size=UDim2.new(1,0,0,36),Parent=frame})
    pad(head,10,0)
    local menu = new("Frame",{Size=UDim2.new(1,0,0,#options*30),Position=UDim2.new(0,0,0,36),BackgroundColor3=Theme.Bg3,BorderSizePixel=0,Visible=false,Parent=frame})
    new("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Parent=menu})
    dropdownSetters[text] = function(value, fireCallback)
        current = tostring(value); head.Text = text..":  "..current
        menu.Visible = false; frame.Size = UDim2.new(1,0,0,36)
        if fireCallback then pcall(onChange,current) end
    end
    for i,opt in ipairs(options) do
        local item = new("TextButton",{Text=opt,Font=Theme.Font,TextSize=12,TextColor3=Theme.Text,TextXAlignment=Enum.TextXAlignment.Left,BackgroundColor3=Theme.Bg3,BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.new(1,0,0,30),LayoutOrder=i,Parent=menu})
        pad(item,10,0)
        item.MouseEnter:Connect(function() playTween(item,{BackgroundTransparency=0},0.1) end)
        item.MouseLeave:Connect(function() playTween(item,{BackgroundTransparency=1},0.1) end)
        item.Activated:Connect(function() dropdownSetters[text](opt, true); playTween(frame,{Size=UDim2.new(1,0,0,36)},0.15) end)
    end
    head.Activated:Connect(function()
        menu.Visible = not menu.Visible
        local target = menu.Visible and (36+#options*30) or 36
        playTween(frame,{Size=UDim2.new(1,0,0,target)}, Anim.DropdownAnimation and 0.15 or 0)
    end)
    return frame
end

function UI.Textbox(parent,text,placeholder,onSubmit,order)
    local wrap = new("Frame",{Size=UDim2.new(1,0,0,36),BackgroundColor3=Theme.Bg2,BorderSizePixel=0,LayoutOrder=order or 0,Parent=parent})
    corner(wrap,UDim.new(0,8))
    local wrapStroke = stroke(wrap,Theme.Stroke); pad(wrap,10,0)
    local box = new("TextBox",{Text=text or "",PlaceholderText=placeholder or "",Font=Theme.Font,TextSize=12,TextColor3=Theme.Text,PlaceholderColor3=Theme.TextDim,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,ClearTextOnFocus=false,Size=UDim2.fromScale(1,1),Parent=wrap})
    box.Focused:Connect(function() playTween(wrapStroke,{Color=Theme.Accent,Thickness=1.5},0.15) end)
    box.FocusLost:Connect(function(enter)
        playTween(wrapStroke,{Color=Theme.Stroke,Thickness=1},0.15)
        if enter then pcall(onSubmit,box.Text) end
    end)
    return box
end

function UI.ScrollList(parent,height,order)
    local sf = new("ScrollingFrame",{Size=UDim2.new(1,0,0,height or 160),BackgroundColor3=Theme.Bg2,BorderSizePixel=0,ScrollBarThickness=4,ScrollBarImageColor3=Theme.Stroke,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y,ClipsDescendants=true,LayoutOrder=order or 0,Parent=parent})
    corner(sf,UDim.new(0,8)); stroke(sf,Theme.Stroke); pad(sf,8)
    new("UIListLayout",{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder,Parent=sf})
    return sf
end

local tabFrames = {}; local tabButtons = {}; local tabButtonStrokes = {}; local activeTab = nil
local function setTabVisual(name, isActive)
    local btn = tabButtons[name]; local outline = tabButtonStrokes[name]
    if not btn then return end
    playTween(btn, {TextColor3 = isActive and Theme.Text or Theme.TextDim, BackgroundColor3 = isActive and Theme.Bg3 or Theme.Bg2}, 0.16)
    if outline then playTween(outline, {Color = isActive and Neon.Cyan or Theme.Stroke, Thickness = isActive and 1.8 or 0.85, Transparency = isActive and 0.06 or 0.78}, 0.16) end
end
local pendingTab = nil; local transitioning = false
local function transitionTo(target)
    if not tabFrames[target] then return end
    if target == activeTab and not pendingTab then return end
    if target == pendingTab then return end
    pendingTab = target
    if transitioning then return end
    transitioning = true
    task.spawn(function()
        while pendingTab do
            local tgt = pendingTab; pendingTab = nil
            if tgt ~= activeTab then
                if activeTab then
                    local prev = tabFrames[activeTab]
                    if prev then
                        setTabVisual(activeTab, false); prev.Scroll.ScrollingEnabled = false
                        if Anim.TabAnimation then
                            local t = playTween(prev.Group, {GroupTransparency = 1, Position = UDim2.fromOffset(-Anim.TabSlideOffset, 0)}, Anim.TabExitDuration)
                            waitTweenOrTimeout(t, Anim.TabExitDuration + 0.6)
                        else
                            prev.Group.GroupTransparency = 1; prev.Group.Position = UDim2.fromOffset(-Anim.TabSlideOffset, 0)
                        end
                        prev.Group.Visible = false; prev.Group.Position = UDim2.fromOffset(0, 0); prev.Group.GroupTransparency = 1
                    end
                end
                local nxt = tabFrames[tgt]
                if nxt then
                    nxt.Group.Visible = true; nxt.Group.GroupTransparency = 1; nxt.Group.Position = UDim2.fromOffset(Anim.TabSlideOffset, 0)
                    nxt.Scroll.ScrollingEnabled = true; activeTab = tgt; setTabVisual(tgt, true)
                    if Anim.TabAnimation then
                        local t = playTween(nxt.Group, {GroupTransparency = 0, Position = UDim2.fromOffset(0, 0)}, Anim.TabEnterDuration)
                        waitTweenOrTimeout(t, Anim.TabEnterDuration + 0.6)
                    else
                        nxt.Group.GroupTransparency = 0; nxt.Group.Position = UDim2.fromOffset(0, 0)
                    end
                end
            end
        end
        transitioning = false
    end)
end

local function CreateTab(name, order)
    local btn = new("TextButton",{Text=name,Font=Theme.FontBold,TextSize=13,TextColor3=Theme.TextDim,TextXAlignment=Enum.TextXAlignment.Left,BackgroundColor3=Theme.Bg2,BorderSizePixel=0,AutoButtonColor=false,Size=UDim2.new(1,0,0,36),LayoutOrder=order,Parent=tabList})
    corner(btn,UDim.new(0,8)); pad(btn,10,0)
    local tabOutline = stroke(btn, Theme.Stroke, 0.85); tabOutline.Transparency = 0.78
    tabButtonStrokes[name] = tabOutline
    btn.MouseEnter:Connect(function() if activeTab ~= name then playTween(btn,{TextColor3=Theme.Text},0.1) end end)
    btn.MouseLeave:Connect(function() if activeTab ~= name then playTween(btn,{TextColor3=Theme.TextDim},0.1) end end)
    btn.Activated:Connect(function() transitionTo(name) end)
    local group = new("CanvasGroup",{Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, GroupTransparency = 1, Visible = false, Position = UDim2.fromOffset(0, 0), ClipsDescendants = true, Parent = content})
    local sf = new("ScrollingFrame",{Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = Theme.Stroke, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, ClipsDescendants = true, Parent = group})
    pad(sf, 14)
    new("UIListLayout",{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder,Parent=sf})
    tabFrames[name] = {Group = group, Scroll = sf}
    tabButtons[name] = btn
    return sf
end

local tabs = {}
for i,name in ipairs(Config.Tabs) do tabs[name] = CreateTab(name, i) end

-- ==========================================================
-- RIVALS GAMEPLAY STATE
-- ==========================================================
local Rivals = {
    Aimbot = { Enabled = false, Smoothing = 5, FOV = 90, HitChance = 100, Part = "Head" },
    Silent = { Enabled = false, Part = "Head", FOV = 180 },
    Rage   = { Enabled = false, Priority = "Current Weapon" },
    Trigger= { Enabled = false, Delay = 0, LastShot = 0 },
    WalkSpeed = 16, JumpPower = 16, InfJump = false,
    MusicId = "", HitSoundId = "", KillSoundId = "",
    ESP = false,
    Antilag = false,
    Headless = false, Korblox = false,
    TeamCheck = true,   -- default on
    GameMode = "Unknown",
}

local LocalPlayer = player
local function getChar() return LocalPlayer and LocalPlayer.Character end
local function getHum() local c = getChar(); return c and c:FindFirstChildOfClass("Humanoid") end
local function getHRP() local c = getChar(); return c and c:FindFirstChild("HumanoidRootPart") end

-- ==========================================================
-- ROUND / MODE DETECTION
-- ==========================================================
local ModeKeywords = {
    FFA  = { "ffa", "freeforall", "free-for-all", "deathmatch", "dm" },
    TDM  = { "tdm", "teamdeath", "teamdeathmatch", "teams" },
    RANKED = { "ranked", "competitive" },
}

local function classifyModeString(s)
    s = tostring(s or ""):lower()
    for mode, keys in pairs(ModeKeywords) do
        for _, k in ipairs(keys) do
            if s:find(k, 1, true) then return mode end
        end
    end
    return nil
end

local function scanForMode()
    -- Team present → TDM (most reliable signal)
    local lp = LocalPlayer
    if lp and lp.Team ~= nil then return "TDM" end

    -- Scan ReplicatedStorage for mode/round string values
    if ReplicatedStorage then
        local scanNames = {"GameMode","Mode","Round","RoundMode","MatchInfo","GameState","RoundState","MatchState","RoundData"}
        for _, n in ipairs(scanNames) do
            local obj = ReplicatedStorage:FindFirstChild(n, true)
            if obj then
                if obj:IsA("StringValue") then
                    local c = classifyModeString(obj.Value)
                    if c then return c end
                end
                if obj:IsA("Folder") or obj:IsA("Configuration") then
                    for _, child in ipairs(obj:GetDescendants()) do
                        pcall(function()
                            if child:IsA("StringValue") or child:IsA("ValueBase") then
                                local c = classifyModeString(tostring(child.Value))
                                if c then return c end
                            end
                        end)
                    end
                end
            end
        end
    end
    return "FFA"
end

local modeListeners = {}
local function notifyModeChange(newMode)
    Rivals.GameMode = newMode
    for _, cb in ipairs(modeListeners) do pcall(cb, newMode) end
end

task.spawn(function()
    task.wait(1)
    while not closed do
        local ok, mode = pcall(scanForMode)
        if ok and mode and mode ~= Rivals.GameMode then
            notifyModeChange(mode)
        end
        task.wait(2)
    end
end)

local function getEnemies()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                table.insert(list, {Player = p, Character = p.Character, Humanoid = hum, Root = hrp})
            end
        end
    end
    return list
end

local function getPart(char, partName)
    if partName == "Head" then return char:FindFirstChild("Head") end
    if partName == "HumanoidRootPart" then return char:FindFirstChild("HumanoidRootPart") end
    if partName == "Torso" then
        return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("LowerTorso")
    end
    return char:FindFirstChild("Head")
end

local function worldToScreen(pos)
    if not camera then return nil end
    local sp, onScreen = camera:WorldToViewportPoint(pos)
    if onScreen then return Vector2.new(sp.X, sp.Y) end
    return nil
end

local function isAlly(plr)
    if not Rivals.TeamCheck then return false end
    if not LocalPlayer or not plr then return false end
    if Rivals.GameMode == "FFA" or Rivals.GameMode == "Unknown" then return false end
    local ok, lpTeam = pcall(function() return LocalPlayer.Team end)
    local ok2, plTeam = pcall(function() return plr.Team end)
    if not ok or not ok2 then return false end
    if lpTeam == nil or plTeam == nil then return false end
    return lpTeam == plTeam
end

local function getClosest(partName, fov)
    if not camera or not getHRP() then return nil end
    local center = camera.ViewportSize * 0.5
    local best, bestDist = nil, fov
    for _, e in ipairs(getEnemies()) do
        if not isAlly(e.Player) then
            local part = getPart(e.Character, partName)
            if part then
                local screen = worldToScreen(part.Position)
                if screen then
                    local dist = (screen - center).Magnitude
                    if dist < bestDist then best, bestDist = e, dist end
                end
            end
        end
    end
    return best
end

-- ==========================================================
-- AIMBOT
-- ==========================================================
local aimConn
local function runAimbot()
    if not Rivals.Aimbot.Enabled then return end
    if math.random(1, 100) > Rivals.Aimbot.HitChance then return end
    local target = getClosest(Rivals.Aimbot.Part, Rivals.Aimbot.FOV)
    if not target or not camera then return end
    local part = getPart(target.Character, Rivals.Aimbot.Part); if not part then return end
    local current = camera.CFrame
    local desired = CFrame.new(current.Position, part.Position)
    local noise = CFrame.Angles(math.rad((math.random()-0.5)*0.35), math.rad((math.random()-0.5)*0.35), 0)
    local smoothingAlpha = math.clamp(1 / math.max(Rivals.Aimbot.Smoothing, 1), 0.05, 1)
    pcall(function() camera.CFrame = current:Lerp(desired * noise, smoothingAlpha) end)
end
local function startAimbot()
    if aimConn then aimConn:Disconnect() end
    aimConn = RunService.RenderStepped:Connect(function() pcall(runAimbot) end)
end
local function stopAimbot() if aimConn then aimConn:Disconnect(); aimConn = nil end end

-- ==========================================================
-- SILENT AIM
-- ==========================================================
local silentStatusLabel = nil
local function updateSilentStatus()
    if silentStatusLabel then
        if Rivals.Silent.Enabled then
            silentStatusLabel.Text = "Status: Manipulated"
            silentStatusLabel.TextColor3 = Theme.Success
        else
            silentStatusLabel.Text = "Status: Inactive"
            silentStatusLabel.TextColor3 = Theme.Danger
        end
    end
end

local silentHookInstalled = false
local function hookSilentAim()
    if silentHookInstalled then return true end
    if not (hookmetamethod and getnamecallmethod and getrawmetatable and setreadonly and newcclosure) then return false end
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if Rivals.Silent.Enabled then
                local target = getClosest(Rivals.Silent.Part, Rivals.Silent.FOV)
                if target then
                    local part = getPart(target.Character, Rivals.Silent.Part)
                    local hrp = getHRP()
                    if part and hrp then
                        if method == "FindPartOnRay" then
                            local args = {...}
                            if type(args[1]) == "Ray" then
                                args[1] = Ray.new(hrp.Position, (part.Position - hrp.Position).Unit * 1000)
                                return old(self, unpack(args))
                            end
                        elseif method == "Raycast" then
                            local args = {...}
                            if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                                local a = { ... }
                                a[1] = hrp.Position
                                a[2] = (part.Position - hrp.Position).Unit * 1000
                                return old(self, unpack(a))
                            end
                        end
                    end
                end
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)
    if ok then silentHookInstalled = true end
    return ok
end

-- ==========================================================
-- TRIGGER BOT
-- ==========================================================
local triggerConn
local function runTrigger()
    if not Rivals.Trigger.Enabled then return end
    if os.clock() - Rivals.Trigger.LastShot < (Rivals.Trigger.Delay / 1000) then return end
    local target = getClosest("Head", 8)
    if target and camera and VirtualInputManager then
        Rivals.Trigger.LastShot = os.clock()
        pcall(function() VirtualInputManager:SendMouseButtonEvent(camera.ViewportSize.X/2, camera.ViewportSize.Y/2, 0, true, game, 0) end)
        task.delay(0.05, function()
            pcall(function() VirtualInputManager:SendMouseButtonEvent(camera.ViewportSize.X/2, camera.ViewportSize.Y/2, 0, false, game, 0) end)
        end)
    end
end
local function startTrigger()
    if triggerConn then triggerConn:Disconnect() end
    triggerConn = RunService.Heartbeat:Connect(function() pcall(runTrigger) end)
end
local function stopTrigger() if triggerConn then triggerConn:Disconnect(); triggerConn = nil end end

-- ==========================================================
-- RAGE BOT
-- ==========================================================
local rageConn
local function runRage()
    if not Rivals.Rage.Enabled then return end
    local hrp = getHRP(); if not hrp then return end
    local target, bestDist = nil, math.huge
    for _, e in ipairs(getEnemies()) do
        if not isAlly(e.Player) then
            local d = (e.Root.Position - hrp.Position).Magnitude
            if d < bestDist and d < 120 then bestDist = d; target = e end
        end
    end
    if target and camera and VirtualInputManager then
        local head = target.Character:FindFirstChild("Head")
        if head then
            pcall(function()
                camera.CFrame = CFrame.new(camera.CFrame.Position, head.Position)
                VirtualInputManager:SendMouseButtonEvent(camera.ViewportSize.X/2, camera.ViewportSize.Y/2, 0, true, game, 0)
                task.delay(0.03, function()
                    pcall(function() VirtualInputManager:SendMouseButtonEvent(camera.ViewportSize.X/2, camera.ViewportSize.Y/2, 0, false, game, 0) end)
                end)
            end)
        end
    end
end
local function startRage()
    if rageConn then rageConn:Disconnect() end
    rageConn = RunService.Heartbeat:Connect(function() pcall(runRage) end)
end
local function stopRage() if rageConn then rageConn:Disconnect(); rageConn = nil end end

-- ==========================================================
-- MOVEMENT
-- ==========================================================
local function applyMovement()
    local hum = getHum()
    if hum then
        pcall(function()
            hum.WalkSpeed = Rivals.WalkSpeed
            hum.JumpPower = Rivals.JumpPower
            hum.UseJumpPower = true
        end)
    end
end
if LocalPlayer then
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        applyMovement()
        hookHitSound()
    end)
end
local infJumpConn
local function startInfJump()
    if infJumpConn then infJumpConn:Disconnect() end
    infJumpConn = UserInputService.JumpRequest:Connect(function()
        if Rivals.InfJump then
            local hum = getHum()
            if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end) end
        end
    end)
end
startInfJump()

-- ==========================================================
-- SOUNDS
-- ==========================================================
local musicSound, hitSound, killSound

local function playMusic(id)
    if musicSound then musicSound:Destroy(); musicSound = nil end
    if not id or id == "" then return end
    musicSound = Instance.new("Sound")
    musicSound.SoundId = "rbxassetid://" .. tostring(id)
    musicSound.Volume = 0.5; musicSound.Looped = true; musicSound.Parent = SoundService
    pcall(function() musicSound:Play() end)
end
local function playHitSound(id)
    if not id or id == "" then return end
    if hitSound then hitSound:Destroy() end
    hitSound = Instance.new("Sound")
    hitSound.SoundId = "rbxassetid://" .. tostring(id)
    hitSound.Volume = 0.8; hitSound.Parent = SoundService
    pcall(function() hitSound:Play() end)
    task.delay(2, function() if hitSound then hitSound:Destroy(); hitSound = nil end end)
end
local function playKillSound(id)
    if not id or id == "" then return end
    if killSound then killSound:Destroy() end
    killSound = Instance.new("Sound")
    killSound.SoundId = "rbxassetid://" .. tostring(id)
    killSound.Volume = 1; killSound.Parent = SoundService
    pcall(function() killSound:Play() end)
    task.delay(3, function() if killSound then killSound:Destroy(); killSound = nil end end)
end

local hitSoundConn = nil
local function hookHitSound()
    if hitSoundConn then hitSoundConn:Disconnect(); hitSoundConn = nil end
    local hum = getHum(); if not hum then return end
    local lastHP = hum.Health
    hitSoundConn = hum.HealthChanged:Connect(function(hp)
        pcall(function()
            if hp < lastHP and Rivals.HitSoundId ~= "" then
                playHitSound(Rivals.HitSoundId)
            end
            lastHP = hp
        end)
    end)
end
hookHitSound()

-- ==========================================================
-- ESP (fixed: BoxStroke stored in cache)
-- ==========================================================
local espFolder = new("Folder", {Name="MingoESP", Parent=screen})
local espCache = {}
local function clearESP()
    for _, obj in pairs(espCache) do
        if obj.Box and obj.Box.Parent then obj.Box:Destroy() end
        if obj.Name and obj.Name.Parent then obj.Name:Destroy() end
        if obj.HP and obj.HP.Parent then obj.HP:Destroy() end
    end
    espCache = {}
end
local function createESPFor(e)
    if espCache[e.Player] then return end
    local box = new("Frame", {BackgroundTransparency = 1, BorderSizePixel = 0, Parent = espFolder, Visible = false})
    local boxStroke = new("UIStroke", {Color = Color3.fromRGB(255,0,0), Thickness = 1.5, Parent = box})
    local nameLbl = new("TextLabel", {BackgroundTransparency = 1, Font = Theme.FontBold, TextSize = 12, TextColor3 = Color3.fromRGB(255,255,255), TextStrokeTransparency = 0.3, Text = e.Player.Name, Parent = espFolder, Visible = false})
    local hpLbl = new("TextLabel", {BackgroundTransparency = 1, Font = Theme.Font, TextSize = 10, TextColor3 = Color3.fromRGB(255,255,255), TextStrokeTransparency = 0.3, Text = "100", Parent = espFolder, Visible = false})
    espCache[e.Player] = {Box = box, BoxStroke = boxStroke, Name = nameLbl, HP = hpLbl}
end

local espConn
local function runESP()
    if not Rivals.ESP then clearESP(); return end
    for _, e in ipairs(getEnemies()) do
        createESPFor(e)
        local data = espCache[e.Player]
        if data then
            local head = e.Character:FindFirstChild("Head")
            local hrp = e.Root
            if head and hrp and camera then
                local headScreen = worldToScreen(head.Position + Vector3.new(0, 0.5, 0))
                local hrpScreen = worldToScreen(hrp.Position - Vector3.new(0, 3, 0))
                if headScreen and hrpScreen then
                    local h = math.abs(hrpScreen.Y - headScreen.Y)
                    local w = h * 0.5
                    data.Box.Visible = true
                    data.Box.Position = UDim2.fromOffset(headScreen.X - w/2, headScreen.Y)
                    data.Box.Size = UDim2.fromOffset(w, h)
                    data.BoxStroke.Color = isAlly(e.Player) and Color3.fromRGB(0,80,255) or Color3.fromRGB(255,0,0)
                    data.Name.Visible = true
                    data.Name.Position = UDim2.fromOffset(headScreen.X - 50, headScreen.Y - 18)
                    data.Name.Size = UDim2.fromOffset(100, 14)
                    data.Name.Text = e.Player.Name
                    data.HP.Visible = true
                    data.HP.Position = UDim2.fromOffset(headScreen.X - 50, headScreen.Y + h + 2)
                    data.HP.Size = UDim2.fromOffset(100, 12)
                    local myHrp = getHRP()
                    local dist = myHrp and math.floor((hrp.Position - myHrp.Position).Magnitude) or 0
                    data.HP.Text = ("HP: %d | %dm"):format(math.floor(e.Humanoid.Health), dist)
                else
                    data.Box.Visible = false; data.Name.Visible = false; data.HP.Visible = false
                end
            end
        end
    end
    for plr, data in pairs(espCache) do
        if not plr.Parent or not plr.Character then
            if data.Box then data.Box:Destroy() end
            if data.Name then data.Name:Destroy() end
            if data.HP then data.HP:Destroy() end
            espCache[plr] = nil
        end
    end
end
local function startESP()
    if espConn then espConn:Disconnect() end
    espConn = RunService.RenderStepped:Connect(function() pcall(runESP) end)
end
local function stopESP() if espConn then espConn:Disconnect(); espConn = nil end; clearESP() end

-- ==========================================================
-- ANTILAG
-- ==========================================================
local antilagCache = {}
local function enableAntilag()
    for _, obj in ipairs(workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("MeshPart") and obj.TextureID ~= "" then
                antilagCache[obj] = obj.TextureID; obj.TextureID = ""
            elseif obj:IsA("Texture") then
                antilagCache[obj] = obj.Transparency; obj.Transparency = 1
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                antilagCache[obj] = obj.Enabled; obj.Enabled = false
            elseif obj:IsA("BasePart") then
                antilagCache[obj] = {Material = obj.Material, Shadow = obj.CastShadow}
                obj.Material = Enum.Material.Plastic; obj.CastShadow = false
            end
        end)
    end
end
local function disableAntilag()
    for obj, data in pairs(antilagCache) do
        pcall(function()
            if obj:IsA("MeshPart") then obj.TextureID = data
            elseif obj:IsA("Texture") then obj.Transparency = data
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then obj.Enabled = data
            elseif obj:IsA("BasePart") and type(data) == "table" then
                obj.Material = data.Material; obj.CastShadow = data.Shadow
            end
        end)
    end
    antilagCache = {}
end

-- ==========================================================
-- DISGUISE / HEADLESS / KORBLOX
-- ==========================================================
local function disguiseAs(nameOrId)
    if not LocalPlayer then return false end
    if tostring(nameOrId):match("^%d+$") then
        local id = tonumber(nameOrId)
        return pcall(function()
            local desc = Players:GetHumanoidDescriptionFromUserId(id)
            local hum = getHum()
            if hum and desc then hum:ApplyDescription(desc) end
        end)
    else
        return pcall(function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower() == tostring(nameOrId):lower() and p.Character then
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local d = hum:GetAppliedDescription()
                        local myHum = getHum()
                        if myHum and d then myHum:ApplyDescription(d) end
                    end
                    break
                end
            end
        end)
    end
end
local function applyHeadless(on)
    local char = getChar(); if not char then return end
    local head = char:FindFirstChild("Head"); if not head then return end
    if on then
        for _, c in ipairs(head:GetChildren()) do
            if c:IsA("MeshPart") or c:IsA("SpecialMesh") or c:IsA("Decal") then
                pcall(function() c.Transparency = 1 end)
            end
        end
    else
        local hum = getHum()
        if hum then
            local desc = hum:GetAppliedDescription()
            if desc then pcall(function() hum:ApplyDescription(desc) end) end
        end
    end
end
local function applyKorblox(on)
    local char = getChar(); if not char then return end
    local rightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg")
    if on and rightLeg then
        for _, c in ipairs(rightLeg:GetChildren()) do
            if c:IsA("BasePart") or c:IsA("Decal") then pcall(function() c.Transparency = 1 end) end
        end
        pcall(function()
            local mesh = Instance.new("SpecialMesh")
            mesh.MeshId = "rbxassetid://10009834121"
            mesh.Parent = rightLeg
        end)
    end
end

