do
    local cfg = tabs["Configs"]
    UI.Header(cfg, "Configuration Manager", 1)
    UI.Label(cfg, configStorePersistent and "Local config storage available" or "Session-only storage", 2, configStorePersistent and Theme.Success or Theme.Warn)
    configSelectedLabel = UI.Label(cfg, "SELECTED CONFIG  ·  NONE", 3, Theme.TextDim)
    configNameBox = UI.Textbox(cfg, "", "New config name", function(_) end, 4)
    UI.Button(cfg, "Create config", nil, function()
        local name = sanitizeConfigName(configNameBox.Text)
        if name == "" then Notify("Configs","error","Enter a name."); return end
        if saveConfig(name) then updateConfigList() end
    end, 5)
    UI.Button(cfg, "Save selected config", nil, function()
        local name = selectedConfigName or sanitizeConfigName(configNameBox.Text)
        if name == "" then Notify("Configs","error","Select or enter a name."); return end
        if saveConfig(name) then updateConfigList() end
    end, 6)
    UI.Button(cfg, "Load selected config", nil, function()
        local name = selectedConfigName or sanitizeConfigName(configNameBox.Text)
        loadConfig(name)
    end, 7)
    UI.Button(cfg, "Delete selected config", nil, function()
        local name = selectedConfigName or sanitizeConfigName(configNameBox.Text)
        deleteConfig(name)
    end, 8)
    UI.Toggle(cfg, "Auto-load selected config", autoLoadConfigName ~= nil, function(on)
        local name = selectedConfigName or sanitizeConfigName(configNameBox.Text)
        if on then
            if name == "" then
                Notify("Configs","error","Select a saved config first.")
                if toggleSetters["Auto-load selected config"] then toggleSetters["Auto-load selected config"](false, false) end
                return
            end
            setAutoLoad(name)
        else setAutoLoad(nil) end
    end, 9)
    UI.Divider(cfg, 10)
    UI.Header(cfg, "Saved Configs", 11)
    configList = UI.ScrollList(cfg, 176, 12)
    updateConfigList()
    UI.Divider(cfg, 13)
    UI.Header(cfg, "Export", 14)
    UI.Button(cfg, "Export selected config", nil, function()
        local name = selectedConfigName or sanitizeConfigName(configNameBox.Text)
        if name == "" then Notify("Configs","error","Select a config."); return end
        exportConfig(name)
    end, 15)
    UI.Button(cfg, "Export current settings", nil, function() exportConfig("") end, 16)
    configExportBox = new("TextBox", {
        Text = "", PlaceholderText = "Exported configuration JSON…",
        Font = Theme.FontMono, TextSize = 10, TextColor3 = Theme.Text, PlaceholderColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true, MultiLine = true, ClearTextOnFocus = false,
        BackgroundColor3 = Theme.Bg2, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 96), LayoutOrder = 17, Parent = cfg,
    })
    corner(configExportBox, UDim.new(0, 8))
    stroke(configExportBox, Theme.Stroke, 1)
    pad(configExportBox, 8, 8)
end

