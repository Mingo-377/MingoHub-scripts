-- MingoHub-Rivals | Integrated from Mingo Template | v1.1 | teamcheck-default + round-detect

local Config = {
    Title      = "MingoHub-Rivals",
    Logo       = "M",
    Accent     = Color3.fromRGB(0, 225, 255),
    Design     = Vector2.new(720, 480),
    MaxSize    = Vector2.new(960, 640),
    MinSize    = Vector2.new(320, 240),
    PcWidthPct = 0.78, PcHeightPct= 0.80,
    MobWidthPct= 0.93, MobHeightPct=0.83,
    Tabs       = { "Main", "Player", "Visuals", "Misc", "Configs", "Information" },
    MaxToasts  = 4,
}

local Anim = {
    EnableAnimations   = true, AnimationSpeed = 1, NotificationDuration = 3,
    HoverAnimation = true, TabAnimation = true, ButtonAnimation = true,
    ToggleAnimation = true, OpenAnimation = true, CloseAnimation = true,
    FocusAnimation = true, DropdownAnimation = true,
    TabExitDuration = 0.15, TabEnterDuration = 0.22, TabSlideOffset = 20,
}

local Theme = {
    Bg = Color3.fromRGB(2, 3, 10), Bg2 = Color3.fromRGB(5, 8, 19),
    Bg3 = Color3.fromRGB(10, 15, 31), Bg4 = Color3.fromRGB(18, 26, 48),
    Stroke = Color3.fromRGB(74, 215, 255), Text = Color3.fromRGB(238, 250, 255),
    TextDim = Color3.fromRGB(137, 164, 190), Accent = Config.Accent,
    Danger = Color3.fromRGB(255, 82, 130), Success = Color3.fromRGB(61, 245, 202),
    Warn = Color3.fromRGB(255, 194, 82),
    Font = Enum.Font.Gotham, FontBold = Enum.Font.GothamBold, FontMono = Enum.Font.Code,
}
local Neon = {
    Cyan = Color3.fromRGB(0, 225, 255), Blue = Color3.fromRGB(48, 116, 255),
    Magenta = Color3.fromRGB(255, 48, 190), Violet = Color3.fromRGB(139, 76, 255),
}

local function svc(n) local ok,s = pcall(function() return game:GetService(n) end); return ok and s or nil end
local TweenService     = svc("TweenService")
local UserInputService = svc("UserInputService")
local Players          = svc("Players")
local Lighting         = svc("Lighting")
local RunService       = svc("RunService")
local HttpService      = svc("HttpService")
local SoundService     = svc("SoundService")
local ReplicatedStorage= svc("ReplicatedStorage")
local VirtualInputManager = svc("VirtualInputManager")
local camera           = workspace.CurrentCamera
local player           = Players and Players.LocalPlayer
local playerGui        = player and player:FindFirstChildOfClass("PlayerGui")

if player and not playerGui then
    local ok, pg = pcall(function() return player:WaitForChild("PlayerGui", 5) end)
    if ok and pg then playerGui = pg end
end

local function has(fn) return type(_G[fn]) == "function" end
local identifyExec = "unknown"
if has("identifyexecutor") then
    local ok, res = pcall(identifyexecutor)
    if ok and res then identifyExec = tostring(res) end
end
local hasClipboard = has("setclipboard")

local function getRoot()
    if type(_G.gethui) == "function" then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    local cg = svc("CoreGui")
    if cg then
        local probe = Instance.new("Folder")
        local ok = pcall(function() probe.Parent = cg end)
        if ok and probe.Parent == cg then pcall(function() probe:Destroy() end); return cg end
        pcall(function() probe:Destroy() end)
    end
    if playerGui then return playerGui end
    if player then
        local ok, pg = pcall(function() return player:WaitForChild("PlayerGui", 5) end)
        if ok and pg then return pg end
    end
    error("MingoHub-Rivals: could not resolve a GUI root")
end

local function new(c,p)
    local i = Instance.new(c)
    if p then for k,v in pairs(p) do i[k]=v end end
    if i:IsA("GuiObject") and i.BackgroundTransparency == 0 and i.BackgroundColor3 then
        local bg = i.BackgroundColor3
        if bg == Theme.Bg then i.BackgroundTransparency = 0.35
        elseif bg == Theme.Bg2 then i.BackgroundTransparency = 0.45
        elseif bg == Theme.Bg3 then i.BackgroundTransparency = 0.55
        elseif bg == Theme.Bg4 then i.BackgroundTransparency = 0.65
        elseif bg == Theme.Accent then i.BackgroundTransparency = 0.25 end
    end
    return i
end
local function corner(p,r) return new("UICorner",{CornerRadius=r or UDim.new(0,10),Parent=p}) end
local function stroke(p,c,t)
    local s = new("UIStroke",{Color=c or Theme.Stroke,Thickness=t or 1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=p})
    pcall(function() s.Transparency = 0.6 end)
    return s
end
local function pad(p,x,y) return new("UIPadding",{PaddingTop=UDim.new(0,y or x),PaddingBottom=UDim.new(0,y or x),PaddingLeft=UDim.new(0,x),PaddingRight=UDim.new(0,x),Parent=p}) end
local function isMobile() return UserInputService and UserInputService.TouchEnabled and not UserInputService.MouseEnabled end

local function aDur(base)
    if not Anim.EnableAnimations then return 0 end
    local s = Anim.AnimationSpeed; if not s or s <= 0 then s = 1 end
    return (base or 0.18) / s
end

local tweenTracks = setmetatable({}, {__mode = "k"})
local function playTween(inst, props, dur, style, dir)
    if not inst or inst.Parent == nil then return nil end
    if not TweenService then
        for k,v in pairs(props) do pcall(function() inst[k] = v end) end
        return nil
    end
    if tweenTracks[inst] then pcall(function() tweenTracks[inst]:Cancel() end); tweenTracks[inst] = nil end
    local d = aDur(dur)
    if d <= 0 then for k,v in pairs(props) do pcall(function() inst[k] = v end) end; return nil end
    local t = TweenService:Create(inst, TweenInfo.new(d, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tweenTracks[inst] = t; t:Play()
    t.Completed:Connect(function() if tweenTracks[inst] == t then tweenTracks[inst] = nil end end)
    return t
end
local function tween(inst, props, dur) return playTween(inst, props, dur) end
local function waitTweenOrTimeout(t, timeout)
    if not t then return end
    local done = false; local conn
    conn = t.Completed:Connect(function() done = true end)
    local deadline = os.clock() + (timeout or 1)
    while not done and os.clock() < deadline do task.wait(0.02) end
    if conn then conn:Disconnect() end
end

local root = getRoot()
for _, guiName in ipairs({"MingoHubUI", "MingoHubToasts", "MingoTemplateUI", "MingoTemplateToasts"}) do
    local previous = root:FindFirstChild(guiName)
    if previous then pcall(function() previous:Destroy() end) end
end
if Lighting then
    for _, blurName in ipairs({"MingoHubGlassBlur", "MingoGlassBlur"}) do
        local previousBlur = Lighting:FindFirstChild(blurName)
        if previousBlur then pcall(function() previousBlur:Destroy() end) end
    end
end

local blur = nil; local blurEnabled = true; local BLUR_MAX_SIZE = 12
if Lighting then blur = new("BlurEffect", {Name="MingoHubGlassBlur", Size=0, Parent=Lighting}) end
local function setBlurActive(active, instant)
    if not blur or not blur.Parent then return end
    local target = (active and blurEnabled) and BLUR_MAX_SIZE or 0
    if instant then blur.Size = target
    else playTween(blur, {Size=target}, 0.32, Enum.EasingStyle.Sine, Enum.EasingDirection.Out) end
end

local screen = new("ScreenGui",{Name="MingoHubUI",ResetOnSpawn=false,IgnoreGuiInset=true,DisplayOrder=100,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
if type(_G.syn) == "table" and type(_G.syn.protect_gui) == "function" then pcall(_G.syn.protect_gui, screen) end
screen.Parent = root
local rootScale = new("UIScale",{Scale=1,Parent=screen})

local toastScreen = new("ScreenGui",{Name="MingoHubToasts",ResetOnSpawn=false,IgnoreGuiInset=true,DisplayOrder=101,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
if type(_G.syn) == "table" and type(_G.syn.protect_gui) == "function" then pcall(_G.syn.protect_gui, toastScreen) end
toastScreen.Parent = root

local toastHolder = new("Frame",{Name="Toasts",BackgroundTransparency=1,Size=UDim2.fromOffset(340,400),AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,12),Parent=toastScreen})
new("UIListLayout",{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder,HorizontalAlignment=Enum.HorizontalAlignment.Center,Parent=toastHolder})

local function updateToastLayout()
    local vp = camera and camera.ViewportSize or Vector2.new(1280,720)
    local mobile = isMobile()
    local w = mobile and math.min(math.floor(vp.X*0.88),340) or 320
    toastHolder.Size = UDim2.fromOffset(w, 400)
    if mobile then toastHolder.AnchorPoint = Vector2.new(0.5,0); toastHolder.Position = UDim2.new(0.5,0,0,12)
    else toastHolder.AnchorPoint = Vector2.new(1,0); toastHolder.Position = UDim2.new(1,-14,0,14) end
end
updateToastLayout()

local activeToasts = {}; local toastOrder = 0
local function destroyToast(card)
    if not card or not card.Parent then return end
    for i = #activeToasts, 1, -1 do if activeToasts[i] == card then table.remove(activeToasts, i); break end end
    card:Destroy()
end
local function evictOldestToast()
    if #activeToasts >= Config.MaxToasts then
        local old = table.remove(activeToasts, 1); if old then old:Destroy() end
    end
end
local Notify
Notify = function(text, kind, desc)
    kind = kind or "info"
    local c = Theme.Accent
    if kind=="success" then c=Theme.Success elseif kind=="error" then c=Theme.Danger elseif kind=="warn" or kind=="warning" then c=Theme.Warn end
    evictOldestToast(); toastOrder += 1
    local card = new("CanvasGroup",{Size=UDim2.new(1,0,0,desc and 68 or 56),BackgroundColor3=Theme.Bg2,BorderSizePixel=0,GroupTransparency=1,LayoutOrder=toastOrder,Parent=toastHolder})
    corner(card, UDim.new(0, 10)); stroke(card, c, 1)
    local bar = new("Frame",{Position=UDim2.new(0,6,0,8),Size=UDim2.new(0,3,1,-16),BackgroundColor3=c,BorderSizePixel=0,Parent=card})
    corner(bar, UDim.new(1, 0))
    local iconTxt = kind=="success" and "✓" or kind=="error" and "✕" or (kind=="warn" or kind=="warning") and "!" or "i"
    local icon = new("TextLabel",{Text=iconTxt,Font=Theme.FontBold,TextSize=14,TextColor3=Theme.Text,BackgroundColor3=c,BorderSizePixel=0,Size=UDim2.fromOffset(24,24),Position=UDim2.new(0,14,0.5,0),AnchorPoint=Vector2.new(0,0.5),Parent=card})
    corner(icon, UDim.new(1, 0))
    new("TextLabel",{Text=tostring(text),Font=Theme.FontBold,TextSize=13,TextColor3=Theme.Text,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,BackgroundTransparency=1,Position=UDim2.new(0,46,0,desc and 10 or 0),Size=UDim2.new(1,-56,0,desc and 20 or 56),Parent=card})
    if desc then
        new("TextLabel",{Text=tostring(desc),Font=Theme.Font,TextSize=11,TextColor3=Theme.TextDim,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,BackgroundTransparency=1,Position=UDim2.new(0,46,0,30),Size=UDim2.new(1,-56,0,16),Parent=card})
    end
    table.insert(activeToasts, card)
    local mobile = isMobile()
    local startPos = mobile and UDim2.fromOffset(0, -40) or UDim2.fromOffset(60, 0)
    card.Position = startPos
    playTween(card, {GroupTransparency = 0, Position = UDim2.fromOffset(0, 0)}, 0.22)
    playTween(bar, {Size = UDim2.new(0, 3, 0, 0)}, Anim.NotificationDuration, Enum.EasingStyle.Linear)
    local dur = Anim.NotificationDuration
    task.delay(dur, function()
        if not card.Parent then return end
        local outEnd = mobile and UDim2.fromOffset(0, -40) or UDim2.fromOffset(60, 0)
        local t = playTween(card, {GroupTransparency = 1, Position = outEnd}, 0.22)
        if t then t.Completed:Connect(function() destroyToast(card) end) end
        task.delay(0.5, function() destroyToast(card) end)
    end)
end

local W, H = Config.Design.X, Config.Design.Y
local main = new("CanvasGroup",{Name="Window",Size=UDim2.fromOffset(W,H),Position=UDim2.fromScale(0.5,0.5),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=Theme.Bg,BorderSizePixel=0,ClipsDescendants=true,GroupTransparency=1,Visible=false,Parent=screen})
corner(main, UDim.new(0, 14)); stroke(main, Theme.Stroke, 1)
new("UISizeConstraint",{MinSize=Config.MinSize, MaxSize=Config.MaxSize, Parent=main})
local mainScale = new("UIScale", {Scale=1, Parent=main})
local windowSizeScale = 1
local panelBaseColor = Theme.Bg2
local cornerRadiusPx = 10

local Backgrounds = {
    ["Glitch"]  = { Type = "Sprite", Id = "rbxassetid://103058823767948", Cols = 4, Rows = 3, FrameW = 256, FrameH = 256, Frames = 12, FPS = 11 },
    ["Default"] = { Type = "Procedural" }
}
local BackgroundOrder = { "Default", "Glitch" }

local bgImage = new("ImageLabel",{Name="BackgroundImage",BackgroundTransparency=1,Image="",ScaleType=Enum.ScaleType.Crop,ResampleMode=Enum.ResamplerMode.Default,Size=UDim2.fromScale(1,1),ZIndex=0,Visible=false,Parent=main})
local bgProcedural = new("Frame",{Name="BackgroundProcedural",BackgroundColor3=Theme.Bg,BackgroundTransparency=0,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ZIndex=0,ClipsDescendants=true,Visible=false,Parent=main})
local procGradient = new("UIGradient",{
    Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(1, 2, 8)),
        ColorSequenceKeypoint.new(0.28, Color3.fromRGB(3, 9, 24)),
        ColorSequenceKeypoint.new(0.56, Color3.fromRGB(13, 7, 29)),
        ColorSequenceKeypoint.new(0.78, Color3.fromRGB(4, 18, 31)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(1, 2, 8)),
    }), Rotation = 0, Parent = bgProcedural
})

local procShapes = {}; local ambientGlows = {}
local glowColors = {Neon.Cyan, Neon.Magenta, Neon.Blue, Neon.Violet, Neon.Cyan}
for i = 1, #glowColors do
    local size = math.random(250, 410)
    local glow = new("Frame",{Name="AmbientGlow"..i,Size=UDim2.fromOffset(size,size),Position=UDim2.fromScale(math.random(),math.random()),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=glowColors[i],BackgroundTransparency=0.855,BorderSizePixel=0,ZIndex=0,Parent=bgProcedural})
    corner(glow, UDim.new(1, 0))
    local glowGradient = new("UIGradient",{Color=ColorSequence.new({ColorSequenceKeypoint.new(0,glowColors[i]),ColorSequenceKeypoint.new(1,Neon.Violet)}),Rotation=math.random(0,360),Parent=glow})
    table.insert(ambientGlows, {Frame=glow,Gradient=glowGradient,BaseSize=size,BaseX=glow.Position.X.Scale,BaseY=glow.Position.Y.Scale,Phase=math.random()*math.pi*2})
end
for i = 1, 58 do
    local size = math.random(4, 18)
    local isCircle = math.random(1, 5) <= 4
    local shapeSize = isCircle and UDim2.fromOffset(size, size) or UDim2.fromOffset(size * 1.8, math.max(2, math.floor(size * 0.22)))
    local tint = (i % 3 == 0) and Neon.Magenta or ((i % 2 == 0) and Neon.Cyan or Neon.Blue)
    local shape = new("Frame",{Size=shapeSize,Position=UDim2.fromScale(math.random(),math.random()),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=tint,BackgroundTransparency=isCircle and math.random(90,97)/100 or 0.82,BorderSizePixel=0,ZIndex=0,Parent=bgProcedural})
    if isCircle then corner(shape, UDim.new(1,0))
    else shape.Rotation = math.random(0, 180); corner(shape, UDim.new(1, 0)) end
    new("UIStroke",{Color=tint,Thickness=1,Transparency=math.random(42,72)/100,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=shape})
    table.insert(procShapes, {Frame=shape,SpeedX=(math.random()-0.5)*0.045,SpeedY=(math.random()-0.5)*0.045,RotSpeed=(math.random()-0.5)*9,Phase=math.random()*math.pi*2,BaseSize=size,BaseTransparency=shape.BackgroundTransparency})
end
local bgOverlay = new("Frame",{Name="BackgroundOverlay",BackgroundColor3=Color3.fromRGB(0,1,8),BackgroundTransparency=0.48,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ZIndex=1,Parent=main})

local bgConn, currentBGName, bgAnimated = nil, BackgroundOrder[1], true
local customBackgroundId = ""
local customImageFit = "Crop"

local function stopBGAnim() if bgConn then bgConn:Disconnect(); bgConn = nil end end

local function setBackground(name)
    local data = Backgrounds[name]; if not data then return end
    currentBGName = name; stopBGAnim()
    if data.Type == "Sprite" then
        bgProcedural.Visible = false; bgImage.Visible = true
        bgImage.Image = data.Id
        bgImage.ImageRectSize = Vector2.new(data.FrameW, data.FrameH)
        bgImage.ImageRectOffset = Vector2.new(0, 0)
        if bgAnimated and RunService then
            local startTime = os.clock(); local fps = data.FPS or 30
            bgConn = RunService.RenderStepped:Connect(function()
                local elapsed = os.clock() - startTime
                local currentFrame = math.floor(elapsed * fps) % data.Frames
                local col = currentFrame % data.Cols; local row = math.floor(currentFrame / data.Cols)
                bgImage.ImageRectOffset = Vector2.new(col * data.FrameW, row * data.FrameH)
            end)
        end
    elseif data.Type == "Procedural" then
        bgImage.Visible = false; bgProcedural.Visible = true
        if bgAnimated and RunService then
            local startTime = os.clock()
            bgConn = RunService.RenderStepped:Connect(function(dt)
                local elapsed = os.clock() - startTime
                procGradient.Rotation = (elapsed * 7) % 360
                for _, glowData in ipairs(ambientGlows) do
                    local glow = glowData.Frame
                    if glow.Parent then
                        local pulse = math.sin(elapsed * 0.55 + glowData.Phase)
                        glow.Position = UDim2.fromScale(glowData.BaseX + math.sin(elapsed*0.16+glowData.Phase)*0.075, glowData.BaseY + math.cos(elapsed*0.14+glowData.Phase)*0.075)
                        local glowScale = 1 + pulse * 0.055
                        glow.Size = UDim2.fromOffset(glowData.BaseSize * glowScale, glowData.BaseSize * glowScale)
                        glowData.Gradient.Rotation = (elapsed * 9 + glowData.Phase * 35) % 360
                    end
                end
                for _, s in ipairs(procShapes) do
                    local f = s.Frame
                    if f.Parent then
                        local px = f.Position.X.Scale + s.SpeedX * dt
                        local py = f.Position.Y.Scale + s.SpeedY * dt
                        if px > 1.2 then px = -0.2 elseif px < -0.2 then px = 1.2 end
                        if py > 1.2 then py = -0.2 elseif py < -0.2 then py = 1.2 end
                        f.Position = UDim2.fromScale(px, py)
                        f.Rotation = f.Rotation + s.RotSpeed * dt
                        local pulse = math.sin(elapsed * 1.65 + s.Phase); local scale = 1 + pulse * 0.12
                        f.Size = UDim2.fromOffset(s.BaseSize * scale, s.BaseSize * scale)
                        f.BackgroundTransparency = math.clamp(s.BaseTransparency - pulse * 0.04, 0.72, 0.99)
                    end
                end
            end)
        end
    end
end

local function setCustomBackground(assetId)
    assetId = tostring(assetId or ""):gsub("%s+", ""):gsub("^rbxassetid://", "")
    if not assetId:match("^%d+$") then return false, "Enter a numeric Roblox asset ID." end
    customBackgroundId = assetId; currentBGName = "Custom"; stopBGAnim()
    bgProcedural.Visible = false; bgImage.Visible = true
    bgImage.Image = "rbxassetid://" .. assetId
    bgImage.ImageRectSize = Vector2.new(0, 0); bgImage.ImageRectOffset = Vector2.new(0, 0)
    bgImage.ScaleType = (customImageFit == "Fit" and Enum.ScaleType.Fit) or (customImageFit == "Stretch" and Enum.ScaleType.Stretch) or Enum.ScaleType.Crop
    return true
end
local function setBGAnimated(on)
    bgAnimated = on
    if currentBGName == "Custom" then stopBGAnim() else setBackground(currentBGName) end
end

local function recomputeRootScale()
    local vp = camera and camera.ViewportSize or Vector2.new(1280,720)
    local mobile = isMobile()
    local targetW, targetH
    if mobile then
        targetW = math.floor(vp.X * Config.MobWidthPct); targetH = math.floor(vp.Y * Config.MobHeightPct)
    else
        targetW = math.floor(math.min(vp.X * Config.PcWidthPct, Config.MaxSize.X))
        targetH = math.floor(math.min(vp.Y * Config.PcHeightPct, Config.MaxSize.Y))
    end
    targetW = math.clamp(targetW, Config.MinSize.X, Config.MaxSize.X)
    targetH = math.clamp(targetH, Config.MinSize.Y, Config.MaxSize.Y)
    rootScale.Scale = math.min(targetW / W, targetH / H)
    updateToastLayout()
end
recomputeRootScale()

local animState = "idle"; local bubble = nil; local closed = false

local function animateShow(cb)
    if animState ~= "idle" or closed then return end
    animState = "showing"; main.Visible = true; setBlurActive(true)
    local center = UDim2.new(0.5, 0, 0.5, 0)
    main.GroupTransparency = 1; mainScale.Scale = 0.91 * windowSizeScale; main.Position = UDim2.new(0.5, 0, 0.5, 18)
    local done = false
    local function finish()
        if done or animState ~= "showing" then return end
        done = true
        main.GroupTransparency = 0; mainScale.Scale = windowSizeScale; main.Position = center; animState = "idle"
        if cb then pcall(cb) end
    end
    if Anim.OpenAnimation and Anim.EnableAnimations then
        local t = playTween(main, {GroupTransparency = 0, Position = center}, 0.46, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        playTween(mainScale, {Scale=windowSizeScale}, 0.52, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        if t then t.Completed:Connect(function(state) if state == Enum.PlaybackState.Completed then finish() end end); task.delay(0.68, finish) else finish() end
    else
        main.GroupTransparency = 0; mainScale.Scale = windowSizeScale; main.Position = center; finish()
    end
end

local function animateHide(cb)
    if animState ~= "idle" or closed then return end
    animState = "hiding"; setBlurActive(false)
    local center = UDim2.new(0.5, 0, 0.5, 0); local done = false
    local function finish()
        if done or animState ~= "hiding" then return end
        done = true; main.Visible = false; main.GroupTransparency = 0; mainScale.Scale = windowSizeScale
        main.Position = center; animState = "idle"
        if cb then pcall(cb) end
    end
    if Anim.CloseAnimation and Anim.EnableAnimations then
        local t = playTween(main, {GroupTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 14)}, 0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        playTween(mainScale, {Scale=0.94 * windowSizeScale}, 0.34, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        if t then t.Completed:Connect(function(state) if state == Enum.PlaybackState.Completed then finish() end end); task.delay(0.48, finish) else finish() end
    else finish() end
end

local titlebar = new("Frame",{Size=UDim2.new(1,0,0,44), BackgroundColor3=Theme.Bg2, BorderSizePixel=0, Parent=main})
corner(titlebar,UDim.new(0,14))
local logo = new("Frame",{Size=UDim2.fromOffset(26,26), Position=UDim2.new(0,12,0.5,0), AnchorPoint=Vector2.new(0,0.5), BackgroundColor3=Theme.Accent, BorderSizePixel=0, Parent=titlebar})
corner(logo,UDim.new(0,8))
new("TextLabel",{Text=Config.Logo,Font=Theme.FontBold,TextSize=15,TextColor3=Theme.Text,BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Parent=logo})
new("TextLabel",{Text=Config.Title,Font=Theme.FontBold,TextSize=14,TextColor3=Theme.Text,TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,Position=UDim2.new(0,46,0,0),Size=UDim2.new(1,-260,1,0),Parent=titlebar})
local titleBtns = new("Frame",{Size=UDim2.fromOffset(70,44), Position=UDim2.new(1,-9,0.5,0), AnchorPoint=Vector2.new(1,0.5), BackgroundTransparency=1, Parent=titlebar})
new("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,HorizontalAlignment=Enum.HorizontalAlignment.Right,VerticalAlignment=Enum.VerticalAlignment.Center,Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder,Parent=titleBtns})
local function titleBtn(t,c,o)
    local b = new("TextButton",{Text=t,Font=Theme.FontBold,TextSize=32,TextColor3=Theme.Text,BackgroundColor3=Theme.Bg3,BorderSizePixel=0,AutoButtonColor=false,Size=UDim2.fromOffset(60,40),LayoutOrder=o,Parent=titleBtns})
    corner(b,UDim.new(0,9)); stroke(b, Neon.Cyan, 1).Transparency = 0.72
    b.MouseEnter:Connect(function() playTween(b,{BackgroundColor3=c},0.1) end)
    b.MouseLeave:Connect(function() playTween(b,{BackgroundColor3=Theme.Bg3},0.1) end)
    return b
end
local btnMin = titleBtn("−",Theme.Bg4,1)

do
    local drag,di,sp,sp0 = false,nil,nil,nil
    titlebar.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag,di = true,i; sp,sp0 = i.Position, main.Position end
    end)
    titlebar.InputChanged:Connect(function(i)
        if not drag or i~=di then return end
        if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
            local d = i.Position-sp
            main.Position = UDim2.new(sp0.X.Scale,sp0.X.Offset+d.X,sp0.Y.Scale,sp0.Y.Offset+d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i) if i==di then drag,di = false,nil end end)
end

local body = new("Frame",{Size=UDim2.new(1,0,1,-44), Position=UDim2.new(0,0,0,44), BackgroundTransparency=1, Parent=main})
local sidebar = new("Frame",{Size=UDim2.new(0,168,1,0), BackgroundColor3=Theme.Bg2, BorderSizePixel=0, Parent=body})
corner(sidebar,UDim.new(0,12)); pad(sidebar,8)
new("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder,Parent=sidebar})

local searchWrap = new("Frame",{Size=UDim2.new(1,0,0,32), BackgroundColor3=Theme.Bg3, BorderSizePixel=0, LayoutOrder=1, Parent=sidebar})
corner(searchWrap,UDim.new(0,8))
local searchStroke = stroke(searchWrap,Theme.Stroke)
pad(searchWrap,8,0)
local searchBox = new("TextBox",{Text="", PlaceholderText="Search...", Font=Theme.Font, TextSize=12, TextColor3=Theme.Text, PlaceholderColor3=Theme.TextDim, TextXAlignment=Enum.TextXAlignment.Left, BackgroundTransparency=1, ClearTextOnFocus=false, Size=UDim2.fromScale(1,1), Parent=searchWrap})
searchBox.Focused:Connect(function() playTween(searchStroke,{Color=Theme.Accent, Thickness=1.5},0.15) end)
searchBox.FocusLost:Connect(function() playTween(searchStroke,{Color=Theme.Stroke, Thickness=1},0.15) end)
