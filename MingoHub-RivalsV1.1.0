-- INITIAL TAB
-- ==========================================================
do
    local first = Config.Tabs[1]
    activeTab = first
    for name, entry in pairs(tabFrames) do
        local isFirst = (name == first)
        entry.Group.Visible = isFirst
        entry.Group.GroupTransparency = isFirst and 0 or 1
        entry.Group.Position = UDim2.fromOffset(0, 0)
        entry.Scroll.ScrollingEnabled = isFirst
    end
    for name, btn in pairs(tabButtons) do
        if name == first then
            btn.TextColor3 = Theme.Text; btn.BackgroundColor3 = Theme.Bg3
            local outline = tabButtonStrokes[name]
