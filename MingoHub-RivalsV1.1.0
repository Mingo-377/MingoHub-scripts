-- ==========================================================
-- HOIST: applyAccentColor etc MUST be declared before applyConfig
-- ==========================================================
local applyAccentColor
local applyPanelBaseColor
local applyTextColor
local applyCornerRadius
local colorPickerSwatches = {}

-- ==========================================================
-- CONFIG SYSTEM
-- ==========================================================
local function resolveGlobalFunction(name)
    local value = nil
    pcall(function() value = _G[name] end)
    if type(value) == "function" then return value end
    local getter = nil
    pcall(function() getter = getgenv end)
    if type(getter) == "function" then
        local ok, env = pcall(getter)
        if ok and type(env) == "table" and type(env[name]) == "function" then return env[name] end
    end
    return nil
end

local fsRead = resolveGlobalFunction("readfile")
local fsWrite = resolveGlobalFunction("writefile")
local fsList = resolveGlobalFunction("listfiles")
local fsDelete = resolveGlobalFunction("delfile")
local fsMakeFolder = resolveGlobalFunction("makefolder")
local fsIsFolder = resolveGlobalFunction("isfolder")
local fsIsFile = resolveGlobalFunction("isfile")
local CONFIG_FOLDER = "MingoHubRivals"
local configMemory = {}
local selectedConfigName = nil
local autoLoadConfigName = nil
local configList = nil
local configNameBox = nil
local configExportBox = nil
local configSelectedLabel = nil
local configStorePersistent = type(fsRead)=="function" and type(fsWrite)=="function" and type(fsList)=="function" and type(fsDelete)=="function"

local function ensureConfigFolder()
    if not configStorePersistent then return false end
    if type(fsIsFolder)=="function" then
        local ok, exists = pcall(fsIsFolder, CONFIG_FOLDER)
        if ok and exists then return true end
    end
    if type(fsMakeFolder)=="function" then pcall(fsMakeFolder, CONFIG_FOLDER) end
    return true
end
local function sanitizeConfigName(name)
    name = tostring(name or ""):gsub("^%s+",""):gsub("%s+$","")
    name = name:gsub("[^%w_%- ]",""):gsub("%s+","_"):sub(1,32)
    return name
end
local function configPath(name) return CONFIG_FOLDER .. "/" .. name .. ".json" end

local function snapshotConfig()
    local c = Theme.Accent
    return {
        Version = 3,
        Accent = {math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5)},
        Background = currentBGName, BackgroundAssetId = customBackgroundId,
        BackgroundDim = bgOverlay.BackgroundTransparency,
        PanelTransparency = main.BackgroundTransparency,
        PanelBase = {math.floor(panelBaseColor.R*255+0.5), math.floor(panelBaseColor.G*255+0.5), math.floor(panelBaseColor.B*255+0.5)},
        TextColor = {math.floor(Theme.Text.R*255+0.5), math.floor(Theme.Text.G*255+0.5), math.floor(Theme.Text.B*255+0.5)},
        WindowSize = windowSizeScale, CornerRadius = cornerRadiusPx,
        AnimationSpeed = Anim.AnimationSpeed, ImageFit = customImageFit,
        AnimateBackground = bgAnimated, Animations = Anim.EnableAnimations, GlassBlur = blurEnabled,
        Rivals = {
            Aimbot = {Enabled=Rivals.Aimbot.Enabled, Smoothing=Rivals.Aimbot.Smoothing, FOV=Rivals.Aimbot.FOV, HitChance=Rivals.Aimbot.HitChance, Part=Rivals.Aimbot.Part},
            Silent = {Enabled=Rivals.Silent.Enabled, Part=Rivals.Silent.Part, FOV=Rivals.Silent.FOV},
            Rage   = {Enabled=Rivals.Rage.Enabled, Priority=Rivals.Rage.Priority},
            Trigger= {Enabled=Rivals.Trigger.Enabled, Delay=Rivals.Trigger.Delay},
            WalkSpeed=Rivals.WalkSpeed, JumpPower=Rivals.JumpPower, InfJump=Rivals.InfJump,
            HitSoundId=Rivals.HitSoundId, KillSoundId=Rivals.KillSoundId,
            ESP=Rivals.ESP, Antilag=Rivals.Antilag,
            Headless=Rivals.Headless, Korblox=Rivals.Korblox,
            TeamCheck=Rivals.TeamCheck,
        },
    }
end

local function readConfig(name)
    if configMemory[name] then return configMemory[name] end
    if not configStorePersistent then return nil, "No file storage." end
    local path = configPath(name)
    if type(fsIsFile)=="function" then
        local ok, exists = pcall(fsIsFile, path)
        if ok and not exists then return nil, "Config not found." end
    end
    local ok, raw = pcall(fsRead, path)
    if not ok or type(raw) ~= "string" then return nil, "Could not read config." end
    if not HttpService then return nil, "JSON service unavailable." end
    local decodedOk, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
    if not decodedOk or type(decoded) ~= "table" then return nil, "Config JSON invalid." end
    return decoded
end

local function saveConfig(name)
    name = sanitizeConfigName(name)
    if name == "" then Notify("Configs","error","Enter a config name."); return false end
    local data = snapshotConfig()
    configMemory[name] = data
    if configStorePersistent then
        ensureConfigFolder()
        if not HttpService then Notify("Configs","error","JSON service unavailable."); return false end
        local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
        if not ok then Notify("Configs","error","Encode failed."); return false end
        local wrote, err = pcall(fsWrite, configPath(name), encoded)
        if not wrote then Notify("Configs","error","Save failed: "..tostring(err)); return false end
    end
    selectedConfigName = name
    Notify("Configs","success", configStorePersistent and ("Saved "..name) or ("Saved "..name.." (session)"))
    return true
end

local function applyConfig(data)
    if type(data) ~= "table" then return false, "Invalid config." end
    if type(data.Accent)=="table" and #data.Accent>=3 then
        local r,g,b = tonumber(data.Accent[1]),tonumber(data.Accent[2]),tonumber(data.Accent[3])
        if r and g and b and applyAccentColor then
            applyAccentColor(Color3.fromRGB(math.clamp(r,0,255),math.clamp(g,0,255),math.clamp(b,0,255)))
        end
    end
    if type(data.PanelBase)=="table" and #data.PanelBase>=3 and applyPanelBaseColor then
        local r,g,b = tonumber(data.PanelBase[1]),tonumber(data.PanelBase[2]),tonumber(data.PanelBase[3])
        if r and g and b then applyPanelBaseColor(Color3.fromRGB(math.clamp(r,0,255),math.clamp(g,0,255),math.clamp(b,0,255))) end
    end
    if type(data.TextColor)=="table" and #data.TextColor>=3 and applyTextColor then
        local r,g,b = tonumber(data.TextColor[1]),tonumber(data.TextColor[2]),tonumber(data.TextColor[3])
        if r and g and b then applyTextColor(Color3.fromRGB(math.clamp(r,0,255),math.clamp(g,0,255),math.clamp(b,0,255))) end
    end
    if tonumber(data.WindowSize) then
        windowSizeScale = math.clamp(tonumber(data.WindowSize), 0.75, 1.2)
        if animState == "idle" then mainScale.Scale = windowSizeScale end
        if sliderSetters["Window size"] then sliderSetters["Window size"](math.floor(windowSizeScale*100+0.5), false) end
    end
    if tonumber(data.CornerRadius) and applyCornerRadius then
        applyCornerRadius(math.clamp(tonumber(data.CornerRadius),2,28))
        if sliderSetters["Corner roundness"] then sliderSetters["Corner roundness"](cornerRadiusPx, false) end
    end
    if tonumber(data.AnimationSpeed) then
        Anim.AnimationSpeed = math.clamp(tonumber(data.AnimationSpeed),0.5,1.6)
        if sliderSetters["Animation speed"] then sliderSetters["Animation speed"](math.floor(Anim.AnimationSpeed*100+0.5), false) end
    end
    Anim.EnableAnimations = data.Animations ~= false
    blurEnabled = data.GlassBlur ~= false
    bgAnimated = data.AnimateBackground ~= false
    if toggleSetters["Animations"] then toggleSetters["Animations"](Anim.EnableAnimations, false) end
    if toggleSetters["Glass Blur"] then toggleSetters["Glass Blur"](blurEnabled, false) end
    if toggleSetters["Animate Background"] then toggleSetters["Animate Background"](bgAnimated, false) end
    if tonumber(data.BackgroundDim) then
        bgOverlay.BackgroundTransparency = math.clamp(tonumber(data.BackgroundDim),0.15,0.85)
        if sliderSetters["Background dim"] then sliderSetters["Background dim"](math.floor(bgOverlay.BackgroundTransparency*100+0.5), false) end
    end
    if tonumber(data.PanelTransparency) then
        main.BackgroundTransparency = math.clamp(tonumber(data.PanelTransparency),0,0.85)
        if sliderSetters["Panel transparency"] then sliderSetters["Panel transparency"](math.floor(main.BackgroundTransparency*100+0.5), false) end
    end
    if data.ImageFit == "Crop" or data.ImageFit == "Fit" or data.ImageFit == "Stretch" then
        customImageFit = data.ImageFit
        if dropdownSetters["Image fit"] then dropdownSetters["Image fit"](customImageFit, false) end
    end
    local bgName = tostring(data.Background or "Default")
    if bgName == "Custom" and tostring(data.BackgroundAssetId or ""):match("^%d+$") then
        local ok, err = setCustomBackground(data.BackgroundAssetId)
        if not ok then return false, err end
    elseif bgName == "Default" or bgName == "Glitch" then
        setBackground(bgName)
    else setBackground("Default") end
    if dropdownSetters["Background"] then dropdownSetters["Background"](bgName, false) end
    setBGAnimated(bgAnimated)
    setBlurActive(main.Visible, false)

    if type(data.Rivals) == "table" then
        local R = data.Rivals
        if type(R.Aimbot)=="table" then
            if type(R.Aimbot.Enabled)=="boolean" and toggleSetters["Enable Aimbot"] then toggleSetters["Enable Aimbot"](R.Aimbot.Enabled, true) end
            if tonumber(R.Aimbot.Smoothing) and sliderSetters["Aimbot Smoothing"] then sliderSetters["Aimbot Smoothing"](R.Aimbot.Smoothing, false) end
            if tonumber(R.Aimbot.FOV) and sliderSetters["Aimbot FOV"] then sliderSetters["Aimbot FOV"](R.Aimbot.FOV, false) end
            if tonumber(R.Aimbot.HitChance) and sliderSetters["Aimbot Hit Chance %"] then sliderSetters["Aimbot Hit Chance %"](R.Aimbot.HitChance, false) end
            if R.Aimbot.Part and dropdownSetters["Target Part"] then dropdownSetters["Target Part"](R.Aimbot.Part, false) end
        end
        if type(R.Silent)=="table" then
            if type(R.Silent.Enabled)=="boolean" and toggleSetters["Enable Silent Aim"] then toggleSetters["Enable Silent Aim"](R.Silent.Enabled, true) end
            if R.Silent.Part and dropdownSetters["Silent Target"] then dropdownSetters["Silent Target"](R.Silent.Part, false) end
            if tonumber(R.Silent.FOV) and sliderSetters["Silent FOV"] then sliderSetters["Silent FOV"](R.Silent.FOV, false) end
        end
        if type(R.Rage)=="table" then
            if type(R.Rage.Enabled)=="boolean" and toggleSetters["Enable RageBot"] then toggleSetters["Enable RageBot"](R.Rage.Enabled, true) end
            if R.Rage.Priority and dropdownSetters["Weapon Priority"] then dropdownSetters["Weapon Priority"](R.Rage.Priority, false) end
        end
        if type(R.Trigger)=="table" then
            if type(R.Trigger.Enabled)=="boolean" and toggleSetters["Enable Trigger Bot"] then toggleSetters["Enable Trigger Bot"](R.Trigger.Enabled, true) end
            if tonumber(R.Trigger.Delay) and sliderSetters["Trigger Delay (ms)"] then sliderSetters["Trigger Delay (ms)"](R.Trigger.Delay, false) end
        end
        if tonumber(R.WalkSpeed) and sliderSetters["WalkSpeed"] then sliderSetters["WalkSpeed"](R.WalkSpeed, false) end
        if tonumber(R.JumpPower) and sliderSetters["JumpPower"] then sliderSetters["JumpPower"](R.JumpPower, false) end
        if type(R.InfJump)=="boolean" and toggleSetters["Infinite Jump"] then toggleSetters["Infinite Jump"](R.InfJump, false) end
        if R.HitSoundId then Rivals.HitSoundId = R.HitSoundId end
        if R.KillSoundId then Rivals.KillSoundId = R.KillSoundId end
        if type(R.ESP)=="boolean" and toggleSetters["Enable ESP"] then toggleSetters["Enable ESP"](R.ESP, true) end
        if type(R.Antilag)=="boolean" and toggleSetters["Full Antilag"] then toggleSetters["Full Antilag"](R.Antilag, true) end
        if type(R.Headless)=="boolean" and toggleSetters["Headless"] then toggleSetters["Headless"](R.Headless, false) end
        if type(R.Korblox)=="boolean" and toggleSetters["Korblox"] then toggleSetters["Korblox"](R.Korblox, false) end
        if type(R.TeamCheck)=="boolean" and toggleSetters["Team Check (TDM only)"] then toggleSetters["Team Check (TDM only)"](R.TeamCheck, false) end
    end
    return true
end

local function getConfigNames()
    local names, seen = {}, {}
    local function addName(rawName)
        local name = sanitizeConfigName(rawName); if name == "" then return end
        local key = string.lower(name)
        if not seen[key] then seen[key] = true; table.insert(names, name) end
    end
    for name in pairs(configMemory) do addName(name) end
    if configStorePersistent then
        ensureConfigFolder()
        local ok, files = pcall(fsList, CONFIG_FOLDER)
        if ok and type(files) == "table" then
            for _, path in ipairs(files) do
                local normalizedPath = tostring(path):gsub("\\", "/")
                local baseName = normalizedPath:match("([^/]+)$") or normalizedPath
                local fileName = baseName:match("^(.-)%.json$")
                if fileName and string.lower(fileName) ~= "autoload" then addName(fileName) end
            end
        end
    end
    table.sort(names, function(a, b) return string.lower(a) < string.lower(b) end)
    return names
end

local function updateConfigList()
    if not configList then return end
    for _, child in ipairs(configList:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
    if configSelectedLabel then
        local selectedText = selectedConfigName and ("SELECTED CONFIG  ·  " .. selectedConfigName) or "SELECTED CONFIG  ·  NONE"
        configSelectedLabel.Text = selectedText
        configSelectedLabel.TextColor3 = selectedConfigName and Theme.Accent or Theme.TextDim
    end
    local names = getConfigNames()
    if #names == 0 then UI.Label(configList, "No saved configs", 1, Theme.TextDim); return end
    for index, name in ipairs(names) do
        local configName = name
        local isSelected = selectedConfigName ~= nil and string.lower(configName) == string.lower(selectedConfigName)
        local row = new("Frame", {Name="ConfigEntry_"..configName, Size=UDim2.new(1,0,0,42), BackgroundColor3=isSelected and Theme.Bg3 or Theme.Bg2, BackgroundTransparency=isSelected and 0.08 or 0.18, BorderSizePixel=0, LayoutOrder=index, Parent=configList})
        corner(row, UDim.new(0, 8))
        local rowOutline = stroke(row, isSelected and Theme.Accent or Theme.Stroke, isSelected and 2 or 1)
        rowOutline.Transparency = isSelected and 0.02 or 0.72
        new("TextLabel", {Text=configName, Font=Theme.FontBold, TextSize=12, TextColor3=isSelected and Theme.Text or Theme.TextDim, TextXAlignment=Enum.TextXAlignment.Left, BackgroundTransparency=1, Position=UDim2.new(0,12,0,0), Size=UDim2.new(1,-92,1,0), ZIndex=2, Parent=row})
        if isSelected then
            new("TextLabel", {Text="✓ SELECTED", Font=Theme.FontBold, TextSize=9, TextColor3=Theme.Accent, TextXAlignment=Enum.TextXAlignment.Right, BackgroundTransparency=1, Position=UDim2.new(1,-88,0,0), Size=UDim2.fromOffset(78,42), ZIndex=2, Parent=row})
        end
        local hit = new("TextButton", {Name="SelectConfig", Text="", BackgroundTransparency=1, BorderSizePixel=0, AutoButtonColor=false, Size=UDim2.fromScale(1,1), ZIndex=3, Parent=row})
        hit.Activated:Connect(function() selectedConfigName = configName; if configNameBox then configNameBox.Text = configName end; updateConfigList() end)
    end
end

local function setAutoLoad(name)
    autoLoadConfigName = name
    if configStorePersistent and HttpService then
        ensureConfigFolder()
        local path = CONFIG_FOLDER .. "/AutoLoad.json"
        if name and name ~= "" then
            local encodedOk, encoded = pcall(function() return HttpService:JSONEncode({Name=name}) end)
            if encodedOk then pcall(fsWrite, path, encoded) end
        elseif type(fsIsFile) == "function" then
            local ok, exists = pcall(fsIsFile, path)
            if ok and exists then pcall(fsDelete, path) end
        else pcall(fsDelete, path) end
    end
    Notify("Configs","success", name and ("Auto-load set to "..name) or "Auto-load disabled")
end

local function loadConfig(name)
    name = sanitizeConfigName(name)
    if name == "" then Notify("Configs","error","Select a config first."); return false end
    local data, err = readConfig(name)
    if not data then Notify("Configs","error",err or "Load failed."); return false end
    local ok, applyErr = applyConfig(data)
    if not ok then Notify("Configs","error",applyErr or "Apply failed."); return false end
    selectedConfigName = name
    Notify("Configs","success","Loaded "..name)
    updateConfigList()
    return true
end

local function exportConfig(name)
    local data, err
    name = sanitizeConfigName(name or selectedConfigName or "")
    if name ~= "" then
        data, err = readConfig(name)
        if not data then Notify("Configs", "error", err or "Export failed."); return false end
    else data = snapshotConfig() end
    if not HttpService then Notify("Configs", "error", "JSON service unavailable."); return false end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok or type(encoded) ~= "string" then Notify("Configs", "error", "Encode failed."); return false end
    if configExportBox then configExportBox.Text = encoded end
    local clipboard = resolveGlobalFunction("setclipboard") or resolveGlobalFunction("toclipboard")
    if clipboard then
        local copied = pcall(clipboard, encoded)
        if copied then Notify("Configs", "success", "Copied to clipboard."); return true end
    end
    Notify("Configs", "info", "Export JSON shown below.")
    return true
end

local function deleteConfig(name)
    name = sanitizeConfigName(name)
    if name == "" then Notify("Configs","error","Select a config first."); return end
    if configStorePersistent then
        local path = configPath(name)
        local ok, err = pcall(fsDelete, path)
        if not ok then Notify("Configs","error","Delete failed: "..tostring(err)); return end
    end
    configMemory[name] = nil
    if autoLoadConfigName == name then setAutoLoad(nil) end
    if selectedConfigName == name then selectedConfigName = nil end
    Notify("Configs","success","Deleted "..name)
    updateConfigList()
end

if configStorePersistent and HttpService then
    local path = CONFIG_FOLDER .. "/AutoLoad.json"
    local ok, raw = pcall(fsRead, path)
    if ok and type(raw)=="string" then
        local decodedOk, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
        if decodedOk and type(decoded)=="table" and type(decoded.Name)=="string" then
            autoLoadConfigName = sanitizeConfigName(decoded.Name)
        end
    end
end

-- ==========================================================
-- TAB: MISC (theme + reset)
-- ==========================================================
do
    local st = tabs["Misc"]
    UI.Header(st, "Appearance", 1)
    UI.Slider(st, "Accent Hue", 0, 360, 210, function(v)
        local color = Color3.fromHSV(v/360, 0.72, 1)
        if applyAccentColor then applyAccentColor(color) end
    end, 2)
    UI.Toggle(st, "Animations", true, function(on) Anim.EnableAnimations = on end, 3)
    UI.Toggle(st, "Glass Blur", true, function(on) blurEnabled = on; setBlurActive(main.Visible, false) end, 4)
    UI.Slider(st, "Panel transparency", 10, 75, 35, function(v) main.BackgroundTransparency = v / 100 end, 5)

    UI.Divider(st, 6)
    UI.Header(st, "Background", 7)
    UI.Dropdown(st, "Background", BackgroundOrder, function(opt) setBackground(opt) end, 8)
    UI.Dropdown(st, "Image fit", {"Crop","Fit","Stretch"}, function(opt) customImageFit = opt; if currentBGName == "Custom" then setCustomBackground(customBackgroundId) end end, 9)
    local backgroundIdBox = UI.Textbox(st, "", "Custom Roblox image asset ID", function(_) end, 10)
    UI.Button(st, "Apply custom background", nil, function()
        local ok, err = setCustomBackground(backgroundIdBox.Text)
        if ok then Notify("Background","success","Applied") else Notify("Background","error",err) end
    end, 11)
    UI.Button(st, "Reset background", nil, function() customBackgroundId = ""; setBackground("Default"); Notify("Background","success","Reset") end, 12)
    UI.Slider(st, "Background dim", 15, 85, 48, function(v) bgOverlay.BackgroundTransparency = v / 100 end, 13)
    UI.Toggle(st, "Animate Background", true, function(on) setBGAnimated(on) end, 14)

    UI.Divider(st, 15)
    UI.Header(st, "Theme & Colors", 16)
    local function addRGBPicker(title, initialColor, applyColor, baseOrder)
        local swatch = new("Frame", {Size=UDim2.new(1,0,0,22), BackgroundColor3=initialColor, BorderSizePixel=0, LayoutOrder=baseOrder, Parent=st})
        corner(swatch, UDim.new(0, 7)); stroke(swatch, Theme.Stroke, 1)
        colorPickerSwatches[title] = swatch
        local channels = {
            R = math.floor(initialColor.R * 255 + 0.5),
            G = math.floor(initialColor.G * 255 + 0.5),
            B = math.floor(initialColor.B * 255 + 0.5),
        }
        local function update()
            local color = Color3.fromRGB(channels.R, channels.G, channels.B)
            if applyColor then applyColor(color) end
            swatch.BackgroundColor3 = color
        end
        UI.Slider(st, title .. " · Red", 0, 255, channels.R, function(v) channels.R = v; update() end, baseOrder + 1)
        UI.Slider(st, title .. " · Green", 0, 255, channels.G, function(v) channels.G = v; update() end, baseOrder + 2)
        UI.Slider(st, title .. " · Blue", 0, 255, channels.B, function(v) channels.B = v; update() end, baseOrder + 3)
    end

    applyAccentColor = function(color)
        local oldAccent, oldStroke = Theme.Accent, Theme.Stroke
        Theme.Accent, Theme.Stroke, Config.Accent, Neon.Cyan = color, color, color, color
        for _, obj in ipairs(screen:GetDescendants()) do
            if obj:IsA("UIStroke") then obj.Color = color
            elseif obj:IsA("GuiObject") and (obj.BackgroundColor3 == oldAccent or obj.BackgroundColor3 == oldStroke) then obj.BackgroundColor3 = color end
        end
        if colorPickerSwatches["Accent color"] then colorPickerSwatches["Accent color"].BackgroundColor3 = color end
        if activeTab then setTabVisual(activeTab, true) end
    end
    applyPanelBaseColor = function(color)
        local old = {Theme.Bg, Theme.Bg2, Theme.Bg3, Theme.Bg4}
        local dark = Color3.new(0,0,0)
        local palette = {color:Lerp(dark,0.78), color:Lerp(dark,0.58), color:Lerp(dark,0.38), color:Lerp(dark,0.18)}
        for _, obj in ipairs(screen:GetDescendants()) do
            if obj:IsA("GuiObject") then
                for i, oldColor in ipairs(old) do
                    if obj.BackgroundColor3 == oldColor then obj.BackgroundColor3 = palette[i]; break end
                end
            end
        end
        Theme.Bg, Theme.Bg2, Theme.Bg3, Theme.Bg4 = palette[1], palette[2], palette[3], palette[4]
        panelBaseColor = color
        main.BackgroundColor3 = Theme.Bg; bgProcedural.BackgroundColor3 = Theme.Bg
        if colorPickerSwatches["Panel color"] then colorPickerSwatches["Panel color"].BackgroundColor3 = color end
    end
    applyTextColor = function(color)
        local oldText, oldDim = Theme.Text, Theme.TextDim
        local newDim = color:Lerp(Theme.Bg, 0.34)
        for _, obj in ipairs(screen:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                if obj.TextColor3 == oldText then obj.TextColor3 = color
                elseif obj.TextColor3 == oldDim then obj.TextColor3 = newDim end
            end
        end
        Theme.Text, Theme.TextDim = color, newDim
        if colorPickerSwatches["Text color"] then colorPickerSwatches["Text color"].BackgroundColor3 = color end
    end
    applyCornerRadius = function(value)
        cornerRadiusPx = math.clamp(math.floor(value + 0.5), 2, 28)
        for _, obj in ipairs(screen:GetDescendants()) do
            if obj:IsA("UICorner") and obj.CornerRadius.Scale == 0 then obj.CornerRadius = UDim.new(0, cornerRadiusPx) end
        end
    end

    addRGBPicker("Accent color", Theme.Accent, function(c) if applyAccentColor then applyAccentColor(c) end end, 17)
    addRGBPicker("Panel color", panelBaseColor, function(c) if applyPanelBaseColor then applyPanelBaseColor(c) end end, 21)
    addRGBPicker("Text color", Theme.Text, function(c) if applyTextColor then applyTextColor(c) end end, 25)

    UI.Divider(st, 29)
    UI.Header(st, "More UI Customization", 30)
    UI.Slider(st, "Window size", 75, 120, 100, function(v)
        windowSizeScale = v / 100
        if animState == "idle" then playTween(mainScale, {Scale = windowSizeScale}, 0.16) end
    end, 31)
    UI.Slider(st, "Corner roundness", 2, 28, cornerRadiusPx, function(v)
        if applyCornerRadius then applyCornerRadius(v) end
    end, 32)
    UI.Slider(st, "Animation speed", 50, 160, 100, function(v) Anim.AnimationSpeed = v / 100 end, 33)

    UI.Divider(st, 34)
    UI.Header(st, "Rivals Reset", 35)
    UI.Button(st, "Reset Rivals Gameplay Settings", "Toggles, sliders, sounds — not UI theme", function()
        Rivals.Aimbot.Enabled=false; Rivals.Aimbot.Smoothing=5; Rivals.Aimbot.FOV=90; Rivals.Aimbot.HitChance=100; Rivals.Aimbot.Part="Head"
        Rivals.Silent.Enabled=false; Rivals.Silent.Part="Head"; Rivals.Silent.FOV=180
        Rivals.Rage.Enabled=false; Rivals.Rage.Priority="Current Weapon"
        Rivals.Trigger.Enabled=false; Rivals.Trigger.Delay=0
        Rivals.WalkSpeed=16; Rivals.JumpPower=16; Rivals.InfJump=false
        Rivals.HitSoundId=""; Rivals.KillSoundId=""
        Rivals.ESP=false; Rivals.Antilag=false
        Rivals.Headless=false; Rivals.Korblox=false
        Rivals.TeamCheck=true
        stopAimbot(); stopTrigger(); stopRage(); stopESP(); disableAntilag()
        if toggleSetters["Enable Aimbot"] then toggleSetters["Enable Aimbot"](false, false) end
        if toggleSetters["Enable Silent Aim"] then toggleSetters["Enable Silent Aim"](false, false) end
        if toggleSetters["Enable RageBot"] then toggleSetters["Enable RageBot"](false, false) end
        if toggleSetters["Enable Trigger Bot"] then toggleSetters["Enable Trigger Bot"](false, false) end
        if toggleSetters["Enable ESP"] then toggleSetters["Enable ESP"](false, false) end
        if toggleSetters["Full Antilag"] then toggleSetters["Full Antilag"](false, false) end
        if toggleSetters["Infinite Jump"] then toggleSetters["Infinite Jump"](false, false) end
        if toggleSetters["Headless"] then toggleSetters["Headless"](false, false) end
        if toggleSetters["Korblox"] then toggleSetters["Korblox"](false, false) end
        if toggleSetters["Team Check (TDM only)"] then toggleSetters["Team Check (TDM only)"](true, false) end
        if sliderSetters["WalkSpeed"] then sliderSetters["WalkSpeed"](16, false) end
        if sliderSetters["JumpPower"] then sliderSetters["JumpPower"](16, false) end
        if sliderSetters["Aimbot Smoothing"] then sliderSetters["Aimbot Smoothing"](5, false) end
        if sliderSetters["Aimbot FOV"] then sliderSetters["Aimbot FOV"](90, false) end
        if sliderSetters["Aimbot Hit Chance %"] then sliderSetters["Aimbot Hit Chance %"](100, false) end
        if sliderSetters["Trigger Delay (ms)"] then sliderSetters["Trigger Delay (ms)"](0, false) end
        applyMovement(); updateSilentStatus()
        Notify("Rivals","success","Gameplay reset")
    end, 36)
end

